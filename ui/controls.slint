// Reusable settings controls per the Figma "Components" and "Settings" frames:
// ON/OFF toggle, accent slider with ticks, segmented control, text field,
// path field with Browse, action button and the collapsible "Advanced Options" bar.
// The dropdown with check mark lives in menu.slint and is re-exported here.
import { Dropdown } from "menu.slint";
import { Theme, Icon } from "theme.slint";
export { Dropdown }

// Field fill used by text fields, the slider track and inactive toggles.
export global Field {
    out property <color> fill: Theme.dark ? #0B0B0B : #F6F6F6;
    out property <color> raised: Theme.dark ? #222222 : #DADADA;
    out property <color> knob: Theme.dark ? #444444 : #BDBDBD;
}

// Figma ON/OFF toggle: 64×30 well, a square knob and the state label.
export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled();
    width: 64px; height: 30px; border-radius: 6px;
    background: Field.fill;
    opacity: enabled ? 1 : 0.4;
    // Label well (the half without the knob)
    Rectangle {
        x: on ? 3px : parent.width / 2; y: 3px;
        width: parent.width / 2 - 3px; height: parent.height - 6px; border-radius: 4px;
        background: on ? Theme.accent.mix(Field.fill, 30%) : Field.raised;
        Text {
            text: on ? "ON" : "OFF"; font-size: 11px;
            color: on ? Theme.accent : Theme.fg-a3;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    Rectangle {
        x: on ? parent.width / 2 : 3px; y: 3px;
        width: parent.width / 2 - 3px; height: parent.height - 6px; border-radius: 4px;
        background: on ? Theme.accent : Field.knob;
        animate x { duration: 110ms; }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(); } }
}

// Accent slider: filled track with tick marks, pill thumb and optional scale labels.
export component AccentSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.1;
    in property <[string]> labels;
    in property <int> ticks: 9;
    in property <bool> enabled: true;
    callback changed(float);
    property <float> frac: clamp((root.value - root.minimum) / max(0.0001, root.maximum - root.minimum), 0, 1);
    property <length> track-h: 16px;
    height: labels.length > 0 ? 40px : 22px;
    opacity: enabled ? 1 : 0.4;
    track := Rectangle {
        y: 3px; height: root.track-h; border-radius: 4px; background: Field.fill;
        Rectangle { x: 0; width: parent.width * root.frac; border-radius: 4px; background: Theme.accent.mix(Field.fill, 25%); }
        for t in root.ticks: Rectangle {
            x: parent.width * (t + 1) / (root.ticks + 1); y: 5px;
            width: 1px; height: parent.height - 10px; background: Theme.divider;
        }
        Rectangle {
            x: clamp(parent.width * root.frac - 4px, 0, parent.width - 8px); y: -3px;
            width: 8px; height: parent.height + 6px; border-radius: 4px; background: Theme.accent;
        }
        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            function apply() {
                let raw = root.minimum + clamp(self.mouse-x / self.width, 0, 1) * (root.maximum - root.minimum);
                root.changed(round(raw / root.step) * root.step);
            }
            pointer-event(e) => { if (e.kind == PointerEventKind.up) { self.apply(); } }
        }
    }
    for l[i] in root.labels: Text {
        x: root.labels.length < 2 ? 0 : (root.width - self.width) * i / (root.labels.length - 1);
        y: root.track-h + 9px;
        text: l; font-size: 11px; color: Theme.fg-a3;
    }
}

// Segmented control (e.g. Theme: Dark | Light | System).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <string> value;
    in property <bool> enabled: true;
    callback selected(string);
    height: 32px; border-radius: 6px; background: Field.fill;
    opacity: enabled ? 1 : 0.4;
    HorizontalLayout {
        padding: 2px; spacing: 2px;
        for o in root.options: Rectangle {
            horizontal-stretch: 1; border-radius: 4px;
            background: o == root.value ? Theme.accent.mix(Field.fill, 30%) : (sta.has-hover ? Field.raised : Field.raised.mix(Field.fill, 60%));
            Text {
                text: o; font-size: 13px;
                color: o == root.value ? Theme.accent : Theme.fg-a2;
                horizontal-alignment: center; vertical-alignment: center;
            }
            sta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.selected(o); } }
        }
    }
}

// Single-line text field on the dark field fill.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> password;
    callback edited(string);
    callback accepted(string);
    height: 32px; border-radius: 6px; background: Field.fill;
    border-width: ti.has-focus ? 1px : 0px; border-color: Theme.accent;
    opacity: enabled ? 1 : 0.4;
    clip: true;
    if root.text == "" && !ti.has-focus: Text {
        x: 12px; height: parent.height; text: root.placeholder;
        color: Theme.fg-a3; font-size: 13px; vertical-alignment: center;
    }
    ti := TextInput {
        x: 12px; width: parent.width - 24px; height: parent.height;
        text <=> root.text; enabled: root.enabled;
        input-type: root.password ? InputType.password : InputType.text;
        color: Theme.fg-2; font-size: 13px; vertical-alignment: center;
        selection-background-color: Theme.accent-bg;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
}

// Flat text button (Browse, Rescan, Reset…).
export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px; min-width: bt.preferred-width + 32px; border-radius: 6px;
    background: bta.has-hover ? Field.raised : transparent;
    opacity: enabled ? 1 : 0.4;
    bt := Text { text: root.text; color: Theme.fg-1; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    bta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Path / file field with a Browse button.
export component PathField inherits HorizontalLayout {
    in-out property <string> text;
    in property <bool> enabled: true;
    callback edited(string);
    callback browse();
    spacing: 8px;
    TextField { horizontal-stretch: 1; text <=> root.text; enabled: root.enabled; edited(t) => { root.edited(t); } }
    FlatButton { text: "Browse"; enabled: root.enabled; clicked => { root.browse(); } }
}

// Collapsible "Advanced Options ›" bar shown at the end of a section.
export component AdvancedBar inherits Rectangle {
    in-out property <bool> expanded;
    callback toggled(bool);
    height: 40px; border-radius: 6px;
    background: ata.has-hover ? Theme.bg-a3.mix(Theme.bg-a1, 50%) : Theme.bg-a3;
    HorizontalLayout {
        alignment: center; spacing: 8px;
        Text { text: "Advanced Options"; color: Theme.fg-a1; font-size: 13px; vertical-alignment: center; }
        Icon {
            y: (parent.height - 16px) / 2; width: 16px; height: 16px;
            source: root.expanded ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg");
            tint: Theme.fg-a1;
        }
    }
    ata := TouchArea { mouse-cursor: pointer; clicked => { root.expanded = !root.expanded; root.toggled(root.expanded); } }
}
