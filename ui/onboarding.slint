// First-run onboarding per Figma "Onboarding" frames: welcome → theme & color → hotkeys.
import { Theme, Metrics, Icon } from "core/theme.slint";
import { PrimaryButton, SecondaryButton, ButtonSize } from "core/buttons.slint";
import { Modal } from "core/modal.slint";

component ThemeCard inherits Rectangle {
    in property <string> name;
    in property <bool> dark;
    in property <bool> selected;
    in property <length> w: 200px;
    callback clicked();
    width: w; height: w * 0.75; border-radius: Metrics.radius-xl;
    background: Theme.bg-a1;
    border-width: 2px; border-color: selected ? Theme.accent : transparent;
    // Mini player preview
    Rectangle {
        x: 12px; y: 12px; width: parent.width - 24px; height: root.height - 58px; border-radius: Metrics.radius-md;
        background: dark ? Theme.preview-dark : Theme.preview-light;
        Rectangle { y: parent.height - 22px; height: 22px; border-radius: Metrics.radius-md; background: dark ? Theme.preview-dark-bar : Theme.preview-light-bar;
            Rectangle { x: 8px; y: 4px; width: parent.width - 16px; height: 3px; background: Theme.accent; }
            Rectangle { x: (parent.width - 16px) / 2; y: 10px; width: 16px; height: 9px; border-radius: Metrics.radius-xs; background: Theme.accent; }
        }
    }
    Text { x: 12px; y: root.height - 36px; text: root.name; color: Theme.fg-1; font-size: Metrics.font-lg; }
    TouchArea { accessible-role: button; accessible-label: root.name; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component OnboardingDialog inherits Modal {
    in-out property <int> step: 0;
    in property <bool> dark: true;
    in property <string> accent;
    in property <[string]> accents;
    in property <[color]> swatches;
    in property <[string]> keys;
    in property <[string]> actions;
    callback set-theme(string);
    callback set-accent(string);
    callback finish();

    // Compact layout for small windows.
    property <bool> compact: root.width < 700px || root.height < 520px;
    card-width: 1090px;
    card-height: 640px;
    inset: root.compact ? 16px : 48px;
    card-radius: Metrics.radius-xxl;
    scrim: Theme.bg-b1;
    dismiss-on-scrim: false;
    // Step dots + skip
    HorizontalLayout {
        x: 24px; y: 22px; height: 10px; spacing: 6px; alignment: start;
        for i in 3: Rectangle { width: i == root.step ? 24px : 10px; height: 10px; border-radius: self.height / 2;
            background: i == root.step ? Theme.accent : Theme.divider; animate width { duration: 150ms; } }
    }
    Rectangle {
        x: root.card-w - self.width - 16px; y: 12px; width: sk.preferred-width + 20px; height: 30px; border-radius: Metrics.radius-sm;
        background: ska.has-hover ? Theme.bg-a1 : transparent;
        sk := Text { text: "Skip"; color: Theme.fg-a1; vertical-alignment: center; horizontal-alignment: center; }
        ska := TouchArea { accessible-role: button; accessible-label: "Skip"; mouse-cursor: pointer; clicked => { root.finish(); } }
    }

    VerticalLayout {
        y: root.compact ? 44px : 60px; height: root.card-h - (root.compact ? 44px + 62px : 60px + 80px);
        padding-left: root.compact ? 16px : 60px; padding-right: self.padding-left; spacing: 18px; alignment: center;
        if root.step == 0: VerticalLayout {
            spacing: 18px; alignment: center;
            HorizontalLayout { alignment: center; Image { source: @image-url("../assets/icons/vlc.svg"); width: root.compact ? 56px : 96px; height: self.width; } }
            Text { text: "Welcome to Vivi!"; color: Theme.fg-1; font-size: root.compact ? Metrics.font-xxl : Metrics.font-display; font-weight: 600; horizontal-alignment: center; }
            Text {
                text: "A fast, minimal media player built on mpv. It plays nearly any video or audio file, remembers where you stopped, and stays out of your way.";
                color: Theme.fg-a1; font-size: Metrics.font-lg; wrap: word-wrap; horizontal-alignment: center;
            }
        }
        if root.step == 1: VerticalLayout {
            spacing: root.compact ? 12px : 22px; alignment: center;
            Text { text: "Select your preferred theme and color."; wrap: word-wrap; color: Theme.fg-1; font-size: root.compact ? Metrics.font-h3 : Metrics.font-xxl; font-weight: 600; horizontal-alignment: center; }
            HorizontalLayout {
                spacing: root.compact ? 10px : 20px; alignment: center;
                ThemeCard { w: root.compact ? min(150px, (root.width - 80px) / 2) : 200px; name: "Dark"; dark: true; selected: root.dark; clicked => { root.set-theme("dark"); } }
                ThemeCard { w: root.compact ? min(150px, (root.width - 80px) / 2) : 200px; name: "Light"; dark: false; selected: !root.dark; clicked => { root.set-theme("light"); } }
            }
            HorizontalLayout {
                spacing: root.compact ? 8px : 12px; alignment: center;
                for a[i] in root.accents: Rectangle {
                    width: root.compact ? 28px : 34px; height: self.width; border-radius: self.width / 2; background: root.swatches[i];
                    border-width: a == root.accent ? 3px : 0px; border-color: Theme.fg-1;
                    TouchArea { accessible-role: button; accessible-label: "Accent colour " + a; accessible-checked: a == root.accent; mouse-cursor: pointer; clicked => { root.set-accent(a); } }
                }
            }
            if !root.compact: Text { text: "You can change this later in Settings → Interface."; color: Theme.fg-a3; horizontal-alignment: center; }
        }
        if root.step == 2: VerticalLayout {
            spacing: root.compact ? 8px : 14px; alignment: center;
            Text { text: "A few keys worth knowing"; color: Theme.fg-1; font-size: root.compact ? Metrics.font-h3 : Metrics.font-xxl; font-weight: 600; horizontal-alignment: center; }
            HorizontalLayout { alignment: center;
                VerticalLayout {
                    width: min(460px, root.width - 64px); spacing: root.compact ? 2px : 6px;
                    for k[i] in root.keys: HorizontalLayout {
                        height: root.compact ? 28px : 34px;
                        Text { text: root.actions[i]; color: Theme.fg-2; vertical-alignment: center; horizontal-stretch: 1; }
                        Rectangle {
                            width: kt.preferred-width + 18px; border-radius: Metrics.radius-sm; background: Theme.bg-a1;
                            border-width: 1px; border-color: Theme.divider;
                            kt := Text { text: k; color: Theme.fg-1; font-family: "DM Mono"; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                }
            }
            if !root.compact: Text { text: "All shortcuts: press ? at any time."; color: Theme.fg-a3; horizontal-alignment: center; }
        }
    }

    HorizontalLayout {
        x: root.compact ? 12px : 24px; y: root.card-h - (root.compact ? 50px : 62px); width: root.card-w - 2 * self.x; height: 38px; spacing: 10px;
        if root.step > 0: SecondaryButton { size: ButtonSize.lg; text: "Back"; clicked => { root.step -= 1; } }
        Rectangle { horizontal-stretch: 1; }
        PrimaryButton {
            size: ButtonSize.lg; text: root.step < 2 ? "Next" : "Get started";
            clicked => { if (root.step < 2) { root.step += 1; } else { root.finish(); } }
        }
    }
}
