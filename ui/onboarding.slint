// First-run onboarding per Figma "Onboarding" frames: welcome → theme & color → hotkeys.
import { Theme, Icon } from "theme.slint";

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    width: t.preferred-width + 32px; height: 38px; border-radius: Theme.radius-lg;
    background: primary ? (ta.has-hover ? Theme.accent-bright : Theme.accent) : (ta.has-hover ? Theme.divider : Theme.bg-a1);
    t := Text { text: root.text; color: primary ? Theme.bg-b2 : Theme.fg-1; font-weight: primary ? 600 : 400; vertical-alignment: center; horizontal-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component ThemeCard inherits Rectangle {
    in property <string> name;
    in property <bool> dark;
    in property <bool> selected;
    callback clicked();
    width: 200px; height: 150px; border-radius: 10px;
    background: Theme.bg-a1;
    border-width: 2px; border-color: selected ? Theme.accent : transparent;
    // Mini player preview
    Rectangle {
        x: 12px; y: 12px; width: parent.width - 24px; height: 92px; border-radius: 6px;
        background: dark ? #0E0E0E : #E7E7E7;
        Rectangle { y: parent.height - 22px; height: 22px; border-radius: 6px; background: dark ? #191919 : #D5D5D5;
            Rectangle { x: 8px; y: 4px; width: parent.width - 16px; height: 3px; background: Theme.accent; }
            Rectangle { x: (parent.width - 16px) / 2; y: 10px; width: 16px; height: 9px; border-radius: 2px; background: Theme.accent; }
        }
    }
    Text { x: 12px; y: 114px; text: root.name; color: Theme.fg-1; font-size: 15px; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component OnboardingDialog inherits Rectangle {
    in-out property <int> step: 0;
    in property <bool> dark: true;
    in property <string> accent;
    in property <[string]> accents;
    in property <[color]> swatches;
    in property <[string]> keys;
    in property <[string]> actions;
    callback set-theme(string);
    callback set-accent(string);
    callback finish();

    background: Theme.bg-b1;
    TouchArea { }
    Rectangle {
        width: min(1090px, root.width - 48px);
        height: min(640px, root.height - 48px);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        background: Theme.bg-a4; border-radius: 14px; border-width: 1px; border-color: Theme.bg-a1;
        clip: true;

        // Step dots + skip
        HorizontalLayout {
            x: 24px; y: 22px; height: 10px; spacing: 6px; alignment: start;
            for i in 3: Rectangle { width: i == root.step ? 24px : 10px; height: 10px; border-radius: 5px;
                background: i == root.step ? Theme.accent : Theme.divider; animate width { duration: 150ms; } }
        }
        Rectangle {
            x: parent.width - self.width - 16px; y: 12px; width: sk.preferred-width + 20px; height: 30px; border-radius: Theme.radius;
            background: ska.has-hover ? Theme.bg-a1 : transparent;
            sk := Text { text: "Skip"; color: Theme.fg-a1; vertical-alignment: center; horizontal-alignment: center; }
            ska := TouchArea { mouse-cursor: pointer; clicked => { root.finish(); } }
        }

        VerticalLayout {
            y: 60px; height: parent.height - 60px - 80px;
            padding-left: 60px; padding-right: 60px; spacing: 18px; alignment: center;
            if root.step == 0: VerticalLayout {
                spacing: 18px; alignment: center;
                HorizontalLayout { alignment: center; Image { source: @image-url("../assets/icons/vlc.svg"); width: 96px; height: 96px; } }
                Text { text: "Welcome to Vivi!"; color: Theme.fg-1; font-size: 32px; font-weight: 600; horizontal-alignment: center; }
                Text {
                    text: "A fast, minimal media player built on mpv. It plays nearly any video or audio file, remembers where you stopped, and stays out of your way.";
                    color: Theme.fg-a1; font-size: 15px; wrap: word-wrap; horizontal-alignment: center;
                }
            }
            if root.step == 1: VerticalLayout {
                spacing: 22px; alignment: center;
                Text { text: "Select your preferred theme and color."; color: Theme.fg-1; font-size: 24px; font-weight: 600; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: 20px; alignment: center;
                    ThemeCard { name: "Dark"; dark: true; selected: root.dark; clicked => { root.set-theme("dark"); } }
                    ThemeCard { name: "Light"; dark: false; selected: !root.dark; clicked => { root.set-theme("light"); } }
                }
                HorizontalLayout {
                    spacing: 12px; alignment: center;
                    for a[i] in root.accents: Rectangle {
                        width: 34px; height: 34px; border-radius: 17px; background: root.swatches[i];
                        border-width: a == root.accent ? 3px : 0px; border-color: Theme.fg-1;
                        TouchArea { mouse-cursor: pointer; clicked => { root.set-accent(a); } }
                    }
                }
                Text { text: "You can change this later in Settings → Interface."; color: Theme.fg-a3; horizontal-alignment: center; }
            }
            if root.step == 2: VerticalLayout {
                spacing: 14px; alignment: center;
                Text { text: "A few keys worth knowing"; color: Theme.fg-1; font-size: 24px; font-weight: 600; horizontal-alignment: center; }
                HorizontalLayout { alignment: center;
                    VerticalLayout {
                        width: 460px; spacing: 6px;
                        for k[i] in root.keys: HorizontalLayout {
                            height: 34px;
                            Text { text: root.actions[i]; color: Theme.fg-2; vertical-alignment: center; horizontal-stretch: 1; }
                            Rectangle {
                                width: kt.preferred-width + 18px; border-radius: Theme.radius; background: Theme.bg-a1;
                                border-width: 1px; border-color: Theme.divider;
                                kt := Text { text: k; color: Theme.fg-1; font-family: "DM Mono"; vertical-alignment: center; horizontal-alignment: center; }
                            }
                        }
                    }
                }
                Text { text: "All shortcuts: Settings → Keyboard Shortcuts."; color: Theme.fg-a3; horizontal-alignment: center; }
            }
        }

        HorizontalLayout {
            x: 24px; y: parent.height - 62px; width: parent.width - 48px; height: 38px; spacing: 10px;
            if root.step > 0: Btn { text: "Back"; clicked => { root.step -= 1; } }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                text: root.step < 2 ? "Next" : "Get started"; primary: true;
                clicked => { if (root.step < 2) { root.step += 1; } else { root.finish(); } }
            }
        }
    }
}
