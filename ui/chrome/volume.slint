// Volume controls: cone wedge, flat bar, hover popup and percent readout (see Customize → Volume).

import { Theme, Metrics, TriIcon } from "../core/theme.slint";

// Cone volume control (Figma "volume": 88x28 wedge, green→red gradient fill).
// The fill width follows the Figma states: 10% → 7px … 100% → 63px, 150% → 75px, 200% → 88px.
export component VolumeBar inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 150;
    callback changed(float);
    in property <bool> compact: false;
    width: compact ? 56px : 88px; height: compact ? Metrics.bar-track-h : 28px;
    // volume (percent) → filled width in Figma units (0..88)
    pure function fill-of(v: float) -> float {
        if (v <= 0) { return 0; }
        if (v <= 50) { return v * 0.66; }
        if (v <= 60) { return 33 + (v - 50) * 0.8; }
        if (v <= 70) { return 41 + (v - 60) * 0.7; }
        if (v <= 100) { return 48 + (v - 70) * 0.5; }
        if (v <= 150) { return 63 + (v - 100) * 0.24; }
        return min(88, 75 + (v - 150) * 0.26);
    }
    // inverse of fill-of
    pure function volume-of(x: float) -> float {
        if (x <= 33) { return x / 0.66; }
        if (x <= 41) { return 50 + (x - 33) / 0.8; }
        if (x <= 48) { return 60 + (x - 41) / 0.7; }
        if (x <= 63) { return 70 + (x - 48) / 0.5; }
        if (x <= 75) { return 100 + (x - 63) / 0.24; }
        return 150 + (x - 75) / 0.26;
    }
    property <float> fx: fill-of(min(root.value, root.maximum));
    // wedge edges: top y = 10.5 - x*10/88, bottom y = 15.5 + x*11/88
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 88; viewbox-height: 28;
        fill: Theme.track;
        MoveTo { x: 0; y: 10; }
        LineTo { x: 88; y: 0; }
        LineTo { x: 88; y: 28; }
        LineTo { x: 0; y: 16; }
        Close { }
    }
    // gradient fill, inset ~1.5 units so the black wedge reads as an outline
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 88; viewbox-height: 28;
        fill: @linear-gradient(90deg, Theme.meter-low 0%, Theme.meter-mid 58%, Theme.meter-high 79%, Theme.meter-peak 100%);
        opacity: 0.8; // Figma renders the gradient at ~80% over the black wedge
        MoveTo { x: 1.5; y: 11.5; }
        LineTo { x: 86.5; y: 2; }
        LineTo { x: 86.5; y: 26; }
        LineTo { x: 1.5; y: 14.5; }
        Close { }
    }
    // unfilled part
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 88; viewbox-height: 28;
        fill: Theme.track;
        MoveTo { x: root.fx; y: 10.5 - root.fx * 10 / 88; }
        LineTo { x: 88; y: 0.5; }
        LineTo { x: 88; y: 27.5; }
        LineTo { x: root.fx; y: 15.5 + root.fx * 12 / 88; }
        Close { }
    }
    TouchArea {
        mouse-cursor: pointer;
        accessible-role: slider; accessible-label: "Volume"; accessible-value: round(root.value) + "%";
        accessible-value-minimum: 0; accessible-value-maximum: root.maximum; accessible-value-step: 5;
        accessible-action-increment => { root.changed(min(root.maximum, root.value + 5)); }
        accessible-action-decrement => { root.changed(max(0, root.value - 5)); }
        moved => { if (self.pressed) { root.changed(min(root.maximum, root.volume-of(clamp(self.mouse-x / self.width, 0, 1) * 88))); } }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.changed(min(root.maximum, root.volume-of(clamp(self.mouse-x / self.width, 0, 1) * 88))); }
        }
        scroll-event(e) => {
            root.changed(clamp(root.value + (e.delta-y > 0 ? 5 : -5), 0, root.maximum));
            accept
        }
    }
}

// Shared input for every volume control style: one slider for screen readers (value, step,
// increment / decrement), click / drag to set, wheel to step. `cone` maps the position
// through the cone's fill curve; `vertical` reads bottom → top; `relative` drags change the
// value by the distance moved (the percentage readout has no track to point at).
export component VolumeTouch inherits TouchArea {
    in property <float> value;
    in property <float> maximum: 150;
    in property <bool> cone;
    in property <bool> vertical;
    in property <bool> relative;
    callback changed(float);
    callback tapped(); // a press without a drag (relative mode)
    property <float> start;
    property <bool> dragged;
    mouse-cursor: root.relative ? ew-resize : pointer;
    accessible-role: slider; accessible-label: "Volume"; accessible-value: round(root.value) + "%";
    accessible-value-minimum: 0; accessible-value-maximum: root.maximum; accessible-value-step: 5;
    accessible-action-increment => { root.changed(min(root.maximum, root.value + 5)); }
    accessible-action-decrement => { root.changed(max(0, root.value - 5)); }
    pure function cone-volume(x: float) -> float {
        if (x <= 33) { return x / 0.66; }
        if (x <= 41) { return 50 + (x - 33) / 0.8; }
        if (x <= 48) { return 60 + (x - 41) / 0.7; }
        if (x <= 63) { return 70 + (x - 48) / 0.5; }
        if (x <= 75) { return 100 + (x - 63) / 0.24; }
        return 150 + (x - 75) / 0.26;
    }
    pure function at() -> float {
        root.vertical ? 1 - clamp(self.mouse-y / self.height, 0, 1) : clamp(self.mouse-x / self.width, 0, 1)
    }
    function set-at() {
        root.changed(min(root.maximum, root.cone ? root.cone-volume(root.at() * 88) : root.at() * root.maximum));
    }
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) {
            root.start = root.value; root.dragged = false;
            if (!root.relative) { root.set-at(); }
        }
        if (e.kind == PointerEventKind.up && root.relative && !root.dragged) { root.tapped(); }
    }
    moved => {
        if (self.pressed) {
            if (root.relative) {
                root.dragged = root.dragged || abs(self.mouse-x - self.pressed-x) > 3px;
                if (root.dragged) { root.changed(clamp(round(root.start + (self.mouse-x - self.pressed-x) / 2px), 0, root.maximum)); }
            } else { root.set-at(); }
        }
    }
    scroll-event(e) => {
        root.changed(clamp(root.value + (e.delta-y > 0 ? 5 : -5), 0, root.maximum));
        accept
    }
}

// "Bar" volume: a flat slider drawn like the seek track of the current bar style.
export component VolumeSlider inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 150;
    in property <bool> compact;
    in property <bool> boxed: true;
    callback changed(float);
    width: compact ? 64px : 88px; height: compact ? Metrics.bar-track-h : 28px;
    property <float> frac: clamp(root.value / max(1, root.maximum), 0, 1);
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.boxed ? (root.compact ? root.height : Metrics.bar-track-h) : 4px;
        border-radius: root.boxed ? 4px : 2px;
        background: root.boxed ? Theme.track : Theme.bg-a1;
        Rectangle {
            x: root.boxed ? 1.5px : 0; y: root.boxed ? 1.5px : 0;
            height: parent.height - (root.boxed ? 3px : 0); border-radius: root.boxed ? 2.5px : 2px;
            width: max(0, (parent.width - (root.boxed ? 3px : 0)) * root.frac);
            background: root.boxed ? (ta.has-hover ? Theme.track-fill-hover : Theme.track-fill) : (ta.has-hover ? Theme.accent-bright : Theme.accent);
        }
    }
    Rectangle {
        width: root.boxed ? 5px : 4px; height: root.boxed ? track.height - 3px : 12px; border-radius: 2px;
        x: clamp(1.5px + (root.width - 3px) * root.frac - self.width, 1.5px, root.width - self.width - 1.5px);
        y: (root.height - self.height) / 2;
        background: Theme.accent;
        visible: root.boxed || ta.has-hover;
    }
    ta := VolumeTouch { value: root.value; maximum: root.maximum; changed(v) => { root.changed(v); } }
}

// "Popup" volume: the speaker icon only; hovering it opens a vertical slider above, the wheel
// changes the volume and a click mutes.
export component VolumePopup inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 150;
    in property <bool> compact;
    in property <string> duo; // icon name (two-tone, see TriIcon)
    in property <bool> flat; // single-tone (Theme.bar-duo off)
    in property <string> tip;
    callback changed(float);
    callback mute();
    width: compact ? 28px : 36px; height: compact ? 26px : 32px;
    border-radius: Metrics.radius-md;
    background: ita.has-hover ? Theme.bg-a1 : transparent;
    property <bool> open: ita.has-hover || pta.has-hover || pta.pressed;
    TriIcon { name: root.duo; flat: root.flat; width: root.compact ? 18px : 20px; height: self.width; tint: ita.has-hover ? Theme.fg-1 : Theme.fg-2; }
    ita := VolumeTouch {
        value: root.value; maximum: root.maximum; relative: true;
        accessible-label: root.tip;
        changed(v) => { root.changed(v); }
        tapped => { root.mute(); }
    }
    // The pop-up reaches down to the icon so moving onto it keeps it open.
    Rectangle {
        visible: root.open;
        property <length> card-h: 132px;
        x: (root.width - self.width) / 2; y: -self.card-h - 4px;
        width: 40px; height: self.card-h + 4px;
        Rectangle {
            height: parent.card-h; border-radius: Metrics.radius-md;
            background: Theme.bar.with-alpha(1); border-width: 1px; border-color: Theme.divider;
            Text { y: 8px; height: 14px; text: round(root.value) + "%"; color: Theme.fg-a2; font-size: Metrics.font-micro; horizontal-alignment: center; }
            Rectangle {
                x: (parent.width - self.width) / 2; y: 28px; width: 6px; height: parent.height - 40px;
                border-radius: self.width / 2; background: Theme.track;
                Rectangle {
                    y: parent.height * (1 - clamp(root.value / max(1, root.maximum), 0, 1));
                    height: parent.height - self.y; border-radius: parent.border-radius;
                    background: pta.has-hover ? Theme.accent-bright : Theme.accent;
                }
                pta := VolumeTouch {
                    x: -12px; width: parent.width + 24px;
                    value: root.value; maximum: root.maximum; vertical: true;
                    changed(v) => { root.changed(v); }
                }
            }
        }
    }
}

// "Percent" volume: the number next to the speaker icon; drag sideways or scroll to change.
export component VolumePercent inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 150;
    in property <bool> compact;
    callback changed(float);
    width: pt.preferred-width + 8px; height: compact ? 26px : 32px;
    border-radius: Metrics.radius-sm;
    background: ta.has-hover || ta.pressed ? Theme.bg-a1 : transparent;
    pt := Text {
        text: round(root.value) + "%"; font-size: Metrics.font-sm; font-family: "DM Mono";
        color: ta.has-hover ? Theme.fg-1 : Theme.fg-a2; vertical-alignment: center; horizontal-alignment: center;
    }
    ta := VolumeTouch { value: root.value; maximum: root.maximum; relative: true; changed(v) => { root.changed(v); } }
}
