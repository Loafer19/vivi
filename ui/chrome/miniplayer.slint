// Miniplayer chrome (Figma "Miniplayer" variants): tiny overlay, compact transport,
// info strip and optional queue.
import { Theme, Metrics, Icon } from "../core/theme.slint";
import { IconButton } from "../core/buttons.slint";
import { Playback } from "../state/playback.slint";
import { Panel } from "../state/panel.slint";
import { ScrollView } from "std-widgets.slint";

export component MiniPlayer inherits Rectangle {
    in property <bool> show-ui;
    in property <bool> tiny;
    in property <length> video-y;
    in property <length> video-h;
    in property <length> strip-h;
    in property <bool> q-shown;
    in property <length> q-h;
    in property <string> folder;
    in property <string> sub;
    in property <string> q-meta;
    in property <[string]> queue-durations;
    in property <bool> queue;
    in-out property <int> q-sel;
    callback focused();
    background: transparent;
    accessible-role: AccessibleRole.text;
    accessible-label: "Miniplayer";

// ---------- Miniplayer (Figma "Miniplayer" variants) ----------
// Tiny: video only; hovering shows play/pause and the way back.
if root.tiny && Playback.has-media && root.show-ui: Rectangle {
    width: root.width; height: root.video-h; x: 0; y: root.video-y;
    background: Theme.scrim-soft;
    IconButton { tab-focus: false; x: 6px; y: 6px; duo: "window"; tip: "Full player (P)"; clicked => { Playback.toggle-mini(); } }
    IconButton { tab-focus: false;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        primary: true; tip: Playback.playing ? "Pause" : "Play";
        duo: Playback.playing ? "pause" : "play";
        clicked => { Playback.toggle-play(); root.focused(); }
    }
    Rectangle {
        y: parent.height - 4px; height: 4px; x: 0;
        width: Playback.duration > 0 ? parent.width * Playback.position / Playback.duration : 0;
        background: Theme.accent;
    }
}
// Compact: × / ⧉ in the corners, transport in the middle, progress along the bottom edge.
if !root.tiny && Playback.has-media && root.show-ui: Rectangle {
    width: root.width; height: root.video-h; x: 0; y: root.video-y;
    background: Theme.scrim-soft;
    IconButton { tab-focus: false; x: 8px; y: 8px; icon: @image-url("../../assets/icons/close.svg"); tip: "Stop and close the miniplayer"; clicked => { Playback.stop(); Playback.toggle-mini(); } }
    IconButton { tab-focus: false; x: parent.width - self.width - 8px; y: 8px; duo: "window"; tip: "Full player (P)"; clicked => { Playback.toggle-mini(); } }
    HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2; y: (parent.height - 40px) / 2; width: self.preferred-width; height: 40px;
        spacing: 18px; alignment: center;
        IconButton { tab-focus: false; y: 4px; tip: "Previous"; duo: "previous"; clicked => { Playback.prev(); } }
        IconButton { tab-focus: false; y: 2px; primary: true; tip: Playback.playing ? "Pause" : (Playback.duration > 0 && Playback.position >= Playback.duration - 0.5 ? "Replay" : "Play"); duo: Playback.playing ? "pause" : (Playback.duration > 0 && Playback.position >= Playback.duration - 0.5 ? "replay" : "play"); clicked => { Playback.toggle-play(); root.focused(); } }
        IconButton { tab-focus: false; y: 4px; tip: "Next"; duo: "next"; clicked => { Playback.next(); } }
    }
    Rectangle {
        x: 10px; width: parent.width - 20px; y: parent.height - 18px; height: 14px;
        Rectangle { y: 5px; height: 4px; border-radius: self.height / 2; background: Theme.on-media-dim; }
        Rectangle { x: 0; y: 5px; height: 4px; border-radius: self.height / 2; width: Playback.duration > 0 ? parent.width * Playback.position / Playback.duration : 0; background: Theme.accent.mix(Theme.video-bg, 70%); }
        Rectangle {
            x: (Playback.duration > 0 ? parent.width * Playback.position / Playback.duration : 0) - 5px; y: 2px;
            width: 10px; height: 10px; border-radius: self.height / 2; background: Theme.accent;
        }
        TouchArea {
            mouse-cursor: pointer;
            accessible-role: slider; accessible-label: "Seek";
            accessible-value-minimum: 0; accessible-value-maximum: Playback.duration; accessible-value: round(Playback.position) + " s";
            clicked => { if (Playback.duration > 0) { Playback.seek(clamp(self.mouse-x / self.width, 0, 1) * Playback.duration); } }
        }
    }
}
// Info strip under the video: title, folder, subtitle track and the queue toggle.
if !root.tiny: Rectangle {
    x: 0; y: root.video-y + root.video-h; width: root.width; height: root.strip-h;
    background: Theme.bar-solid;
    TouchArea { }
    VerticalLayout {
        padding-left: 12px; padding-right: 8px; padding-top: 7px; padding-bottom: 5px; spacing: 2px;
        Text { text: Playback.media-title; color: Theme.fg-a2; font-size: Metrics.font-sm; overflow: elide; }
        HorizontalLayout {
            spacing: 6px;
            Icon { y: 4px; width: 14px; height: 14px; source: @image-url("../../assets/icons/folder.svg"); tint: Theme.fg-a3; }
            Text { text: root.folder; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; overflow: elide; max-width: 120px; }
            Rectangle { width: 6px; }
            Icon { y: 4px; width: 14px; height: 14px; source: @image-url("../../assets/icons/subtitles.svg"); tint: Theme.fg-a3; }
            Text { text: root.sub; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Rectangle {
                width: 26px; height: 22px; border-radius: Metrics.radius-sm;
                background: qta.has-hover ? Theme.bg-a1 : transparent;
                Icon { width: 16px; height: 16px; source: @image-url("../../assets/icons/queue.svg"); tint: root.queue ? Theme.accent : Theme.fg-a2; }
                qta := TouchArea { accessible-role: button; accessible-label: "Queue"; accessible-checked: root.queue; mouse-cursor: pointer; clicked => { Playback.toggle-mini-queue(); } }
                Tooltip { text: @markdown("Queue"); }
            }
        }
    }
}
// Queue variant: header, item count/length with sort/remove/add, draggable rows.
if root.q-shown: Rectangle {
    y: 0; height: root.q-h;
    background: Theme.bar-solid;
    TouchArea { }
    VerticalLayout {
        Rectangle {
            height: 36px; background: Theme.surface-head;
            Text { text: "Queue"; color: Theme.fg-a2; font-size: Metrics.font-sm; }
        }
        HorizontalLayout {
            height: 34px; padding-left: 12px; padding-right: 6px; spacing: 2px;
            Text { text: root.q-meta; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; horizontal-stretch: 1; }
            IconButton { tab-focus: false; y: 2px; width: 30px; height: 30px; duo: "sort"; tip: "Sort by name"; clicked => { Playback.queue-sort(); } }
            IconButton { tab-focus: false; y: 2px; width: 30px; height: 30px; duo: "remove"; tip: "Remove selected"; clicked => { if (root.q-sel >= 0) { Panel.queue-remove(root.q-sel); root.q-sel = -1; } } }
            IconButton { tab-focus: false; y: 2px; width: 30px; height: 30px; duo: "add"; tip: "Add files"; clicked => { Panel.queue-add(); } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start; spacing: 0px; padding-left: 6px; padding-right: 6px;
                for it[i] in Panel.queue: Rectangle {
                    height: 30px; border-radius: Metrics.radius-sm;
                    property <length> dy;
                    background: i == root.q-sel ? Theme.bg-a1 : row-ta.has-hover ? Theme.hover : transparent;
                    row-ta := TouchArea {
                        accessible-role: list-item; accessible-label: it.label; accessible-item-selected: i == root.q-sel;
                        accessible-action-default => { Panel.queue-play(i); }
                        mouse-cursor: pointer;
                        clicked => { root.q-sel = i; }
                        double-clicked => { Panel.queue-play(i); }
                    }
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 8px; spacing: 8px;
                        Rectangle {
                            width: 22px;
                            Icon { width: 14px; height: 14px; source: @image-url("../../assets/icons/list.svg"); tint: drag.pressed ? Theme.accent : Theme.fg-a3; }
                            drag := TouchArea {
                                accessible-role: button; accessible-label: "Drag to re-order " + it.label;
                                mouse-cursor: grab;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.up) {
                                        let d = round((self.mouse-y - self.pressed-y) / 30px);
                                        if (d != 0) { Panel.queue-move(i, clamp(d, -i, Panel.queue.length - 1 - i)); }
                                    }
                                }
                            }
                        }
                        Text { text: it.label; color: it.selected ? Theme.accent : Theme.fg-a2; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Text { text: i < root.queue-durations.length ? root.queue-durations[i] : ""; color: Theme.fg-a3; font-family: "DM Mono"; font-size: Metrics.font-xs; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
}
