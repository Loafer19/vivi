// UI of the built-in plugins (src/plugins): Skip intro button, karaoke lyrics overlay
// and the Figma "Add Subtitles" dialog (docs/design/frames/dialog-add-subtitles.png)
// used by the Subtitle Search plugin.
import { ScrollView } from "std-widgets.slint";
import { Theme, Icon } from "theme.slint";
import { Item } from "panel.slint";
import { Dropdown, TextField, FlatButton, Field } from "controls.slint";

// "Skip intro" / "Skip credits" pill, bottom right above the controls.
export component SkipButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    callback dismiss();
    width: row.preferred-width; height: 44px;
    border-radius: 10px;
    background: ta.has-hover ? Theme.accent : Theme.bar;
    border-width: 1px; border-color: Theme.accent;
    row := HorizontalLayout {
        padding-left: 18px; padding-right: 6px; spacing: 10px;
        Text { text: root.text; color: ta.has-hover ? Theme.bg-b2 : Theme.fg-1; font-size: 15px; font-weight: 600; vertical-alignment: center; }
        Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: @image-url("../assets/icons/next.svg"); tint: ta.has-hover ? Theme.bg-b2 : Theme.accent; }
        Rectangle {
            width: 28px;
            Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/close.svg"); tint: xa.has-hover ? Theme.fg-1 : Theme.fg-a3; }
            xa := TouchArea { mouse-cursor: pointer; clicked => { root.dismiss(); } }
        }
    }
    ta := TouchArea { width: parent.width - 34px; x: 0; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Karaoke lyrics: the current line in the accent color, neighbours fading out; the
// block scrolls smoothly as lines change. Drawn over video or the visualizer.
export component LyricsView inherits Rectangle {
    in property <[string]> lines;
    in property <int> index: -1;
    in property <length> size: 22px;
    in property <bool> plain;
    property <length> line-h: root.size * 1.7;
    property <int> visible-lines: root.plain ? 8 : 5;
    // Dim the picture behind the lyrics (off over the visualizer).
    in property <bool> backdrop;
    height: self.line-h * self.visible-lines;
    clip: true;
    if root.backdrop: Rectangle {
        x: (parent.width - self.width) / 2; width: min(parent.width, 760px);
        border-radius: 16px; background: #000000A0;
    }
    if !root.plain: Rectangle {
        for l[i] in root.lines: Text {
            property <int> d: abs(i - root.index);
            visible: self.d <= 3;
            x: 0; width: root.width;
            y: (i - root.index + 2) * root.line-h;
            height: root.line-h;
            animate y { duration: 260ms; easing: ease-out; }
            text: l == "" ? "♪" : l;
            horizontal-alignment: center; vertical-alignment: center;
            overflow: elide;
            font-size: i == root.index ? root.size * 1.15 : root.size;
            font-weight: i == root.index ? 700 : 500;
            color: i == root.index ? Theme.accent : #FFFFFF;
            opacity: i == root.index ? 1 : max(0.15, 0.7 - self.d * 0.2);
            animate opacity, color { duration: 200ms; }
        }
    }
    // Plain lyrics (no timing): every line, scroll with the wheel or by dragging.
    if root.plain: Flickable {
        x: (parent.width - self.width) / 2; width: min(parent.width, 760px);
        viewport-height: col.preferred-height;
        col := VerticalLayout {
            padding-top: 12px; padding-bottom: 12px;
            for l in root.lines: Text {
                text: l;
                horizontal-alignment: center; vertical-alignment: center;
                wrap: word-wrap;
                font-size: root.size * 0.8; font-weight: 500;
                color: #FFFFFF; opacity: 0.85;
            }
        }
    }
}

component SubRow inherits Rectangle {
    in property <Item> item;
    callback clicked();
    callback activated();
    in property <image> icon: @image-url("../assets/icons/subtitle.svg");
    in property <image> logo;
    property <string> name: root.item.label;
    height: 36px; border-radius: 6px;
    background: item.selected ? Theme.bg-a1 : ta.has-hover ? Theme.bg-a1.mix(Theme.bg-a3, 50%) : transparent;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        if root.logo.width == 0: Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: root.icon; tint: item.selected ? Theme.accent : Theme.fg-a2; }
        if root.logo.width > 0: Image { y: (parent.height - 24px) / 2; width: 32px; height: 24px; source: root.logo; image-fit: contain; }
        Text { horizontal-stretch: 1; text: root.item.key; color: Theme.fg-1; font-size: 13px; vertical-alignment: center; overflow: elide; }
        Text { text: root.item.label; color: Theme.fg-a3; font-size: 12px; vertical-alignment: center; }
        if item.selected: Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: @image-url("../assets/icons/check-active.svg"); }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.activated(); } }
}

// Local subtitle row of "From Computer": a subtitle file with a check (To This File) or
// a video paired with its subtitle over a dashed leader (To This Folder; label = sub).
component LocalSubRow inherits Rectangle {
    in property <Item> item;
    in property <bool> pair;
    callback clicked();
    height: 36px; border-radius: 6px;
    background: !root.pair && item.selected ? Theme.bg-b1 : ta.has-hover ? Theme.bg-a1.mix(Theme.bg-a3, 50%) : transparent;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; tint: Theme.fg-a2;
            source: root.pair ? @image-url("../assets/icons/video.svg") : @image-url("../assets/icons/subtitle.svg"); }
        Text { horizontal-stretch: root.pair ? 0 : 1; text: root.item.key; color: Theme.fg-2; font-size: 13px; vertical-alignment: center; overflow: elide; }
        if root.pair: Rectangle {
            horizontal-stretch: 1;
            // Dashed leader between the video and its subtitle (Figma).
            for i in floor(self.width / 8px): Rectangle {
                x: i * 8px; y: (parent.height - 1px) / 2; width: 4px; height: 1px; background: Theme.divider;
            }
        }
        if root.pair: Rectangle {
            width: 46%;
            HorizontalLayout { spacing: 10px;
                Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; tint: Theme.fg-a2; source: @image-url("../assets/icons/subtitle.svg"); }
                Text { horizontal-stretch: 1; text: root.item.label != "" ? root.item.label : "No subtitle file"; color: root.item.label != "" ? Theme.fg-2 : Theme.fg-a3; font-size: 13px; vertical-alignment: center; overflow: elide; }
            }
        }
        if !root.pair && item.selected: Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; tint: Theme.accent; source: @image-url("../assets/icons/check-active.svg"); }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Add Subtitles (Figma "Add Subtitles to Playlist/Folder"): target (this file / this
// folder) and source (OpenSubtitles / Computer) dropdowns. OpenSubtitles: search +
// language and a result list. Computer: the folder breadcrumb and its subtitle files
// (multi-select) or the folder's videos paired with their subtitles. Cancel / Save.
export component SubtitleDialog inherits Rectangle {
    in property <[Item]> results;    // key = file name, label = meta (see subtitles.rs)
    in property <[Item]> local;      // From Computer rows (see subtitles.rs)
    in property <string> folder;     // breadcrumb of the scanned folder
    in property <string> status;
    in property <bool> busy;
    in-out property <string> query;
    in-out property <string> lang;
    in-out property <int> target;    // 0 this file, 1 this folder
    in-out property <int> source;    // 0 OpenSubtitles, 1 Computer
    callback search();
    callback select(int);
    callback done(int);
    callback mode();                 // target or source changed
    callback toggle(int);
    callback browse();
    callback save-local();
    callback close();
    property <int> selected: -1;
    property <bool> can-save: root.source == 0 ? root.selected >= 0 && !root.busy : root.local.length > 0;
    background: #000000A0;
    TouchArea { clicked => { root.close(); } }
    dlg := Rectangle {
        width: min(1000px, root.width - 32px); height: min(760px, root.height - 32px);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        background: Theme.bg-a4; border-radius: 12px; border-width: 1px; border-color: Theme.bg-a1;
        drop-shadow-blur: 24px; drop-shadow-color: #00000080;
        clip: true;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                background: Theme.bg-b1;
                VerticalLayout {
                    HorizontalLayout {
                        height: 44px; padding-left: 16px; padding-right: 8px;
                        Text { horizontal-stretch: 1; text: "Add Subtitles"; color: Theme.fg-a1; font-size: 14px; vertical-alignment: center; }
                        VerticalLayout { alignment: center;
                            Rectangle { width: 30px; height: 30px; border-radius: Theme.radius; background: cx.has-hover ? Theme.bg-a1 : transparent;
                                Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/close.svg"); }
                                cx := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } } } }
                    }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; padding-bottom: 8px; spacing: 10px;
                        Dropdown {
                            width: 190px; options: ["To This File", "To This Folder"]; value: self.options[root.target];
                            selected(i, o) => { root.target = i; root.selected = -1; root.mode(); }
                        }
                        Dropdown {
                            width: 190px; options: ["From Computer", "From OpenSubtitles"]; value: root.source == 1 ? "From Computer" : "From OpenSubtitles";
                            selected(i, o) => { root.source = i == 0 ? 1 : 0; root.selected = -1; root.mode(); }
                        }
                        if root.source == 1: Rectangle {
                            horizontal-stretch: 1; height: 36px; border-radius: 6px; background: bx.has-hover ? Theme.bg-a1 : Theme.bg-a3;
                            HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 10px;
                                Icon { y: (parent.height - 20px) / 2; width: 20px; height: 20px; source: @image-url("../assets/icons/folder.svg"); tint: Theme.fg-a2; }
                                Text { horizontal-stretch: 1; text: root.folder; color: Theme.fg-a2; font-size: 14px; vertical-alignment: center; overflow: elide; }
                            }
                            bx := TouchArea { mouse-cursor: pointer; clicked => { root.browse(); } }
                        }
                        if root.source == 0: Rectangle {
                            horizontal-stretch: 1; height: 36px; border-radius: 6px; background: Theme.bg-a3;
                            Icon { x: 8px; width: 18px; height: 18px; source: @image-url("../assets/icons/search.svg"); tint: Theme.fg-a3; }
                            TextField {
                                x: 28px; width: parent.width - 30px; height: parent.height; background: transparent;
                                text <=> root.query; placeholder: "Title, episode…";
                                accepted => { root.selected = -1; root.search(); }
                            }
                        }
                        if root.source == 0: TextField { width: 110px; height: 36px; text <=> root.lang; placeholder: "English"; accepted => { root.selected = -1; root.search(); } }
                        if root.source == 0: FlatButton { height: 36px; text: root.busy ? "…" : "Search"; enabled: !root.busy; clicked => { root.selected = -1; root.search(); } }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.source == 0: ScrollView {
                    VerticalLayout {
                        padding: 16px; spacing: 2px; alignment: start;
                        for r[i] in root.results: SubRow {
                            item: r;
                            clicked => { root.selected = i; root.select(i); }
                            activated => { root.selected = i; root.select(i); root.done(root.selected); }
                        }
                    }
                }
                if root.source == 1: ScrollView {
                    VerticalLayout {
                        padding: 16px; spacing: 2px; alignment: start;
                        for r[i] in root.local: LocalSubRow {
                            item: r; pair: root.target == 1;
                            clicked => { root.toggle(i); }
                        }
                    }
                }
                if root.status != "": Text {
                    x: 24px; width: parent.width - 48px; y: (root.source == 0 ? root.results.length : root.local.length) == 0 ? (parent.height - self.height) / 2 : parent.height - self.height - 4px;
                    text: root.status; wrap: word-wrap; horizontal-alignment: center;
                    color: Theme.fg-a2; font-size: 13px;
                }
            }
            HorizontalLayout {
                padding: 16px; spacing: 8px; alignment: space-between;
                FlatButton { text: "Cancel"; clicked => { root.close(); } }
                Rectangle {
                    width: 94px; height: 32px; border-radius: 4px;
                    background: Theme.dark ? #371F06 : Theme.accent-bg;
                    opacity: root.can-save ? 1 : 0.5;
                    Text { text: "Save"; color: Theme.accent; font-weight: 600; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { enabled: root.can-save; mouse-cursor: pointer;
                        clicked => { if (root.source == 0) { root.done(root.selected); } else { root.save-local(); } } }
                }
            }
        }
    }
}

// Shared dialog of the music plugins (Auto-tagger, Free Music): optional source
// dropdown, query + search button, result list, a detail pane (tag diff or licence),
// status line and two actions. The owner plugin id routes the callbacks.
export component MusicDialog inherits Rectangle {
    in property <string> title;
    in property <[Item]> results;
    in property <[image]> logos;
    in property <string> status;
    in property <bool> busy;
    in property <string> detail;
    in property <string> placeholder;
    in property <string> search-label: "Search";
    in property <string> primary-text;
    in property <string> secondary-text;
    in property <[string]> sources;
    in-out property <string> source;
    in-out property <string> query;
    in property <[string]> chips;   // optional filter chips (Network Streams groups / categories)
    in property <string> chip;
    in property <[string]> actions; // optional extra footer buttons
    callback chip-clicked(string);
    callback action(string, int);
    callback search();
    callback select(int);
    callback primary(int);
    callback secondary(int);
    callback close();
    property <int> selected: -1;
    background: #000000A0;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: min(900px, root.width - 32px); height: min(640px, root.height - 32px);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        background: Theme.bg-a4; border-radius: 12px; border-width: 1px; border-color: Theme.bg-a1;
        clip: true;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: 44px; background: Theme.bg-a3;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 8px;
                    Text { horizontal-stretch: 1; text: root.title; color: Theme.fg-1; font-size: 14px; vertical-alignment: center; }
                    VerticalLayout { alignment: center;
                        Rectangle { width: 30px; height: 30px; border-radius: Theme.radius; background: mx.has-hover ? Theme.bg-a1 : transparent;
                            Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/close.svg"); }
                            mx := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } } } }
                }
            }
            HorizontalLayout {
                padding: 12px; spacing: 8px;
                if root.sources.length > 0: Dropdown {
                    width: 180px; options: root.sources; value: root.source;
                    selected(i, o) => { root.source = o; }
                }
                Rectangle {
                    horizontal-stretch: 1; height: 36px; border-radius: 6px; background: Field.fill;
                    Icon { x: 8px; width: 18px; height: 18px; source: @image-url("../assets/icons/search.svg"); tint: Theme.fg-a3; }
                    TextField {
                        x: 28px; width: parent.width - 30px; height: parent.height; background: transparent;
                        text <=> root.query; placeholder: root.placeholder;
                        accepted => { root.selected = -1; root.search(); }
                    }
                }
                FlatButton { height: 36px; text: root.busy ? "…" : root.search-label; enabled: !root.busy; clicked => { root.selected = -1; root.search(); } }
            }
            if root.chips.length > 0: Rectangle {
                height: 34px; clip: true;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; padding-bottom: 6px; spacing: 6px; alignment: start;
                    for c in root.chips: Rectangle {
                        width: ct.preferred-width + 20px; height: 26px; border-radius: 13px;
                        background: c == root.chip ? Theme.accent.with-alpha(0.30) : (cta.has-hover ? Theme.bg-a1 : Theme.bg-a3);
                        border-width: 1px; border-color: c == root.chip ? Theme.accent : transparent;
                        ct := Text { text: c; color: c == root.chip ? Theme.fg-1 : Theme.fg-a2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        cta := TouchArea { mouse-cursor: pointer; clicked => { root.selected = -1; root.chip-clicked(c); } }
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1; padding-left: 12px; padding-right: 12px; spacing: 12px;
                Rectangle {
                    horizontal-stretch: 3;
                    ScrollView {
                        VerticalLayout {
                            spacing: 2px; alignment: start;
                            for r[i] in root.results: SubRow {
                                item: { key: r.key, label: r.label, selected: i == root.selected };
                                icon: @image-url("../assets/icons/music.svg");
                                logo: i < root.logos.length ? root.logos[i] : @image-url("");
                                clicked => { root.selected = i; root.select(i); }
                                activated => { root.selected = i; root.select(i); root.primary(i); }
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 2; border-radius: 8px; background: Theme.bg-a3;
                    ScrollView {
                        VerticalLayout { padding: 12px; alignment: start;
                            Text { text: root.detail == "" ? "Select a result to see the details." : root.detail; wrap: word-wrap; color: root.detail == "" ? Theme.fg-a3 : Theme.fg-1; font-size: 12px; }
                        }
                    }
                }
            }
            HorizontalLayout {
                padding: 12px; spacing: 8px;
                Text { horizontal-stretch: 1; text: root.status; color: Theme.fg-a2; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                FlatButton { text: "Close"; clicked => { root.close(); } }
                for act in root.actions: FlatButton { text: act; enabled: !root.busy; clicked => { root.action(act, root.selected); } }
                FlatButton { text: root.secondary-text; enabled: !root.busy && (root.secondary-text == "Choose file…" || ((root.selected >= 0 || root.secondary-text == "Write all") && root.results.length > 0)); clicked => { root.secondary(root.selected); } }
                Rectangle {
                    width: max(96px, pt.preferred-width + 24px); height: 32px; border-radius: 6px;
                    opacity: root.selected >= 0 && !root.busy ? 1 : 0.5;
                    background: Theme.accent;
                    pt := Text { text: root.primary-text; color: Theme.bg-b2; font-weight: 600; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { enabled: root.selected >= 0 && !root.busy; mouse-cursor: pointer; clicked => { root.primary(root.selected); } }
                }
            }
        }
    }
}

// "Now playing" card for audio-only network streams (Network Streams plugin): station
// logo or a radio icon, station name, current ICY title and codec / bitrate.
export component NowPlayingCard inherits Rectangle {
    in property <string> station;
    in property <string> track;
    in property <string> info;
    in property <image> logo;
    in property <bool> has-logo;
    height: 120px;
    border-radius: 16px;
    background: Theme.bg-a4.with-alpha(0.88);
    border-width: 1px; border-color: Theme.accent.with-alpha(0.45);
    drop-shadow-blur: 24px; drop-shadow-color: #00000060;
    HorizontalLayout {
        padding: 16px; spacing: 16px;
        Rectangle {
            width: 88px; height: 88px; border-radius: 12px; clip: true;
            background: Theme.accent.with-alpha(0.18);
            if root.has-logo: Image { width: parent.width; height: parent.height; source: root.logo; image-fit: contain; }
            if !root.has-logo: Icon { x: 22px; y: 22px; width: 44px; height: 44px; source: @image-url("../assets/icons/streaming.svg"); tint: Theme.accent; }
        }
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: "NOW PLAYING"; color: Theme.accent; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
            Text { text: root.station; color: Theme.fg-1; font-size: 17px; font-weight: 600; overflow: elide; }
            if root.track != "": Text { text: root.track; color: Theme.fg-a2; font-size: 14px; overflow: elide; }
            if root.info != "": Text { text: root.info; color: Theme.fg-a3; font-size: 12px; overflow: elide; }
        }
    }
}

// ---------- Auto-tagger review (src/plugins/tagger.rs) ----------
export struct TagField { name: string, old: string, new: string, changed: bool, checked: bool, source: string }  // source: where `new` comes from
export struct TagCover { img: image, label: string, info: string }
export struct TagFile {
    name: string, source: string, confidence: int, checked: bool, fields: [TagField],
    has-old-cover: bool, old-cover: image, old-cover-info: string,
    covers: [TagCover], cover-pick: int,   // -1 keeps the existing cover
}

component Check inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    width: 18px; height: 18px; border-radius: 4px;
    border-width: 1px; border-color: root.checked ? Theme.accent : Theme.divider;
    background: root.checked ? Theme.accent : transparent;
    opacity: root.enabled ? 1 : 0.35;
    if root.checked: Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/check-active.svg"); tint: Theme.bg-b2; }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(); } }
}

component Thumb inherits Rectangle {
    in property <image> img;
    in property <bool> empty;
    in property <bool> picked;
    callback clicked();
    callback zoom();
    width: 72px; height: 72px; border-radius: 6px; clip: true;
    background: Theme.bg-b1;
    border-width: root.picked ? 2px : 1px; border-color: root.picked ? Theme.accent : Theme.divider;
    if !root.empty: Image { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; source: root.img; image-fit: cover; }
    if root.empty: Text { text: "No cover"; color: Theme.fg-a3; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.zoom(); } }
    if !root.empty: Rectangle {
        x: parent.width - 22px; y: 2px; width: 20px; height: 20px; border-radius: 4px; background: #000000A0;
        Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/search.svg"); tint: #FFFFFF; }
        TouchArea { mouse-cursor: pointer; clicked => { root.zoom(); } }
    }
}

// Before/after review: per file a card with one row per tag field (current next to
// proposed; changed rows highlighted, unchanged dimmed), the match source and
// confidence, and cover art (current vs. candidates, click to pick, magnifier to
// enlarge). Checkboxes per file and per field; Apply selected / Apply all / Skip.
// After writing, a summary with Undo (restores tags and covers from a backup).
export component TagReviewDialog inherits Rectangle {
    in property <[TagFile]> files;
    in property <string> status;
    in property <bool> busy;
    in property <string> summary;        // non-empty: the after-apply summary view
    in property <[string]> summary-lines;
    in property <bool> can-undo;
    callback cmd(string, string);
    property <image> zoom-img;
    property <string> zoom-info;
    property <bool> zoomed;
    background: #000000A0;
    TouchArea { }
    tdlg := Rectangle {
        width: min(980px, root.width - 32px); height: min(760px, root.height - 32px);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        background: Theme.bg-a4; border-radius: 12px; border-width: 1px; border-color: Theme.bg-a1;
        drop-shadow-blur: 24px; drop-shadow-color: #00000080;
        clip: true;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: 44px; background: Theme.bg-b1;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 8px; spacing: 10px;
                    Text { horizontal-stretch: 1; text: root.summary != "" ? "Auto-tagger · Done" : "Auto-tagger · Review changes"; color: Theme.fg-1; font-size: 14px; vertical-alignment: center; }
                    if root.summary == "": Text { text: "Changed"; color: Theme.accent; font-size: 12px; vertical-alignment: center; }
                    if root.summary == "": Text { text: "Unchanged"; color: Theme.fg-a3; font-size: 12px; vertical-alignment: center; }
                    VerticalLayout { alignment: center;
                        Rectangle { width: 30px; height: 30px; border-radius: Theme.radius; background: cx.has-hover ? Theme.bg-a1 : transparent;
                            Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/close.svg"); }
                            cx := TouchArea { mouse-cursor: pointer; clicked => { root.cmd("review-close", ""); } } } }
                }
            }
            if root.summary == "": ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px; spacing: 14px; alignment: start;
                    for f[fi] in root.files: card := Rectangle {
                        property <length> colw: (tdlg.width - 32px - 14px - 24px - 28px - 110px - 16px - 30px - 110px) / 2;
                        border-radius: 8px; background: Theme.bg-a3; border-width: 1px; border-color: Theme.bg-a1;
                        opacity: f.checked ? 1 : 0.55;
                        VerticalLayout {
                            padding: 12px; spacing: 4px;
                            HorizontalLayout {
                                spacing: 10px; height: 28px;
                                Check { y: 5px; checked: f.checked; toggled => { root.cmd("toggle-file", fi); } }
                                Text { horizontal-stretch: 1; text: f.name; color: Theme.fg-1; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                Rectangle {
                                    width: src.preferred-width + 16px; height: 22px; y: 3px; border-radius: 11px;
                                    background: (f.confidence >= 90 ? #2E7D32 : f.confidence >= 70 ? #B8860B : #B23B3B).with-alpha(0.25);
                                    src := Text { text: f.source; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
                                        color: f.confidence >= 90 ? #7CC47F : f.confidence >= 70 ? #E2B44A : #E57373; }
                                }
                            }
                            // Column headers
                            HorizontalLayout {
                                spacing: 10px; height: 22px; padding-left: 28px;
                                Text { width: 110px; text: "Field"; color: Theme.fg-a3; font-size: 11px; vertical-alignment: center; }
                                Text { width: card.colw; text: "Current"; color: Theme.fg-a3; font-size: 11px; vertical-alignment: center; }
                                Text { width: 16px; text: ""; }
                                Text { width: card.colw; text: "Proposed"; color: Theme.fg-a3; font-size: 11px; vertical-alignment: center; }
                                Text { width: 100px; text: "Source"; color: Theme.fg-a3; font-size: 11px; vertical-alignment: center; }
                            }
                            for t[ti] in f.fields: Rectangle {
                                height: 28px; border-radius: 4px;
                                background: t.changed ? Theme.accent.with-alpha(t.checked ? 0.12 : 0.05) : transparent;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Check { y: 5px; checked: t.checked; enabled: t.changed && f.checked; toggled => { root.cmd("toggle-field", fi + ":" + ti); } }
                                    Text { width: 110px; text: t.name; color: t.changed ? Theme.fg-2 : Theme.fg-a3; font-size: 13px; vertical-alignment: center; }
                                    Text { width: card.colw; text: t.old == "" ? "—" : t.old; color: Theme.fg-a3; font-size: 13px; vertical-alignment: center; overflow: elide;
                                        opacity: t.changed ? 1 : 0.7; }
                                    Text { width: 16px; text: t.changed ? "→" : "="; color: t.changed ? Theme.accent : Theme.fg-a3; font-size: 13px; vertical-alignment: center; horizontal-alignment: center; }
                                    Text { width: card.colw; text: t.changed ? t.new : (t.old == "" ? "—" : t.old); font-size: 13px; vertical-alignment: center; overflow: elide;
                                        color: t.changed ? (t.checked ? Theme.accent-bright : Theme.fg-a2) : Theme.fg-a3; font-weight: t.changed ? 600 : 400; }
                                    Text { width: 100px; text: t.changed ? t.source : ""; color: Theme.fg-a3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                            // Cover art: current vs. candidates
                            HorizontalLayout {
                                spacing: 10px; padding-top: 6px;
                                Check { y: 27px; checked: f.cover-pick >= 0; enabled: f.checked && f.covers.length > 0;
                                    toggled => { root.cmd("cover-pick", fi + ":" + (f.cover-pick >= 0 ? -1 : 0)); } }
                                VerticalLayout { width: 110px; alignment: center;
                                    Text { text: "Cover art"; color: f.cover-pick >= 0 ? Theme.fg-2 : Theme.fg-a3; font-size: 13px; }
                                    Text { text: f.covers.length == 0 ? "No candidates" : f.cover-pick >= 0 ? (f.has-old-cover ? "Replace" : "Embed") : "Keep current"; color: f.cover-pick >= 0 ? Theme.accent : Theme.fg-a3; font-size: 11px; }
                                }
                                VerticalLayout { spacing: 3px;
                                    Thumb { img: f.old-cover; empty: !f.has-old-cover; picked: f.cover-pick < 0;
                                        clicked => { root.cmd("cover-pick", fi + ":-1"); }
                                        zoom => { root.zoom-img = f.old-cover; root.zoom-info = "Current · " + f.old-cover-info; root.zoomed = true; } }
                                    Text { width: 72px; text: f.has-old-cover ? "Current\n" + f.old-cover-info : "Current"; color: f.cover-pick < 0 ? Theme.fg-2 : Theme.fg-a3; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; }
                                }
                                Text { text: "→"; color: Theme.accent; font-size: 16px; vertical-alignment: center; height: 72px; }
                                for c[ci] in f.covers: VerticalLayout { spacing: 3px;
                                    Thumb { img: c.img; picked: f.cover-pick == ci;
                                        clicked => { root.cmd("cover-pick", fi + ":" + ci); }
                                        zoom => { root.zoom-img = c.img; root.zoom-info = c.label + " · " + c.info; root.zoomed = true; } }
                                    Text { width: 72px; text: c.label + "\n" + c.info; color: f.cover-pick == ci ? Theme.accent : Theme.fg-a3; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
            if root.summary != "": VerticalLayout {
                vertical-stretch: 1; padding: 24px; spacing: 10px; alignment: start;
                Text { text: root.summary; color: Theme.fg-1; font-size: 18px; font-weight: 600; }
                for l in root.summary-lines: Text { text: l; color: Theme.fg-a2; font-size: 13px; overflow: elide; }
            }
            HorizontalLayout {
                padding: 12px; padding-left: 16px; spacing: 8px;
                Text { horizontal-stretch: 1; text: root.status; color: Theme.fg-a2; font-size: 12px; vertical-alignment: center; overflow: elide; }
                if root.summary == "": FlatButton { text: "Skip"; enabled: !root.busy; clicked => { root.cmd("review-close", ""); } }
                if root.summary == "": FlatButton { text: "Apply all"; enabled: !root.busy; clicked => { root.cmd("apply-all", ""); } }
                if root.summary == "": Rectangle {
                    width: 128px; height: 32px; border-radius: 6px; background: Theme.accent; opacity: root.busy ? 0.5 : 1;
                    Text { text: "Apply selected"; color: Theme.bg-b2; font-weight: 600; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { enabled: !root.busy; mouse-cursor: pointer; clicked => { root.cmd("apply-selected", ""); } }
                }
                if root.summary != "": FlatButton { text: "Undo"; enabled: root.can-undo && !root.busy; clicked => { root.cmd("undo", ""); } }
                if root.summary != "": Rectangle {
                    width: 80px; height: 32px; border-radius: 6px; background: Theme.accent;
                    Text { text: "Done"; color: Theme.bg-b2; font-weight: 600; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.cmd("review-close", ""); } }
                }
            }
        }
        // Enlarged cover
        if root.zoomed: Rectangle {
            background: #000000D0;
            TouchArea { mouse-cursor: pointer; clicked => { root.zoomed = false; } }
            VerticalLayout {
                alignment: center; spacing: 10px;
                HorizontalLayout { alignment: center;
                    Image { width: min(500px, root.height - 140px); height: self.width; source: root.zoom-img; image-fit: contain; } }
                Text { text: root.zoom-info + "  ·  click to close"; color: #DDDDDD; font-size: 13px; horizontal-alignment: center; }
            }
        }
    }
}
