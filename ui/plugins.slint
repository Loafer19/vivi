// UI of the built-in plugins (src/plugins): Skip intro button, karaoke lyrics overlay
// and the Figma "Add Subtitles" dialog (docs/design/frames/dialog-add-subtitles.png)
// used by the Subtitle Search plugin.
import { ScrollView } from "std-widgets.slint";
import { Theme, Metrics, Icon, TriIcon } from "core/theme.slint";
import { Item } from "panel.slint";
import { Dropdown, TextField } from "core/controls.slint";
import { Modal } from "core/modal.slint";
import { FlatButton, PrimaryButton } from "core/buttons.slint";
import { Badge, BadgeTone } from "core/rows.slint";
import { TagStatus } from "core/types.slint";

// "Skip intro" / "Skip credits" pill, bottom right above the controls.
export component SkipButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    callback dismiss();
    width: row.preferred-width; height: 44px;
    border-radius: Metrics.radius-xl;
    background: ta.has-hover ? Theme.accent : Theme.bar;
    border-width: 1px; border-color: Theme.accent;
    row := HorizontalLayout {
        padding-left: 18px; padding-right: 6px; spacing: 10px;
        Text { text: root.text; color: ta.has-hover ? Theme.bg-b2 : Theme.fg-1; font-size: Metrics.font-lg; font-weight: 600; vertical-alignment: center; }
        Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: @image-url("../assets/icons/next.svg"); tint: ta.has-hover ? Theme.bg-b2 : Theme.accent; }
        Rectangle {
            width: 28px;
            Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/close.svg"); tint: xa.has-hover ? Theme.fg-1 : Theme.fg-a3; }
            xa := TouchArea { accessible-role: button; accessible-label: "Dismiss"; mouse-cursor: pointer; clicked => { root.dismiss(); } }
        }
    }
    ta := TouchArea { accessible-role: button; accessible-label: root.text; width: parent.width - 34px; x: 0; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Karaoke lyrics: the current line in the accent color, neighbours fading out; the
// block scrolls smoothly as lines change. Drawn over video or the visualizer.
export component LyricsView inherits Rectangle {
    in property <[string]> lines;
    in property <int> index: -1;
    in property <length> size: 22px;
    in property <bool> plain;
    property <length> line-h: root.size * 1.7;
    property <int> visible-lines: root.plain ? 8 : 5;
    // Dim the picture behind the lyrics (off over the visualizer).
    in property <bool> backdrop;
    height: self.line-h * self.visible-lines;
    clip: true;
    if root.backdrop: Rectangle {
        x: (parent.width - self.width) / 2; width: min(parent.width, 760px);
        border-radius: Metrics.radius-xxl; background: Theme.media-chip;
    }
    if !root.plain: Rectangle {
        for l[i] in root.lines: Text {
            property <int> d: abs(i - root.index);
            visible: self.d <= 3;
            x: 0; width: root.width;
            y: (i - root.index + 2) * root.line-h;
            height: root.line-h;
            animate y { duration: 260ms; easing: ease-out; }
            text: l == "" ? "♪" : l;
            horizontal-alignment: center; vertical-alignment: center;
            overflow: elide;
            font-size: i == root.index ? root.size * 1.15 : root.size;
            font-weight: i == root.index ? 700 : 500;
            color: i == root.index ? Theme.accent : Theme.on-media;
            opacity: i == root.index ? 1 : max(0.15, 0.7 - self.d * 0.2);
            animate opacity, color { duration: 200ms; }
        }
    }
    // Plain lyrics (no timing): every line, scroll with the wheel or by dragging.
    if root.plain: Flickable {
        x: (parent.width - self.width) / 2; width: min(parent.width, 760px);
        content-height: col.preferred-height;
        col := VerticalLayout {
            padding-top: 12px; padding-bottom: 12px;
            for l in root.lines: Text {
                text: l;
                horizontal-alignment: center; vertical-alignment: center;
                wrap: word-wrap;
                font-size: root.size * 0.8; font-weight: 500;
                color: Theme.on-media; opacity: 0.85;
            }
        }
    }
}

component SubRow inherits Rectangle {
    in property <Item> item;
    callback clicked();
    callback activated();
    in property <image> icon: @image-url("../assets/icons/subtitle.svg");
    in property <image> logo;
    property <string> name: root.item.label;
    height: 36px; border-radius: Metrics.radius-md;
    background: item.selected ? Theme.bg-a1 : ta.has-hover ? Theme.bg-a1.mix(Theme.bg-a3, 50%) : transparent;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        if root.logo.width == 0: Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: root.icon; tint: item.selected ? Theme.accent : Theme.fg-a2; }
        if root.logo.width > 0: Image { y: (parent.height - 24px) / 2; width: 32px; height: 24px; source: root.logo; image-fit: contain; }
        nt := Text { horizontal-stretch: 1; min-width: min(self.preferred-width, root.width * 0.5); text: root.item.key; color: Theme.fg-1; font-size: Metrics.font-md; vertical-alignment: center; overflow: elide; }
        Text { horizontal-stretch: 0; max-width: max(0, root.width * 0.45); text: root.item.label; color: Theme.fg-a3; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; }
        if item.selected: Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: @image-url("../assets/icons/check-active.svg"); }
    }
    ta := TouchArea { accessible-role: list-item; accessible-label: root.item.key + ", " + root.item.label; accessible-item-selected: root.item.selected; accessible-action-default => { root.activated(); } mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.activated(); } }
    if nt.preferred-width > nt.width + 1px: Tooltip { text: @markdown("\{root.item.key}"); }
}

// Grid tile of the station browser: the logo (or a radio icon) with the name under it
// (two lines, then elided; the full name in the tooltip).
component StationTile inherits Rectangle {
    in property <Item> item;
    in property <image> logo;
    in property <length> logo-h;
    callback clicked();
    callback activated();
    border-radius: Metrics.radius-lg;
    background: item.selected ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.bg-a1 : Theme.bg-a3;
    border-width: 1px; border-color: item.selected ? Theme.accent.with-alpha(0.6) : transparent;
    Rectangle {
        x: 8px; y: 8px; width: parent.width - 16px; height: root.logo-h;
        border-radius: Metrics.radius-md; background: Theme.bg-b1; clip: true;
        if root.logo.width > 0: Image { x: 10px; y: 10px; width: parent.width - 20px; height: parent.height - 20px; source: root.logo; image-fit: contain; }
        if root.logo.width == 0: TriIcon {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 36px; height: 36px; tint: Theme.fg-a3;
            base: @image-url("../assets/icons/layers/streaming-twotone-b.svg"); accent: @image-url("../assets/icons/layers/streaming-twotone-a.svg"); dim: @image-url("../assets/icons/layers/streaming-twotone-d.svg");
        }
    }
    Text {
        x: 8px; y: root.logo-h + 14px; width: parent.width - 16px; height: parent.height - root.logo-h - 20px;
        text: root.item.key; wrap: word-wrap; overflow: elide;
        horizontal-alignment: center; vertical-alignment: top;
        color: Theme.fg-1; font-size: Metrics.font-sm;
    }
    ta := TouchArea { accessible-role: list-item; accessible-label: root.item.key + ", " + root.item.label; accessible-item-selected: root.item.selected; accessible-action-default => { root.activated(); } mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.activated(); } }
    Tooltip { text: @markdown("\{root.item.key}"); }
}

// List / grid switch of a dialog header: a two-tone icon (18 px), the active one raised.
component ViewButton inherits Rectangle {
    in property <string> label;   // screen-reader name and hover tooltip
    in property <bool> active;
    in property <image> base;
    in property <image> accent;
    in property <image> dim;
    callback clicked();
    width: 30px; height: 30px; border-radius: Metrics.radius-sm;
    background: root.active ? Theme.bg-a1 : ta.has-hover ? Theme.bg-a1.mix(Theme.bg-a3, 50%) : transparent;
    TriIcon { x: 6px; y: 6px; width: 18px; height: 18px; base: root.base; accent: root.accent; dim: root.dim; tint: root.active || ta.has-hover ? Theme.fg-1 : Theme.fg-a3; opacity: root.active || ta.has-hover ? 1 : 0.6; }
    ta := TouchArea { accessible-role: button; accessible-label: root.label; accessible-checked: root.active; mouse-cursor: pointer; clicked => { root.clicked(); } }
    kf := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; }
            reject
        }
    }
    if kf.has-focus: Rectangle { border-width: Metrics.focus-ring-w; border-color: Theme.focus-ring; border-radius: root.border-radius; }
    Tooltip { text: @markdown("\{root.label}"); }
}

// Local subtitle row of "From Computer": a subtitle file with a check (To This File) or
// a video paired with its subtitle over a dashed leader (To This Folder; label = sub).
component LocalSubRow inherits Rectangle {
    in property <Item> item;
    in property <bool> pair;
    callback clicked();
    height: 36px; border-radius: Metrics.radius-md;
    background: !root.pair && item.selected ? Theme.bg-b1 : ta.has-hover ? Theme.bg-a1.mix(Theme.bg-a3, 50%) : transparent;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; tint: Theme.fg-a2;
            source: root.pair ? @image-url("../assets/icons/video.svg") : @image-url("../assets/icons/subtitle.svg"); }
        Text { horizontal-stretch: root.pair ? 0 : 1; text: root.item.key; color: Theme.fg-2; font-size: Metrics.font-md; vertical-alignment: center; overflow: elide; }
        if root.pair: Rectangle {
            horizontal-stretch: 1;
            // Dashed leader between the video and its subtitle (Figma).
            for i in floor(self.width / 8px): Rectangle {
                x: i * 8px; y: (parent.height - 1px) / 2; width: 4px; height: 1px; background: Theme.divider;
            }
        }
        if root.pair: Rectangle {
            width: 46%;
            HorizontalLayout { spacing: 10px;
                Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; tint: Theme.fg-a2; source: @image-url("../assets/icons/subtitle.svg"); }
                Text { horizontal-stretch: 1; text: root.item.label != "" ? root.item.label : "No subtitle file"; color: root.item.label != "" ? Theme.fg-2 : Theme.fg-a3; font-size: Metrics.font-md; vertical-alignment: center; overflow: elide; }
            }
        }
        if !root.pair && item.selected: Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; tint: Theme.accent; source: @image-url("../assets/icons/check-active.svg"); }
    }
    ta := TouchArea { accessible-role: list-item; accessible-label: root.item.key; accessible-item-selected: root.item.selected; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// OpenSubtitles result (src/plugins/subtitles.rs): file name, feature title, language,
// downloads, rating, FPS and the hash / hearing-impaired / trusted / machine / pick flags.
export struct SubHit { name: string, title: string, lang: string, downloads: string, rating: string, hi: bool, fps: string, hash: bool, trusted: bool, ai: bool, pick: bool }

component SubHitRow inherits Rectangle {
    in property <SubHit> hit;
    in property <bool> selected;
    in property <bool> busy;
    callback clicked();
    callback load();
    height: 56px; border-radius: Metrics.radius-lg;
    background: root.selected ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.bg-a1 : transparent;
    border-width: 1px; border-color: root.selected ? Theme.accent.with-alpha(0.6) : transparent;
    ta := TouchArea { accessible-role: list-item; accessible-label: root.hit.name; accessible-item-selected: root.selected; accessible-action-default => { root.load(); } mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.load(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        VerticalLayout { alignment: center;
            Rectangle { width: 38px; height: 26px; border-radius: Metrics.radius-md; background: root.hit.hash ? Theme.accent : Theme.bg-a1;
                Text { text: root.hit.lang; font-size: Metrics.font-xs; font-weight: 700; color: root.hit.hash ? Theme.bg-b2 : Theme.fg-2; horizontal-alignment: center; vertical-alignment: center; } } }
        VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
            Text { text: root.hit.name; color: Theme.fg-1; font-size: Metrics.font-md; font-weight: 600; overflow: elide; }
            HorizontalLayout { spacing: 6px;
                if root.hit.hash: Badge { text: "✓ Exact match"; tone: BadgeTone.accent; }
                if root.hit.pick: Badge { text: "Your pick"; tone: BadgeTone.accent; }
                if root.hit.hi: Badge { text: "HI"; }
                if root.hit.fps != "": Badge { text: root.hit.fps + " fps"; }
                if root.hit.trusted: Badge { text: "Trusted"; }
                if root.hit.ai: Badge { text: "Machine"; tone: BadgeTone.warn; }
                Text { horizontal-stretch: 1; text: root.hit.title; color: Theme.fg-a3; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; }
            }
        }
        VerticalLayout { alignment: center; spacing: 3px;
            Text { text: "↓ " + root.hit.downloads; font-family: "DM Mono"; font-size: Metrics.font-sm; color: Theme.fg-a2; horizontal-alignment: right; }
            Text { text: root.hit.rating != "" ? "★ " + root.hit.rating : ""; font-family: "DM Mono"; font-size: Metrics.font-sm; color: Theme.accent; horizontal-alignment: right; }
        }
        VerticalLayout { alignment: center;
            Rectangle {
                width: 64px; height: 28px; border-radius: Metrics.radius-md;
                opacity: root.selected || ta.has-hover || la.has-hover ? (root.busy ? 0.5 : 1) : 0;
                background: la.has-hover ? Theme.accent-bright : Theme.accent;
                Text { text: "Load"; color: Theme.bg-b2; font-size: Metrics.font-sm; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                la := TouchArea { enabled: !root.busy; accessible-role: button; accessible-label: "Load " + root.hit.name; mouse-cursor: pointer; clicked => { root.load(); } }
            }
        }
    }
}

component LangChip inherits Rectangle {
    in property <Item> item;
    callback clicked();
    height: 26px; width: lt.preferred-width + 18px; border-radius: self.height / 2;
    background: root.item.selected ? Theme.accent.with-alpha(0.22) : ca.has-hover ? Theme.bg-a1 : Theme.bg-a3;
    border-width: 1px; border-color: root.item.selected ? Theme.accent.with-alpha(0.7) : transparent;
    lt := Text { text: root.item.key == root.item.label ? root.item.label : root.item.key.to-uppercase(); font-size: Metrics.font-xs; font-weight: 600;
        color: root.item.selected ? Theme.accent-bright : Theme.fg-a2; horizontal-alignment: center; vertical-alignment: center; }
    ca := TouchArea { accessible-role: button; accessible-label: root.item.label; accessible-checked: root.item.selected; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Add Subtitles (Figma "Add Subtitles to Playlist/Folder"): target (this file / this
// folder) and source (OpenSubtitles / Computer) dropdowns. OpenSubtitles: query (name,
// episode or IMDb id), language chips (remembered), results with badges, details +
// preview, Load. Computer: the folder breadcrumb and its subtitle files (multi-select)
// or the folder's videos paired with their subtitles. Cancel / Save.
export component SubtitleDialog inherits Modal {
    in property <[SubHit]> hits;
    in property <[Item]> langs;      // key = code, label = name, selected
    in property <int> selected: -1;
    in property <string> details;
    in property <string> preview;
    in property <bool> save-next;
    in property <[Item]> local;      // From Computer rows (see subtitles.rs)
    in property <string> folder;     // breadcrumb of the scanned folder
    in property <string> status;
    in property <bool> busy;
    in-out property <string> query;
    in-out property <string> lang;
    in-out property <int> target;    // 0 this file, 1 this folder
    in-out property <int> source;    // 0 OpenSubtitles, 1 Computer
    callback cmd(string, string);    // → plugin-command("subtitle-search", …)
    callback close();
    property <bool> ok: root.selected >= 0 && root.selected < root.hits.length && !root.busy;
    property <bool> can-save: root.source == 0 ? root.ok : root.local.length > 0;
    card-width: 1080px;
    card-height: 760px;
    dismissed => { root.close(); }
    VerticalLayout {
        Rectangle {
            background: Theme.bg-b1;
            VerticalLayout {
                HorizontalLayout {
                    height: 44px; padding-left: 16px; padding-right: 8px; spacing: 8px;
                    Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: @image-url("../assets/icons/subtitles.svg"); tint: Theme.accent; }
                    Text { horizontal-stretch: 1; text: "Add Subtitles"; color: Theme.fg-1; font-size: Metrics.font-base; font-weight: 600; vertical-alignment: center; }
                    if root.source == 0: Text { text: "OpenSubtitles.com"; color: Theme.fg-a3; font-size: Metrics.font-sm; vertical-alignment: center; }
                    VerticalLayout { alignment: center;
                        Rectangle { width: 30px; height: 30px; border-radius: Metrics.radius-sm; background: cx.has-hover ? Theme.bg-a1 : transparent;
                            Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/close.svg"); }
                            cx := TouchArea { accessible-role: button; accessible-label: "Close"; mouse-cursor: pointer; clicked => { root.close(); } } } }
                }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; padding-bottom: root.source == 0 ? 6px : 10px; spacing: 8px;
                    Dropdown {
                        width: 170px; options: ["To This File", "To This Folder"]; value: self.options[root.target];
                        selected(i, o) => { root.target = i; root.cmd("mode", ""); }
                    }
                    Dropdown {
                        width: 190px; options: ["From Computer", "From OpenSubtitles"]; value: root.source == 1 ? "From Computer" : "From OpenSubtitles";
                        selected(i, o) => { root.source = i == 0 ? 1 : 0; root.cmd("mode", ""); }
                    }
                    if root.source == 1: Rectangle {
                        horizontal-stretch: 1; height: 36px; border-radius: Metrics.radius-md; background: bx.has-hover ? Theme.bg-a1 : Theme.bg-a3;
                        HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 10px;
                            Icon { y: (parent.height - 20px) / 2; width: 20px; height: 20px; source: @image-url("../assets/icons/folder.svg"); tint: Theme.fg-a2; }
                            Text { horizontal-stretch: 1; text: root.folder; color: Theme.fg-a2; font-size: Metrics.font-base; vertical-alignment: center; overflow: elide; }
                        }
                        bx := TouchArea { accessible-role: button; accessible-label: "Choose folder: " + root.folder; mouse-cursor: pointer; clicked => { root.cmd("browse", ""); } }
                    }
                    if root.source == 0: Rectangle {
                        horizontal-stretch: 1; height: 36px; border-radius: Metrics.radius-md; background: Theme.bg-a3;
                        Icon { x: 8px; width: 18px; height: 18px; source: @image-url("../assets/icons/search.svg"); tint: Theme.fg-a3; }
                        TextField {
                            x: 28px; width: parent.width - 30px; height: parent.height; background: transparent;
                            text <=> root.query; placeholder: "Title, episode, or IMDb id (tt0133093)";
                            accepted => { root.cmd("search", ""); }
                        }
                    }
                    if root.source == 0: PrimaryButton {
                        min-w: 104px; enabled: !root.busy; text: root.busy ? "Searching" : "Search"; icon: @image-url("../assets/icons/search.svg");
                        clicked => { root.cmd("search", ""); }
                    }
                }
                if root.source == 0: HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; padding-bottom: 10px; spacing: 6px;
                    Text { text: "Languages"; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; }
                    for l in root.langs: LangChip { item: l; clicked => { root.cmd("lang", l.key); } }
                    Rectangle { horizontal-stretch: 1; }
                    TextField { width: 110px; height: 26px; text <=> root.lang; placeholder: "Other codes…"; accepted(t) => { root.cmd("lang-text", t); } }
                }
            }
        }
        if root.source == 0: HorizontalLayout {
            vertical-stretch: 1; padding: 12px; spacing: 12px;
            Rectangle {
                horizontal-stretch: 1;
                ScrollView {
                    VerticalLayout { spacing: 2px; alignment: start;
                        for h[i] in root.hits: SubHitRow {
                            hit: h; selected: i == root.selected; busy: root.busy;
                            clicked => { root.cmd("select", i); }
                            load => { root.cmd("download", i); }
                        }
                    }
                }
                if root.hits.length == 0: Text {
                    width: parent.width - 32px; x: 16px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                    text: root.status; color: Theme.fg-a2; font-size: Metrics.font-md;
                }
            }
            Rectangle {
                width: max(280px, root.card-w * 0.34); border-radius: Metrics.radius-lg; background: Theme.bg-b1; border-width: 1px; border-color: Theme.bg-a1;
                VerticalLayout { padding: 14px; spacing: 10px;
                    Text { text: root.details == "" ? "Select a result to see its details. Exact matches were made for this very file and need no syncing." : root.details;
                        wrap: word-wrap; color: root.details == "" ? Theme.fg-a3 : Theme.fg-2; font-size: Metrics.font-sm; }
                    if root.ok && root.preview == "": HorizontalLayout { alignment: start;
                        Rectangle { width: pt.preferred-width + 24px; height: 28px; border-radius: Metrics.radius-md; background: pa.has-hover ? Theme.field-raised : Theme.bg-a3;
                            pt := Text { text: "Preview text (uses one download)"; font-size: Metrics.font-sm; color: Theme.fg-1; horizontal-alignment: center; vertical-alignment: center; }
                            pa := TouchArea { accessible-role: button; accessible-label: pt.text; mouse-cursor: pointer; clicked => { root.cmd("preview", root.selected); } } } }
                    Rectangle { height: 1px; background: Theme.divider; visible: root.preview != ""; }
                    ScrollView { vertical-stretch: 1;
                        VerticalLayout { alignment: start;
                            Text { text: root.preview; wrap: word-wrap; font-family: "DM Mono"; color: Theme.fg-a1; font-size: Metrics.font-sm; }
                        }
                    }
                }
            }
        }
        if root.source == 1: Rectangle {
            vertical-stretch: 1;
            ScrollView {
                VerticalLayout {
                    padding: 16px; spacing: 2px; alignment: start;
                    for r[i] in root.local: LocalSubRow {
                        item: r; pair: root.target == 1;
                        clicked => { root.cmd("toggle", i); }
                    }
                }
            }
            if root.status != "": Text {
                x: 24px; width: parent.width - 48px; y: root.local.length == 0 ? (parent.height - self.height) / 2 : parent.height - self.height - 4px;
                text: root.status; wrap: word-wrap; horizontal-alignment: center;
                color: Theme.fg-a2; font-size: Metrics.font-md;
            }
        }
        HorizontalLayout {
            padding: 12px; padding-left: 16px; spacing: 10px;
            Text { horizontal-stretch: 1; text: root.source == 0 && root.hits.length > 0 ? root.status : ""; color: Theme.fg-a2; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; }
            if root.source == 0: HorizontalLayout { spacing: 8px;
                Rectangle { y: (parent.height - 18px) / 2; width: 18px; height: 18px; border-radius: Metrics.radius-sm;
                    background: root.save-next ? Theme.accent : Theme.field; border-width: 1px; border-color: root.save-next ? Theme.accent : Theme.divider;
                    if root.save-next: Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/check-selected.svg"); tint: Theme.bg-b2; } }
                Text { text: "Save next to the video"; color: Theme.fg-2; font-size: Metrics.font-sm; vertical-alignment: center; }
                TouchArea { accessible-role: checkbox; accessible-label: "Save next to the video"; accessible-checked: root.save-next; mouse-cursor: pointer; clicked => { root.cmd("save-next", ""); } }
            }
            FlatButton { text: "Cancel"; clicked => { root.close(); } }
            Rectangle {
                width: 110px; height: 32px; border-radius: Metrics.radius-md;
                background: root.source == 0 ? Theme.accent : (Theme.dark ? Theme.track-fill : Theme.accent-bg);
                opacity: root.can-save ? 1 : 0.5;
                Text { text: root.source == 0 ? "Load" : "Save"; color: root.source == 0 ? Theme.bg-b2 : Theme.accent; font-weight: 600; font-size: Metrics.font-md; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { enabled: root.can-save; accessible-role: button; accessible-label: root.source == 0 ? "Load" : "Save"; mouse-cursor: pointer;
                    clicked => { if (root.source == 0) { root.cmd("download", root.selected); } else { root.cmd("save-local", ""); } } }
            }
        }
    }
}

// Free Music result row (src/plugins/free_music.rs): cover, title, artist · album,
// source badge, licence chip (green when commercial use is allowed), duration.
export struct FmRow { title: string, sub: string, badge: string, lic: string, free: bool, dur: string, cover: image, has-cover: bool, dl: bool, selected: bool }
// A dropdown filter of the shared music dialog (Free Music: mood, licence, length, sort).
export struct MdFilter { name: string, options: [string], value: string }

component TrackRow inherits Rectangle {
    in property <FmRow> fm;
    callback clicked();
    callback activated();
    callback play();
    callback queue();
    callback download();
    height: 52px; border-radius: Metrics.radius-md;
    background: fm.selected ? Theme.bg-a1 : ta.has-hover ? Theme.bg-a1.mix(Theme.bg-a3, 50%) : transparent;
    HorizontalLayout {
        padding-left: 6px; padding-right: 10px; spacing: 10px;
        Rectangle {
            y: 6px; width: 40px; height: 40px; border-radius: Metrics.radius-sm; clip: true;
            background: Theme.accent.with-alpha(0.15);
            if root.fm.has-cover: Image { width: parent.width; height: parent.height; source: root.fm.cover; image-fit: cover; }
            if !root.fm.has-cover: Icon { x: 10px; y: 10px; width: 20px; height: 20px; source: @image-url("../assets/icons/music.svg"); tint: Theme.accent; }
        }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 2px;
            Text { text: root.fm.title; color: fm.selected ? Theme.accent-bright : Theme.fg-1; font-size: Metrics.font-md; font-weight: 600; overflow: elide; }
            Text { text: root.fm.sub; color: Theme.fg-a2; font-size: Metrics.font-sm; overflow: elide; }
        }
        VerticalLayout { alignment: center;
            Rectangle {
                width: bt.preferred-width + 12px; height: 18px; border-radius: self.height / 2;
                background: root.fm.badge == "Jamendo" ? Theme.info-bg.with-alpha(0.25) : root.fm.badge == "FMA" ? Theme.tag-pink.with-alpha(0.25) : Theme.neutral-bg.with-alpha(0.19);
                bt := Text { text: root.fm.badge; color: Theme.fg-2; font-size: Metrics.font-micro; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        VerticalLayout { alignment: center;
            Rectangle {
                width: max(64px, lt.preferred-width + 12px); height: 18px; border-radius: self.height / 2;
                border-width: 1px; border-color: root.fm.free ? Theme.ok : Theme.divider;
                background: root.fm.free ? Theme.ok-bg.with-alpha(0.18) : transparent;
                lt := Text { text: root.fm.lic; color: root.fm.free ? Theme.ok : Theme.fg-a2; font-size: Metrics.font-micro; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text { width: 40px; text: root.fm.dur; color: Theme.fg-a3; font-size: Metrics.font-sm; horizontal-alignment: right; vertical-alignment: center; }
        for b[k] in [
            { icon: @image-url("../assets/icons/play.svg"), tip: "Play", on: true },
            { icon: @image-url("../assets/icons/queue.svg"), tip: "Add to queue", on: true },
            { icon: @image-url("../assets/icons/arrow-down.svg"), tip: "Download", on: root.fm.dl },
        ]: Rectangle {
            y: 12px; width: 28px; height: 28px; border-radius: self.height / 2;
            opacity: (ta.has-hover || root.fm.selected) ? (b.on ? 1 : 0.3) : (k == 2 && b.on ? 0.45 : 0);
            background: bta.has-hover && b.on ? Theme.accent.with-alpha(0.25) : transparent;
            Icon { x: 6px; y: 6px; width: 16px; height: 16px; source: b.icon; tint: bta.has-hover ? Theme.accent-bright : Theme.fg-a2; }
            bta := TouchArea { enabled: b.on; accessible-role: button; accessible-label: b.tip + ": " + root.fm.title; mouse-cursor: pointer;
                clicked => { if k == 0 { root.play(); } else if k == 1 { root.queue(); } else { root.download(); } } }
        }
    }
    ta := TouchArea { accessible-role: list-item; accessible-label: root.fm.title + ", " + root.fm.sub; accessible-item-selected: root.fm.selected; accessible-action-default => { root.activated(); } z: -1; mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.activated(); } }
}

// Shared dialog of the music plugins (Auto-tagger, Free Music): optional source
// dropdown, query + search button, result list, a detail pane (tag diff or licence),
// status line and two actions. The owner plugin id routes the callbacks.
export component MusicDialog inherits Modal {
    in property <string> title;
    in property <[Item]> results;
    in property <[image]> logos;
    in property <string> status;
    in property <bool> busy;
    in property <string> detail;
    in property <string> placeholder;
    in property <string> search-label: "Search";
    in property <string> primary-text;
    in property <string> secondary-text;
    in property <[string]> sources;
    in-out property <string> source;
    in-out property <string> query;
    in property <[string]> chips;   // optional filter chips (Network Streams groups / categories)
    in property <string> chip;
    in property <[string]> actions; // optional extra footer buttons
    in property <[FmRow]> tracks;     // Free Music rows (replace `results` rendering when set)
    in property <bool> rich;          // render `tracks` (Free Music)
    in property <[MdFilter]> filters; // optional dropdown filters under the chips
    in property <string> copy-text;   // text the "Copy credit" action puts on the clipboard
    in property <bool> has-more;      // scrolling to the end asks for more
    in property <bool> can-grid;      // list / grid toggle in the header (Network Streams)
    in property <bool> grid;          // results as logo tiles
    callback view(bool);              // the toggle: true = grid
    callback chip-clicked(string);
    callback filter(string, string);
    callback more();
    callback edited();
    callback action(string, int);
    callback search();
    callback select(int);
    callback primary(int);
    callback secondary(int);
    callback close();
    property <int> selected: -1;
    // The station browser grows with the window (the modal still keeps it inside).
    card-width: root.rich ? 1060px : root.can-grid ? max(900px, min(1400px, root.width * 0.86)) : 900px;
    card-height: root.rich ? 720px : root.can-grid ? max(640px, min(960px, root.height * 0.88)) : 640px;
    dismissed => { root.close(); }
    VerticalLayout {
        Rectangle {
            height: 44px; background: Theme.bg-a3;
            HorizontalLayout {
                padding-left: 16px; padding-right: 8px;
                Text { horizontal-stretch: 1; text: root.title; color: Theme.fg-1; font-size: Metrics.font-base; vertical-alignment: center; }
                if root.can-grid: HorizontalLayout { alignment: center; spacing: 2px; padding-right: 8px;
                    VerticalLayout { alignment: center;
                        ViewButton { label: "List view"; active: !root.grid; clicked => { root.view(false); }
                            base: @image-url("../assets/icons/layers/list-twotone-b.svg"); accent: @image-url("../assets/icons/layers/list-twotone-a.svg"); dim: @image-url("../assets/icons/layers/list-twotone-d.svg"); } }
                    VerticalLayout { alignment: center;
                        ViewButton { label: "Grid view"; active: root.grid; clicked => { root.view(true); }
                            base: @image-url("../assets/icons/layers/grid-twotone-b.svg"); accent: @image-url("../assets/icons/layers/grid-twotone-a.svg"); dim: @image-url("../assets/icons/layers/grid-twotone-d.svg"); } }
                }
                VerticalLayout { alignment: center;
                    Rectangle { width: 30px; height: 30px; border-radius: Metrics.radius-sm; background: mx.has-hover ? Theme.bg-a1 : transparent;
                        Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/close.svg"); }
                        mx := TouchArea { accessible-role: button; accessible-label: "Close"; mouse-cursor: pointer; clicked => { root.close(); } } } }
            }
        }
        HorizontalLayout {
            padding: 12px; spacing: 8px;
            if root.sources.length > 0: Dropdown {
                width: 180px; options: root.sources; value: root.source;
                selected(i, o) => { root.source = o; }
            }
            Rectangle {
                horizontal-stretch: 1; height: 36px; border-radius: Metrics.radius-md; background: Theme.field;
                Icon { x: 8px; width: 18px; height: 18px; source: @image-url("../assets/icons/search.svg"); tint: Theme.fg-a3; }
                TextField {
                    x: 28px; width: parent.width - 30px; height: parent.height; background: transparent;
                    text <=> root.query; placeholder: root.placeholder;
                    accepted => { root.selected = -1; root.search(); }
                    edited => { root.edited(); }
                }
            }
            FlatButton { height: 36px; text: root.busy ? "…" : root.search-label; enabled: !root.busy; clicked => { root.selected = -1; root.search(); } }
        }
        if root.chips.length > 0: Rectangle {
            height: 34px; clip: true;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; padding-bottom: 6px; spacing: 6px; alignment: start;
                for c in root.chips: Rectangle {
                    width: ct.preferred-width + 20px; height: 26px; border-radius: self.height / 2;
                    background: c == root.chip ? Theme.accent.with-alpha(0.30) : (cta.has-hover ? Theme.bg-a1 : Theme.bg-a3);
                    border-width: 1px; border-color: c == root.chip ? Theme.accent : transparent;
                    ct := Text { text: c; color: c == root.chip ? Theme.fg-1 : Theme.fg-a2; font-size: Metrics.font-sm; horizontal-alignment: center; vertical-alignment: center; }
                    cta := TouchArea { accessible-role: button; accessible-label: c; accessible-checked: c == root.chip; mouse-cursor: pointer; clicked => { root.selected = -1; root.chip-clicked(c); } }
                }
            }
        }
        if root.filters.length > 0: HorizontalLayout {
            padding-left: 12px; padding-right: 12px; padding-bottom: 8px; spacing: 8px;
            for f in root.filters: Dropdown {
                horizontal-stretch: 1; height: 32px; options: f.options; value: f.value;
                selected(i, o) => { root.selected = -1; root.filter(f.name, o); }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1; padding-left: 12px; padding-right: 12px; spacing: 12px;
            Rectangle {
                horizontal-stretch: root.rich ? 5 : 3;
                if root.rich: sv := ScrollView {
                    changed content-y => {
                        if root.has-more && self.content-height > self.visible-height
                            && -self.content-y > self.content-height - self.visible-height - 160px { root.more(); }
                    }
                    VerticalLayout {
                        spacing: 2px; alignment: start;
                        for r[i] in root.tracks: TrackRow {
                            fm: { title: r.title, sub: r.sub, badge: r.badge, lic: r.lic, free: r.free, dur: r.dur, cover: r.cover, has-cover: r.has-cover, dl: r.dl, selected: r.selected || i == root.selected };
                            clicked => { root.selected = i; root.select(i); }
                            activated => { root.selected = i; root.select(i); root.primary(i); }
                            play => { root.selected = i; root.select(i); root.primary(i); }
                            queue => { root.action("Queue", i); }
                            download => { root.selected = i; root.select(i); root.secondary(i); }
                        }
                        if root.has-more: Rectangle { height: 40px;
                            Text { text: "Load more"; color: Theme.accent; font-size: Metrics.font-sm; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { accessible-role: button; accessible-label: "Load more"; mouse-cursor: pointer; clicked => { root.more(); } }
                        }
                    }
                }
                // Rows or tiles. Arrow keys move the selection (in the grid Up / Down move a
                // row), Home / End jump, Enter plays; the selection is kept in view.
                if !root.rich: ks := FocusScope {
                    accessible-role: list;
                    accessible-label: root.grid ? "Results, grid" : "Results";
                    property <length> gap: 10px;
                    property <length> inner: rsv.width - 14px;  // room for the scroll bar
                    property <int> cols: max(1, floor((self.inner + self.gap) / (150px + self.gap)));
                    property <length> tile-w: (self.inner - (self.cols - 1) * self.gap) / self.cols;
                    property <length> logo-h: self.tile-w * 0.62;
                    property <length> tile-h: self.logo-h + 54px;
                    property <length> row-h: root.grid ? self.tile-h : 36px;
                    property <length> stride: root.grid ? self.tile-h + self.gap : 38px;
                    property <bool> g: root.grid;
                    changed g => { self.reveal(root.selected); }
                    function reveal(i: int) {
                        if i < 0 { return; }
                        if (root.grid ? floor(i / self.cols) : i) * self.stride < -rsv.content-y {
                            rsv.content-y = -(root.grid ? floor(i / self.cols) : i) * self.stride;
                        } else if (root.grid ? floor(i / self.cols) : i) * self.stride + self.row-h > -rsv.content-y + rsv.visible-height {
                            rsv.content-y = -((root.grid ? floor(i / self.cols) : i) * self.stride + self.row-h - rsv.visible-height);
                        }
                    }
                    function go(i: int) {
                        root.selected = max(0, min(root.results.length - 1, i));
                        root.select(root.selected);
                        self.reveal(root.selected);
                    }
                    key-pressed(e) => {
                        if root.results.length == 0 { return reject; }
                        if e.text == Key.DownArrow { self.go(root.selected < 0 ? 0 : root.selected + (root.grid ? self.cols : 1)); return accept; }
                        if e.text == Key.UpArrow { self.go(root.selected < 0 ? 0 : root.selected - (root.grid ? self.cols : 1)); return accept; }
                        if root.grid && e.text == Key.RightArrow { self.go(root.selected + 1); return accept; }
                        if root.grid && e.text == Key.LeftArrow { self.go(root.selected < 0 ? 0 : root.selected - 1); return accept; }
                        if e.text == Key.Home { self.go(0); return accept; }
                        if e.text == Key.End { self.go(root.results.length - 1); return accept; }
                        if e.text == Key.Return && root.selected >= 0 { root.primary(root.selected); return accept; }
                        reject
                    }
                    property <length> content-h: root.grid
                        ? max(0, ceil(root.results.length / self.cols) * self.stride - self.gap)
                        : max(0, root.results.length * self.stride - 2px);
                    rsv := ScrollView {
                        // Set here: the rows / tiles are conditional, so it cannot be inferred.
                        content-height: ks.content-h;
                        if !root.grid: VerticalLayout {
                            spacing: 2px; alignment: start;
                            for r[i] in root.results: SubRow {
                                item: { key: r.key, label: r.label, selected: i == root.selected };
                                icon: @image-url("../assets/icons/music.svg");
                                logo: i < root.logos.length ? root.logos[i] : @image-url("");
                                clicked => { ks.focus(); root.selected = i; root.select(i); }
                                activated => { root.selected = i; root.select(i); root.primary(i); }
                            }
                        }
                        if root.grid: Rectangle {
                            x: 0; y: 0; width: ks.inner;
                            height: ks.content-h;
                            for r[i] in root.results: StationTile {
                                x: mod(i, ks.cols) * (ks.tile-w + ks.gap); y: floor(i / ks.cols) * ks.stride;
                                width: ks.tile-w; height: ks.tile-h; logo-h: ks.logo-h;
                                item: { key: r.key, label: r.label, selected: i == root.selected };
                                logo: i < root.logos.length ? root.logos[i] : @image-url("");
                                clicked => { ks.focus(); root.selected = i; root.select(i); }
                                activated => { root.selected = i; root.select(i); root.primary(i); }
                            }
                        }
                    }
                    if ks.has-focus: Rectangle { border-width: Metrics.focus-ring-w; border-color: Theme.focus-ring; border-radius: Metrics.radius-md; }
                }
            }
            Rectangle {
                horizontal-stretch: root.rich ? 2 : 2; max-width: root.rich ? 300px : root.can-grid ? 340px : 2000px; border-radius: Metrics.radius-lg; background: Theme.bg-a3;
                ScrollView {
                    VerticalLayout { padding: 12px; alignment: start;
                        Text { text: root.detail == "" ? "Select a result to see the details." : root.detail; wrap: word-wrap; color: root.detail == "" ? Theme.fg-a3 : Theme.fg-1; font-size: Metrics.font-sm; }
                    }
                }
            }
        }
        copier := TextInput { height: 0px; visible: false; text: root.copy-text; read-only: true; }
        if root.rich: Text { x: 12px; width: parent.width - 24px; height: 18px; text: root.status; color: Theme.fg-a2; font-size: Metrics.font-sm; overflow: elide; }
        HorizontalLayout {
            padding: 12px; padding-top: root.rich ? 6px : 12px; spacing: 8px;
            if !root.rich: Text { horizontal-stretch: 1; text: root.status; color: Theme.fg-a2; font-size: Metrics.font-sm; wrap: word-wrap; vertical-alignment: center; }
            if root.rich: Rectangle { horizontal-stretch: 1; }
            FlatButton { text: "Close"; clicked => { root.close(); } }
            for act in root.actions: FlatButton { text: act; enabled: !root.busy || root.rich; clicked => {
                if act == "Copy credit" { copier.select-all(); copier.copy(); copier.clear-selection(); }
                root.action(act, root.selected); } }
            FlatButton { text: root.secondary-text; enabled: (!root.busy || root.rich) && root.secondary-text != "Preview only" && (root.secondary-text == "Choose file…" || ((root.selected >= 0 || root.secondary-text == "Write all" || (root.rich && root.detail != "")) && root.results.length > 0)); clicked => { root.secondary(root.selected); } }
            Rectangle {
                width: max(96px, pt.preferred-width + 24px); height: 32px; border-radius: Metrics.radius-md;
                opacity: (root.selected >= 0 || (root.rich && root.detail != "")) && (!root.busy || root.rich) ? 1 : 0.5;
                background: Theme.accent;
                pt := Text { text: root.primary-text; color: Theme.bg-b2; font-weight: 600; font-size: Metrics.font-md; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { enabled: (root.selected >= 0 || (root.rich && root.detail != "")) && (!root.busy || root.rich); accessible-role: button; accessible-label: root.primary-text; mouse-cursor: pointer; clicked => { root.primary(root.selected); } }
            }
        }
    }
}

// "Now playing" card for audio-only network streams (Network Streams plugin): station
// logo or a radio icon, station name, current ICY title and codec / bitrate.
export component NowPlayingCard inherits Rectangle {
    in property <string> station;
    in property <string> track;
    in property <string> info;
    in property <image> logo;
    in property <bool> has-logo;
    height: 120px;
    border-radius: Metrics.radius-xxl;
    background: Theme.bg-a4.with-alpha(0.88);
    border-width: 1px; border-color: Theme.accent.with-alpha(0.45);
    drop-shadow-blur: 24px; drop-shadow-color: Theme.shadow-soft;
    HorizontalLayout {
        padding: 16px; spacing: 16px;
        Rectangle {
            width: 88px; height: 88px; border-radius: Metrics.radius-xl; clip: true;
            background: Theme.accent.with-alpha(0.18);
            if root.has-logo: Image { width: parent.width; height: parent.height; source: root.logo; image-fit: contain; }
            if !root.has-logo: Icon { x: 22px; y: 22px; width: 44px; height: 44px; source: @image-url("../assets/icons/streaming.svg"); tint: Theme.accent; }
        }
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: "NOW PLAYING"; color: Theme.accent; font-size: Metrics.font-xs; font-weight: 700; letter-spacing: 1px; }
            Text { text: root.station; color: Theme.fg-1; font-size: Metrics.font-h3; font-weight: 600; overflow: elide; }
            if root.track != "": Text { text: root.track; color: Theme.fg-a2; font-size: Metrics.font-base; overflow: elide; }
            if root.info != "": Text { text: root.info; color: Theme.fg-a3; font-size: Metrics.font-sm; overflow: elide; }
        }
    }
}

// ---------- Auto-tagger review (src/plugins/tagger.rs) ----------
export struct TagField { name: string, old: string, new: string, changed: bool, checked: bool, source: string, alts: int }  // source: where `new` comes from; alts: other sources' values (⇄ cycles)
export struct TagResult { name: string, status: TagStatus, detail: string, changes: [string], can-undo: bool }  // status: tagged | renamed | skipped | failed | undone
export struct TagCover { img: image, label: string, info: string }
export struct TagFile {
    name: string, source: string, confidence: int, note: string, checked: bool, fields: [TagField],
    has-old-cover: bool, old-cover: image, old-cover-info: string,
    covers: [TagCover], cover-pick: int,   // -1 keeps the existing cover
}

component Check inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    width: 18px; height: 18px; border-radius: Metrics.radius-sm;
    border-width: 1px; border-color: root.checked ? Theme.accent : Theme.divider;
    background: root.checked ? Theme.accent : transparent;
    opacity: root.enabled ? 1 : 0.35;
    if root.checked: Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/check-active.svg"); tint: Theme.bg-b2; }
    TouchArea { enabled: root.enabled; accessible-role: checkbox; accessible-label: root.label; accessible-checked: root.checked; mouse-cursor: pointer; clicked => { root.toggled(); } }
}

component Thumb inherits Rectangle {
    in property <image> img;
    in property <bool> empty;
    in property <bool> picked;
    callback clicked();
    callback zoom();
    width: 72px; height: 72px; border-radius: Metrics.radius-md; clip: true;
    background: Theme.bg-b1;
    border-width: root.picked ? 2px : 1px; border-color: root.picked ? Theme.accent : Theme.divider;
    if !root.empty: Image { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; source: root.img; image-fit: cover; }
    if root.empty: Text { text: "No cover"; color: Theme.fg-a3; font-size: Metrics.font-xs; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { accessible-role: button; accessible-label: root.empty ? "No cover" : "Cover image"; accessible-checked: root.picked; mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.zoom(); } }
    if !root.empty: Rectangle {
        x: parent.width - 22px; y: 2px; width: 20px; height: 20px; border-radius: Metrics.radius-sm; background: Theme.media-chip;
        Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/search.svg"); tint: Theme.on-media; }
        TouchArea { accessible-role: button; accessible-label: "Enlarge cover"; mouse-cursor: pointer; clicked => { root.zoom(); } }
    }
}

// Before/after review: per file a card with one row per tag field (current next to
// proposed; changed rows highlighted, unchanged dimmed), the match source and
// confidence, and cover art (current vs. candidates, click to pick, magnifier to
// enlarge). Checkboxes per file and per field; Apply selected / Apply all / Skip.
// After writing, a summary with Undo (restores tags and covers from a backup).
export component TagReviewDialog inherits Modal {
    in property <[TagFile]> files;
    in property <string> status;
    in property <bool> busy;
    in property <string> summary;        // non-empty: the after-apply summary view
    in property <string> summary-sub;
    in property <bool> summary-ok;
    in property <[TagResult]> results;
    in property <bool> can-undo;
    callback cmd(string, string);
    property <image> zoom-img;
    property <string> zoom-info;
    property <bool> zoomed;
    card-width: 980px;
    card-height: 760px;
    dismiss-on-scrim: false;
    VerticalLayout {
        Rectangle {
            height: 44px; background: Theme.bg-b1;
            HorizontalLayout {
                padding-left: 16px; padding-right: 8px; spacing: 10px;
                Text { horizontal-stretch: 1; text: root.summary != "" ? "Auto-tagger · Done" : "Auto-tagger · Review changes"; color: Theme.fg-1; font-size: Metrics.font-base; vertical-alignment: center; }
                if root.summary == "": Text { text: "Changed"; color: Theme.accent; font-size: Metrics.font-sm; vertical-alignment: center; }
                if root.summary == "": Text { text: "Unchanged"; color: Theme.fg-a3; font-size: Metrics.font-sm; vertical-alignment: center; }
                VerticalLayout { alignment: center;
                    Rectangle { width: 30px; height: 30px; border-radius: Metrics.radius-sm; background: cx.has-hover ? Theme.bg-a1 : transparent;
                        Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/close.svg"); }
                        cx := TouchArea { accessible-role: button; accessible-label: "Close"; mouse-cursor: pointer; clicked => { root.cmd("review-close", ""); } } } }
            }
        }
        if root.summary == "": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px; spacing: 14px; alignment: start;
                for f[fi] in root.files: card := Rectangle {
                    property <length> colw: (root.card-w - 32px - 14px - 24px - 28px - 110px - 16px - 30px - 140px) / 2;
                    border-radius: Metrics.radius-lg; background: Theme.bg-a3; border-width: 1px; border-color: Theme.bg-a1;
                    opacity: f.checked ? 1 : 0.55;
                    VerticalLayout {
                        padding: 12px; spacing: 4px;
                        HorizontalLayout {
                            spacing: 10px; height: 28px;
                            Check { label: "Include file"; y: 5px; checked: f.checked; toggled => { root.cmd("toggle-file", fi); } }
                            VerticalLayout { horizontal-stretch: 1; alignment: center;
                                Text { text: f.name; color: Theme.fg-1; font-size: Metrics.font-base; font-weight: 600; overflow: elide; }
                            }
                            Rectangle {
                                width: src.preferred-width + 16px; height: 22px; y: 3px; border-radius: self.height / 2;
                                background: (f.confidence >= 90 ? Theme.ok-bg : f.confidence >= 70 ? Theme.warn-bg : Theme.err-bg).with-alpha(0.25);
                                src := Text { text: f.source; font-size: Metrics.font-sm; horizontal-alignment: center; vertical-alignment: center;
                                    color: f.confidence >= 90 ? Theme.ok : f.confidence >= 70 ? Theme.warn : Theme.err; }
                            }
                        }
                        if f.note != "": Text { x: 28px; text: f.note; color: Theme.fg-a3; font-size: Metrics.font-xs; overflow: elide; }
                        // Column headers
                        HorizontalLayout {
                            spacing: 10px; height: 22px; padding-left: 28px;
                            Text { width: 110px; text: "Field"; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; }
                            Text { width: card.colw; text: "Current"; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; }
                            Text { width: 16px; text: ""; }
                            Text { width: card.colw; text: "Proposed"; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; }
                            Text { width: 130px; text: "Source"; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; }
                        }
                        for t[ti] in f.fields: Rectangle {
                            height: 28px; border-radius: Metrics.radius-sm;
                            background: t.changed ? Theme.accent.with-alpha(t.checked ? 0.12 : 0.05) : transparent;
                            HorizontalLayout {
                                spacing: 10px;
                                Check { label: "Apply field"; y: 5px; checked: t.checked; enabled: t.changed && f.checked; toggled => { root.cmd("toggle-field", fi + ":" + ti); } }
                                Text { width: 110px; text: t.name; color: t.changed ? Theme.fg-2 : Theme.fg-a3; font-size: Metrics.font-md; vertical-alignment: center; }
                                Text { width: card.colw; text: t.old == "" ? "—" : t.old; color: Theme.fg-a3; font-size: Metrics.font-md; vertical-alignment: center; overflow: elide;
                                    opacity: t.changed ? 1 : 0.7; }
                                Text { width: 16px; text: t.changed ? "→" : "="; color: t.changed ? Theme.accent : Theme.fg-a3; font-size: Metrics.font-md; vertical-alignment: center; horizontal-alignment: center; }
                                Text { width: card.colw; text: t.changed ? t.new : (t.old == "" ? "—" : t.old); font-size: Metrics.font-md; vertical-alignment: center; overflow: elide;
                                    color: t.changed ? (t.checked ? Theme.accent-bright : Theme.fg-a2) : Theme.fg-a3; font-weight: t.changed ? 600 : 400; }
                                HorizontalLayout { width: 130px; spacing: 4px;
                                    Rectangle {
                                        width: min(sl.preferred-width + 12px, t.alts > 0 ? 82px : 130px); height: 18px; y: 5px; border-radius: self.height / 2;
                                        visible: t.changed || t.alts > 0;
                                        background: t.source == "MusicBrainz" ? Theme.hover : Theme.accent.with-alpha(0.14);
                                        sl := Text { text: t.source; color: t.source == "MusicBrainz" ? Theme.fg-a2 : Theme.accent-bright; font-size: Metrics.font-micro; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                    if t.alts > 0: Rectangle {
                                        width: 42px; height: 18px; y: 5px; border-radius: self.height / 2;
                                        border-width: 1px; border-color: alt.has-hover ? Theme.accent : Theme.accent.with-alpha(0.45);
                                        background: alt.has-hover ? Theme.accent.with-alpha(0.32) : Theme.accent.with-alpha(0.08);
                                        Text { text: "⇄ " + t.alts; color: alt.has-hover ? Theme.fg-1 : Theme.accent-bright; font-weight: 600; font-size: Metrics.font-micro; horizontal-alignment: center; vertical-alignment: center; }
                                        alt := TouchArea { enabled: f.checked; accessible-role: button; accessible-label: "Alternatives: " + t.alts; mouse-cursor: pointer; clicked => { root.cmd("field-alt", fi + ":" + ti); } }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                        // Cover art: current vs. candidates
                        HorizontalLayout {
                            spacing: 10px; padding-top: 6px;
                            Check { label: "Replace cover"; y: 27px; checked: f.cover-pick >= 0; enabled: f.checked && f.covers.length > 0;
                                toggled => { root.cmd("cover-pick", fi + ":" + (f.cover-pick >= 0 ? -1 : 0)); } }
                            VerticalLayout { width: 110px; alignment: center;
                                Text { text: "Cover art"; color: f.cover-pick >= 0 ? Theme.fg-2 : Theme.fg-a3; font-size: Metrics.font-md; }
                                Text { text: f.covers.length == 0 ? "No candidates" : f.cover-pick >= 0 ? (f.has-old-cover ? "Replace" : "Embed") : "Keep current"; color: f.cover-pick >= 0 ? Theme.accent : Theme.fg-a3; font-size: Metrics.font-xs; }
                            }
                            VerticalLayout { spacing: 3px;
                                Thumb { img: f.old-cover; empty: !f.has-old-cover; picked: f.cover-pick < 0;
                                    clicked => { root.cmd("cover-pick", fi + ":-1"); }
                                    zoom => { root.zoom-img = f.old-cover; root.zoom-info = "Current · " + f.old-cover-info; root.zoomed = true; } }
                                Text { width: 72px; text: f.has-old-cover ? "Current\n" + f.old-cover-info : "Current"; color: f.cover-pick < 0 ? Theme.fg-2 : Theme.fg-a3; font-size: Metrics.font-micro; horizontal-alignment: center; wrap: word-wrap; }
                            }
                            Text { text: "→"; color: Theme.accent; font-size: Metrics.font-lg; vertical-alignment: center; height: 72px; }
                            for c[ci] in f.covers: VerticalLayout { spacing: 3px;
                                Thumb { img: c.img; picked: f.cover-pick == ci;
                                    clicked => { root.cmd("cover-pick", fi + ":" + ci); }
                                    zoom => { root.zoom-img = c.img; root.zoom-info = c.label + " · " + c.info; root.zoomed = true; } }
                                Text { width: 72px; text: c.label + "\n" + c.info; color: f.cover-pick == ci ? Theme.accent : Theme.fg-a3; font-size: Metrics.font-micro; horizontal-alignment: center; wrap: word-wrap; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }
        if root.summary != "": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 20px; spacing: 12px; alignment: start;
                // Success / problem headline
                HorizontalLayout {
                    spacing: 14px; height: 56px;
                    Rectangle {
                        width: 48px; height: 48px; y: 4px; border-radius: self.height / 2;
                        background: (root.summary-ok ? Theme.ok-bg : Theme.accent).with-alpha(0.22);
                        Text { text: root.summary-ok ? "✓" : "!"; color: root.summary-ok ? Theme.ok : Theme.accent-bright; font-size: Metrics.font-xxl; font-weight: 800;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout { alignment: center; spacing: 2px;
                        Text { text: root.summary; color: Theme.fg-1; font-size: Metrics.font-xl; font-weight: 700; }
                        if root.summary-sub != "": Text { text: root.summary-sub; color: Theme.fg-a2; font-size: Metrics.font-md; }
                    }
                }
                for r[ri] in root.results: Rectangle {
                    border-radius: Metrics.radius-lg; background: Theme.bg-a3; border-width: 1px;
                    border-color: r.status == TagStatus.failed ? Theme.err-bg.with-alpha(0.5) : Theme.bg-a1;
                    opacity: r.status == TagStatus.skipped || r.status == TagStatus.undone ? 0.7 : 1;
                    VerticalLayout {
                        padding: 12px; spacing: 4px;
                        HorizontalLayout {
                            spacing: 10px; height: 26px;
                            Rectangle {
                                width: st.preferred-width + 16px; height: 20px; y: 3px; border-radius: self.height / 2;
                                background: (r.status == TagStatus.failed ? Theme.err-bg : r.status == TagStatus.skipped || r.status == TagStatus.undone ? Theme.neutral-bg : r.status == TagStatus.renamed ? Theme.accent : Theme.ok-bg).with-alpha(0.25);
                                st := Text { text: r.status == TagStatus.tagged ? "Tagged" : r.status == TagStatus.renamed ? "Tagged + renamed" : r.status == TagStatus.skipped ? "Skipped" : r.status == TagStatus.undone ? "Undone" : "Failed";
                                    font-size: Metrics.font-xs; font-weight: 600; horizontal-alignment: center; vertical-alignment: center;
                                    color: r.status == TagStatus.failed ? Theme.err : r.status == TagStatus.skipped || r.status == TagStatus.undone ? Theme.fg-a2 : r.status == TagStatus.renamed ? Theme.accent-bright : Theme.ok; }
                            }
                            VerticalLayout { horizontal-stretch: 1; alignment: center;
                                Text { text: r.name; color: Theme.fg-1; font-size: Metrics.font-base; font-weight: 600; overflow: elide; } }
                            Text { text: r.detail; color: Theme.fg-a3; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; max-width: 320px; }
                            FlatButton { text: "Open folder"; clicked => { root.cmd("open-folder", ri); } }
                            if r.can-undo: FlatButton { text: "Undo"; enabled: !root.busy; clicked => { root.cmd("undo-file", ri); } }
                        }
                        for c in r.changes: HorizontalLayout {
                            padding-left: 4px; spacing: 8px; height: 20px;
                            Rectangle { width: 4px; height: 4px; y: 8px; border-radius: self.height / 2; background: Theme.accent; }
                            Text { text: c; color: Theme.fg-a2; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            padding: 12px; padding-left: 16px; spacing: 8px;
            Text { horizontal-stretch: 1; text: root.status; color: Theme.fg-a2; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; }
            if root.summary == "": FlatButton { text: "Skip"; enabled: !root.busy; clicked => { root.cmd("review-close", ""); } }
            if root.summary == "": FlatButton { text: "Apply all"; enabled: !root.busy; clicked => { root.cmd("apply-all", ""); } }
            if root.summary == "": Rectangle {
                width: 128px; height: 32px; border-radius: Metrics.radius-md; background: Theme.accent; opacity: root.busy ? 0.5 : 1;
                Text { text: "Apply selected"; color: Theme.bg-b2; font-weight: 600; font-size: Metrics.font-md; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { enabled: !root.busy; accessible-role: button; accessible-label: "Apply selected"; mouse-cursor: pointer; clicked => { root.cmd("apply-selected", ""); } }
            }
            if root.summary != "": FlatButton { text: "Undo all"; enabled: root.can-undo && !root.busy; clicked => { root.cmd("undo", ""); } }
            if root.summary != "": Rectangle {
                width: 80px; height: 32px; border-radius: Metrics.radius-md; background: Theme.accent;
                Text { text: "Done"; color: Theme.bg-b2; font-weight: 600; font-size: Metrics.font-md; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { accessible-role: button; accessible-label: "Done"; mouse-cursor: pointer; clicked => { root.cmd("review-close", ""); } }
            }
        }
    }
    // Enlarged cover
    if root.zoomed: Rectangle {
        background: Theme.scrim-strong;
        TouchArea { accessible-role: button; accessible-label: "Close enlarged cover"; mouse-cursor: pointer; clicked => { root.zoomed = false; } }
        VerticalLayout {
            alignment: center; spacing: 10px;
            HorizontalLayout { alignment: center;
                Image { width: min(500px, root.height - 140px); height: self.width; source: root.zoom-img; image-fit: contain; } }
            Text { text: root.zoom-info + "  ·  click to close"; color: Theme.on-media; font-size: Metrics.font-md; horizontal-alignment: center; }
        }
    }
}

// ---------- Lyrics: full-screen karaoke view and manual search (src/plugins/lyrics.rs) ----------
// A word of the current line (enhanced LRC): `progress` 0..1 drives the accent wipe.
export struct KWord { text: string, gap: bool, row: int, progress: float }
export struct LyricsHit { title: string, artist: string, album: string, duration: string, synced: bool, close: bool }

// Rounded pill button of the karaoke header.
component KPill inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px; width: (root.has-icon ? 23px : 0px) + kt.preferred-width + 30px; border-radius: self.height / 2;
    background: root.primary ? (ta.has-hover ? Theme.accent-bright : Theme.accent) : (ta.has-hover ? Theme.stage-chip-hover : Theme.stage-chip);
    border-width: 1px; border-color: root.primary ? transparent : Theme.stage-chip-line;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 120ms; }
    if root.has-icon: Icon { x: 15px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: root.icon; tint: root.primary ? Theme.bg-b2 : Theme.stage-fg.with-alpha(0.8); }
    kt := Text { x: root.has-icon ? 38px : 15px; width: self.preferred-width; height: parent.height; text: root.text; color: root.primary ? Theme.bg-b2 : Theme.stage-fg.with-alpha(0.88); font-size: Metrics.font-md; font-weight: 600; vertical-alignment: center; }
    ta := TouchArea { enabled: root.enabled; accessible-role: button; accessible-label: root.text; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Full-screen karaoke: the current line large and centred in the accent colour (with a
// word-by-word wipe for enhanced LRC), past lines dimmed above, upcoming lines below;
// the list glides as lines change. Header: track, source, timing offset, search, save.
/// What the lyrics plugin currently has for the track (typed, so views never
/// compare display strings).
export enum LyricsState { found, searching, missing }

export component KaraokeView inherits Rectangle {
    in property <LyricsState> state: LyricsState.missing;
    in property <float> offset-s;
    in property <[string]> lines;
    in property <int> index: -1;
    in property <bool> plain;
    in property <[KWord]> words;
    in property <int> rows;
    in property <string> title;
    in property <string> artist;
    in property <string> source;
    in property <string> offset;
    in property <bool> can-save;
    in property <bool> manual;
    in property <length> big: 48px;
    // Player chrome shown (follows the UI auto-hide): header, hint and cursor hide with it.
    in property <bool> chrome: true;
    callback cmd(string, string);
    callback activity(); // pointer moved: reset the auto-hide timer
    property <length> small: root.big * 0.55;
    property <length> pitch: root.small * 1.85;
    property <length> line-h: root.big * 1.28;
    // Height kept for the current line is the same for every line (two rows), so nothing
    // shifts when a line wraps at the smallest size.
    property <length> cur-h: root.line-h * max(2, root.rows) + 12px;
    property <length> side: max(40px, root.width * 0.08);
    // Shrink-to-fit: the current line uses the large size only when it fits on one row,
    // otherwise the largest size that does, down to the size of the other lines.
    property <length> avail: root.width - 2 * root.side;
    property <length> fit: root.index >= 0 && root.index < root.lines.length
        ? max(root.small, min(root.big, root.big * (root.avail / max(1px, measure.preferred-width)) * 0.98))
        : root.big;
    measure := Text {
        visible: false;
        text: root.index >= 0 && root.index < root.lines.length ? root.lines[root.index] : "";
        font-size: root.big; font-weight: 800;
    }
    background: Theme.stage;
    clip: true;
    TouchArea {   // swallow clicks on the backdrop; moves show the chrome again
        mouse-cursor: root.chrome ? MouseCursor.default : MouseCursor.none;
        changed mouse-x => { root.activity(); }
        changed mouse-y => { root.activity(); }
    }
    // Soft accent glow behind the current line.
    Rectangle {
        y: root.height * 0.18; height: root.height * 0.64;
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.13) 0%, Theme.accent.with-alpha(0.04) 45%, transparent 75%);
    }

    area := Rectangle {
        y: 112px; height: root.height - 112px - 120px;
        clip: true;
        property <length> mid: self.height / 2;
        if !root.plain: Rectangle {
            for l[i] in root.lines: Text {
                property <int> d: i - root.index;
                property <bool> cur: i == root.index;
                visible: abs(self.d) <= 8;
                x: root.side; width: area.width - 2 * root.side;
                height: self.cur ? root.cur-h : root.pitch;
                y: self.cur ? area.mid - root.cur-h / 2
                    : self.d < 0 ? area.mid - root.cur-h / 2 + self.d * root.pitch
                    : area.mid + root.cur-h / 2 + (self.d - 1) * root.pitch;
                animate y { duration: 480ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                text: l == "" ? "♪" : l;
                font-size: self.cur ? root.fit : root.small;
                animate font-size { duration: 320ms; easing: ease-out; }
                font-weight: self.cur ? 800 : 600;
                wrap: word-wrap; overflow: elide;
                horizontal-alignment: center; vertical-alignment: center;
                color: self.cur ? Theme.accent : Theme.stage-fg;
                opacity: self.cur ? (root.rows > 0 ? 0 : 1) : max(0.07, (self.d < 0 ? 0.30 : 0.58) - (abs(self.d) - 1) * 0.085);
                animate opacity, color { duration: 260ms; }
            }
            // Word-level wipe of the current line (enhanced LRC).
            if root.rows > 0 && root.index >= 0: VerticalLayout {
                x: root.side; width: area.width - 2 * root.side;
                y: area.mid - root.cur-h / 2; height: root.cur-h;
                alignment: center;
                for r in root.rows: HorizontalLayout {
                    alignment: center; height: root.line-h;
                    for w in root.words: Rectangle {
                        property <bool> on: w.row == r;
                        visible: self.on;
                        width: self.on ? base.preferred-width + (w.gap ? root.fit * 0.27 : 0px) : 0px;
                        base := Text {
                            x: 0; y: 0; width: self.preferred-width; height: root.line-h;
                            text: w.text; font-size: root.fit; font-weight: 800;
                            color: Theme.stage-fg; opacity: 0.4; vertical-alignment: center;
                        }
                        Rectangle {
                            x: 0; y: 0; height: root.line-h; clip: true;
                            width: base.preferred-width * w.progress;
                            animate width { duration: 110ms; easing: linear; }
                            Text {
                                x: 0; y: 0; width: base.preferred-width; height: root.line-h;
                                text: w.text; font-size: root.fit; font-weight: 800;
                                color: Theme.accent; vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
        // Plain lyrics: the whole text, scroll with the wheel or by dragging.
        if root.plain: Flickable {
            x: root.side; width: area.width - 2 * root.side;
            content-height: pcol.preferred-height;
            pcol := VerticalLayout {
                padding-top: 24px; padding-bottom: 48px; spacing: 4px;
                for l in root.lines: Text {
                    text: l; wrap: word-wrap; horizontal-alignment: center;
                    font-size: root.small * 1.05; font-weight: 600; color: l == "" ? transparent : Theme.stage-fg; opacity: 0.86;
                    min-height: root.small * 0.9;
                }
            }
        }
        // Fade the list out towards the top and bottom.
        if !root.plain: Rectangle { y: 0; height: 90px; background: @linear-gradient(180deg, Theme.stage 0%, Theme.stage.with-alpha(0) 100%); }
        if !root.plain: Rectangle { y: parent.height - 90px; height: 90px; background: @linear-gradient(180deg, Theme.stage.with-alpha(0) 0%, Theme.stage 100%); }
        // No lyrics yet.
        if root.lines.length == 0: VerticalLayout {
            alignment: center; spacing: 14px;
            HorizontalLayout { alignment: center;
                Rectangle { width: 76px; height: 76px; border-radius: self.height / 2; background: Theme.accent.with-alpha(0.14);
                    Icon { width: 34px; height: 34px; source: @image-url("../assets/icons/music.svg"); tint: Theme.accent; } } }
            Text { text: root.state == LyricsState.searching ? "Looking for lyrics…" : "No lyrics for this track"; color: Theme.stage-fg; font-size: Metrics.font-xxl; font-weight: 700; horizontal-alignment: center; }
            Text { text: "Search LRCLIB by artist and title, or put a .lrc file next to the song."; color: Theme.fg-a2; font-size: Metrics.font-base; horizontal-alignment: center; }
            HorizontalLayout { alignment: center; padding-top: 6px;
                KPill { primary: true; text: "Search lyrics…"; has-icon: true; icon: @image-url("../assets/icons/search.svg"); clicked => { root.cmd("search-open", ""); } } }
        }
    }

    // Header: track on the left, actions on the right (hidden with the player chrome).
    Rectangle {
        visible: root.chrome;
        y: 40px; height: 72px;
        background: @linear-gradient(180deg, Theme.stage 0%, Theme.stage.with-alpha(0) 100%);
        HorizontalLayout {
            padding-left: root.side; padding-right: 20px; spacing: 10px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 1; spacing: 2px;
                Text { text: root.title == "" ? "Lyrics" : root.title; color: Theme.stage-fg; font-size: Metrics.font-xl; font-weight: 700; overflow: elide; }
                HorizontalLayout { spacing: 8px; alignment: start;
                    if root.artist != "": Text { text: root.artist; color: Theme.fg-a2; font-size: Metrics.font-base; overflow: elide; vertical-alignment: center; }
                    if root.artist != "": Text { text: "·"; color: Theme.fg-a3; font-size: Metrics.font-base; vertical-alignment: center; }
                    Text { text: root.source; color: Theme.accent; font-size: Metrics.font-md; font-weight: 600; vertical-alignment: center; overflow: elide; }
                }
            }
            // Timing offset stepper.
            VerticalLayout { alignment: center;
                Rectangle {
                    height: 34px; width: orow.preferred-width; border-radius: self.height / 2; background: Theme.stage-chip;
                    border-width: 1px; border-color: Theme.stage-chip-line;
                    orow := HorizontalLayout {
                        Rectangle { width: 40px; border-radius: self.height / 2; background: m.has-hover ? Theme.stage-chip-hover : transparent;
                            Text { text: "−"; color: Theme.stage-fg; font-size: Metrics.font-h3; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            m := TouchArea { accessible-role: button; accessible-label: "Lyrics offset −0.1 s"; mouse-cursor: pointer; clicked => { root.cmd("offset", "-0.1"); } } }
                        Rectangle { width: 76px;
                            Text { text: root.offset; color: root.offset-s == 0 ? Theme.stage-fg.with-alpha(0.69) : Theme.accent; font-family: "DM Mono"; font-size: Metrics.font-md; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { accessible-role: button; accessible-label: "Lyrics offset " + root.offset + " (double-click to reset)"; accessible-action-default => { root.cmd("offset", "reset"); } mouse-cursor: pointer; double-clicked => { root.cmd("offset", "reset"); } } }
                        Rectangle { width: 40px; border-radius: self.height / 2; background: p.has-hover ? Theme.stage-chip-hover : transparent;
                            Text { text: "+"; color: Theme.stage-fg; font-size: Metrics.font-h3; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            p := TouchArea { accessible-role: button; accessible-label: "Lyrics offset +0.1 s"; mouse-cursor: pointer; clicked => { root.cmd("offset", "0.1"); } } }
                    }
                }
            }
            VerticalLayout { alignment: center;
                KPill { text: "Search"; has-icon: true; icon: @image-url("../assets/icons/search.svg"); clicked => { root.cmd("search-open", ""); } } }
            if root.manual: VerticalLayout { alignment: center;
                KPill { text: "Reset pick"; has-icon: true; icon: @image-url("../assets/icons/refresh.svg"); clicked => { root.cmd("forget", ""); } } }
            if root.can-save: VerticalLayout { alignment: center;
                KPill { text: "Save .lrc"; has-icon: true; icon: @image-url("../assets/icons/save.svg"); clicked => { root.cmd("save-lrc", ""); } } }
            if root.can-save: VerticalLayout { alignment: center;
                KPill { text: "Embed"; clicked => { root.cmd("embed", ""); } } }
            VerticalLayout { alignment: center;
                Rectangle { width: 34px; height: 34px; border-radius: self.height / 2; background: xa.has-hover ? Theme.stage-chip-hover : Theme.stage-chip;
                    Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/close.svg"); tint: Theme.stage-fg; }
                    xa := TouchArea { accessible-role: button; accessible-label: "Close karaoke"; mouse-cursor: pointer; clicked => { root.cmd("karaoke", "off"); } } } }
        }
    }
    // Shortcut hint above the player controls.
    Text {
        visible: root.chrome;
        y: root.height - 72px - 34px; x: 0; width: root.width; horizontal-alignment: center;
        text: "L  close   ·   [  ]  offset ±0.1 s   ·   Shift  ±0.5 s   ·   Ctrl L  search";
        color: Theme.stage-fg.with-alpha(0.33); font-size: Metrics.font-sm;
    }
}

component HitRow inherits Rectangle {
    in property <LyricsHit> hit;
    in property <bool> selected;
    callback clicked();
    callback activated();
    height: 52px; border-radius: Metrics.radius-lg;
    background: root.selected ? Theme.accent.with-alpha(0.16) : ta.has-hover ? Theme.bg-a1 : transparent;
    border-width: 1px; border-color: root.selected ? Theme.accent.with-alpha(0.6) : transparent;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 12px;
        VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 2px;
            Text { text: root.hit.title; color: Theme.fg-1; font-size: Metrics.font-base; font-weight: 600; overflow: elide; }
            Text { text: root.hit.artist + (root.hit.album != "" ? "  ·  " + root.hit.album : ""); color: Theme.fg-a2; font-size: Metrics.font-sm; overflow: elide; }
        }
        if root.hit.duration != "": Text {
            text: root.hit.duration; vertical-alignment: center; font-family: "DM Mono"; font-size: Metrics.font-md;
            color: root.hit.close ? Theme.accent : Theme.fg-a2;
        }
        VerticalLayout { alignment: center;
            Rectangle {
                width: 64px; height: 22px; border-radius: self.height / 2;
                background: root.hit.synced ? Theme.accent.with-alpha(0.22) : Theme.bg-a1;
                Text { text: root.hit.synced ? "Synced" : "Plain"; font-size: Metrics.font-xs; font-weight: 600; horizontal-alignment: center; vertical-alignment: center;
                    color: root.hit.synced ? Theme.accent-bright : Theme.fg-a2; }
            }
        }
    }
    ta := TouchArea { accessible-role: list-item; accessible-label: root.hit.title + ", " + root.hit.artist; accessible-item-selected: root.selected; accessible-action-default => { root.activated(); } mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.activated(); } }
}

// Find Lyrics: edit artist and title, search LRCLIB, pick a result (synced first, the
// duration in accent when it matches the playing file within 3 s) with a preview.
export component LyricsSearchDialog inherits Modal {
    in property <[LyricsHit]> results;
    in property <string> status;
    in property <string> preview;
    in property <bool> busy;
    in-out property <string> artist;
    in-out property <string> title;
    in-out property <int> selected: -1;
    callback cmd(string, string);
    property <bool> ok: root.selected >= 0 && root.selected < root.results.length && !root.busy;
    card-width: 940px;
    card-height: 660px;
    dismissed => { root.cmd("search-close", ""); }
    VerticalLayout {
        Rectangle {
            height: 44px; background: Theme.bg-b1;
            HorizontalLayout {
                padding-left: 16px; padding-right: 8px; spacing: 8px;
                Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: @image-url("../assets/icons/music.svg"); tint: Theme.accent; }
                Text { horizontal-stretch: 1; text: "Find Lyrics"; color: Theme.fg-1; font-size: Metrics.font-base; font-weight: 600; vertical-alignment: center; }
                Text { text: "LRCLIB"; color: Theme.fg-a3; font-size: Metrics.font-sm; vertical-alignment: center; }
                VerticalLayout { alignment: center;
                    Rectangle { width: 30px; height: 30px; border-radius: Metrics.radius-sm; background: cx.has-hover ? Theme.bg-a1 : transparent;
                        Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/close.svg"); }
                        cx := TouchArea { accessible-role: button; accessible-label: "Close"; mouse-cursor: pointer; clicked => { root.cmd("search-close", ""); } } } }
            }
        }
        HorizontalLayout {
            padding: 12px; spacing: 8px;
            VerticalLayout { horizontal-stretch: 2; spacing: 4px;
                Text { text: "Artist"; color: Theme.fg-a3; font-size: Metrics.font-xs; }
                TextField { height: 36px; text <=> root.artist; placeholder: "Artist (optional)"; accepted => { root.selected = -1; root.cmd("search", ""); } } }
            VerticalLayout { horizontal-stretch: 3; spacing: 4px;
                Text { text: "Title"; color: Theme.fg-a3; font-size: Metrics.font-xs; }
                TextField { height: 36px; text <=> root.title; placeholder: "Song title"; accepted => { root.selected = -1; root.cmd("search", ""); } } }
            VerticalLayout { alignment: end;
                PrimaryButton {
                    min-w: 104px; enabled: !root.busy; text: root.busy ? "Searching" : "Search"; icon: @image-url("../assets/icons/search.svg");
                    clicked => { root.selected = -1; root.cmd("search", ""); }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1; padding-left: 12px; padding-right: 12px; spacing: 12px;
            Rectangle {
                horizontal-stretch: 3;
                ScrollView {
                    VerticalLayout { spacing: 2px; alignment: start;
                        for h[i] in root.results: HitRow {
                            hit: h; selected: i == root.selected;
                            clicked => { root.selected = i; root.cmd("search-select", i); }
                            activated => { root.selected = i; root.cmd("search-use", i); }
                        }
                    }
                }
                if root.results.length == 0: Text {
                    width: parent.width - 32px; x: 16px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                    text: root.status; color: Theme.fg-a2; font-size: Metrics.font-md;
                }
            }
            Rectangle {
                horizontal-stretch: 2; border-radius: Metrics.radius-lg; background: Theme.bg-b1; border-width: 1px; border-color: Theme.bg-a1;
                ScrollView {
                    VerticalLayout { padding: 14px; alignment: start;
                        Text { text: root.preview == "" ? "Select a result to preview its lyrics." : root.preview; wrap: word-wrap;
                            color: root.preview == "" ? Theme.fg-a3 : Theme.fg-2; font-size: Metrics.font-md; }
                    }
                }
            }
        }
        HorizontalLayout {
            padding: 12px; padding-left: 16px; spacing: 8px;
            Text { horizontal-stretch: 1; text: root.results.length > 0 ? root.status : ""; color: Theme.fg-a2; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; }
            FlatButton { text: "Cancel"; clicked => { root.cmd("search-close", ""); } }
            FlatButton { text: "Use plain text"; enabled: root.ok; clicked => { root.cmd("search-plain", root.selected); } }
            Rectangle {
                width: 120px; height: 32px; border-radius: Metrics.radius-md; background: Theme.accent; opacity: root.ok ? 1 : 0.5;
                Text { text: "Use lyrics"; color: Theme.bg-b2; font-weight: 600; font-size: Metrics.font-md; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { enabled: root.ok; accessible-role: button; accessible-label: "Use lyrics"; mouse-cursor: pointer; clicked => { root.cmd("search-use", root.selected); } }
            }
        }
    }
}
