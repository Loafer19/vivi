// Library → Downloads: the shared Downloads panel (src/downloads.rs). Rows: artwork or the
// plugin's glyph, title, plugin, progress, size / speed / ETA, and actions for the state.
// A group row (a playlist) shows "12 / 40" and expands to its items, drawn indented.
import { Theme, Metrics, Icon } from "core/theme.slint";
import { Icons } from "core/icons.slint";
import { IconButton, SecondaryButton, ButtonSize } from "core/buttons.slint";
import { TextField } from "core/controls.slint";
import { Downloads, DlJob } from "state/downloads.slint";

component Act inherits IconButton {
    size: ButtonSize.sm;
}

component JobRow inherits Rectangle {
    in property <DlJob> job;
    in property <bool> narrow; // docked sidebar: no plugin name, the title gets the room
    property <bool> running: job.state == "queued" || job.state == "active" || job.state == "paused";
    height: root.job.child ? 52px : 64px; border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.bg-a1 : Theme.bg-a3;
    accessible-role: list-item;
    accessible-label: root.job.title + ", " + root.job.plugin + ", " + root.job.detail;
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: root.job.child ? 40px : 12px; padding-right: 8px; spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.job.child ? 34px : 44px; height: self.width; border-radius: Metrics.radius-sm; background: Theme.bg-a4; clip: true;
                if root.job.has-art: Image { width: 100%; height: 100%; source: root.job.art; image-fit: cover; }
                if !root.job.has-art: Icon { width: 20px; height: 20px; source: Icons.plugin(root.job.icon); tint: Theme.fg-a2; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.job.title; color: Theme.fg-1; font-size: Metrics.font-base; overflow: elide; horizontal-stretch: 1; }
                Text { text: root.job.child || root.narrow ? "" : root.job.plugin; color: Theme.fg-a3; font-size: Metrics.font-sm; overflow: elide; max-width: 140px; }
            }
            if root.job.state == "active" || root.job.state == "paused": Rectangle {
                height: 4px; border-radius: 2px; background: Theme.bg-a1;
                Rectangle {
                    x: 0; height: 100%; border-radius: 2px;
                    width: root.job.progress >= 0 ? parent.width * root.job.progress : parent.width * 0.15;
                    background: root.job.state == "paused" ? Theme.fg-a3 : Theme.accent;
                }
            }
            Text {
                text: root.job.detail; font-size: Metrics.font-sm; overflow: elide;
                color: root.job.state == "failed" ? Theme.danger : Theme.fg-a2;
            }
        }
        HorizontalLayout {
            alignment: end; spacing: 2px;
            if root.job.kids > 0: VerticalLayout { alignment: center; Act { tip: root.job.expanded ? "Hide items" : "Show all " + root.job.kids + " items"; icon: root.job.expanded ? @image-url("../assets/icons/chevron-up.svg") : @image-url("../assets/icons/chevron-down.svg"); clicked => { Downloads.act(root.job.id, "expand"); } } }
            if root.job.state == "active" && root.job.can-pause: VerticalLayout { alignment: center; Act { tip: "Pause"; icon: @image-url("../assets/icons/pause.svg"); clicked => { Downloads.act(root.job.id, "pause"); } } }
            if root.job.state == "paused": VerticalLayout { alignment: center; Act { tip: "Resume"; icon: @image-url("../assets/icons/play.svg"); clicked => { Downloads.act(root.job.id, "resume"); } } }
            if root.running: VerticalLayout { alignment: center; Act { tip: "Cancel"; icon: @image-url("../assets/icons/close.svg"); clicked => { Downloads.act(root.job.id, "cancel"); } } }
            if root.job.state == "failed": VerticalLayout { alignment: center; Act { tip: "Retry"; icon: @image-url("../assets/icons/refresh.svg"); clicked => { Downloads.act(root.job.id, "retry"); } } }
            if root.job.has-file: VerticalLayout { alignment: center; Act { tip: "Play now"; icon: @image-url("../assets/icons/play.svg"); clicked => { Downloads.act(root.job.id, "play"); } } }
            if root.job.has-file: VerticalLayout { alignment: center; Act { tip: "Open file"; icon: @image-url("../assets/icons/open.svg"); clicked => { Downloads.act(root.job.id, "open"); } } }
            if root.job.has-file: VerticalLayout { alignment: center; Act { tip: "Show in folder"; icon: @image-url("../assets/icons/folder.svg"); clicked => { Downloads.act(root.job.id, "folder"); } } }
            if !root.running: VerticalLayout { alignment: center; Act { tip: "Remove from list"; icon: @image-url("../assets/icons/close.svg"); clicked => { Downloads.act(root.job.id, "remove"); } } }
        }
    }
}

export component DownloadsView inherits VerticalLayout {
    spacing: 12px; alignment: start;
    // The docked Library sidebar (~330 px of content) next to the player.
    in property <bool> narrow;
    property <string> url;
    // Two rows: the Library side pane (media playing) is ~330 px wide, and one row with a
    // fixed 340 px field made the whole view wider than the pane (row buttons cut off).
    if Downloads.url-plugin != "": HorizontalLayout {
        spacing: 8px;
        TextField {
            min-width: 120px; max-width: 480px; horizontal-stretch: 1; text <=> root.url;
            placeholder: Downloads.url-label != "" ? Downloads.url-label : "Paste a link to download";
            label: "Link to download";
            accepted(t) => { if (t != "") { Downloads.run(Downloads.url-plugin, Downloads.url-command, t); root.url = ""; } }
        }
        SecondaryButton {
            text: "Add"; size: ButtonSize.sm; enabled: root.url != "";
            clicked => { Downloads.run(Downloads.url-plugin, Downloads.url-command, root.url); root.url = ""; }
        }
    }
    if !root.narrow: HorizontalLayout {
        spacing: 8px; alignment: start;
        for a in Downloads.actions: SecondaryButton { text: a.label; size: ButtonSize.sm; clicked => { Downloads.run(a.id, a.title, ""); } }
        Rectangle { horizontal-stretch: 1; }
        if Downloads.finished: SecondaryButton { text: "Clear finished"; size: ButtonSize.sm; clicked => { Downloads.clear-finished(); } }
    }
    // Docked Library sidebar: one button per line, so none pushes the rows out of view.
    if root.narrow: VerticalLayout {
        spacing: 6px;
        for a in Downloads.actions: HorizontalLayout { alignment: start; SecondaryButton { text: a.label; size: ButtonSize.sm; clicked => { Downloads.run(a.id, a.title, ""); } } }
        if Downloads.finished: HorizontalLayout { alignment: start; SecondaryButton { text: "Clear finished"; size: ButtonSize.sm; clicked => { Downloads.clear-finished(); } } }
    }
    if Downloads.line != "": Text { text: Downloads.line; color: Theme.fg-a2; font-size: Metrics.font-sm; }
    if Downloads.jobs.length == 0: VerticalLayout {
        padding-top: 30px; spacing: 6px;
        Text { text: "No downloads yet"; color: Theme.fg-1; font-size: Metrics.font-lg; horizontal-alignment: center; }
        Text { text: "Downloads from Free Music, Offline Downloads and other extensions show up here."; color: Theme.fg-a3; horizontal-alignment: center; wrap: word-wrap; }
    }
    for j in Downloads.jobs: JobRow { job: j; narrow: root.narrow; }
}
