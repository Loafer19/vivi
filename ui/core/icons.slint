// Every icon lookup by key (was KindIcon, VizIcons, PluginIcons, PresetIcon, MenuIcons).
export global Icons {
    // Library item kind → icon.
    public pure function kind(kind: string) -> image {
        if kind == "add" { return @image-url("../../assets/icons/add.svg"); }
        if kind == "songs" { return @image-url("../../assets/icons/songs.svg"); }
        if kind == "album" { return @image-url("../../assets/icons/album.svg"); }
        if kind == "artist" { return @image-url("../../assets/icons/artist.svg"); }
        if kind == "genre" { return @image-url("../../assets/icons/genre.svg"); }
        if kind == "streaming" { return @image-url("../../assets/icons/streaming.svg"); }
        if kind == "web" { return @image-url("../../assets/icons/link.svg"); }
        if kind == "folder" { return @image-url("../../assets/icons/folder.svg"); }
        if kind == "audio" { return @image-url("../../assets/icons/music.svg"); }
        if kind == "group" { return @image-url("../../assets/icons/album.svg"); }
        if kind == "playlist" { return @image-url("../../assets/icons/playlist.svg"); }
        return @image-url("../../assets/icons/video.svg");
    }

    // Visualizer mode index → two-tone layers (0 = Disabled has none).
    pure public function viz(i: int) -> image {
        if (i == 1) { return @image-url("../../assets/icons/layers/spectometer-twotone-b.svg"); }
        if (i == 2) { return @image-url("../../assets/icons/layers/scope-twotone-b.svg"); }
        if (i == 3) { return @image-url("../../assets/icons/layers/spectrum-twotone-b.svg"); }
        if (i == 4) { return @image-url("../../assets/icons/layers/waveform-twotone-b.svg"); }
        if (i == 5) { return @image-url("../../assets/icons/disc.svg"); }
        if (i == 6) { return @image-url("../../assets/icons/genre.svg"); }
        if (i == 7) { return @image-url("../../assets/icons/music.svg"); }
        @image-url("")
    }
    pure public function viz-accent(i: int) -> image {
        if (i == 1) { return @image-url("../../assets/icons/layers/spectometer-twotone-a.svg"); }
        if (i == 2) { return @image-url("../../assets/icons/layers/scope-twotone-a.svg"); }
        if (i == 3) { return @image-url("../../assets/icons/layers/spectrum-twotone-a.svg"); }
        if (i == 4) { return @image-url("../../assets/icons/layers/waveform-twotone-a.svg"); }
        @image-url("")
    }
    pure public function viz-dim(i: int) -> image {
        if (i == 1) { return @image-url("../../assets/icons/layers/spectometer-twotone-d.svg"); }
        if (i == 2) { return @image-url("../../assets/icons/layers/scope-twotone-d.svg"); }
        if (i == 3) { return @image-url("../../assets/icons/layers/spectrum-twotone-d.svg"); }
        if (i == 4) { return @image-url("../../assets/icons/layers/waveform-twotone-d.svg"); }
        @image-url("")
    }

    // Plugin manifest icon key (src/plugins Manifest::icon) → icon.
    pure public function plugin(key: string) -> image {
        if (key == "visualizer") { return @image-url("../../assets/icons/spectrum-twotone.svg"); }
        if (key == "skip") { return @image-url("../../assets/icons/next.svg"); }
        if (key == "lyrics") { return @image-url("../../assets/icons/music.svg"); }
        if (key == "subtitles") { return @image-url("../../assets/icons/subtitles.svg"); }
        if (key == "script") { return @image-url("../../assets/icons/file.svg"); }
        if (key == "loop") { return @image-url("../../assets/icons/repeat-right.svg"); }
        if (key == "stats") { return @image-url("../../assets/icons/spectometer-twotone.svg"); }
        if (key == "tag") { return @image-url("../../assets/icons/edit.svg"); }
        if (key == "free-music") { return @image-url("../../assets/icons/album.svg"); }
        if (key == "streams") { return @image-url("../../assets/icons/streaming.svg"); }
        if (key == "discord") { return @image-url("../../assets/icons/profile.svg"); }
        if (key == "remote") { return @image-url("../../assets/icons/capture-device.svg"); }
        if (key == "scrobble") { return @image-url("../../assets/icons/favorite-twotone.svg"); }
        if (key == "night") { return @image-url("../../assets/icons/volume-high.svg"); }
        if (key == "eq") { return @image-url("../../assets/icons/eq.svg"); }
        if (key == "chapters") { return @image-url("../../assets/icons/chapters-twotone.svg"); }
        @image-url("../../assets/icons/plugins.svg")
    }

    // Equalizer preset name → icon.
    pure public function preset(n: string) -> image {
        return n == "Classical" ? @image-url("../../assets/icons/eq-classical.svg")
            : n == "Club" ? @image-url("../../assets/icons/eq-club.svg")
            : n == "Dance" ? @image-url("../../assets/icons/eq-dance.svg")
            : n == "Full bass" ? @image-url("../../assets/icons/eq-full_bass.svg")
            : n == "Full bass & treble" ? @image-url("../../assets/icons/eq-full_bass_and_treble.svg")
            : n == "Full treble" ? @image-url("../../assets/icons/eq-full_treble.svg")
            : n == "Headphones" ? @image-url("../../assets/icons/eq-headphones.svg")
            : n == "Large hall" ? @image-url("../../assets/icons/eq-large_hall.svg")
            : n == "Live" ? @image-url("../../assets/icons/eq-live.svg")
            : n == "Party" ? @image-url("../../assets/icons/eq-party.svg")
            : n == "Pop" ? @image-url("../../assets/icons/eq-pop.svg")
            : n == "Reggae" ? @image-url("../../assets/icons/eq-reggae.svg")
            : n == "Rock" ? @image-url("../../assets/icons/eq-rock.svg")
            : n == "Ska" ? @image-url("../../assets/icons/eq-ska.svg")
            : n == "Soft" ? @image-url("../../assets/icons/eq-soft.svg")
            : n == "Soft rock" ? @image-url("../../assets/icons/eq-soft_rock.svg")
            : n == "Techno" ? @image-url("../../assets/icons/eq-techno.svg")
            : @image-url("../../assets/icons/remove.svg");
    }

