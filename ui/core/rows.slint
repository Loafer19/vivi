// Shared list pieces: section headers, status badges, value chips and a
// hoverable list row.
import { Theme, Metrics } from "theme.slint";

// Section heading. Default: a bold title inside panels; `caps`: the small
// spaced-out uppercase label used above groups (About, Settings).
export component SectionHeader inherits Text {
    in property <bool> caps;
    color: root.caps ? Theme.fg-a3 : Theme.fg-1;
    font-size: root.caps ? Metrics.font-sm : Metrics.font-base;
    font-weight: 600;
    letter-spacing: root.caps ? 0.6px : 0;
}

export enum BadgeTone { neutral, accent, ok, warn, err, info }

// Small rounded status pill ("Exact match", "HI", "Machine").
export component Badge inherits Rectangle {
    in property <string> text;
    in property <BadgeTone> tone: BadgeTone.neutral;
    height: 20px; width: bt.preferred-width + 14px; border-radius: self.height / 2;
    background: root.tone == BadgeTone.accent ? Theme.accent.with-alpha(0.22)
        : root.tone == BadgeTone.warn ? Theme.warn-bg.with-alpha(0.25)
        : root.tone == BadgeTone.ok ? Theme.ok-bg.with-alpha(0.25)
        : root.tone == BadgeTone.err ? Theme.err-bg.with-alpha(0.25)
        : root.tone == BadgeTone.info ? Theme.info-bg.with-alpha(0.25)
        : Theme.bg-a1;
    bt := Text {
        text: root.text; font-size: Metrics.font-xs; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
        color: root.tone == BadgeTone.accent ? Theme.accent-bright
            : root.tone == BadgeTone.warn ? Theme.warn
            : root.tone == BadgeTone.ok ? Theme.ok
            : root.tone == BadgeTone.err ? Theme.err
            : root.tone == BadgeTone.info ? Theme.info
            : Theme.fg-a2;
    }
}

// Read-only monospace value next to a control ("1.25×").
export component ValueChip inherits Rectangle {
    in property <string> text;
    height: 26px; width: max(52px, bt.preferred-width + 18px); border-radius: Metrics.radius-md; background: Theme.field;
    bt := Text { text: root.text; color: Theme.fg-2; font-family: "DM Mono"; font-size: Metrics.font-sm; horizontal-alignment: center; vertical-alignment: center; }
}

// One clickable row in a list or menu. Colours are parameters so menus,
// dropdown options, presets, the queue and library rows share one hit area
// and hover logic while keeping their own look. Children are drawn above
// the row's touch area, so inner buttons still get their clicks.
export component ListRow inherits Rectangle {
    in property <bool> selected;
    // Drawn like hover (e.g. a menu row whose submenu is open).
    in property <bool> highlighted;
    in property <bool> enabled: true;
    in property <length> row-height: Metrics.row-h;
    in property <length> radius: Metrics.radius-sm;
    in property <brush> hover-bg: Theme.bg-a1;
    in property <brush> selected-bg: Theme.accent-bg;
    out property <bool> row-hovered: ta.has-hover;
    callback clicked();
    callback entered();
    // Window coordinates of a right click.
    callback right-clicked(length, length);
    height: root.row-height;
    border-radius: root.radius;
    background: (ta.has-hover && root.enabled) || root.highlighted ? root.hover-bg : root.selected ? root.selected-bg : transparent;
    opacity: root.enabled ? 1 : 0.4;
    ta := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => { if (self.has-hover) { root.entered(); } }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    @children
}
