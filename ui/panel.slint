// Right side panel (Figma "sidebar", "Audio - Equalizer", "Video - Essential/Crop/Colors").
// 400px wide. Two tab groups: Playback / Video / Audio / Subtitles (quick settings)
// and Queue / Bookmarks / Chapters / Library (lists). Tab ids: 0 subs, 1 audio,
// 2 video, 3 playback, 4 queue, 5 library, 6 bookmarks, 7 chapters.
import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme, Icon } from "theme.slint";
import { Field, Toggle, AccentSlider, Segmented, TextField, Dropdown } from "controls.slint";
import { Equalizer, VideoFilters, AudioEffects } from "filters.slint";

export struct Item { key: string, label: string, selected: bool }

component Section inherits Text {
    color: Theme.fg-1; font-weight: 600; font-size: 14px;
}

// A clickable list of options with a check mark on the selected one.
component OptionList inherits VerticalLayout {
    in property <[Item]> items;
    in property <string> empty-text: "None";
    callback pick(Item);
    spacing: 2px; alignment: start;
    if items.length == 0: Text { text: root.empty-text; color: Theme.fg-a3; }
    for it in items: Rectangle {
        height: 32px;
        border-radius: Theme.radius;
        background: ta.has-hover ? Theme.bg-a1 : (it.selected ? Theme.accent-bg : transparent);
        HorizontalLayout {
            padding-left: 10px; padding-right: 8px; spacing: 8px;
            Text {
                text: it.label; overflow: elide; vertical-alignment: center;
                color: it.selected ? Theme.accent-bright : Theme.fg-2;
            }
            if it.selected: Icon { source: @image-url("../assets/icons/check-active.svg"); tint: Theme.accent; width: 18px; height: 32px; }
        }
        ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(it); } }
    }
}

// Labelled slider with value read-out (Figma "Values").
component SliderRow inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <string> unit;
    in property <int> decimals: 0;
    in-out property <float> value;
    in property <float> default-value: 0;
    callback changed(float);
    spacing: 6px;
    HorizontalLayout {
        Text { text: root.label; color: Theme.fg-a1; horizontal-stretch: 1; }
        Text {
            text: (root.decimals == 0 ? round(root.value) : round(root.value * 100) / 100) + root.unit;
            color: Theme.fg-1; font-family: "DM Mono"; font-size: 13px;
        }
        Rectangle { width: 8px; }
        Rectangle {
            width: 18px; height: 18px; border-radius: 3px;
            background: rta.has-hover ? Theme.bg-a1 : transparent;
            Icon { source: @image-url("../assets/icons/refresh.svg"); width: 14px; height: 14px; tint: Theme.fg-a3; }
            rta := TouchArea { clicked => { root.value = root.default-value; root.changed(root.value); } }
        }
    }
    Rectangle {
        height: 18px;
        property <float> frac: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);
        Rectangle {
            y: 6px; height: 6px; border-radius: 3px; background: Theme.divider;
            Rectangle { x: 0; height: 6px; border-radius: 3px; width: parent.width * frac; background: Theme.accent; }
        }
        Rectangle {
            x: parent.width * frac - 7px; y: 2px; width: 14px; height: 14px; border-radius: 7px;
            background: ta.pressed || ta.has-hover ? Theme.accent-bright : Theme.fg-1;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            function apply() {
                let raw = root.minimum + clamp(self.mouse-x / self.width, 0, 1) * (root.maximum - root.minimum);
                root.value = round(raw / root.step) * root.step;
                root.changed(root.value);
            }
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.apply(); } }
            moved => { if (self.pressed) { self.apply(); } }
        }
    }
}

// Underlined text tab (Figma side-panel tabs): icon + label, active = accent + underline.
component Tab inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> compact;
    callback clicked();
    height: 44px; horizontal-stretch: 1;
    background: ta.has-hover && !active ? Theme.bg-a1.with-alpha(0.5) : transparent;
    HorizontalLayout {
        alignment: center; spacing: 6px;
        Icon { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: root.icon; tint: root.active ? Theme.accent : Theme.fg-a3; }
        if !root.compact: Text { text: root.label; font-size: 13px; vertical-alignment: center; color: root.active ? Theme.fg-1 : Theme.fg-a2; }
    }
    Rectangle { y: parent.height - 2px; height: 2px; width: parent.width - 12px; x: 6px; border-radius: 1px; background: root.active ? Theme.accent : transparent; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Section title with a hairline above it (settings tabs).
component Group inherits VerticalLayout {
    in property <string> title;
    in property <bool> first;
    spacing: 10px; padding-top: first ? 2px : 6px;
    if !root.first: Rectangle { height: 1px; background: Theme.divider.with-alpha(0.5); }
    Text { text: root.title; color: Theme.fg-1; font-weight: 600; font-size: 14px; }
    @children
}

// Label on the left, control on the right.
component Line inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 10px; min-height: 36px;
    VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 1px;
        Text { text: root.label; color: Theme.fg-a1; font-size: 13px; overflow: elide; }
        if root.hint != "": Text { text: root.hint; color: Theme.fg-a3; font-size: 11px; overflow: elide; }
    }
    VerticalLayout { alignment: center; @children }
}

// Small value pill (e.g. "1.00×", "-0.40 s").
component Badge inherits Rectangle {
    in property <string> text;
    height: 26px; width: max(52px, bt.preferred-width + 18px); border-radius: 5px; background: Field.fill;
    bt := Text { text: root.text; color: Theme.fg-2; font-family: "DM Mono"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
}

// Footer button that opens the full Settings window on a category.
component AdvancedLink inherits Rectangle {
    callback clicked();
    height: 36px; border-radius: 6px;
    background: ta.has-hover ? Theme.bg-a1 : transparent;
    HorizontalLayout { alignment: center; spacing: 8px;
        Icon { y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: @image-url("../assets/icons/settings.svg"); tint: Theme.fg-a2; }
        Text { text: "Open Advanced Settings"; color: Theme.fg-a2; font-size: 13px; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback clicked();
    height: 32px; border-radius: Theme.radius;
    background: ta.has-hover ? Theme.divider : Theme.bg-a1;
    HorizontalLayout {
        alignment: center; spacing: 8px;
        Icon { source: root.icon; width: 18px; height: 32px; }
        Text { text: root.text; color: Theme.fg-1; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Queue row with hover actions (play, move up/down, remove).
component QueueRow inherits Rectangle {
    in property <Item> it;
    in property <int> index;
    callback play(int);
    callback move(int, int);
    callback remove(int);
    height: 36px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.bg-a1 : (it.selected ? Theme.accent-bg : transparent);
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.play(root.index); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 4px; spacing: 6px;
        Text { text: (root.index + 1) + "."; color: Theme.fg-a3; vertical-alignment: center; font-family: "DM Mono"; font-size: 12px; }
        Text {
            horizontal-stretch: 1;
            text: it.label; overflow: elide; vertical-alignment: center;
            color: it.selected ? Theme.accent-bright : Theme.fg-2;
        }
        HorizontalLayout {
            spacing: 2px;
            Rectangle { width: 24px;
                Icon { source: @image-url("../assets/icons/chevron-up.svg"); width: 16px; height: 36px; }
                up := TouchArea { clicked => { root.move(root.index, -1); } } }
            Rectangle { width: 24px;
                Icon { source: @image-url("../assets/icons/chevron-down.svg"); width: 16px; height: 36px; }
                dn := TouchArea { clicked => { root.move(root.index, 1); } } }
            Rectangle { width: 24px;
                Icon { source: @image-url("../assets/icons/close.svg"); width: 14px; height: 36px; }
                rm := TouchArea { clicked => { root.remove(root.index); } } }
        }
    }
}

// "#RRGGBB" field with a live swatch.
component ColorField inherits HorizontalLayout {
    in-out property <string> value;
    callback accepted(string);
    spacing: 6px; width: 170px;
    TextField { horizontal-stretch: 1; text <=> root.value; placeholder: "#FFFFFF"; accepted(t) => { root.accepted(t); } }
    Rectangle { width: 26px; height: 26px; y: 3px; border-radius: 4px; border-width: 1px; border-color: Theme.divider;
        background: root.value == "#000000" ? #000000 : root.value == "#FFFFFF" ? #FFFFFF : root.value == "#FFFF00" ? #FFFF00 : Theme.fg-2; }
}

// Collapsible "Show preset" card (Figma "Default Preset").
component PresetCard inherits Rectangle {
    in property <string> name;
    callback save();
    property <bool> open;
    border-radius: 6px; background: Field.fill; clip: true;
    VerticalLayout {
        Rectangle { height: 40px;
            HorizontalLayout { padding-left: 12px; padding-right: 10px;
                Text { text: "Show Preset"; color: Theme.fg-2; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                Icon { y: (parent.height - 16px) / 2; width: 16px; height: 16px; tint: Theme.fg-a2;
                    source: root.open ? @image-url("../assets/icons/chevron-up.svg") : @image-url("../assets/icons/chevron-down.svg"); } }
            TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } } }
        if root.open: VerticalLayout { padding: 12px; padding-top: 0; spacing: 10px;
            Text { text: "Saves delays, subtitle size/position and track languages for “" + root.name + "”. Applied automatically to other episodes."; color: Theme.fg-a3; wrap: word-wrap; font-size: 12px; }
            Button { text: "Save preset for this show"; icon: @image-url("../assets/icons/save.svg"); clicked => { root.save(); } } }
    }
}

// "N Bookmarks   −  +" header shared by the list tabs.
component ListHeader inherits HorizontalLayout {
    in property <string> text;
    in property <bool> show-minus: true;
    in property <string> minus-tip;
    in property <string> plus-tip;
    callback minus();
    callback plus();
    height: 36px; spacing: 4px;
    Text { text: root.text; color: Theme.fg-a2; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
    if root.show-minus: Rectangle { width: 30px; border-radius: 4px; background: ma.has-hover ? Theme.bg-a1 : transparent;
        Icon { width: 18px; height: 18px; source: @image-url("../assets/icons/remove.svg"); tint: Theme.fg-a2; }
        ma := TouchArea { mouse-cursor: pointer; clicked => { root.minus(); } } }
    Rectangle { width: 30px; border-radius: 4px; background: pa.has-hover ? Theme.bg-a1 : transparent;
        Icon { width: 18px; height: 18px; source: @image-url("../assets/icons/add.svg"); tint: Theme.fg-a2; }
        pa := TouchArea { mouse-cursor: pointer; clicked => { root.plus(); } } }
}

// Numbered / named row with a right-aligned monospace timestamp.
component TimeRow inherits Rectangle {
    in property <string> number;
    in property <string> title;
    in property <string> time;
    in property <bool> current;
    callback clicked();
    height: 38px; border-radius: Theme.radius;
    background: ta.has-hover ? Theme.bg-a1 : (current ? Theme.accent-bg.with-alpha(0.5) : transparent);
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 12px;
        if root.number != "": Text { width: 22px; text: root.number; color: Theme.accent; font-family: "DM Mono"; font-size: 13px; vertical-alignment: center; }
        Text { text: root.title; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; color: root.current ? Theme.accent-bright : Theme.fg-2; }
        Text { text: root.time; color: Theme.fg-a3; font-family: "DM Mono"; font-size: 12px; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

global TimeFmt {
    // seconds → "HH:MM:SS" (with ".mmm" when ms is true)
    pure public function hms(t: float, ms: bool) -> string {
        let s = floor(max(t, 0));
        let h = floor(s / 3600);
        let m = floor(mod(s, 3600) / 60);
        let sec = mod(s, 60);
        let base = (h < 10 ? "0" : "") + h + ":" + (m < 10 ? "0" : "") + m + ":" + (sec < 10 ? "0" : "") + sec;
        if (!ms) { return base; }
        let f = round((t - s) * 1000);
        return base + "." + (f < 10 ? "00" : f < 100 ? "0" : "") + f;
    }
}

export component SidePanel inherits Rectangle {
    in-out property <int> tab: 0;
    in-out property <length> scroll-y;
    in property <[Item]> sub-tracks;
    in property <[Item]> audio-tracks;
    in property <[Item]> audio-devices;
    in property <[Item]> chapters;
    in property <[string]> chapter-times;
    in property <[image]> chapter-thumbs;
    in property <[bool]> chapter-has-thumb;
    callback chapters-refresh();
    in property <[Item]> bookmarks;
    in property <[Item]> queue;
    in property <[Item]> playlists;
    callback queue-play(int);
    callback queue-move(int, int);
    callback queue-remove(int);
    callback queue-add();
    callback queue-clear();
    callback playlist-save(string);
    callback playlist-load(string);
    callback playlist-delete(string);
    in property <string> preset-name;
    in property <[Item]> library;
    callback library-search(string);
    callback library-play(string);
    callback library-enqueue(string);
    callback save-preset();
    callback seek-to(string);
    callback add-bookmark();
    callback remove-bookmark();
    in property <string> ab-state: "Off";
    in property <string> sleep-state: "";
    in property <string> hwdec: "auto-safe";
    in property <[string]> viz-modes: ["Disabled"];
    in property <int> viz-mode;
    callback viz-select(int);
    // Lyrics plugin: karaoke toggle, timing offset, search and save (cmd → plugin-command).
    in property <bool> lyrics-enabled;
    in property <bool> karaoke-open;
    in property <string> lyrics-source;
    in property <string> lyrics-offset;
    in property <bool> lyrics-can-save;
    in property <bool> lyrics-manual;
    callback lyrics(string, string);
    // Subtitle Search plugin: per-file offset, Auto-sync, remembered pick (cmd → plugin-command).
    in property <bool> subs-enabled;
    in property <string> subs-offset: "0.0 s";
    in property <bool> subs-has-pick;
    in property <string> subs-pick-label;
    in property <bool> subs-sync;
    callback subs(string, string);
    callback find-subs();
    // Settings-window category to open (see settings.rs CATEGORIES).
    callback open-settings(int);

    callback set-prop(string, string);
    callback run(string);
    callback load-sub();
    callback sleep(int);
    callback close();

    // Slider values (synced from mpv by the app).
    in-out property <float> sub-delay: 0;
    in-out property <float> sub-scale: 1;
    in-out property <float> sub-pos: 100;
    in-out property <float> audio-delay: 0;
    in-out property <float> boost: 100;
    property <string> aspect: "-1";
    in-out property <int> rotate: 0;
    in-out property <float> zoom: 0;
    in-out property <float> panscan: 0;
    in-out property <float> brightness: 0;
    in-out property <float> contrast: 0;
    in-out property <float> saturation: 0;
    in-out property <float> gamma: 0;
    in-out property <float> speed: 1;
    // Local toggles mirrored to mpv on change (session only).
    in-out property <bool> stats-on;
    in-out property <bool> reverse-on;
    in-out property <bool> sub-timeline;
    in-out property <float> sub-speed: 1;
    in-out property <bool> sub-ass-override: false;
    in-out property <string> sub-font: "Inter";
    in-out property <string> sub-color: "#FFFFFF";
    in-out property <string> sub-outline-color: "#000000";
    in-out property <string> flip: "None";
    in-out property <string> stereo: "Auto";
    in-out property <string> hdr: "Auto";
    property <string> sleep-choice: root.sleep-state == "" ? "Off" : root.sleep-state;
    property <bool> settings-group: root.tab <= 3;
    property <bool> narrow: root.width < 360px;

    width: 400px;
    background: Theme.bar;
    TouchArea { } // keep clicks inside the panel

    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 44px; background: Theme.bg-b1.with-alpha(0.7);
            HorizontalLayout {
                padding-left: 4px; padding-right: 4px;
                if root.settings-group: Tab { compact: root.narrow; icon: @image-url("../assets/icons/playback.svg"); label: "Playback"; active: root.tab == 3; clicked => { root.tab = 3; } }
                if root.settings-group: Tab { compact: root.narrow; icon: @image-url("../assets/icons/video.svg"); label: "Video"; active: root.tab == 2; clicked => { root.tab = 2; } }
                if root.settings-group: Tab { compact: root.narrow; icon: @image-url("../assets/icons/audio.svg"); label: "Audio"; active: root.tab == 1; clicked => { root.tab = 1; } }
                if root.settings-group: Tab { compact: root.narrow; icon: @image-url("../assets/icons/subtitles.svg"); label: "Subtitles"; active: root.tab == 0; clicked => { root.tab = 0; } }
                if !root.settings-group: Tab { compact: root.narrow; icon: @image-url("../assets/icons/queue.svg"); label: "Queue"; active: root.tab == 4; clicked => { root.tab = 4; } }
                if !root.settings-group: Tab { compact: root.narrow; icon: @image-url("../assets/icons/bookmark.svg"); label: "Bookmarks"; active: root.tab == 6; clicked => { root.tab = 6; } }
                if !root.settings-group: Tab { compact: root.narrow; icon: @image-url("../assets/icons/chapters.svg"); label: "Chapters"; active: root.tab == 7; clicked => { root.tab = 7; root.chapters-refresh(); } }
                if !root.settings-group: Tab { compact: true; icon: @image-url("../assets/icons/videos.svg"); label: "Library"; active: root.tab == 5; clicked => { root.tab = 5; root.library-search(""); } }
                Rectangle {
                    width: 32px;
                    Icon { source: @image-url("../assets/icons/close.svg"); width: 16px; height: 16px; tint: Theme.fg-a3; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            content-y <=> root.scroll-y;
            VerticalLayout {
                spacing: 14px; padding: 16px; padding-right: 20px; alignment: start;
                // ---- Playback ----
                if root.tab == 3: VerticalLayout {
                    spacing: 6px; alignment: start;
                    Group { first: true; title: "Speed";
                        HorizontalLayout { spacing: 6px;
                            for v in [0.5, 1, 1.25, 1.5, 2]: Rectangle {
                                height: 28px; horizontal-stretch: 1; border-radius: 5px;
                                background: abs(root.speed - v) < 0.001 ? Theme.accent.mix(Field.fill, 30%) : (sa.has-hover ? Field.raised : Field.fill);
                                Text { text: v + "×"; font-size: 12px; color: abs(root.speed - v) < 0.001 ? Theme.accent : Theme.fg-a2; }
                                sa := TouchArea { mouse-cursor: pointer; clicked => { root.speed = v; root.set-prop("speed", v); } }
                            }
                            Badge { text: round(root.speed * 100) / 100 + "×"; }
                        }
                        AccentSlider {
                            value: root.speed; minimum: 0.25; maximum: 2; step: 0.05; ticks: 6;
                            labels: ["0.25", "0.5", "0.75", "1", "1.25", "1.5", "1.75", "2"];
                            changed(v) => { root.speed = v; root.set-prop("speed", v); }
                        }
                    }
                    Group { title: "Display";
                        Line { label: "Show Statistics"; hint: "mpv stats overlay";
                            Toggle { on: root.stats-on; toggled => { root.stats-on = !root.stats-on; root.run("script-binding stats/display-stats-toggle"); } } }
                        Line { label: "Subtitle Timeline on Seekbar"; hint: "Coming soon";
                            Toggle { on: root.sub-timeline; enabled: false; toggled => { root.sub-timeline = !root.sub-timeline; } } }
                        Line { label: "Audio Visualizer"; hint: "Audio-only files";
                            Dropdown { width: 170px; options: root.viz-modes; value: root.viz-modes.length > root.viz-mode ? root.viz-modes[root.viz-mode] : ""; selected(i, o) => { root.viz-select(i); } } }
                    }
                    Group { title: "Control";
                        Line { label: "Reverse"; hint: "Play backwards (mpv play-direction)";
                            Toggle { on: root.reverse-on; toggled => { root.reverse-on = !root.reverse-on; root.set-prop("play-direction", root.reverse-on ? "backward" : "forward"); } } }
                        Line { label: "Sleep Timer"; hint: root.sleep-state;
                            Dropdown { width: 170px; options: ["Off", "15 min", "30 min", "60 min", "End of file"]; value: root.sleep-state == "" ? "Off" : "On";
                                selected(i, o) => { root.sleep(i == 0 ? 0 : i == 1 ? 15 : i == 2 ? 30 : i == 3 ? 60 : -1); } } }
                        Line { label: "A-B Loop"; hint: root.ab-state;
                            Button { width: 110px; text: "Set A / B"; icon: @image-url("../assets/icons/repeat-right.svg"); clicked => { root.run("ab-loop"); } } }
                    }
                    if root.lyrics-enabled: Group { title: "Lyrics";
                        Line { label: "Karaoke View"; hint: "Full-screen lyrics · L";
                            Toggle { on: root.karaoke-open; toggled => { root.lyrics("karaoke", root.karaoke-open ? "off" : "on"); } } }
                        Line { label: "Timing Offset"; hint: "Saved per track · [ ] ±0.1 s, Shift ±0.5 s";
                            HorizontalLayout { spacing: 4px;
                                for d in [-0.5, -0.1]: Rectangle { width: 40px; height: 26px; border-radius: 5px; background: oa.has-hover ? Field.raised : Field.fill;
                                    Text { text: d; font-size: 11px; color: Theme.fg-a2; horizontal-alignment: center; vertical-alignment: center; }
                                    oa := TouchArea { mouse-cursor: pointer; clicked => { root.lyrics("offset", d); } } }
                                Rectangle { width: 64px; height: 26px; border-radius: 5px; background: Field.fill;
                                    Text { text: root.lyrics-offset; font-family: "DM Mono"; font-size: 12px; color: root.lyrics-offset == "0.0 s" ? Theme.fg-2 : Theme.accent; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { mouse-cursor: pointer; double-clicked => { root.lyrics("offset", "reset"); } } }
                                for d in [0.1, 0.5]: Rectangle { width: 40px; height: 26px; border-radius: 5px; background: ob.has-hover ? Field.raised : Field.fill;
                                    Text { text: "+" + d; font-size: 11px; color: Theme.fg-a2; horizontal-alignment: center; vertical-alignment: center; }
                                    ob := TouchArea { mouse-cursor: pointer; clicked => { root.lyrics("offset", d); } } }
                            } }
                        Line { label: "Source"; hint: root.lyrics-source;
                            HorizontalLayout { spacing: 6px;
                                if root.lyrics-manual: Button { width: 86px; text: "Reset"; icon: @image-url("../assets/icons/refresh.svg"); clicked => { root.lyrics("forget", ""); } }
                                Button { width: 110px; text: "Search…"; icon: @image-url("../assets/icons/search.svg"); clicked => { root.lyrics("search-open", ""); } } } }
                        if root.lyrics-can-save: HorizontalLayout { spacing: 8px;
                            Button { horizontal-stretch: 1; text: "Save as .lrc"; icon: @image-url("../assets/icons/save.svg"); clicked => { root.lyrics("save-lrc", ""); } }
                            Button { horizontal-stretch: 1; text: "Embed in tags"; icon: @image-url("../assets/icons/music.svg"); clicked => { root.lyrics("embed", ""); } } }
                    }
                    AdvancedLink { clicked => { root.open-settings(4); } }
                }
                // ---- Video ----
                if root.tab == 2: VerticalLayout {
                    spacing: 6px; alignment: start;
                    Group { first: true; title: "Geometry";
                        Text { text: "Flip"; color: Theme.fg-a1; font-size: 13px; }
                        Segmented { options: ["None", "Horizontal", "Vertical"]; value: root.flip;
                            selected(o) => {
                                root.flip = o;
                                root.run("vf remove @vflip");
                                if (o == "Horizontal") { root.run("vf add @vflip:hflip"); }
                                if (o == "Vertical") { root.run("vf add @vflip:vflip"); }
                            } }
                        Line { label: "Rotate";
                            Segmented { width: 200px; options: ["0°", "90°", "180°", "270°"]; value: root.rotate + "°";
                                selected(o) => { root.rotate = o == "90°" ? 90 : o == "180°" ? 180 : o == "270°" ? 270 : 0; root.set-prop("video-rotate", root.rotate); } } }
                        Line { label: "Zoom";
                            Dropdown { width: 170px; options: ["0.5×", "1:1 Original", "1.5×", "2×"];
                                value: root.zoom <= -0.9 ? "0.5×" : root.zoom >= 0.95 ? "2×" : root.zoom >= 0.5 ? "1.5×" : abs(root.zoom) < 0.01 ? "1:1 Original" : round(pow(2, root.zoom) * 100) / 100 + "×";
                                selected(i, o) => { root.zoom = i == 0 ? -1 : i == 2 ? 0.585 : i == 3 ? 1 : 0; root.set-prop("video-zoom", root.zoom); } } }
                        Line { label: "Aspect Ratio";
                            Dropdown { width: 170px; options: ["Default", "16:9", "4:3", "2.35:1", "1:1"]; value: root.aspect == "-1" ? "Default" : root.aspect;
                                selected(i, o) => { root.aspect = i == 0 ? "-1" : o; root.set-prop("video-aspect-override", root.aspect); } } }
                        Line { label: "Crop"; hint: "Pan & scan to fill";
                            Dropdown { width: 170px; options: ["Default", "Fill 50%", "Fill"]; value: root.panscan >= 99 ? "Fill" : root.panscan >= 1 ? "Fill 50%" : "Default";
                                selected(i, o) => { root.panscan = i * 50; root.set-prop("panscan", i * 0.5); } } }
                    }
                    Group { title: "Rendering";
                        Line { label: "HDR"; hint: "Tone mapping";
                            Dropdown { width: 170px; options: ["Auto", "Passthrough", "Tone-map to SDR"]; value: root.hdr;
                                selected(i, o) => { root.hdr = o; root.set-prop("target-colorspace-hint", i == 1 ? "yes" : "no"); root.set-prop("tone-mapping", i == 2 ? "bt.2390" : "auto"); } } }
                        Line { label: "Hardware Decoding";
                            Segmented { width: 170px; options: ["Auto", "Off"]; value: root.hwdec == "no" ? "Off" : "Auto";
                                selected(o) => { root.set-prop("hwdec", o == "Off" ? "no" : "auto-safe"); } } }
                    }
                    Group { title: "Filters";
                        VideoFilters { }
                    }
                    PresetCard { name: root.preset-name; save => { root.save-preset(); } }
                    AdvancedLink { clicked => { root.open-settings(5); } }
                }
                // ---- Audio ----
                if root.tab == 1: VerticalLayout {
                    spacing: 6px; alignment: start;
                    Group { first: true; title: "Track";
                        OptionList { items: root.audio-tracks; empty-text: "No audio tracks"; pick(it) => { root.set-prop("aid", it.key); } }
                        Line { label: "Stereo Mode";
                            Dropdown { width: 170px; options: ["Auto", "Stereo", "Mono", "Swap L/R"]; value: root.stereo;
                                selected(i, o) => {
                                    root.stereo = o;
                                    root.set-prop("audio-channels", i == 1 ? "stereo" : i == 2 ? "mono" : "auto-safe");
                                    root.run("af remove @stereo");
                                    if (i == 3) { root.run("af add @stereo:lavfi=[pan=stereo|c0=c1|c1=c0]"); }
                                } } }
                    }
                    Group { title: "Output Device";
                        OptionList { items: root.audio-devices; pick(it) => { root.set-prop("audio-device", it.key); } }
                    }
                    Group { title: "Synchronization";
                        SliderRow { label: "Audio Delay"; unit: " s"; decimals: 2; minimum: -2; maximum: 2; step: 0.05;
                            value <=> root.audio-delay; changed(v) => { root.set-prop("audio-delay", v); } }
                        SliderRow { label: "Volume Boost"; unit: "%"; minimum: 0; maximum: 150; default-value: 100;
                            value <=> root.boost; changed(v) => { root.set-prop("volume", round(v)); } }
                    }
                    Group { title: "Equalizer";
                        Equalizer { }
                    }
                    Group { title: "Effects";
                        AudioEffects { }
                    }
                    PresetCard { name: root.preset-name; save => { root.save-preset(); } }
                    AdvancedLink { clicked => { root.open-settings(6); } }
                }
                // ---- Subtitles ----
                if root.tab == 0: VerticalLayout {
                    spacing: 6px; alignment: start;
                    Group { first: true; title: "Track";
                        OptionList {
                            items: [{ key: "no", label: "Off", selected: false }];
                            pick(it) => { root.set-prop("sid", it.key); }
                        }
                        OptionList { items: root.sub-tracks; empty-text: "No subtitle tracks"; pick(it) => { root.set-prop("sid", it.key); } }
                        HorizontalLayout { spacing: 8px;
                            Button { horizontal-stretch: 1; text: "Add file…"; icon: @image-url("../assets/icons/add.svg"); clicked => { root.load-sub(); } }
                            if root.subs-enabled: Button { horizontal-stretch: 1; text: "Find online…"; icon: @image-url("../assets/icons/search.svg"); clicked => { root.find-subs(); } }
                        }
                        if root.subs-has-pick: Line { label: "OpenSubtitles Pick"; hint: root.subs-pick-label;
                            Button { width: 86px; text: "Forget"; icon: @image-url("../assets/icons/close.svg"); clicked => { root.subs("forget", ""); } } }
                    }
                    if root.subs-enabled: Group { title: "Offset";
                        Line { label: "Offset"; hint: "Saved per file";
                            HorizontalLayout { spacing: 4px;
                                for d in [-1, -0.1]: Rectangle { width: 40px; height: 26px; border-radius: 5px; background: soa.has-hover ? Field.raised : Field.fill;
                                    Text { text: d; font-size: 11px; color: Theme.fg-a2; horizontal-alignment: center; vertical-alignment: center; }
                                    soa := TouchArea { mouse-cursor: pointer; clicked => { root.subs("offset", d); } } }
                                Rectangle { width: 64px; height: 26px; border-radius: 5px; background: Field.fill;
                                    Text { text: root.subs-offset; font-family: "DM Mono"; font-size: 12px; color: root.subs-offset == "0.0 s" ? Theme.fg-2 : Theme.accent; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { mouse-cursor: pointer; double-clicked => { root.subs("offset", "reset"); } } }
                                for d in [0.1, 1]: Rectangle { width: 40px; height: 26px; border-radius: 5px; background: sob.has-hover ? Field.raised : Field.fill;
                                    Text { text: "+" + d; font-size: 11px; color: Theme.fg-a2; horizontal-alignment: center; vertical-alignment: center; }
                                    sob := TouchArea { mouse-cursor: pointer; clicked => { root.subs("offset", d); } } }
                            } }
                        Text { text: "Z / X ±0.1 s, Shift ±1 s · Lyrics keep [ ]"; color: Theme.fg-a3; font-size: 11px; }
                        HorizontalLayout { spacing: 8px;
                            Button { horizontal-stretch: 1; text: "Reset offset"; icon: @image-url("../assets/icons/refresh.svg"); clicked => { root.subs("offset", "reset"); } }
                            Button { horizontal-stretch: 1; text: root.subs-sync ? "Auto-sync to audio" : "Auto-sync (plugin)"; icon: @image-url("../assets/icons/waveform-twotone.svg"); clicked => { root.subs("sync", ""); } }
                        }
                    }
                    Group { title: "Synchronization";
                        SliderRow { label: "Delay"; unit: " s"; decimals: 2; minimum: -10; maximum: 10; step: 0.05;
                            value <=> root.sub-delay; changed(v) => { root.set-prop("sub-delay", v); } }
                        HorizontalLayout {
                            Text { text: "−10 s"; color: Theme.fg-a3; font-size: 11px; horizontal-stretch: 1; }
                            Text { text: "0 s"; color: Theme.fg-a3; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: center; }
                            Text { text: "+10 s"; color: Theme.fg-a3; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: right; }
                        }
                        SliderRow { label: "Speed"; unit: "×"; decimals: 2; minimum: 0.5; maximum: 2; step: 0.01; default-value: 1;
                            value <=> root.sub-speed; changed(v) => { root.set-prop("sub-speed", v); } }
                    }
                    Group { title: "Appearance";
                        SliderRow { label: "Size"; unit: "×"; decimals: 2; minimum: 0.5; maximum: 2.5; step: 0.05; default-value: 1;
                            value <=> root.sub-scale; changed(v) => { root.set-prop("sub-scale", v); } }
                        SliderRow { label: "Position"; unit: "%"; minimum: 0; maximum: 150; default-value: 100;
                            value <=> root.sub-pos; changed(v) => { root.set-prop("sub-pos", round(v)); } }
                        Line { label: "Override Embedded Style"; hint: "Force these settings on ASS subs";
                            Toggle { on: root.sub-ass-override; toggled => { root.sub-ass-override = !root.sub-ass-override; root.set-prop("sub-ass-override", root.sub-ass-override ? "force" : "scale"); } } }
                        Line { label: "Font";
                            TextField { width: 170px; text <=> root.sub-font; placeholder: "Inter"; accepted(t) => { root.set-prop("sub-font", t); } } }
                        Line { label: "Text Color";
                            ColorField { value <=> root.sub-color; accepted(t) => { root.set-prop("sub-color", t); } } }
                        Line { label: "Outline Color";
                            ColorField { value <=> root.sub-outline-color; accepted(t) => { root.set-prop("sub-border-color", t); } } }
                    }
                    PresetCard { name: root.preset-name; save => { root.save-preset(); } }
                    AdvancedLink { clicked => { root.open-settings(7); } }
                }
                // ---- Bookmarks ----
                if root.tab == 6: VerticalLayout {
                    spacing: 4px; alignment: start;
                    ListHeader {
                        text: root.bookmarks.length + (root.bookmarks.length == 1 ? " Bookmark" : " Bookmarks");
                        show-minus: root.bookmarks.length > 0;
                        minus => { root.remove-bookmark(); } plus => { root.add-bookmark(); }
                    }
                    if root.bookmarks.length == 0: Text { text: "No bookmarks yet — press + or Ctrl+B."; color: Theme.fg-a3; wrap: word-wrap; }
                    for it in root.bookmarks: TimeRow {
                        title: it.label; time: TimeFmt.hms(it.key.to-float(), true);
                        clicked => { root.seek-to(it.key); }
                    }
                }
                // ---- Chapters ----
                if root.tab == 7: VerticalLayout {
                    spacing: 2px; alignment: start;
                    if root.chapters.length == 0: Text { text: "No chapters in this file."; color: Theme.fg-a3; }
                    for it[i] in root.chapters: crow := Rectangle {
                        property <bool> thumb: i < root.chapter-has-thumb.length && root.chapter-has-thumb[i];
                        height: self.thumb ? 52px : 38px;
                        border-radius: Theme.radius;
                        background: cta.has-hover ? Theme.bg-a1 : (it.selected ? Theme.accent-bg.with-alpha(0.5) : transparent);
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 12px;
                            Text { width: 22px; text: i + 1; color: Theme.accent; font-family: "DM Mono"; font-size: 13px; vertical-alignment: center; }
                            if crow.thumb: Rectangle {
                                y: 6px; width: 71px; height: 40px; border-radius: 3px; clip: true; background: #000000;
                                Image { width: parent.width; height: parent.height; source: root.chapter-thumbs[i]; image-fit: ImageFit.cover; }
                            }
                            Text { text: it.label; overflow: elide; vertical-alignment: center; horizontal-stretch: 1;
                                color: it.selected ? Theme.accent-bright : Theme.fg-2; }
                            Text { text: i < root.chapter-times.length ? root.chapter-times[i] : ""; color: Theme.fg-a3; font-family: "DM Mono"; font-size: 12px; vertical-alignment: center; }
                        }
                        cta := TouchArea { mouse-cursor: pointer; clicked => { root.set-prop("chapter", it.key); } }
                    }
                }
                // ---- Compact library ----
                if root.tab == 5: VerticalLayout {
                    spacing: 10px; alignment: start;
                    LineEdit { placeholder-text: "Search library"; edited(t) => { root.library-search(t); } }
                    if root.library.length == 0: Text { text: "No matching files. Folders are set in Settings → Library."; color: Theme.fg-a3; wrap: word-wrap; }
                    for it in root.library: Rectangle {
                        height: 34px; border-radius: Theme.radius;
                        background: lta.has-hover ? Theme.bg-a1 : transparent;
                        lta := TouchArea { mouse-cursor: pointer; clicked => { root.library-play(it.key); } }
                        HorizontalLayout {
                            padding-left: 8px; spacing: 6px;
                            Text { text: it.label; color: Theme.fg-2; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            Rectangle { width: 30px;
                                Icon { source: @image-url("../assets/icons/add.svg"); width: 16px; height: 34px; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.library-enqueue(it.key); } } }
                        }
                    }
                }
                // ---- Queue & playlists (Figma "Miniplayer", "playlist", "new playlist") ----
                if root.tab == 4: VerticalLayout {
                    spacing: 14px; alignment: start;
                    ListHeader {
                        text: root.queue.length + (root.queue.length == 1 ? " Item" : " Items") + " in Queue";
                        minus-tip: "Clear queue"; plus-tip: "Add files";
                        minus => { root.queue-clear(); } plus => { root.queue-add(); }
                    }
                    if root.queue.length == 0: Text { text: "Queue is empty — add files or drop them on the window."; color: Theme.fg-a3; wrap: word-wrap; }
                    VerticalLayout {
                        spacing: 2px; alignment: start;
                        for it[i] in root.queue: QueueRow {
                            it: it; index: i;
                            play(n) => { root.queue-play(n); }
                            move(n, d) => { root.queue-move(n, d); }
                            remove(n) => { root.queue-remove(n); }
                        }
                    }
                    Section { text: "Save queue as playlist"; }
                    HorizontalLayout {
                        spacing: 6px;
                        name := LineEdit { placeholder-text: "Playlist name"; horizontal-stretch: 1; }
                        Button { width: 80px; text: "Save"; icon: @image-url("../assets/icons/save.svg"); clicked => { root.playlist-save(name.text); name.text = ""; } }
                    }
                    Section { text: "Playlists"; }
                    if root.playlists.length == 0: Text { text: "No saved playlists"; color: Theme.fg-a3; }
                    for pl in root.playlists: Rectangle {
                        height: 34px; border-radius: Theme.radius;
                        background: pta.has-hover ? Theme.bg-a1 : transparent;
                        pta := TouchArea { mouse-cursor: pointer; clicked => { root.playlist-load(pl.key); } }
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 4px; spacing: 8px;
                            Icon { source: @image-url("../assets/icons/playlist.svg"); width: 18px; height: 34px; }
                            Text { text: pl.label; color: Theme.fg-2; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Rectangle { width: 24px;
                                Icon { source: @image-url("../assets/icons/close.svg"); width: 14px; height: 34px; tint: Theme.fg-a3; }
                                TouchArea { clicked => { root.playlist-delete(pl.key); } } }
                        }
                    }
                }
            }
        }
    }
}
