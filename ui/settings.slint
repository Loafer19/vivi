// Settings window per the Figma frames "Settings - General/Interface/…/Extensions"
// (docs/design/frames/settings-*.png): search + grouped sidebar, section headers,
// rows built from the reusable controls in controls.slint.
import { ScrollView } from "std-widgets.slint";
import { Theme, Icon } from "theme.slint";
import { Dropdown, Toggle, AccentSlider, Segmented, TextField, PathField, FlatButton, AdvancedBar, Field } from "controls.slint";

export struct SettingRow {
    id: string,
    category: string,
    title: string,
    info: string,
    // "toggle" | "choice" | "segmented" | "slider" | "text" | "path" | "action" | "key"
    // | "color" | "header" | "info" | "advanced" (the collapsible bar)
    // | "plugin" (Extensions card: title = name, info = description, value = enabled,
    //   options = [version, author, icon key, source]) | "secret" (hidden text)
    // | "buttons" (title/info + one button per label; clicked label is the value)
    // | "package" (catalog card: title = name, info = description, value = "confirm"
    //   while the permission prompt is open, options = [version, author, icon key,
    //   permissions, state, size], labels = buttons)
    kind: string,
    value: string,
    options: [string],
    swatches: [color],
    labels: [string],
    minimum: float,
    maximum: float,
    step: float,
    enabled: bool,
}

// Plugin manifest icon key → icon (see src/plugins Manifest::icon).
global PluginIcons {
    pure public function get(key: string) -> image {
        if (key == "visualizer") { return @image-url("../assets/icons/spectrum-twotone.svg"); }
        if (key == "skip") { return @image-url("../assets/icons/next.svg"); }
        if (key == "lyrics") { return @image-url("../assets/icons/music.svg"); }
        if (key == "subtitles") { return @image-url("../assets/icons/subtitles.svg"); }
        if (key == "script") { return @image-url("../assets/icons/file.svg"); }
        if (key == "loop") { return @image-url("../assets/icons/repeat-right.svg"); }
        if (key == "stats") { return @image-url("../assets/icons/spectometer-twotone.svg"); }
        if (key == "tag") { return @image-url("../assets/icons/edit.svg"); }
        if (key == "free-music") { return @image-url("../assets/icons/album.svg"); }
        if (key == "streams") { return @image-url("../assets/icons/streaming.svg"); }
        if (key == "discord") { return @image-url("../assets/icons/profile.svg"); }
        if (key == "remote") { return @image-url("../assets/icons/capture-device.svg"); }
        if (key == "scrobble") { return @image-url("../assets/icons/favorite-twotone.svg"); }
        if (key == "night") { return @image-url("../assets/icons/volume-high.svg"); }
        if (key == "eq") { return @image-url("../assets/icons/eq.svg"); }
        if (key == "chapters") { return @image-url("../assets/icons/chapters-twotone.svg"); }
        @image-url("../assets/icons/plugins.svg")
    }
}

// Extensions card: icon, name, version · author · source, description and ON/OFF.
// clip + max-height keep long descriptions inside the fixed-height row.
component PluginCard inherits Rectangle {
    in property <SettingRow> setting;
    callback changed(string, string);
    property <bool> on: setting.value == "true";
    border-radius: 8px;
    background: Theme.bg-a3;
    border-width: 1px; border-color: on ? Theme.accent.with-alpha(0.35) : transparent;
    clip: true;
    HorizontalLayout {
        padding: 12px; spacing: 12px;
        VerticalLayout { alignment: center;
            Rectangle {
                width: 40px; height: 40px; border-radius: 8px;
                background: on ? Theme.accent.mix(Field.fill, 25%) : Field.raised;
                Icon { width: 22px; height: 22px; source: PluginIcons.get(setting.options[2]); tint: on ? Theme.accent : Theme.fg-a2; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 3px;
            HorizontalLayout { spacing: 8px;
                Text {
                    text: setting.title; color: Theme.fg-1; font-size: 14px; font-weight: 600;
                    overflow: elide; horizontal-stretch: 1;
                }
                Text {
                    text: (setting.options[0] != "" ? "v" + setting.options[0] + "  ·  " : "") + (setting.options[1] != "" ? setting.options[1] + "  ·  " : "") + setting.options[3];
                    color: Theme.fg-a3; font-size: 11px; vertical-alignment: center; font-family: "DM Mono";
                    overflow: elide;
                }
            }
            // Exactly 2 lines at 12px. Wrapped text reports its full height as the layout
            // minimum, so a bare Text grew past the card and painted over the next row;
            // the fixed-height clipping box keeps long descriptions inside the card.
            Rectangle {
                height: 32px; clip: true;
                Text {
                    x: 0; y: 0; width: parent.width; height: 32px;
                    text: setting.info; color: Theme.fg-a2; font-size: 12px;
                    wrap: word-wrap; overflow: elide; vertical-alignment: top;
                }
            }
        }
        VerticalLayout { alignment: center;
            Toggle { on: root.on; toggled => { root.changed(setting.id, root.on ? "false" : "true"); } }
        }
    }
}

// Catalog card (Extensions → Browse): icon, name, meta, description, permissions and
// Install / Update / Uninstall buttons, or the permission prompt.
// clip + capped description/meta keep long catalog copy inside the card.
component PackageCard inherits Rectangle {
    in property <SettingRow> setting;
    callback changed(string, string);
    property <bool> confirm: setting.value == "confirm";
    border-radius: 8px;
    background: Theme.bg-a3;
    border-width: 1px; border-color: confirm ? Theme.accent : transparent;
    clip: true;
    HorizontalLayout {
        padding: 12px; spacing: 12px;
        VerticalLayout { alignment: center;
            Rectangle {
                width: 40px; height: 40px; border-radius: 8px; background: Field.raised;
                Icon { width: 22px; height: 22px; source: PluginIcons.get(setting.options[2]); tint: Theme.accent; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 3px;
            HorizontalLayout { spacing: 8px;
                Text {
                    text: setting.title; color: Theme.fg-1; font-size: 14px; font-weight: 600;
                    overflow: elide; horizontal-stretch: 1;
                }
                Text {
                    text: "v" + setting.options[0] + "  ·  " + setting.options[1] + "  ·  " + setting.options[5];
                    color: Theme.fg-a3; font-size: 11px; vertical-alignment: center; font-family: "DM Mono";
                    overflow: elide;
                }
            }
            Rectangle {  // 2 lines, clipped (see PluginCard)
                height: 32px; clip: true;
                Text {
                    x: 0; y: 0; width: parent.width; height: 32px;
                    text: setting.info; color: Theme.fg-a2; font-size: 12px;
                    wrap: word-wrap; overflow: elide; vertical-alignment: top;
                }
            }
            Text {
                text: root.confirm ? setting.options[4] : setting.options[3] + (setting.options[4] != "" ? "  ·  " + setting.options[4] : "");
                color: root.confirm ? Theme.fg-1 : Theme.fg-a3; font-size: 11px;
                wrap: word-wrap; overflow: elide; height: 16px;
            }
        }
        VerticalLayout { alignment: center; spacing: 4px;
            for l in setting.labels: FlatButton { text: l; enabled: setting.enabled; clicked => { root.changed(setting.id, l); } }
        }
    }
}

component Info inherits Rectangle {
    in property <string> text;
    width: 18px; height: 18px;
    Icon { source: @image-url("../assets/icons/info.svg"); width: 16px; height: 16px; tint: ta.has-hover ? Theme.accent : Theme.fg-a3; }
    ta := TouchArea { }
    if ta.has-hover: Rectangle {
        x: 24px; y: -6px; z: 10;
        width: 280px; height: tip.preferred-height + 16px;
        background: Theme.bg-a1; border-radius: Theme.radius; border-width: 1px; border-color: Theme.divider;
        tip := Text { x: 8px; y: 8px; width: parent.width - 16px; text: root.text; wrap: word-wrap; color: Theme.fg-1; font-size: 12px; }
    }
}

component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    callback clicked();
    width: 30px; height: 30px; border-radius: 4px;
    background: selected ? Theme.accent.mix(Field.fill, 30%) : transparent;
    Rectangle { width: 18px; height: 18px; border-radius: 2px; background: root.swatch; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Row inherits Rectangle {
    in property <SettingRow> setting;
    in-out property <bool> advanced;
    callback changed(string, string);
    callback advanced-toggled(bool);
    property <length> ctl-w: min(300px, root.width * 0.45);
    height: setting.kind == "plugin" ? 76px : setting.kind == "package" ? 104px : setting.kind == "header" ? 48px : setting.kind == "advanced" ? 56px : setting.kind == "slider" && setting.labels.length > 0 ? 58px : 42px;
    if setting.kind == "header": Text {
        x: 0; y: 20px; text: setting.title; color: Theme.fg-1; font-weight: 600; font-size: 15px;
    }
    if setting.kind == "advanced": AdvancedBar {
        y: 8px; width: parent.width; expanded <=> root.advanced;
        toggled(e) => { root.advanced-toggled(e); }
    }
    if setting.kind == "plugin": PluginCard {
        y: 6px; height: parent.height - 6px; width: parent.width;
        setting: root.setting;
        changed(id, v) => { root.changed(id, v); }
    }
    if setting.kind == "package": PackageCard {
        y: 6px; height: parent.height - 6px; width: parent.width;
        setting: root.setting;
        changed(id, v) => { root.changed(id, v); }
    }
    if setting.kind != "header" && setting.kind != "advanced" && setting.kind != "plugin" && setting.kind != "package": HorizontalLayout {
        spacing: 10px; padding-top: 5px; padding-bottom: 5px;
        HorizontalLayout {
            spacing: 6px; horizontal-stretch: 1; alignment: start;
            Text { text: setting.title; color: setting.enabled ? Theme.fg-a1 : Theme.fg-a3.with-alpha(0.6); font-size: 13px; vertical-alignment: center; overflow: elide; }
            if setting.info != "": VerticalLayout { alignment: center; Info { text: setting.info; } }
        }
        if setting.kind == "toggle": VerticalLayout { alignment: center;
            Toggle { on: setting.value == "true"; enabled: setting.enabled; toggled => { root.changed(setting.id, setting.value == "true" ? "false" : "true"); } } }
        if setting.kind == "choice": VerticalLayout { alignment: center;
            Dropdown { width: root.ctl-w; options: setting.options; value: setting.value; selected(i, o) => { root.changed(setting.id, o); } } }
        if setting.kind == "segmented": VerticalLayout { alignment: center;
            Segmented { width: root.ctl-w; options: setting.options; value: setting.value; enabled: setting.enabled; selected(o) => { root.changed(setting.id, o); } } }
        if setting.kind == "color": VerticalLayout { alignment: center;
            Rectangle { width: root.ctl-w; height: 34px; border-radius: 6px; background: Field.fill;
                HorizontalLayout { padding: 2px; alignment: space-between;
                    for o[i] in setting.options: Swatch { swatch: setting.swatches[i]; selected: o == setting.value; clicked => { root.changed(setting.id, o); } } } } }
        if setting.kind == "text": VerticalLayout { alignment: center;
            TextField {
                width: root.ctl-w; text: setting.value; enabled: setting.enabled;
                placeholder: setting.options.length > 0 ? setting.options[0] : "";
                accepted(t) => { root.changed(setting.id, t); }
                edited(t) => { root.changed(setting.id, t); }
            } }
        if setting.kind == "secret": VerticalLayout { alignment: center;
            TextField {
                width: root.ctl-w; text: setting.value; enabled: setting.enabled; password: true;
                placeholder: "Not set";
                accepted(t) => { root.changed(setting.id, t); }
                edited(t) => { root.changed(setting.id, t); }
            } }
        if setting.kind == "path": VerticalLayout { alignment: center;
            PathField {
                width: root.ctl-w; text: setting.value; enabled: setting.enabled;
                edited(t) => { root.changed(setting.id, t); }
                browse => { root.changed(setting.id, "::browse"); }
            } }
        if setting.kind == "slider": HorizontalLayout {
            spacing: 10px; width: root.ctl-w;
            VerticalLayout { alignment: center; horizontal-stretch: 1;
                AccentSlider {
                    value: setting.value.to-float(); minimum: setting.minimum; maximum: setting.maximum; step: setting.step;
                    labels: setting.labels; enabled: setting.enabled;
                    changed(v) => { root.changed(setting.id, v); }
                } }
            if setting.labels.length == 0: Text { width: 44px; text: round(setting.value.to-float() * 100) / 100; color: Theme.fg-a2; font-family: "DM Mono"; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
        }
        if setting.kind == "buttons": HorizontalLayout { alignment: end; spacing: 4px;
            for l in setting.labels: VerticalLayout { alignment: center;
                FlatButton { text: l; enabled: setting.enabled; clicked => { root.changed(setting.id, l); } } } }
        if setting.kind == "action": VerticalLayout { alignment: center;
            FlatButton { text: setting.value; enabled: setting.enabled; clicked => { root.changed(setting.id, "run"); } } }
        if setting.kind == "key": HorizontalLayout { spacing: 4px; alignment: end; padding-top: 4px; padding-bottom: 4px;
            Rectangle {
                width: kt.preferred-width + 16px; border-radius: Theme.radius; background: Field.fill;
                kt := Text { text: setting.value; color: Theme.fg-2; font-family: "DM Mono"; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
            }
        }
    }
}

export component SettingsDialog inherits Rectangle {
    in property <[string]> categories;
    property <bool> narrow: root.width < 760px;
    in property <[SettingRow]> rows;
    in-out property <int> category: 0;
    in-out property <bool> advanced: false;
    in property <string> status;
    in-out property <string> search;
    callback changed(string, string);
    callback refresh(int, string, bool); // category, search, advanced
    callback close();
    // Sidebar icons and group labels, in category order (see settings.rs CATEGORIES).
    property <[image]> icons: [
        @image-url("../assets/icons/preferences.svg"), @image-url("../assets/icons/interface.svg"),
        @image-url("../assets/icons/privacy.svg"), @image-url("../assets/icons/hotkeys.svg"),
        @image-url("../assets/icons/playback.svg"), @image-url("../assets/icons/video.svg"),
        @image-url("../assets/icons/audio.svg"), @image-url("../assets/icons/subtitles.svg"),
        @image-url("../assets/icons/folder.svg"), @image-url("../assets/icons/streaming.svg"),
        @image-url("../assets/icons/speed.svg"), @image-url("../assets/icons/record.svg"),
        @image-url("../assets/icons/plugins.svg"),
    ];
    function group(i: int) -> string {
        i == 0 ? "App" : i == 4 ? "Media" : i == 9 ? "System" : ""
    }
    function go(i: int) { root.search = ""; root.category = i; root.advanced = false; root.refresh(i, "", false); }

    background: #000000A0;
    TouchArea { clicked => { root.close(); } }

    dlg := Rectangle {
        width: root.narrow ? root.width - 16px : min(1048px, root.width - 48px);
        height: root.narrow ? root.height - 16px : min(865px, root.height - 48px);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        background: Theme.bg-a4; border-radius: 12px;
        border-width: 1px; border-color: Theme.bg-a1;
        clip: true;
        TouchArea { }
        HorizontalLayout {
            // Sidebar: search + grouped categories (a dropdown on narrow windows)
            if !root.narrow: Rectangle {
                width: 240px; background: Theme.bg-b1;
                VerticalLayout {
                    padding: 8px; spacing: 8px;
                    Rectangle {
                        height: 40px; border-radius: 6px; background: Theme.bg-a3;
                        Icon { x: 10px; width: 20px; height: 20px; source: @image-url("../assets/icons/search.svg"); tint: Theme.fg-a3; }
                        TextField {
                            x: 30px; width: parent.width - 34px; height: parent.height; background: transparent;
                            text <=> root.search; placeholder: "Search";
                            edited(t) => { root.refresh(root.category, t, root.advanced); }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1; border-radius: 6px; background: Theme.bg-a3;
                        Flickable {
                            VerticalLayout {
                                padding: 6px; spacing: 2px; alignment: start;
                                for c[i] in root.categories: VerticalLayout {
                                    spacing: 2px;
                                    if root.group(i) != "": Text {
                                        height: 36px; text: root.group(i); color: Theme.fg-a3; font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        height: 40px; border-radius: 6px;
                                        property <bool> sel: i == root.category && root.search == "";
                                        background: sel ? Theme.bg-a1 : (cta.has-hover ? Theme.bg-a1.mix(Theme.bg-a3, 50%) : transparent);
                                        Icon { x: 10px; width: 22px; height: 22px; source: root.icons[i]; tint: parent.sel ? Theme.accent : Theme.fg-a2; }
                                        Text {
                                            x: 46px; text: c; vertical-alignment: center; height: parent.height; font-size: 14px;
                                            color: parent.sel ? Theme.fg-1 : Theme.fg-a1;
                                        }
                                        cta := TouchArea { mouse-cursor: pointer; clicked => { root.go(i); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Content
            VerticalLayout {
                if root.narrow: HorizontalLayout {
                    padding: 8px; spacing: 8px;
                    Dropdown {
                        horizontal-stretch: 1;
                        options: root.categories;
                        value: root.categories[root.category];
                        selected(i, c) => { root.go(i); }
                    }
                    TextField {
                        horizontal-stretch: 1;
                        text <=> root.search;
                        placeholder: "Search";
                        edited(t) => { root.refresh(root.category, t, root.advanced); }
                    }
                }
                Rectangle {
                    height: 56px; background: Theme.bg-a3;
                    HorizontalLayout {
                        padding-left: 24px; padding-right: 12px; spacing: 10px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.search != "" ? "Results for “" + root.search + "”" : root.categories[root.category] + " Settings";
                            color: Theme.fg-1; font-size: 16px; vertical-alignment: center;
                        }
                        VerticalLayout { alignment: center;
                            Rectangle {
                                width: 32px; height: 32px; border-radius: Theme.radius;
                                background: xta.has-hover ? Theme.bg-a1 : transparent;
                                Icon { source: @image-url("../assets/icons/close.svg"); width: 18px; height: 18px; }
                                xta := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
                            } }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start; padding-left: 24px; padding-right: 24px; padding-bottom: 24px;
                        if root.rows.length == 0: Text { height: 40px; vertical-alignment: center; text: "No matching settings."; color: Theme.fg-a3; }
                        for r in root.rows: Row {
                            setting: r; advanced: root.advanced;
                            changed(id, v) => { root.changed(id, v); }
                            advanced-toggled(e) => { root.advanced = e; root.refresh(root.category, root.search, e); }
                        }
                    }
                }
                if root.status != "": Text { height: 24px; horizontal-alignment: center; text: root.status; color: Theme.fg-a3; font-size: 12px; }
            }
        }
    }
}
