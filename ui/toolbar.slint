// Bottom-bar customization per Figma "Player - customize" and "Profiles".
import { Theme, Metrics, Icon, TriIcon } from "core/theme.slint";
import { Modal } from "core/modal.slint";
import { PrimaryButton, SecondaryButton } from "core/buttons.slint";
import { BarStyle, Bars, VolumeStyle } from "core/types.slint";
import { EdgeFades } from "core/controls.slint";
import { Icons } from "core/icons.slint";
import { ToolMeta } from "state/customize.slint";

export global Tools {
    // Icon name (TriIcon / IconButton `duo`) of a bar item.
    public pure function duo(id: string) -> string {
        if id == "prev" { return "previous"; }
        if id == "time" || id == "duration" { return "recent"; }
        if id == "seek" { return "playback"; }
        if id == "spacer" { return "divider"; }
        if id == "volume" { return "volume-high"; }
        if id == "video" { return "playback_settings"; }
        if id == "back10" { return "backward-10-sec"; }
        if id == "fwd10" { return "forward-10-sec"; }
        if id == "repeat" { return "repeat-right"; }
        if id == "shuffle" { return "shuffle-right"; }
        if id == "play" || id == "next" || id == "queue" || id == "subtitles" || id == "audio" || id == "speed"
            || id == "chapters" || id == "bookmark" || id == "stop" || id == "snapshot" || id == "settings"
            || id == "fullscreen" { return id; }
        return "more";
    }
    public pure function label(id: string) -> string {
        if id == "prev" { return "Previous"; }
        if id == "play" { return "Play / pause"; }
        if id == "next" { return "Next"; }
        if id == "time" { return "Elapsed time"; }
        if id == "duration" { return "Total time"; }
        if id == "seek" { return "Seekbar"; }
        if id == "spacer" { return "Flexible space"; }
        if id == "queue" { return "Queue"; }
        if id == "subtitles" { return "Subtitles"; }
        if id == "audio" { return "Audio"; }
        if id == "volume" { return "Volume"; }
        if id == "video" { return "Video"; }
        if id == "speed" { return "Playback speed"; }
        if id == "chapters" { return "Chapters"; }
        if id == "bookmark" { return "Bookmark"; }
        if id == "back10" { return "Backward 10s"; }
        if id == "fwd10" { return "Forward 10s"; }
        if id == "stop" { return "Stop"; }
        if id == "snapshot" { return "Snapshot"; }
        if id == "repeat" { return "Repeat"; }
        if id == "shuffle" { return "Shuffle"; }
        if id == "settings" { return "Settings"; }
        if id == "fullscreen" { return "Fullscreen"; }
        if id == "|" { return "Play controls"; }
        return id;
    }
    // Tile caption in Customize (fits 76px); tooltips keep the full label.
    public pure function short(id: string) -> string {
        if id == "back10" { return "Back 10s"; }
        if id == "fwd10" { return "Fwd 10s"; }
        if id == "spacer" { return "Space"; }
        if id == "speed" { return "Speed"; }
        if id == "time" { return "Elapsed"; }
        if id == "duration" { return "Total"; }
        if id == "play" { return "Play"; }
        return Tools.label(id);
    }
}

component Glyph inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    width: 20px; height: 24px; border-radius: Metrics.radius-sm;
    background: ta.has-hover && enabled ? Theme.divider : transparent;
    Text { text: root.text; color: enabled ? Theme.fg-1 : Theme.fg-a3; font-size: Metrics.font-base; vertical-alignment: center; horizontal-alignment: center; }
    ta := TouchArea { mouse-cursor: enabled ? pointer : default; clicked => { if (root.enabled) { root.clicked(); } } }
}

// One placed item: icon with move/remove controls and a hover label.
component Placed inherits Rectangle {
    in property <string> id;
    // A plugin button's label / icon key (empty label = built-in item).
    in property <ToolMeta> meta;
    property <bool> plug: root.meta.label != "";
    in property <bool> first;
    in property <bool> last;
    in property <int> index;
    in property <int> count;
    callback move(int);
    callback remove();
    // Tile pitch in the row (width + spacing), for drag-to-reorder.
    property <length> pitch: 82px;
    property <length> dx: hov.pressed ? hov.mouse-x - hov.pressed-x : 0;
    property <int> steps: clamp(round(root.dx / root.pitch), -root.index, root.count - 1 - root.index);
    width: 76px; height: 74px;
    z: hov.pressed ? 10 : 0;
    border-radius: Metrics.radius-md; background: Theme.bg-a1;
    border-width: 1px; border-color: hov.has-hover || hov.pressed ? Theme.accent : Theme.divider;
    // Drag shows an accent insertion marker where the tile will land.
    hov := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.steps != 0) {
                root.move(root.steps);
            }
        }
    }
    if hov.pressed && root.steps != 0: Rectangle {
        x: root.steps * root.pitch + (root.steps > 0 ? root.width + 2px : -4px); y: 4px;
        width: 2px; height: root.height - 8px; background: Theme.accent;
    }
    TriIcon { y: 7px; name: root.plug ? Icons.plugin-duo(root.meta.icon) : Tools.duo(root.id); width: 20px; height: 20px; tint: Theme.fg-1; }
    Text {
        x: 4px; y: 30px; width: parent.width - 8px; height: 16px;
        text: root.plug ? root.meta.label : Tools.short(root.id); color: Theme.fg-a2; font-size: Metrics.font-xs;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    HorizontalLayout {
        y: 47px; height: 24px; alignment: center; spacing: 1px;
        Glyph { text: "‹"; enabled: !root.first; clicked => { root.move(-1); } }
        Glyph { text: "×"; clicked => { root.remove(); } }
        Glyph { text: "›"; enabled: !root.last; clicked => { root.move(1); } }
    }
    if hov.has-hover: Rectangle {
        y: -28px; height: 24px; width: tl.preferred-width + 14px; z: 5;
        background: Theme.bg-a1; border-radius: Metrics.radius-sm; border-width: 1px; border-color: Theme.divider;
        tl := Text { text: root.plug ? root.meta.label : Tools.label(root.id); color: Theme.fg-1; font-size: Metrics.font-sm; vertical-alignment: center; horizontal-alignment: center; }
    }
}

component Zone inherits Rectangle {
    in property <string> title;
    in property <[string]> items;
    in property <[ToolMeta]> metas;
    in property <int> offset;
    in property <bool> lock-first;
    in property <bool> lock-last;
    callback move(int, int);
    callback remove(int);
    min-height: 102px; border-radius: Metrics.radius-md; background: Theme.bg-b1;
    preferred-width: row.preferred-width + 20px;
    Text { x: 12px; y: 6px; text: root.title; color: Theme.fg-a1; font-size: Metrics.font-xs; }
    if root.items.length == 0: Text { text: "Empty"; color: Theme.fg-a3; }
    row := HorizontalLayout {
        x: 10px; y: 22px; height: 74px; spacing: 6px; alignment: start;
        for id[i] in root.items: Placed {
            id: id;
            meta: i < root.metas.length ? root.metas[i] : { label: "", icon: "" };
            first: i == 0;
            last: i == root.items.length - 1;
            index: i; count: root.items.length;
            move(d) => { root.move(root.offset + i, d); }
            remove() => { root.remove(root.offset + i); }
        }
    }
}

// Miniature of a progress-bar style, drawn on its chip in Customize.
component BarPreview inherits Rectangle {
    in property <string> style;
    in property <brush> ink;    // track / controls
    in property <brush> fill;   // played part
    width: 28px; height: 14px;
    if root.style == "Compact": Rectangle {
        Rectangle { x: 0; y: 5px; width: 4px; height: 4px; border-radius: 2px; background: root.ink; }
        Rectangle { x: 7px; y: 6px; width: 14px; height: 2px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 7px; y: 6px; width: 6px; height: 2px; border-radius: 1px; background: root.fill; }
        Rectangle { x: 24px; y: 5px; width: 4px; height: 4px; border-radius: 2px; background: root.ink; }
    }
    if root.style == "Classic": Rectangle {
        Rectangle { x: 0; y: 2px; width: 28px; height: 2px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 0; y: 2px; width: 11px; height: 2px; border-radius: 1px; background: root.fill; }
        for cx in [0px, 6px, 12px, 24px]: Rectangle { x: cx; y: 8px; width: 4px; height: 4px; border-radius: 2px; background: root.ink; }
    }
    if root.style == "Waveform": Rectangle {
        for h[i] in [4px, 8px, 12px, 6px, 10px, 5px, 9px]: Rectangle {
            x: i * 4px; y: (14px - h) / 2; width: 2px; height: h; border-radius: 1px;
            background: i < 3 ? root.fill : root.ink;
        }
    }
    if root.style == "Plain": Rectangle {
        Rectangle { x: 0; y: 12px; width: 28px; height: 1px; background: root.ink; }
        Rectangle { x: 0; y: 12px; width: 10px; height: 1px; background: root.fill; }
    }
}

// Miniature of a volume control style for the Customize chips (small glyphs: single-tone).
component VolumePreview inherits Rectangle {
    in property <string> style;
    in property <brush> ink;
    in property <brush> fill;
    width: 28px; height: 14px;
    if root.style == "Cone": Path {
        width: 100%; height: 100%;
        viewbox-width: 28; viewbox-height: 14;
        fill: root.ink;
        MoveTo { x: 0; y: 6; } LineTo { x: 28; y: 0; } LineTo { x: 28; y: 14; } LineTo { x: 0; y: 8; } Close { }
    }
    if root.style == "Cone": Path {
        width: 100%; height: 100%;
        viewbox-width: 28; viewbox-height: 14;
        fill: root.fill;
        MoveTo { x: 0; y: 6; } LineTo { x: 17; y: 2.4; } LineTo { x: 17; y: 11.6; } LineTo { x: 0; y: 8; } Close { }
    }
    if root.style == "Bar": Rectangle {
        Rectangle { x: 0; y: 4px; width: 28px; height: 6px; border-radius: 3px; background: root.ink; }
        Rectangle { x: 0; y: 4px; width: 17px; height: 6px; border-radius: 3px; background: root.fill; }
    }
    if root.style == "Popup": Rectangle {
        Rectangle { x: 0; y: 5px; width: 6px; height: 6px; border-radius: 1px; background: root.ink; }
        Rectangle { x: 12px; y: 0; width: 4px; height: 14px; border-radius: 2px; background: root.ink; }
        Rectangle { x: 12px; y: 5px; width: 4px; height: 9px; border-radius: 2px; background: root.fill; }
    }
    if root.style == "Percent": Rectangle {
        Rectangle { x: 0; y: 4px; width: 6px; height: 6px; border-radius: 1px; background: root.ink; }
        Text { x: 9px; width: 19px; text: "%"; color: root.fill; font-size: Metrics.font-sm; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
    }
}

export component CustomizeDialog inherits Modal {
    in property <[string]> items;
    in property <[ToolMeta]> items-meta;
    in property <[ToolMeta]> available-meta;
    in property <[string]> styles;
    in property <BarStyle> bar-style;
    callback pick-style(string);
    in property <[string]> vol-styles;
    in property <VolumeStyle> vol-style;
    callback pick-volume(string);
    in property <[string]> available;
    in property <[string]> profiles;
    in property <string> profile;
    callback move(int, int);
    callback remove(int);
    callback add(string);
    callback pick-profile(string);
    callback save();
    callback cancel();

    card-width: 1000px;
    card-height: col.preferred-height;
    inset: 48px;
    lift: 72px;
    dismiss-on-scrim: false;
    col := VerticalLayout {
        padding: 22px; spacing: 14px;
        Text { text: "Customize Player"; color: Theme.fg-1; font-size: Metrics.font-xl; font-weight: 600; }
        Text {
            text: "Every element is movable: drag a tile (or use ‹ ›) to re-order the bottom bar (left → right) and × to remove an item. Click an item below to add it; buttons from your extensions come after the built-in items. The bar under this dialog is a live preview.";
            color: Theme.fg-a1; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px; alignment: start;
            Text { text: "Profile"; color: Theme.fg-2; vertical-alignment: center; }
            for p in root.profiles: Rectangle {
                accessible-role: button; accessible-label: "Profile: " + p;
                accessible-checked: p == root.profile;
                accessible-action-default => { root.pick-profile(p); }
                height: 30px; width: pt.preferred-width + 22px; border-radius: Metrics.radius-md;
                background: p == root.profile ? Theme.accent : (pta.has-hover ? Theme.divider : Theme.bg-a1);
                pt := Text { text: p; color: p == root.profile ? Theme.bg-b2 : Theme.fg-2; vertical-alignment: center; horizontal-alignment: center; }
                pta := TouchArea { mouse-cursor: pointer; clicked => { root.pick-profile(p); } }
            }
            if root.profile == "Custom": Rectangle {
                height: 30px; width: ct.preferred-width + 22px; border-radius: Metrics.radius-md; background: Theme.accent;
                ct := Text { text: "Custom"; color: Theme.bg-b2; vertical-alignment: center; horizontal-alignment: center; }
            }
        }
        HorizontalLayout {
            spacing: 8px; alignment: start;
            Text { text: "Progress bar"; color: Theme.fg-2; vertical-alignment: center; }
            for st[si] in root.styles: Rectangle {
                accessible-role: button; accessible-label: "Progress bar: " + stt.text;
                accessible-checked: si == Bars.index(root.bar-style);
                accessible-action-default => { root.pick-style(st); }
                height: 30px; width: stt.preferred-width + 28px + 30px; border-radius: Metrics.radius-md;
                background: si == Bars.index(root.bar-style) ? Theme.accent : (sta.has-hover ? Theme.divider : Theme.bg-a1);
                BarPreview {
                    x: 11px; y: (parent.height - self.height) / 2; style: st;
                    ink: si == Bars.index(root.bar-style) ? Theme.bg-b2 : Theme.fg-a2;
                    fill: si == Bars.index(root.bar-style) ? Theme.bg-b2 : Theme.accent;
                }
                stt := Text {
                    x: 11px + 28px + 8px; width: self.preferred-width;
                    text: st == "Compact" ? "Compact inline" : st == "Classic" ? "Classic (full width on top)" : st == "Waveform" ? "Waveform (audio)" : "Plain thin";
                    color: si == Bars.index(root.bar-style) ? Theme.bg-b2 : Theme.fg-2; vertical-alignment: center; horizontal-alignment: center;
                }
                sta := TouchArea { mouse-cursor: pointer; clicked => { root.pick-style(st); } }
            }
        }
        HorizontalLayout {
            spacing: 8px; alignment: start;
            Text { text: "Volume"; color: Theme.fg-2; vertical-alignment: center; }
            for vs[vi] in root.vol-styles: Rectangle {
                property <bool> on: vi == Bars.volume-index(root.vol-style);
                accessible-role: button; accessible-label: "Volume control: " + vt.text;
                accessible-checked: self.on;
                accessible-action-default => { root.pick-volume(vs); }
                height: 30px; width: vt.preferred-width + 28px + 30px; border-radius: Metrics.radius-md;
                background: self.on ? Theme.accent : (vta.has-hover ? Theme.divider : Theme.bg-a1);
                VolumePreview {
                    x: 11px; y: (parent.height - self.height) / 2; style: vs;
                    ink: parent.on ? Theme.bg-b2 : Theme.fg-a2;
                    fill: parent.on ? Theme.bg-b2 : Theme.accent;
                }
                vt := Text {
                    x: 11px + 28px + 8px; width: self.preferred-width;
                    text: vs == "Cone" ? "Cone" : vs == "Bar" ? "Flat bar" : vs == "Popup" ? "Pop-up slider" : "Icon + percent";
                    color: parent.on ? Theme.bg-b2 : Theme.fg-2; vertical-alignment: center; horizontal-alignment: center;
                }
                vta := TouchArea { mouse-cursor: pointer; clicked => { root.pick-volume(vs); } }
            }
        }
        Text { text: "In the player"; color: Theme.fg-1; font-weight: 600; }
        Rectangle {
            height: 104px;
            bar-fl := Flickable {
                interactive: false;
                content-width: max(self.width, zone.preferred-width);
                zone := Zone {
                    width: max(parent.width, self.preferred-width);
                    title: "BOTTOM BAR  (left → right)"; items: root.items; metas: root.items-meta; offset: 0;
                    move(i, d) => { root.move(i, d); }
                    remove(i) => { root.remove(i); }
                }
            }
            EdgeFades { viewport-x: bar-fl.content-x; viewport-width: bar-fl.content-width; base: Theme.bg-b1; }
        }
        Text { text: "Available items"; color: Theme.fg-1; font-weight: 600; }
        Rectangle {
            height: 76px; border-radius: Metrics.radius-md;
            border-width: 1px; border-color: Theme.divider;
            if root.available.length == 0: Text { text: "Every item is already in the player."; color: Theme.fg-a3; }
            av-fl := Flickable {
                x: 1px; width: parent.width - 2px;
                content-width: max(self.width, av-row.preferred-width + 20px);
                av-row := HorizontalLayout {
                x: 10px; y: 10px; height: 56px; spacing: 6px; alignment: start;
                for id[ai] in root.available: Rectangle {
                    property <string> plabel: ai < root.available-meta.length ? root.available-meta[ai].label : "";
                    property <string> full: self.plabel != "" ? self.plabel : Tools.label(id);
                    height: 56px; width: 76px; border-radius: Metrics.radius-md;
                    background: ata.has-hover ? Theme.divider : Theme.bg-a1;
                    TriIcon { y: 8px; name: parent.plabel != "" ? Icons.plugin-duo(root.available-meta[ai].icon) : Tools.duo(id); width: 20px; height: 20px; tint: Theme.fg-1; }
                    Text {
                        x: 4px; y: 32px; width: parent.width - 8px; height: 16px;
                        text: parent.plabel != "" ? parent.plabel : Tools.short(id); color: Theme.fg-a2; font-size: Metrics.font-xs;
                        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                    }
                    ata := TouchArea { accessible-role: button; accessible-label: "Add " + parent.full; mouse-cursor: pointer; clicked => { root.add(id); } }
                    if ata.has-hover: Rectangle {
                        y: -30px; height: 24px; width: tl.preferred-width + 14px; z: 5;
                        background: Theme.bg-a1; border-radius: Metrics.radius-sm;
                        tl := Text { text: "Add " + (ai < root.available-meta.length && root.available-meta[ai].label != "" ? root.available-meta[ai].label : Tools.label(id)); color: Theme.fg-1; font-size: Metrics.font-sm; vertical-alignment: center; horizontal-alignment: center; }
                    }
                }
                }
            }
            EdgeFades {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                viewport-x: av-fl.content-x; viewport-width: av-fl.content-width; base: Theme.bg-a4;
            }
        }
        HorizontalLayout {
            spacing: 10px; alignment: end;
            SecondaryButton { text: "Cancel"; clicked => { root.cancel(); } }
            PrimaryButton { text: "Save"; clicked => { root.save(); } }
        }
    }
}
