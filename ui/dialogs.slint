// "Open Network Stream" and "New Playlist" dialogs per the Figma frame
// docs/design/frames/dialog-network-playlist.png.
import { Theme, Metrics, Icon } from "core/theme.slint";
import { TextField } from "core/controls.slint";
import { ScrollView } from "std-widgets.slint";
import { Modal } from "core/modal.slint";
import { PrimaryButton, SecondaryButton, ButtonSize } from "core/buttons.slint";

// Window chrome shared by both dialogs: dark title bar with the close cross.
component DialogFrame inherits Modal {
    in property <string> title;
    in property <length> dialog-width: 760px;
    callback close();
    card-width: root.dialog-width;
    card-height: col.preferred-height;
    card-background: Theme.surface;
    bordered: false;
    dismissed => { root.close(); }
    col := VerticalLayout {
        Rectangle {
            height: 40px; background: Theme.surface-head;
            HorizontalLayout {
                padding-left: 16px; padding-right: 8px;
                Text { text: root.title; color: Theme.fg-a2; font-size: Metrics.font-sm; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout { alignment: center;
                    Rectangle { width: 28px; height: 28px; border-radius: Metrics.radius-sm; background: cx.has-hover ? Theme.bg-a1 : transparent;
                        Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/close.svg"); tint: Theme.fg-a2; }
                        cx := TouchArea { accessible-role: button; accessible-label: "Close"; mouse-cursor: pointer; clicked => { root.close(); } } } }
            }
        }
        @children
    }
}

component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> extra;
    in property <string> hint;
    spacing: 8px;
    HorizontalLayout {
        spacing: 4px; alignment: start;
        Text { text: root.title; color: Theme.fg-1; font-size: Metrics.font-base; font-weight: 500; }
        if root.extra != "": Text { text: root.extra; color: Theme.fg-a3; font-size: Metrics.font-base; }
    }
    Text { text: root.hint; color: Theme.fg-a3; font-size: Metrics.font-sm; wrap: word-wrap; }
}

// Multi-line URL box; one link per line.
export component NetworkStreamDialog inherits Rectangle {
    in property <bool> ytdlp;
    in property <[string]> history;
    in property <string> error;
    in-out property <string> urls;
    in-out property <string> name;
    // urls (newline separated), optional playlist name
    callback submit(string, string);
    callback close();
    property <bool> has-urls: root.urls.character-count > 0;
    DialogFrame {
        title: "Open Network Stream"; dialog-width: 760px;
        close => { root.close(); }
        VerticalLayout {
            padding: 20px; padding-top: 18px; spacing: 18px;
            Heading {
                title: "Network URL";
                hint: "You can enter multiple links to load. http(s), HLS/DASH, .m3u, rtsp, rtmp, udp…"
                    + (root.ytdlp ? " YouTube and other sites play through yt-dlp." : " Install yt-dlp to play YouTube and other sites.");
            }
            Rectangle {
                height: 136px; border-radius: Metrics.radius-sm; background: Theme.field;
                border-width: box.has-focus ? 1px : 0px; border-color: Theme.accent;
                clip: true;
                if root.urls == "" && !box.has-focus: Text {
                    x: 10px; y: 10px; text: "e.g., https://www.example.com/stream.avi";
                    color: Theme.fg-a3; font-size: Metrics.font-sm;
                }
                box := TextInput {
                    x: 10px; y: 10px; width: parent.width - 20px; height: parent.height - 20px;
                    text <=> root.urls; single-line: false; wrap: word-wrap;
                    color: Theme.fg-2; font-size: Metrics.font-sm; font-family: "DM Mono";
                    selection-background-color: Theme.accent-bg;
                }
            }
            if root.history.length > 0: VerticalLayout {
                spacing: 4px;
                Text { text: "Recent streams"; color: Theme.fg-a3; font-size: Metrics.font-sm; }
                for h in root.history: Rectangle {
                    height: 26px; border-radius: Metrics.radius-sm;
                    background: hta.has-hover ? Theme.bg-a1 : transparent;
                    Text { x: 8px; width: parent.width - 16px; text: h; color: Theme.fg-a2; font-size: Metrics.font-sm; font-family: "DM Mono"; overflow: elide; vertical-alignment: center; }
                    hta := TouchArea {
                        accessible-role: button; accessible-label: "Add recent stream " + h;
                        mouse-cursor: pointer;
                        clicked => { root.urls = root.urls == "" ? h : root.urls + "\n" + h; }
                    }
                }
            }
            Heading { title: "Playlist Name"; extra: "(optional)"; hint: "The playlist will be saved and displayed with this title."; }
            TextField { height: 30px; text <=> root.name; placeholder: "e.g., Favorite TV Channels"; }
            if root.error != "": Text { text: root.error; color: Theme.danger; font-size: Metrics.font-sm; wrap: word-wrap; }
            Rectangle { height: 8px; }
            HorizontalLayout {
                alignment: space-between;
                SecondaryButton { size: ButtonSize.sm; min-w: 72px; text: "Cancel"; clicked => { root.close(); } }
                PrimaryButton {
                    size: ButtonSize.sm; min-w: 72px;
                    text: root.name == "" ? "Open" : "Save"; enabled: root.has-urls;
                    clicked => { root.submit(root.urls, root.name); }
                }
            }
        }
    }
    init => { box.focus(); }
}

// New Playlist: title + thumbnail, then a drop zone / file picker.
export component NewPlaylistDialog inherits Rectangle {
    in property <[string]> files;   // display names
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> drag-over;
    in property <string> error;
    in-out property <string> name;
    callback pick-cover();
    callback pick-files();
    callback remove-file(int);
    callback save(string);
    callback close();
    DialogFrame {
        title: "New Playlist"; dialog-width: 560px;
        close => { root.close(); }
        VerticalLayout {
            padding: 20px; padding-top: 18px; spacing: 18px;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 12px; alignment: start;
                    Heading { title: "Playlist Details"; hint: "The playlist will be saved and displayed with this title and thumbnail."; }
                    nm := TextField { height: 30px; text <=> root.name; placeholder: "e.g., Favorite Videos"; accepted => { root.save(root.name); } }
                }
                Rectangle {
                    width: 96px; height: 96px; border-radius: Metrics.radius-sm; clip: true;
                    background: Theme.field;
                    border-width: ca.has-hover ? 1px : 0px; border-color: Theme.accent;
                    if root.has-cover: Image { width: parent.width; height: parent.height; source: root.cover; image-fit: ImageFit.cover; }
                    if !root.has-cover: Rectangle {
                        width: 28px; height: 28px; border-radius: Metrics.radius-sm; background: Theme.popup-hover;
                        Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/add.svg"); tint: Theme.fg-2; }
                    }
                    ca := TouchArea { accessible-role: button; accessible-label: "Choose cover image"; mouse-cursor: pointer; clicked => { root.pick-cover(); } }
                }
            }
            Heading { title: "Select Files"; hint: "These files will be added to the playlist."; }
            Rectangle {
                height: root.files.length == 0 ? 150px : 190px;
                border-radius: Metrics.radius-sm; background: Theme.field;
                border-width: 1px; border-color: root.drag-over || za.has-hover ? Theme.accent : Theme.divider;
                clip: true;
                // Dashed outline per Figma: short dashes over the border.
                if root.files.length == 0: VerticalLayout {
                    alignment: center; spacing: 12px;
                    Text { text: "Drag files into the box or click here to select files."; color: Theme.fg-a3; font-size: Metrics.font-sm; horizontal-alignment: center; }
                    HorizontalLayout { alignment: center;
                        Rectangle { width: 46px; height: 24px; border-radius: Metrics.radius-sm; background: Theme.popup-hover;
                            Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/add.svg"); tint: Theme.fg-2; } } }
                }
                za := TouchArea { accessible-role: button; accessible-label: "Add files"; mouse-cursor: pointer; clicked => { root.pick-files(); } }
                if root.files.length > 0: VerticalLayout {
                    padding: 8px; spacing: 4px;
                    HorizontalLayout {
                        Text { text: root.files.length + (root.files.length == 1 ? " file" : " files"); color: Theme.fg-a2; font-size: Metrics.font-sm; horizontal-stretch: 1; vertical-alignment: center; }
                        Rectangle { width: 46px; height: 24px; border-radius: Metrics.radius-sm; background: aa.has-hover ? Theme.divider : (Theme.popup-hover);
                            Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/add.svg"); tint: Theme.fg-2; }
                            aa := TouchArea { accessible-role: button; accessible-label: "Add files"; mouse-cursor: pointer; clicked => { root.pick-files(); } } }
                    }
                    ScrollView {
                        VerticalLayout {
                            alignment: start; spacing: 0px;
                            for f[i] in root.files: Rectangle {
                                height: 28px; border-radius: Metrics.radius-sm;
                                background: fta.has-hover ? Theme.bg-a1 : transparent;
                                fta := TouchArea { }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 4px; spacing: 8px;
                                    Text { text: (i + 1) + "."; color: Theme.fg-a3; font-family: "DM Mono"; font-size: Metrics.font-xs; vertical-alignment: center; width: 24px; }
                                    Text { text: f; color: Theme.fg-2; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    Rectangle { width: 24px;
                                        Icon { width: 12px; height: 12px; source: @image-url("../assets/icons/close.svg"); tint: Theme.fg-a3; }
                                        TouchArea { accessible-role: button; accessible-label: "Remove " + f; mouse-cursor: pointer; clicked => { root.remove-file(i); } } }
                                }
                            }
                        }
                    }
                }
            }
            if root.error != "": Text { text: root.error; color: Theme.danger; font-size: Metrics.font-sm; }
            HorizontalLayout {
                alignment: space-between;
                SecondaryButton { size: ButtonSize.sm; min-w: 72px; text: "Cancel"; clicked => { root.close(); } }
                PrimaryButton {
                    size: ButtonSize.sm; min-w: 72px;
                    text: "Save"; enabled: root.name != "";
                    clicked => { root.save(root.name); }
                }
            }
        }
    }
}

// QR code a plugin asks to show (`script-message vivi-qr <title> <text> [caption]`),
// e.g. Remote Control's pairing link for phones.
export component QrDialog inherits Rectangle {
    in property <string> title;
    in property <image> code;
    in property <string> text;
    in property <string> caption;
    callback close();
    DialogFrame {
        title: root.title; dialog-width: 380px;
        close => { root.close(); }
        VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            HorizontalLayout { alignment: center;
                Rectangle { width: 264px; height: 264px; background: white; border-radius: Metrics.radius-lg;
                    Image { width: 240px; height: 240px; source: root.code; image-rendering: pixelated; }
                }
            }
            Text { text: root.text; color: Theme.fg-1; font-size: Metrics.font-sm; horizontal-alignment: center; wrap: char-wrap; }
            if root.caption != "": Text { text: root.caption; color: Theme.fg-a3; font-size: Metrics.font-sm; horizontal-alignment: center; wrap: word-wrap; }
            HorizontalLayout { alignment: end; PrimaryButton { size: ButtonSize.sm; min-w: 72px; text: "Done"; clicked => { root.close(); } } }
        }
    }
}

// Confirmation a plugin asks for (e.g. the YouTube Music download warning): a warning
// icon, a title, the text, Cancel and the confirm button. Enter confirms, Esc cancels.
export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> heading;
    in property <string> text;
    in property <string> ok-label: "OK";
    in property <bool> warning;
    callback answer(bool);
    DialogFrame {
        title: root.title; dialog-width: 480px;
        close => { root.answer(false); }
        fs := FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.Return { root.answer(true); return accept; }
                reject
            }
            VerticalLayout {
                padding: 20px; spacing: 14px; alignment: start;
                HorizontalLayout { spacing: 12px;
                    if root.warning: VerticalLayout { alignment: start;
                        Rectangle { width: 32px; height: 32px; border-radius: 16px; background: Theme.warn-bg.with-alpha(0.22);
                            Text { text: "!"; color: Theme.warn; font-size: Metrics.font-base; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; } } }
                    VerticalLayout { spacing: 8px; horizontal-stretch: 1;
                        Text { text: root.heading; color: Theme.fg-1; font-size: Metrics.font-base; font-weight: 600; wrap: word-wrap; }
                        Text { text: root.text; color: Theme.fg-a2; font-size: Metrics.font-sm; wrap: word-wrap; }
                    }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    SecondaryButton { size: ButtonSize.sm; min-w: 72px; text: "Cancel"; clicked => { root.answer(false); } }
                    PrimaryButton { size: ButtonSize.sm; min-w: 72px; text: root.ok-label; clicked => { root.answer(true); } }
                }
            }
        }
    }
}

// One shortcut: action on the left, key chip on the right.
component ShortcutRow inherits HorizontalLayout {
    in property <string> action;
    in property <string> keys;
    height: 30px; spacing: 12px;
    Text { text: root.action; color: Theme.fg-2; font-size: Metrics.font-sm; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    VerticalLayout { alignment: center;
        Rectangle {
            width: kt.preferred-width + 16px; height: 22px; border-radius: Metrics.radius-sm;
            background: Theme.field; border-width: 1px; border-color: Theme.divider;
            kt := Text { text: root.keys; color: Theme.fg-1; font-family: "DM Mono"; font-size: Metrics.font-sm; vertical-alignment: center; horizontal-alignment: center; }
        }
    }
}

// "?" overlay: the whole keymap (src/keymap.rs) in two columns.
export component ShortcutsDialog inherits Rectangle {
    in property <[string]> actions;
    in property <[string]> keys;
    callback close();
    property <bool> wide: root.width >= 760px;
    property <int> half: root.wide ? ceil(root.actions.length / 2) : root.actions.length;
    DialogFrame {
        title: "Keyboard Shortcuts"; dialog-width: 880px;
        close => { root.close(); }
        ScrollView {
            height: min(cols.preferred-height, root.height - 120px);
            cols := HorizontalLayout {
                padding: 16px; padding-top: 10px; spacing: 32px;
                VerticalLayout {
                    alignment: start;
                    for i in root.half: ShortcutRow { action: root.actions[i]; keys: root.keys[i]; }
                }
                if root.wide: VerticalLayout {
                    alignment: start;
                    for i in root.actions.length - root.half: ShortcutRow { action: root.actions[i + root.half]; keys: root.keys[i + root.half]; }
                }
            }
        }
        Text {
            text: "Press ? or Esc to close · also in Settings → Controls";
            color: Theme.fg-a3; font-size: Metrics.font-xs; horizontal-alignment: center;
            height: 30px; vertical-alignment: center;
        }
    }
}
