// Vivi player UI. Layout & tokens follow the Figma "Player" frame:
// topbar 40px #191919 (pad 6, gap 10, title Inter 14 #8F8F8F centered),
// Controls 54px #191919 @93% (pad 20/11, gap 20), radii 4/6.

import { Theme, Metrics, Icon } from "core/theme.slint";
import { ScrollView } from "std-widgets.slint";
import { SidePanel, Item } from "panel.slint";
import { SettingsDialog, SettingRow } from "settings.slint";
import { CustomizeDialog, Tools } from "toolbar.slint";
import { OnboardingDialog } from "onboarding.slint";
import { LibraryView, LibItem } from "library.slint";
import { NetworkStreamDialog, NewPlaylistDialog, QrDialog, ConfirmDialog, ShortcutsDialog } from "dialogs.slint";
import { FxState } from "filters.slint";
import { MenuPanel, MenuItem } from "menu.slint";
import { VizView, VizDropdown } from "viz.slint";
import { SkipButton, LyricsView, SubtitleDialog, MusicDialog, FmRow, MdFilter, NowPlayingCard, TagReviewDialog, TagFile, TagField, TagCover, TagResult, KaraokeView, LyricsState, LyricsSearchDialog, KWord, LyricsHit, SubHit } from "plugins.slint";
import { Modal } from "core/modal.slint";
import { IconButton, PrimaryButton, FlatButton, ButtonSize } from "core/buttons.slint";
import { BarStyle, BarMetrics, Bars, VolumeStyle, PanelTab, Overlay, TagStatus } from "core/types.slint";
import { Overlays } from "state/overlays.slint";
import { Playback } from "state/playback.slint";
import { Panel } from "state/panel.slint";
import { Dialogs } from "state/dialogs.slint";
import { Menus } from "state/menus.slint";
import { Library } from "state/library.slint";
import { Settings } from "state/settings.slint";
import { Customize } from "state/customize.slint";
import { Icons } from "core/icons.slint";
import { Downloads } from "state/downloads.slint";
import { Lyrics } from "state/lyrics.slint";
import { Subtitles } from "state/subtitles.slint";
import { MusicDialogState, MdCaps } from "state/music-dialog.slint";
import { TagReview } from "state/tag-review.slint";
import { NowPlaying } from "state/now-playing.slint";
import { Notices } from "state/notices.slint";
import { Viz } from "state/viz.slint";
import { SkipIntro } from "state/skip-intro.slint";
import { Extensions, ExtTab } from "state/extensions.slint";
import { ExtensionsDialog } from "extensions.slint";
import { Palette, PaletteItem } from "state/palette.slint";
import { PaletteDialog } from "palette.slint";
import { Drawer } from "state/drawer.slint";
import { SideDrawer } from "drawer.slint";
export { MenuItem } from "menu.slint";
export { About } from "about.slint";
export { Item, SettingRow, Theme, LibItem, FxState, LyricsState, BarStyle, PanelTab, Overlay, TagStatus, Overlays, Playback, Panel, Dialogs, Menus, Library, Settings, Customize, Lyrics, Subtitles, MusicDialogState, MdCaps, TagReview, NowPlaying, Notices, Viz, SkipIntro, Extensions, Palette, Drawer, Downloads }

component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <[image]> frames; // evenly spaced preview frames from the Chapter Thumbnails cache (may be empty)
    in property <[float]> chapters; // chapter start times (s) → segment gaps on the track
    in property <[float]> peaks; // audio waveform peaks 0..1 (empty = plain bar)
    in property <float> range-a: -1; // plugin range (vivi-range), drawn in blue
    in property <float> range-b: -1;
    in property <string> range-label;
    in property <float> ab-a: -1; // A-B loop / range bounds in seconds (-1 = unset)
    in property <float> ab-b: -1;
    in property <length> track-h: 8px;
    in property <bool> boxed: false; // full-height dark track, dim fill, slim bright handle
    callback seek(float);
    callback ab-set(float, float);
    pure callback fmt(float) -> string;
    height: 18px;
    property <float> frac: duration > 0 ? clamp(position / duration, 0, 1) : 0;
    property <float> hover-frac: clamp(ta.mouse-x / self.width, 0, 1);
    property <bool> hovering: ta.has-hover;
    changed hovering => {
        if self.hovering && root.duration > 0 {
            Playback.preview-wanted();
        }
    }
    property <bool> wave: root.peaks.length > 0;
    property <float> ra: root.duration > 0 && root.ab-a >= 0 ? clamp(root.ab-a / root.duration, 0, 1) : -1;
    property <float> rb: root.duration > 0 && root.ab-b >= 0 ? clamp(root.ab-b / root.duration, 0, 1) : (root.ra >= 0 ? root.frac : -1);
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.wave || root.boxed ? root.height : (ta.has-hover ? root.track-h + 2px : root.track-h);
        border-radius: root.boxed ? 4px : 2px;
        background: root.wave ? transparent : root.boxed ? Theme.track : Theme.bg-a1;
        clip: root.boxed;
        if ta.has-hover && !root.wave: Rectangle {
            x: root.boxed ? 1.5px : 0; y: root.boxed ? 1.5px : 0;
            height: parent.height - (root.boxed ? 3px : 0); border-radius: root.boxed ? 2.5px : 2px;
            width: max(0, (parent.width - (root.boxed ? 3px : 0)) * root.hover-frac);
            background: root.boxed ? Theme.track-tick : Theme.divider;
        }
        if !root.wave: Rectangle {
            x: root.boxed ? 1.5px : 0; y: root.boxed ? 1.5px : 0;
            height: parent.height - (root.boxed ? 3px : 0); border-radius: root.boxed ? 2.5px : 2px;
            width: max(0, (parent.width - (root.boxed ? 3px : 0)) * (ta.pressed ? root.hover-frac : root.frac));
            background: root.boxed ? (ta.has-hover ? Theme.track-fill-hover : Theme.track-fill) : (ta.has-hover ? Theme.accent-bright : Theme.accent);
        }
        // Waveform: one bar per peak, the played part in the accent colour.
        for v[i] in root.peaks: Rectangle {
            x: parent.width * i / root.peaks.length;
            width: max(1px, parent.width / root.peaks.length - 1px);
            height: max(2px, parent.height * clamp(v, 0, 1));
            y: (parent.height - self.height) / 2;
            border-radius: Metrics.radius-xs;
            background: (i + 0.5) / root.peaks.length <= (ta.pressed ? root.hover-frac : root.frac) ? Theme.accent
                : ta.has-hover && (i + 0.5) / root.peaks.length <= root.hover-frac ? Theme.fg-a2 : Theme.fg-a3;
        }
        // Chapter boundaries cut the track into segments.
        for c in root.chapters: Rectangle {
            visible: root.duration > 0 && c > 0.5 && c < root.duration - 0.5;
            x: parent.width * c / max(root.duration, 1) - 2px; width: 4px;
            height: parent.height; background: Theme.bar.with-alpha(1);
            // Notch above and below so boundaries read on thin tracks too.
            if !root.boxed: Rectangle { x: 1px; width: 2px; y: -4px; height: 3px; border-radius: self.width / 2; background: Theme.fg-a2; }
            if !root.boxed: Rectangle { x: 1px; width: 2px; y: parent.height + 1px; height: 3px; border-radius: self.width / 2; background: Theme.fg-a2; }
        }
        // Plugin range (Cut & Export In/Out)
        if root.duration > 0 && root.range-a >= 0: Rectangle {
            property <float> e: root.range-b >= 0 ? root.range-b : root.position;
            x: parent.width * clamp(min(root.range-a, self.e) / root.duration, 0, 1);
            width: parent.width * clamp(abs(self.e - root.range-a) / root.duration, 0, 1);
            height: parent.height; border-radius: Metrics.radius-xs;
            background: Theme.range.with-alpha(0.25); border-width: 1px; border-color: Theme.range;
        }
        // A-B range overlay
        if root.ra >= 0 && root.rb >= 0: Rectangle {
            x: parent.width * min(root.ra, root.rb); width: parent.width * abs(root.rb - root.ra);
            height: parent.height; border-radius: Metrics.radius-xs;
            background: Theme.accent.with-alpha(0.28);
            border-width: 1px; border-color: Theme.accent-bright;
        }
    }
    // Playhead handle (compact style)
    if root.duration > 0 && !root.wave: Rectangle {
        width: root.boxed ? 5px : 4px; height: root.boxed ? root.height - 3px : root.track-h + 8px; border-radius: root.boxed ? 2.5px : 2px;
        x: clamp(1.5px + (root.width - 3px) * (ta.pressed ? root.hover-frac : root.frac) - self.width, 1.5px, root.width - self.width - 1.5px); y: (root.height - self.height) / 2;
        background: Theme.accent;
        visible: root.boxed || root.track-h > 8px || ta.has-hover;
    }
    // Hover frame preview (#10; frames from the Chapter Thumbnails package)
    if ta.has-hover && root.duration > 0 && root.frames.length > 0: Rectangle {
        y: -30px - 6px - 108px;
        width: 192px; height: 108px;
        x: clamp(ta.mouse-x - self.width / 2, 0, root.width - self.width);
        border-radius: Metrics.radius-md; clip: true;
        background: Theme.video-bg;
        border-width: 1px; border-color: Theme.divider;
        Image {
            width: parent.width; height: parent.height; image-fit: contain;
            source: root.frames[round(root.hover-frac * (root.frames.length - 1))];
        }
    }
    // Hover time tooltip
    if ta.has-hover && root.duration > 0: Rectangle {
        y: -30px;
        width: tiptext.preferred-width + 12px; height: 22px;
        x: clamp(ta.mouse-x - self.width / 2, 0, root.width - self.width);
        border-radius: Metrics.radius-sm;
        background: Theme.bg-a1;
        tiptext := Text {
            text: root.fmt(root.hover-frac * root.duration);
            color: Theme.fg-1; font-family: "DM Mono"; font-size: Metrics.font-sm;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        accessible-role: slider; accessible-label: "Seek";
        accessible-value: root.fmt(root.position) + " of " + root.fmt(root.duration);
        accessible-value-minimum: 0; accessible-value-maximum: root.duration; accessible-value-step: 5;
        accessible-action-increment => { root.seek(min(root.duration, root.position + 5)); }
        accessible-action-decrement => { root.seek(max(0, root.position - 5)); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && root.duration > 0) {
                root.seek(root.hover-frac * root.duration);
            }
        }
    }
    // Draggable A/B edge handles
    if root.ra >= 0 && root.ab-b >= 0: Rectangle {
        x: root.width * root.ra - 5px; width: 10px; height: root.height + 6px; y: -3px;
        Rectangle { x: 3px; width: 4px; border-radius: self.width / 2; background: ha.has-hover || ha.pressed ? Theme.on-media : Theme.accent-bright; }
        ha := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed) {
                    root.ab-set(clamp((parent.x + self.mouse-x) / root.width, 0, 1) * root.duration, root.ab-b);
                }
            }
        }
    }
    if root.ab-a >= 0 && root.ab-b >= 0: Rectangle {
        x: root.width * root.rb - 5px; width: 10px; height: root.height + 6px; y: -3px;
        Rectangle { x: 3px; width: 4px; border-radius: self.width / 2; background: hb.has-hover || hb.pressed ? Theme.on-media : Theme.accent-bright; }
        hb := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed) {
                    root.ab-set(root.ab-a, clamp((parent.x + self.mouse-x) / root.width, 0, 1) * root.duration);
                }
            }
        }
    }
}

// Cone volume control (Figma "volume": 88x28 wedge, green→red gradient fill).
// The fill width follows the Figma states: 10% → 7px … 100% → 63px, 150% → 75px, 200% → 88px.
component VolumeBar inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 150;
    callback changed(float);
    in property <bool> compact: false;
    width: compact ? 56px : 88px; height: compact ? Metrics.bar-track-h : 28px;
    // volume (percent) → filled width in Figma units (0..88)
    pure function fill-of(v: float) -> float {
        if (v <= 0) { return 0; }
        if (v <= 50) { return v * 0.66; }
        if (v <= 60) { return 33 + (v - 50) * 0.8; }
        if (v <= 70) { return 41 + (v - 60) * 0.7; }
        if (v <= 100) { return 48 + (v - 70) * 0.5; }
        if (v <= 150) { return 63 + (v - 100) * 0.24; }
        return min(88, 75 + (v - 150) * 0.26);
    }
    // inverse of fill-of
    pure function volume-of(x: float) -> float {
        if (x <= 33) { return x / 0.66; }
        if (x <= 41) { return 50 + (x - 33) / 0.8; }
        if (x <= 48) { return 60 + (x - 41) / 0.7; }
        if (x <= 63) { return 70 + (x - 48) / 0.5; }
        if (x <= 75) { return 100 + (x - 63) / 0.24; }
        return 150 + (x - 75) / 0.26;
    }
    property <float> fx: fill-of(min(root.value, root.maximum));
    // wedge edges: top y = 10.5 - x*10/88, bottom y = 15.5 + x*11/88
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 88; viewbox-height: 28;
        fill: Theme.track;
        MoveTo { x: 0; y: 10; }
        LineTo { x: 88; y: 0; }
        LineTo { x: 88; y: 28; }
        LineTo { x: 0; y: 16; }
        Close { }
    }
    // gradient fill, inset ~1.5 units so the black wedge reads as an outline
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 88; viewbox-height: 28;
        fill: @linear-gradient(90deg, Theme.meter-low 0%, Theme.meter-mid 58%, Theme.meter-high 79%, Theme.meter-peak 100%);
        opacity: 0.8; // Figma renders the gradient at ~80% over the black wedge
        MoveTo { x: 1.5; y: 11.5; }
        LineTo { x: 86.5; y: 2; }
        LineTo { x: 86.5; y: 26; }
        LineTo { x: 1.5; y: 14.5; }
        Close { }
    }
    // unfilled part
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 88; viewbox-height: 28;
        fill: Theme.track;
        MoveTo { x: root.fx; y: 10.5 - root.fx * 10 / 88; }
        LineTo { x: 88; y: 0.5; }
        LineTo { x: 88; y: 27.5; }
        LineTo { x: root.fx; y: 15.5 + root.fx * 12 / 88; }
        Close { }
    }
    TouchArea {
        mouse-cursor: pointer;
        accessible-role: slider; accessible-label: "Volume"; accessible-value: round(root.value) + "%";
        accessible-value-minimum: 0; accessible-value-maximum: root.maximum; accessible-value-step: 5;
        accessible-action-increment => { root.changed(min(root.maximum, root.value + 5)); }
        accessible-action-decrement => { root.changed(max(0, root.value - 5)); }
        moved => { if (self.pressed) { root.changed(min(root.maximum, root.volume-of(clamp(self.mouse-x / self.width, 0, 1) * 88))); } }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.changed(min(root.maximum, root.volume-of(clamp(self.mouse-x / self.width, 0, 1) * 88))); }
        }
        scroll-event(e) => {
            root.changed(clamp(root.value + (e.delta-y > 0 ? 5 : -5), 0, root.maximum));
            accept
        }
    }
}

// Shared input for every volume control style: one slider for screen readers (value, step,
// increment / decrement), click / drag to set, wheel to step. `cone` maps the position
// through the cone's fill curve; `vertical` reads bottom → top; `relative` drags change the
// value by the distance moved (the percentage readout has no track to point at).
component VolumeTouch inherits TouchArea {
    in property <float> value;
    in property <float> maximum: 150;
    in property <bool> cone;
    in property <bool> vertical;
    in property <bool> relative;
    callback changed(float);
    callback tapped(); // a press without a drag (relative mode)
    property <float> start;
    property <bool> dragged;
    mouse-cursor: root.relative ? ew-resize : pointer;
    accessible-role: slider; accessible-label: "Volume"; accessible-value: round(root.value) + "%";
    accessible-value-minimum: 0; accessible-value-maximum: root.maximum; accessible-value-step: 5;
    accessible-action-increment => { root.changed(min(root.maximum, root.value + 5)); }
    accessible-action-decrement => { root.changed(max(0, root.value - 5)); }
    pure function cone-volume(x: float) -> float {
        if (x <= 33) { return x / 0.66; }
        if (x <= 41) { return 50 + (x - 33) / 0.8; }
        if (x <= 48) { return 60 + (x - 41) / 0.7; }
        if (x <= 63) { return 70 + (x - 48) / 0.5; }
        if (x <= 75) { return 100 + (x - 63) / 0.24; }
        return 150 + (x - 75) / 0.26;
    }
    pure function at() -> float {
        root.vertical ? 1 - clamp(self.mouse-y / self.height, 0, 1) : clamp(self.mouse-x / self.width, 0, 1)
    }
    function set-at() {
        root.changed(min(root.maximum, root.cone ? root.cone-volume(root.at() * 88) : root.at() * root.maximum));
    }
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) {
            root.start = root.value; root.dragged = false;
            if (!root.relative) { root.set-at(); }
        }
        if (e.kind == PointerEventKind.up && root.relative && !root.dragged) { root.tapped(); }
    }
    moved => {
        if (self.pressed) {
            if (root.relative) {
                root.dragged = root.dragged || abs(self.mouse-x - self.pressed-x) > 3px;
                if (root.dragged) { root.changed(clamp(round(root.start + (self.mouse-x - self.pressed-x) / 2px), 0, root.maximum)); }
            } else { root.set-at(); }
        }
    }
    scroll-event(e) => {
        root.changed(clamp(root.value + (e.delta-y > 0 ? 5 : -5), 0, root.maximum));
        accept
    }
}

// "Bar" volume: a flat slider drawn like the seek track of the current bar style.
component VolumeSlider inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 150;
    in property <bool> compact;
    in property <bool> boxed: true;
    callback changed(float);
    width: compact ? 64px : 88px; height: compact ? Metrics.bar-track-h : 28px;
    property <float> frac: clamp(root.value / max(1, root.maximum), 0, 1);
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.boxed ? (root.compact ? root.height : Metrics.bar-track-h) : 4px;
        border-radius: root.boxed ? 4px : 2px;
        background: root.boxed ? Theme.track : Theme.bg-a1;
        Rectangle {
            x: root.boxed ? 1.5px : 0; y: root.boxed ? 1.5px : 0;
            height: parent.height - (root.boxed ? 3px : 0); border-radius: root.boxed ? 2.5px : 2px;
            width: max(0, (parent.width - (root.boxed ? 3px : 0)) * root.frac);
            background: root.boxed ? (ta.has-hover ? Theme.track-fill-hover : Theme.track-fill) : (ta.has-hover ? Theme.accent-bright : Theme.accent);
        }
    }
    Rectangle {
        width: root.boxed ? 5px : 4px; height: root.boxed ? track.height - 3px : 12px; border-radius: 2px;
        x: clamp(1.5px + (root.width - 3px) * root.frac - self.width, 1.5px, root.width - self.width - 1.5px);
        y: (root.height - self.height) / 2;
        background: Theme.accent;
        visible: root.boxed || ta.has-hover;
    }
    ta := VolumeTouch { value: root.value; maximum: root.maximum; changed(v) => { root.changed(v); } }
}

// "Popup" volume: the speaker icon only; hovering it opens a vertical slider above, the wheel
// changes the volume and a click mutes.
component VolumePopup inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 150;
    in property <bool> compact;
    in property <image> icon;
    in property <string> tip;
    callback changed(float);
    callback mute();
    width: compact ? 28px : 36px; height: compact ? 26px : 32px;
    border-radius: Metrics.radius-md;
    background: ita.has-hover ? Theme.bg-a1 : transparent;
    property <bool> open: ita.has-hover || pta.has-hover || pta.pressed;
    Icon { source: root.icon; width: root.compact ? 18px : 20px; height: self.width; tint: ita.has-hover ? Theme.fg-1 : Theme.fg-2; }
    ita := VolumeTouch {
        value: root.value; maximum: root.maximum; relative: true;
        accessible-label: root.tip;
        changed(v) => { root.changed(v); }
        tapped => { root.mute(); }
    }
    // The pop-up reaches down to the icon so moving onto it keeps it open.
    Rectangle {
        visible: root.open;
        property <length> card-h: 132px;
        x: (root.width - self.width) / 2; y: -self.card-h - 4px;
        width: 40px; height: self.card-h + 4px;
        Rectangle {
            height: parent.card-h; border-radius: Metrics.radius-md;
            background: Theme.bar.with-alpha(1); border-width: 1px; border-color: Theme.divider;
            Text { y: 8px; height: 14px; text: round(root.value) + "%"; color: Theme.fg-a2; font-size: Metrics.font-micro; horizontal-alignment: center; }
            Rectangle {
                x: (parent.width - self.width) / 2; y: 28px; width: 6px; height: parent.height - 40px;
                border-radius: self.width / 2; background: Theme.track;
                Rectangle {
                    y: parent.height * (1 - clamp(root.value / max(1, root.maximum), 0, 1));
                    height: parent.height - self.y; border-radius: parent.border-radius;
                    background: pta.has-hover ? Theme.accent-bright : Theme.accent;
                }
                pta := VolumeTouch {
                    x: -12px; width: parent.width + 24px;
                    value: root.value; maximum: root.maximum; vertical: true;
                    changed(v) => { root.changed(v); }
                }
            }
        }
    }
}

// "Percent" volume: the number next to the speaker icon; drag sideways or scroll to change.
component VolumePercent inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 150;
    in property <bool> compact;
    callback changed(float);
    width: pt.preferred-width + 8px; height: compact ? 26px : 32px;
    border-radius: Metrics.radius-sm;
    background: ta.has-hover || ta.pressed ? Theme.bg-a1 : transparent;
    pt := Text {
        text: round(root.value) + "%"; font-size: Metrics.font-sm; font-family: "DM Mono";
        color: ta.has-hover ? Theme.fg-1 : Theme.fg-a2; vertical-alignment: center; horizontal-alignment: center;
    }
    ta := VolumeTouch { value: root.value; maximum: root.maximum; relative: true; changed(v) => { root.changed(v); } }
}

// A configurable bottom-bar item (see toolbar.slint for the catalogue).
component BarItem inherits HorizontalLayout {
    in property <string> id;
    in property <bool> active;
    in property <bool> muted;
    in property <float> volume;
    in property <float> volume-max: 150;
    in property <bool> fullscreen;
    in property <bool> wide: true; // room for the volume slider
    in property <bool> shown: true; // false = collapsed into the overflow menu
    in property <bool> compact: false;
    in property <VolumeStyle> vstyle: VolumeStyle.cone;
    in property <bool> boxed: true; // bar style draws boxed tracks (all but Plain)
    callback act(string);
    callback volume-changed(float);
    property <image> vol-icon: root.muted || root.volume < 1 ? @image-url("../assets/icons/close-none.svg")
            : root.volume < 50 ? @image-url("../assets/icons/close-low.svg")
            : root.volume < 100 ? @image-url("../assets/icons/close-medium.svg")
            : @image-url("../assets/icons/volume-high.svg");
    spacing: root.compact ? 2px : 6px;
    horizontal-stretch: 0;
    if root.shown && root.id == "volume" && root.vstyle != VolumeStyle.popup: IconButton { tab-focus: false;
        size: root.compact ? ButtonSize.sm : ButtonSize.md;
        tip: Tools.label("volume");
        icon: root.vol-icon;
        clicked => { root.act("mute"); }
    }
    if root.shown && root.id == "volume" && root.vstyle == VolumeStyle.popup: VerticalLayout { alignment: center; VolumePopup {
        compact: root.compact; icon: root.vol-icon; tip: Tools.label("volume");
        value: root.volume; maximum: root.volume-max;
        changed(v) => { root.volume-changed(v); }
        mute => { root.act("mute"); }
    } }
    if root.shown && root.wide && root.id == "volume" && root.vstyle == VolumeStyle.bar: VerticalLayout { alignment: root.compact ? center : start; VolumeSlider {
        compact: root.compact; boxed: root.boxed; value: root.volume; maximum: root.volume-max;
        changed(v) => { root.volume-changed(v); }
    } }
    if root.shown && root.id == "volume" && root.vstyle == VolumeStyle.percent: VerticalLayout { alignment: root.compact ? center : start; VolumePercent {
        compact: root.compact; value: root.volume; maximum: root.volume-max;
        changed(v) => { root.volume-changed(v); }
    } }
    // Inline bars: centred on the row like the seek track, so both share one vertical centre.
    if root.shown && root.wide && root.id == "volume" && root.vstyle == VolumeStyle.cone && root.compact: VerticalLayout { alignment: center; VolumeBar {
        compact: true; value: root.volume; maximum: root.volume-max;
        changed(v) => { root.volume-changed(v); }
    } }
    // Classic: the seek track has its own row; the wedge stays in line with the buttons.
    if root.shown && root.wide && root.id == "volume" && root.vstyle == VolumeStyle.cone && !root.compact: VolumeBar {
        compact: false; value: root.volume; maximum: root.volume-max;
        changed(v) => { root.volume-changed(v); }
    }
    // Icon only on the bar (labels live in the ⋯ overflow menu and hover Tooltip).
    if root.shown && root.id != "volume": IconButton { tab-focus: false;
        size: root.compact ? ButtonSize.sm : ButtonSize.md; active: root.active; tip: Tools.label(root.id);
        icon: root.id == "fullscreen" && root.fullscreen ? @image-url("../assets/icons/fullscreen-active.svg") : Tools.icon(root.id);
        clicked => { root.act(root.id); }
    }
}

component OverflowRow inherits Rectangle {
    in property <string> id;
    // Plugin buttons: their own label / icon (else the Tools catalogue's).
    in property <string> plabel;
    in property <image> picon;
    property <string> label: root.plabel != "" ? root.plabel : Tools.label(root.id);
    in property <bool> active;
    callback act(string);
    border-radius: Metrics.radius-sm;
    background: ta.has-hover ? Theme.bg-a1 : transparent;
    clip: true;
    ta := TouchArea { accessible-role: button; accessible-label: root.label; mouse-cursor: pointer; clicked => { root.act(root.id); } }
    HorizontalLayout {
        padding-left: 8px; spacing: 10px;
        Icon { source: root.plabel != "" ? root.picon : Tools.icon(root.id); width: 20px; height: 20px; y: 8px; tint: root.active ? Theme.accent : Theme.fg-1; }
        Text { text: root.label; color: root.active ? Theme.accent : Theme.fg-1; vertical-alignment: center; }
    }
}

export component AppWindow inherits Window {
    icon: @image-url("../packaging/vivi.svg");
    title: Playback.has-media ? Playback.media-title + " — Vivi" : "Vivi";
    preferred-width: 1280px;
    preferred-height: 720px;
    // Main window minimum; the miniplayer goes down to 280x160.
    min-width: root.mini ? 280px : 480px;
    min-height: root.mini ? 160px : 320px;
    // Transparent only while playing (mpv underlay shows through); opaque otherwise.
    background: Playback.has-media ? transparent : Theme.bg-b1;
    default-font-family: "Inter";
    default-font-size: Metrics.font-base;

    in property <bool> fullscreen: false;
    // Driven from Rust: false after ~2s of mouse inactivity during playback.
    in property <bool> controls-visible: true;

    callback activity();
    // text, shift, ctrl, alt; unhandled keys are forwarded to mpv scripts.
    callback key(string, bool, bool, bool) -> bool;
    // Music visualizer (src/viz): shown for audio-only media; mode 0 = Disabled.
    // Plugins (src/plugins). Fields of `plugin-command` args are joined with U+001F.
    callback plugin-command(string, string, string);
    // Plain (unsynced) lyrics, e.g. radio: a scrollable block without highlight.
    // Full-screen karaoke view and manual search (Lyrics plugin).
    out property <length> karaoke-big: clamp(root.width / 22, 30px, 64px);
    // Characters per karaoke row, for wrapping the word-timed current line; counted at the
    // smallest size the view shrinks a line to (0.55 × big), so a line only wraps when it
    // cannot fit one row even then.
    out property <int> karaoke-cols: max(10, floor((root.width - 2 * max(40px, root.width * 0.08)) / (root.karaoke-big * 0.55 * 0.6)));
    // Network stream loading overlay (core, see loading.rs).
    // Now-playing card for audio-only network streams (Network Streams plugin).
    // "Add subtitles": the search dialog when the Subtitle Search plugin is on.
    public function add-subs() {
        if (Subtitles.plugin) { Overlays.subs-open = true; root.plugin-command("subtitle-search", "open", ""); }
        else { Panel.load-sub(); }
    }

    // Side panel
    // The overlay Esc closes (top-most open one); same conditions as each overlay's `if` below.
    out property <Overlay> top-overlay:
        Menus.menu-kind != "" ? Overlay.menu
        : Overlays.palette-open ? Overlay.palette
        : Overlays.shortcuts-open ? Overlay.shortcuts
        : Overlays.info-open ? Overlay.info
        : Overlays.onboarding-open ? Overlay.onboarding
        : Overlays.customize-open ? Overlay.customize
        : Overlays.tr-open ? Overlay.tag-review
        : Overlays.ls-open ? Overlay.lyrics-search
        : Overlays.confirm-open ? Overlay.confirm
        : Overlays.md-open ? Overlay.music-dialog
        : Overlays.subs-open ? Overlay.subtitles
        : Overlays.qr-open ? Overlay.qr
        : Overlays.extensions-open ? Overlay.extensions
        : Overlays.settings-open ? Overlay.settings
        : Overlays.new-playlist-open ? Overlay.new-playlist
        : Overlays.network-open ? Overlay.network
        : Overlays.drawer-open && Playback.has-media && !root.mini && root.show-ui ? Overlay.drawer
        : Overlays.panel-open && Playback.has-media && !root.mini ? Overlay.side-panel
        : Overlays.library-open && Playback.has-media ? Overlay.library
        : Overlays.karaoke-open && Playback.has-media && !root.mini && !Overlays.library-open ? Overlay.karaoke
        : Overlay.none;
    // Only the resume message (this text) offers "Start over"; other toasts just have OK.

    // Side-panel slider values (synced from mpv so presets/defaults show up)

    // Toolbar (bottom bar) and customization
    // Cumulative ~32 px slots of foldable items (-1 = always shown) and their total.
    pure function is-core(id: string) -> bool {
        return id == "prev" || id == "play" || id == "next" || id == "time" || id == "seek" || id == "duration" || id == "spacer" || id == "back10" || id == "fwd10";
    }
    public function bar-act(id: string) {
        if (id == "queue") { root.open-panel(PanelTab.queue); }
        else if (id == "subtitles") { root.open-panel(PanelTab.subtitles); }
        else if (id == "audio") { root.open-panel(PanelTab.audio); }
        else if (id == "video") { root.open-panel(PanelTab.video); }
        else if (id == "speed") { root.open-panel(PanelTab.playback); }
        else if (id == "chapters") { root.open-panel(PanelTab.chapters); Panel.chapters-refresh(); }
        else if (id == "mute") { Playback.toggle-mute(); }
        else if (id == "fullscreen") { Playback.toggle-fullscreen(); }
        else if (id == "bookmark") { Panel.add-bookmark(); }
        else if (id == "settings") { Overlays.settings-open = true; Settings.refresh(Settings.category, "", false); }
        else { Playback.bar-action(id); }
    }
    // Responsive bottom bar: how many items fit on each side of the play controls.
    // Items are ~40px wide; the left side also holds the time display. The rest go to "⋯".
    // Foldable slots that fit beside the transport, times and a 200 px seekbar.
    property <int> bar-fit: max(0, floor((root.width - root.bar.reserve) / root.bar.slot));
    property <bool> bar-has-volume: root.width >= root.bar.volume-min-window;
    function bar-active(id: string) -> bool {
        return (id == "queue" && Overlays.panel-open && Panel.tab == PanelTab.queue)
            || (id == "subtitles" && Overlays.panel-open && Panel.tab == PanelTab.subtitles)
            || (id == "audio" && Overlays.panel-open && Panel.tab == PanelTab.audio)
            || (id == "video" && Overlays.panel-open && Panel.tab == PanelTab.video)
            || (id == "speed" && Overlays.panel-open && Panel.tab == PanelTab.playback)
            || (id == "chapters" && Overlays.panel-open && Panel.tab == PanelTab.chapters)
            || (id == "repeat" && Playback.repeat-on) || (id == "shuffle" && Playback.shuffle-on)
            || (id == "settings" && Overlays.settings-open);
    }

    // Library
    // QR dialog of a plugin (vivi-qr).
    // Library as the full home screen (vs. the 427 px sidebar while playing).
    // Properties & Metadata dialog
    // "Hide UI" from the main menu (Ctrl+\): bars stay hidden until toggled back.
    in-out property <bool> ui-hidden;
    // Menus (built in src/menus.rs): main right-click menu, library context menus,
    // sort and view options. menu-kind "" = closed.
    // Miniplayer: compact always-on-top window (391x339, 391x690 with the queue).
    in-out property <bool> mini;
    in-out property <bool> mini-queue;
    // Miniplayer layout: queue shown only when there is room; "tiny" = video-only.
    property <bool> mini-q-shown: root.mini && root.mini-queue && root.height >= 420px;
    // Figma miniplayer: queue on top, the video, then a 52px info strip (not in the tiny variant).
    property <length> mini-q-h: root.mini-q-shown ? min(351px, root.height - 212px) : 0px;
    property <bool> mini-tiny: root.width < 320px || root.height - root.mini-q-h < 200px;
    property <length> mini-strip-h: root.mini && !root.mini-tiny ? 52px : 0px;
    property <length> mini-video-y: root.mini-q-h;
    property <length> mini-video-h: root.height - root.mini-q-h - root.mini-strip-h;
    property <float> mini-margin: root.mini ? root.mini-q-h / root.height : 0;
    property <float> mini-margin-b: root.mini ? root.mini-strip-h / root.height : 0;
    changed mini-margin-b => { Panel.set-prop("video-margin-ratio-bottom", root.mini-margin-b); }
    in property <string> mini-folder;
    in property <string> mini-sub;
    in property <string> mini-q-meta;
    in property <[string]> queue-durations;
    property <int> mini-q-sel: -1;
    changed mini-margin => { Panel.set-prop("video-margin-ratio-top", root.mini-margin); }

    // Onboarding

    // Settings
    // "?" overlay; rows come from the keymap (src/keymap.rs).
    // Plugin range on the seekbar (`script-message vivi-range <a> <b> [label]`), e.g. Cut & Export In/Out.
    property <BarMetrics> bar: Bars.metrics(Customize.bar-style);
    property <bool> bar-classic: root.bar.classic;
    out property <length> bar-h: root.bar.height;
    function open-panel(t: PanelTab) {
        if (Overlays.panel-open && Panel.tab == t) { Overlays.panel-open = false; }
        else { Panel.tab = t; Overlays.panel-open = true; }
    }

    pure function fmt(t: float) -> string {
        if (t < 0) { return "00:00"; }
        let h = floor(t / 3600);
        let m = floor(mod(t, 3600) / 60);
        let s = floor(mod(t, 60));
        (h > 0 ? h + ":" : "") + (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s
    }
    property <bool> show-ui: (!Playback.has-media || root.controls-visible || Overlays.panel-open || Overlays.settings-open || Overlays.customize-open) && !(root.ui-hidden && Playback.has-media);

    // Rust moves focus back to the player after Esc closed an overlay.
    public function focus-main() { fs.focus(); }
    property <bool> dialog-open: Overlays.settings-open || Overlays.extensions-open || Overlays.palette-open || Overlays.customize-open || Overlays.network-open
        || Overlays.new-playlist-open || Overlays.subs-open || Overlays.md-open || Overlays.ls-open
        || Overlays.tr-open || Overlays.onboarding-open || Overlays.qr-open || Overlays.confirm-open || Overlays.info-open
        || Overlays.shortcuts-open;

    // Esc reaches the keymap even while a text field inside a dialog has focus: this
    // scope wraps every element below and sees Esc before the focused item does.
    keys := FocusScope {
    width: 100%; height: 100%;
    focus-on-click: false; focus-on-tab-navigation: false;
    capture-key-pressed(e) => {
        if (e.text == Key.Escape) {
            root.activity();
            if (root.key(e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt)) { return accept; }
        }
        reject
    }

    fs := FocusScope {
        key-pressed(e) => {
            root.activity();
            if (root.key(e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt)) { return accept; }
            // Tab moves focus only inside an open dialog, or to the lines of live-stream
            // lyrics (to sync them with Enter).
            if (e.text == Key.Tab || e.text == Key.Backtab) { return root.dialog-open || (Lyrics.live && Lyrics.lines.length > 0) ? reject : accept; }
            reject
        }
    }
    init => { fs.focus(); }

    // Whole-window activity tracker (mouse moves reset the auto-hide timer).
    main-ta := TouchArea {
        mouse-cursor: root.show-ui ? MouseCursor.default : MouseCursor.none;
        changed mouse-x => { root.activity(); }
        changed mouse-y => { root.activity(); }
        clicked => { fs.focus(); if (Playback.has-media) { Playback.toggle-play(); } }
        double-clicked => { Playback.toggle-fullscreen(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down && Playback.has-media) {
                Menus.menu-request("main", self.mouse-x, self.mouse-y, "");
            }
        }
    }

    // ---------- Music visualizer (audio-only media) ----------
    if Playback.has-media && Viz.audio && Viz.mode > 0: VizView {
        frame: Viz.frame; note: Viz.note;
    }

    // ---------- Now playing card (audio-only network streams) ----------
    if Playback.has-media && NowPlaying.show && !root.mini: NowPlayingCard {
        // Centred in the space right of the docked library while that is shown.
        property <length> left: Overlays.library-open && !Library.full && root.show-ui ? min(427px, root.width) : 0px;
        x: self.left + (root.width - self.left - self.width) / 2;
        y: Viz.mode > 0 ? 64px : (root.height - self.height) / 2;
        width: min(460px, root.width - self.left - 48px);
        station: NowPlaying.station; track: NowPlaying.track; info: NowPlaying.info;
        logo: NowPlaying.logo; has-logo: NowPlaying.has-logo; music: NowPlaying.music;
    }

    // ---------- Lyrics overlay (Lyrics plugin) ----------
    if Playback.has-media && Lyrics.lines.length > 0 && !Overlays.library-open && !root.mini && !Overlays.karaoke-open: LyricsView {
        x: 40px; width: root.width - 80px;
        y: Viz.audio && Viz.mode > 0 ? (root.height - self.height) / 2 + 40px : root.height - root.bar-h - self.height - 60px;
        lines: Lyrics.lines; index: Lyrics.index; size: Lyrics.size * 1px; plain: Lyrics.plain;
        backdrop: !(Viz.audio && Viz.mode > 0);
        live: Lyrics.live; cmd(n, a) => { root.plugin-command("lyrics", n, a); fs.focus(); } activity => { root.activity(); } chrome: root.show-ui;
    }

    // ---------- Full-screen karaoke (Lyrics plugin; L or side panel) ----------
    if Playback.has-media && Overlays.karaoke-open && !Overlays.library-open && !root.mini: KaraokeView {
        width: root.width; height: root.height;
        lines: Lyrics.lines; index: Lyrics.index; plain: Lyrics.plain; live: Lyrics.live;
        words: Lyrics.words; rows: Lyrics.rows; big: root.karaoke-big;
        chrome: root.show-ui; activity => { root.activity(); }
        title: Lyrics.title; artist: Lyrics.artist; source: Lyrics.source;
        state: Lyrics.state; offset-s: Lyrics.offset;
        offset: Lyrics.offset-label; can-save: Lyrics.can-save; manual: Lyrics.manual;
        cmd(n, a) => { root.plugin-command("lyrics", n, a); fs.focus(); }
    }

    // ---------- Library (home screen when idle; overlay via the Home button) ----------
    if !Playback.has-media || Overlays.library-open: LibraryView {
        property <bool> docked: Playback.has-media && !Library.full;
        // The docked library hides with the other controls during playback.
        visible: !self.docked || root.show-ui;
        sidebar: self.docked;
        x: 0; y: 40px;
        width: self.docked ? min(427px, root.width) : root.width;
        height: root.height - 40px - (self.docked ? root.bar-h : 0px);
        items: Library.items; continue-items: Library.continue; recent-items: Library.recent; pinned-items: Library.pinned;
        listen-items: Library.listen; folder-items: Library.folders; list-items: Library.lists; artist-items: Library.artists;
        nav: Library.nav; crumb-keys: Library.crumb-keys; crumb-labels: Library.crumb-labels;
        sort: Library.sort; grid: Library.grid; count: Library.count; scanning: Library.scanning; has-media: Playback.has-media;
        can-back: Library.can-back; can-forward: Library.can-forward;
        query <=> Library.query;
        navigate(k) => { Library.query = ""; Library.navigate(k); }
        history(f) => { Library.query = ""; Library.history(f); }
        search(q) => { Library.search(q); }
        open(k, kind) => { Library.open(k, kind); }
        menu-request(kind, x, y, c) => { Menus.menu-request(kind, x, y, c); }
        open-file() => { Playback.open-file(); }
        open-network() => { Overlays.network-open = true; }
        sources: Extensions.sources;
        open-source(id) => { Extensions.run(id, "::source"); }
        widgets: Extensions.widgets;
        run-widget(id, cmd) => { Extensions.run(id, cmd); }
        open-extensions() => { Extensions.select(Extensions.tab, false); }
        add-folders() => { Settings.category = 8; Overlays.settings-open = true; Settings.refresh(8, "", false); }
        clear-recent() => { Library.clear-recent(); }
        forget-recent(it) => { Library.menu(it.recent-key, it.kind, "forget-recent"); }
        popout() => {
            if (Playback.has-media) { Library.full = !Library.full; } else { Playback.open-file(); }
        }
    }

    // ---------- Top bar (title) ----------
    // Hover strip that reveals the bar. It must sit *below* the bar in z-order (declared
    // first); declared after it, it swallowed every click on the top-bar buttons.
    top-ta := TouchArea { y: 0; height: 40px; changed has-hover => { root.activity(); } }
    if !root.mini && (root.show-ui || top-ta.has-hover): Rectangle {
        y: 0; height: 40px;
        background: Playback.has-media ? Theme.bar : Theme.bg-a4;
        HorizontalLayout {
            padding-left: 6px; padding-right: 6px; padding-top: 4px; padding-bottom: 4px; spacing: Theme.gap;
            IconButton { tab-focus: false; icon: @image-url("../assets/icons/open.svg"); tip: "Open file"; clicked => { Playback.open-file(); } }
            if Playback.has-media: IconButton { tab-focus: false; icon: @image-url("../assets/icons/home.svg"); tip: "Library"; active: Overlays.library-open; clicked => { Overlays.library-open = !Overlays.library-open; } }
            Text {
                horizontal-stretch: 1;
                text: Playback.has-media ? Playback.media-title : "Vivi Media Player";
                color: Theme.fg-a2; horizontal-alignment: center; vertical-alignment: center;
                overflow: elide;
            }
            if Playback.has-media: IconButton { tab-focus: false; icon: @image-url("../assets/icons/pip.svg"); tip: "Miniplayer (P)"; clicked => { Playback.toggle-mini(); } }
            IconButton { tab-focus: false; icon: @image-url("../assets/icons/settings.svg"); tip: "Settings (Ctrl+,)"; active: Overlays.settings-open; clicked => { Overlays.settings-open = !Overlays.settings-open; Settings.refresh(Settings.category, "", false); } }
            IconButton { tab-focus: false; icon: @image-url("../assets/icons/fullscreen.svg"); tip: root.fullscreen ? "Exit fullscreen (F)" : "Fullscreen (F)"; active: root.fullscreen; clicked => { Playback.toggle-fullscreen(); } }
        }
    }

    if !root.mini && Playback.has-media && Viz.audio && !Overlays.library-open && !Overlays.karaoke-open && (root.show-ui || top-ta.has-hover): VizDropdown {
        x: 12px; y: 50px;
        modes: Viz.modes; mode: Viz.mode;
        select(i) => { Viz.select(i); }
    }

    // ---------- Plugin side drawer (src/drawer.rs); hides with the controls ----------
    if !root.mini && Playback.has-media && Overlays.drawer-open && root.show-ui: SideDrawer {
        width: root.width < 800px ? root.width : 360px;
        x: root.width - self.width - (Overlays.panel-open && root.width >= 800px ? 400px : 0);
        y: 40px;
        height: root.height - 40px - root.bar-h;
        close => { Overlays.drawer-open = false; fs.focus(); }
    }

    // ---------- Side panel ----------
    if !root.mini && Playback.has-media && Overlays.panel-open: SidePanel {
        // Overlays the video; full width on narrow windows.
        scroll-y <=> Panel.scroll;
        width: root.width < 800px ? root.width : 400px;
        x: root.width - self.width;
        y: 40px;
        height: root.height - 40px - root.bar-h;
        tab <=> Panel.tab;
        sub-tracks: Panel.sub-tracks; audio-tracks: Panel.audio-tracks;
        audio-devices: Panel.audio-devices; chapters: Panel.chapters; chapter-thumbs: Panel.chapter-thumbs; chapter-has-thumb: Panel.chapter-has-thumb;
        chapters-refresh => { Panel.chapters-refresh(); }
        ab-state: Playback.ab-state; sleep-state: Panel.sleep-state; hwdec: Panel.hwdec;
        set-prop(n, v) => { Panel.set-prop(n, v); }
        run(c) => { Panel.run(c); }
        load-sub() => { Panel.load-sub(); }
        sleep(m) => { Panel.sleep(m); }
        bookmarks: Panel.bookmarks;
        seek-to(k) => { Playback.seek(k.to-float()); }
        add-bookmark() => { Panel.add-bookmark(); }
        remove-bookmark() => { Panel.remove-bookmark(); }
        chapter-times: Panel.chapter-times;
        viz-modes: Viz.modes; viz-mode: Viz.mode;
        viz-select(i) => { Viz.select(i); }
        lyrics-enabled: Lyrics.enabled; karaoke-open: Overlays.karaoke-open; lyrics-source: Lyrics.source;
        lyrics-offset-s: Lyrics.offset; subs-offset-s: Panel.pv-sub-delay;
        lyrics-offset: Lyrics.offset-label; lyrics-can-save: Lyrics.can-save; lyrics-manual: Lyrics.manual;
        lyrics(n, a) => { root.plugin-command("lyrics", n, a); }
        subs-enabled: Subtitles.plugin; subs-offset: Subtitles.offset; subs-has-pick: Subtitles.has-pick; subs-pick-label: Subtitles.pick-label; subs-sync: Subtitles.sync;
        subs(n, a) => { if (n == "offset" || n == "sync") { Panel.sub-offset(n, a); } else { root.plugin-command("subtitle-search", n, a); } }
        find-subs() => { root.add-subs(); }
        open-settings(c) => { Settings.category = c; Overlays.settings-open = true; Settings.refresh(c, "", false); }
        queue: Panel.queue; playlists: Panel.playlists;
        queue-play(i) => { Panel.queue-play(i); }
        queue-move(i, d) => { Panel.queue-move(i, d); }
        queue-remove(i) => { Panel.queue-remove(i); }
        queue-add() => { Panel.queue-add(); }
        queue-clear() => { Panel.queue-clear(); }
        playlist-save(n) => { Panel.playlist-save(n); }
        playlist-load(k) => { Panel.playlist-load(k); }
        playlist-delete(k) => { Panel.playlist-delete(k); }
        preset-name: Panel.preset-name;
        library: Panel.lib;
        library-search(q) => { Panel.lib-search(q); }
        library-play(k) => { Library.open(k, "video"); }
        recent: Library.recent;
        recent-open(it) => { Library.open(it.key, it.kind); }
        library-enqueue(k) => { Library.menu(k, "video", "enqueue"); }
        sub-delay <=> Panel.pv-sub-delay;
        sub-scale <=> Panel.pv-sub-scale;
        sub-pos <=> Panel.pv-sub-pos;
        audio-delay <=> Panel.pv-audio-delay;
        boost <=> Panel.pv-boost;
        rotate <=> Panel.pv-rotate;
        zoom <=> Panel.pv-zoom;
        panscan <=> Panel.pv-panscan;
        brightness <=> Panel.pv-brightness;
        contrast <=> Panel.pv-contrast;
        saturation <=> Panel.pv-saturation;
        gamma <=> Panel.pv-gamma;
        speed <=> Panel.pv-speed;
        save-preset() => { Panel.save-preset(); }
        close() => { Overlays.panel-open = false; }
    }

    // ---------- Network stream loading spinner / error ----------
    if Notices.loading-show && !root.mini: Rectangle {
        background: transparent;
        VerticalLayout {
            alignment: center; spacing: 14px;
            HorizontalLayout { alignment: center;
                Rectangle { width: 48px; height: 48px;
                    Image {
                        width: 48px; height: 48px; source: @image-url("../assets/icons/spinner.svg");
                        colorize: Theme.accent;
                        transform-rotation: mod(animation-tick() / 1ms, 1000) * 0.36deg;
                    }
                }
            }
            Text { text: Notices.loading-buffering ? "Buffering…" : "Opening…"; color: Theme.fg-a2; font-size: Metrics.font-md; horizontal-alignment: center; }
            Text { text: Notices.loading-name; color: Theme.fg-1; font-size: Metrics.font-h3; horizontal-alignment: center; overflow: elide; }
        }
    }
    if Notices.stream-error != "": Rectangle {
        width: min(se.preferred-width + se-actions.preferred-width + 52px, root.width - 32px); height: 48px;
        x: (root.width - self.width) / 2;
        y: root.height - root.bar-h - self.height - 16px;
        border-radius: Metrics.radius-xxl; background: Theme.bar;
        // Click the message to dismiss it.
        TouchArea { accessible-role: button; accessible-label: "Dismiss: " + Notices.stream-error; clicked => { Notices.stream-error = ""; } }
        HorizontalLayout {
            padding-left: 20px; padding-right: 10px; spacing: 12px;
            se := Text { text: Notices.stream-error; color: Theme.err; font-size: Metrics.font-base; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            se-actions := HorizontalLayout {
                alignment: center; spacing: Metrics.space-1; horizontal-stretch: 0;
                if Notices.stream-url != "": FlatButton {
                    y: (48px - self.height) / 2; size: ButtonSize.sm; text: "Retry";
                    clicked => { Notices.stream-error = ""; Playback.open-url(Notices.stream-url); }
                }
                FlatButton {
                    y: (48px - self.height) / 2; size: ButtonSize.sm; text: Notices.stream-copied ? "Copied ✓" : "Copy";
                    clicked => { se-copy.select-all(); se-copy.copy(); se-copy.clear-selection(); Notices.stream-copied = true; }
                }
            }
        }
        // Invisible carrier for the clipboard copy (message and URL).
        se-copy := TextInput {
            height: 0px; visible: false; read-only: true;
            text: Notices.stream-url != "" ? Notices.stream-error + "\n" + Notices.stream-url : Notices.stream-error;
        }
    }

    // ---------- Skip intro / credits (Skip Intro plugin) ----------
    if Playback.has-media && SkipIntro.label != "" && !root.mini: SkipButton {
        x: root.width - self.width - 24px;
        y: root.height - (root.show-ui ? root.bar-h : 0px) - self.height - 24px;
        text: SkipIntro.label;
        icon: SkipIntro.icon;
        clicked => { root.plugin-command("skip-intro", "skip", ""); fs.focus(); }
        dismiss => { root.plugin-command("skip-intro", "dismiss", ""); fs.focus(); }
    }

    // ---------- Controls ----------
    // ---------- Bottom bar: every element is a movable item (Customize Player) ----------
    // Compact / Waveform / Plain: one row with the seekbar inline where "seek" sits.
    // Classic: the seekbar spans a row on top and "seek" becomes a flexible gap.
    if !root.mini && Playback.has-media && root.show-ui: Rectangle {
        y: root.height - self.height;
        height: root.bar-h;
        background: Theme.bar-dark;
        TouchArea { } // swallow clicks so they don't toggle play
        Rectangle { y: 0; height: 1px; background: Theme.bar-line; }
        VerticalLayout {
            padding-left: root.bar.pad-x-left; padding-right: root.bar.pad-x-right;
            padding-top: root.bar.pad-top; padding-bottom: root.bar.pad-bottom;
            spacing: 2px;
            if root.bar-classic: SeekBar {
                position: Playback.position; duration: Playback.duration;
                frames: Playback.preview-frames;
                chapters: Playback.chapter-starts; ab-a: Playback.ab-a; ab-b: Playback.ab-b; range-a: Playback.range-a; range-b: Playback.range-b; range-label: Playback.range-label;
                ab-set(x, y) => { Playback.set-ab(x, y); }
                fmt(t) => { root.fmt(t) }
                seek(t) => { Playback.seek(t); fs.focus(); }
            }
            HorizontalLayout {
                spacing: root.bar.gap;
                for id[i] in Customize.bar-items: HorizontalLayout {
                    property <bool> on: i >= Customize.bar-cum.length || Customize.bar-cum[i] < 0 || Customize.bar-cum[i] <= root.bar-fit;
                    property <bool> ab: Playback.ab-a >= 0 && Playback.ab-b >= 0;
                    horizontal-stretch: id == "seek" || id == "spacer" ? 1 : 0;
                    spacing: 2px;
                    if id == "prev": IconButton { tab-focus: false; size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; tip: "Previous"; icon: @image-url("../assets/icons/previous.svg"); clicked => { Playback.prev(); } }
                    if id == "play": IconButton { tab-focus: false; size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; primary: true; tip: Playback.playing ? "Pause" : "Play"; icon: Playback.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg"); clicked => { Playback.toggle-play(); fs.focus(); } }
                    if id == "next": IconButton { tab-focus: false; size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; tip: "Next"; icon: @image-url("../assets/icons/next.svg"); clicked => { Playback.next(); } }
                    if on && id == "back10": IconButton { tab-focus: false; size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; tip: "Back 10 s"; icon: @image-url("../assets/icons/backward-10-sec.svg"); clicked => { Playback.seek(max(0, Playback.position - 10)); fs.focus(); } }
                    if on && id == "fwd10": IconButton { tab-focus: false; size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; tip: "Forward 10 s"; icon: @image-url("../assets/icons/forward-10-sec.svg"); clicked => { Playback.seek(min(Playback.duration, Playback.position + 10)); fs.focus(); } }
                    if id == "time": HorizontalLayout {
                        padding-left: 8px; padding-right: 6px; spacing: 4px;
                        Text {
                            text: ab ? "*" + fmt(Playback.ab-a) : fmt(Playback.position);
                            color: ab ? Theme.accent-bright : (root.bar-classic ? Theme.fg-1 : Theme.fg-a2);
                            font-size: Metrics.font-sm; vertical-alignment: center;
                        }
                        if ab: Text {
                            text: "‹"; color: na.has-hover ? Theme.accent-bright : Theme.fg-a2; font-size: Metrics.font-h3; vertical-alignment: center; width: 14px; horizontal-alignment: center;
                            na := TouchArea { accessible-role: button; accessible-label: "Loop start 0.5 s earlier"; mouse-cursor: pointer; clicked => { Playback.set-ab(max(0, Playback.ab-a - 0.5), Playback.ab-b); } }
                        }
                    }
                    if id == "duration": HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; spacing: 4px;
                        if ab: Text {
                            text: "›"; color: nb.has-hover ? Theme.accent-bright : Theme.fg-a2; font-size: Metrics.font-h3; vertical-alignment: center; width: 14px; horizontal-alignment: center;
                            nb := TouchArea { accessible-role: button; accessible-label: "Loop end 0.5 s later"; mouse-cursor: pointer; clicked => { Playback.set-ab(Playback.ab-a, min(Playback.duration, Playback.ab-b + 0.5)); } }
                        }
                        Text {
                            text: ab ? "*" + fmt(Playback.ab-b) : fmt(Playback.duration);
                            color: ab ? Theme.accent-bright : Theme.fg-a2;
                            font-size: Metrics.font-sm; vertical-alignment: center;
                        }
                        if ab: IconButton { tab-focus: false; size: true ? ButtonSize.sm : ButtonSize.md; tip: "Clear A-B range"; icon: @image-url("../assets/icons/close.svg"); clicked => { Playback.set-ab(-1, -1); fs.focus(); } }
                    }
                    // Centred on the row (a fixed-height child would sit at the top).
                    if id == "seek" && !root.bar-classic: VerticalLayout { alignment: center; horizontal-stretch: 1; SeekBar {
                        horizontal-stretch: 1;
                        height: Playback.wave-peaks.length > 0 ? Metrics.bar-wave-h : Metrics.bar-track-h;
                        boxed: root.bar.boxed;
                        track-h: 4px;
                        position: Playback.position; duration: Playback.duration;
                        frames: Playback.preview-frames; peaks: Playback.wave-peaks;
                        chapters: Playback.chapter-starts; ab-a: Playback.ab-a; ab-b: Playback.ab-b; range-a: Playback.range-a; range-b: Playback.range-b; range-label: Playback.range-label;
                        ab-set(x, y) => { Playback.set-ab(x, y); }
                        fmt(t) => { root.fmt(t) }
                        seek(t) => { Playback.seek(t); fs.focus(); }
                    } }
                    if id == "spacer" || (id == "seek" && root.bar-classic): Rectangle { horizontal-stretch: 1; }
                    // A plugin's button (`controlbar.button`), when the user added it in Customize.
                    if on && i < Customize.bar-meta.length && Customize.bar-meta[i].label != "": IconButton { tab-focus: false;
                        size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; tip: Customize.bar-meta[i].label;
                        icon: Icons.plugin(Customize.bar-meta[i].icon);
                        clicked => { root.bar-act(id); fs.focus(); }
                    }
                    if on && !root.is-core(id) && (i >= Customize.bar-meta.length || Customize.bar-meta[i].label == ""): BarItem {
                        id: id; compact: !root.bar-classic; wide: root.bar-has-volume; active: root.bar-active(id); vstyle: Customize.vol-style; boxed: root.bar.boxed; muted: Playback.muted; volume: Playback.volume; volume-max: Playback.volume-max; fullscreen: root.fullscreen;
                        act(x) => { root.bar-act(x); fs.focus(); }
                        volume-changed(v) => { Playback.volume = v; Playback.volume-changed(v); }
                    }
                }
                if Customize.bar-slots > root.bar-fit: IconButton { tab-focus: false;
                    size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; icon: @image-url("../assets/icons/more.svg"); tip: "More";
                    clicked => { overflow.show(); }
                }
            }
        }
    }

    // ---------- Extension hint above the seek bar (src/preview.rs) ----------
    // Toast look, high enough to clear the seek bar's hover time (and above a toast).
    if !root.mini && Playback.has-media && root.show-ui && Notices.hint-text != "": Rectangle {
        width: min(hint.preferred-width, root.width - 32px); height: 44px;
        x: (root.width - self.width) / 2;
        y: root.height - root.bar-h - self.height - (Notices.resume-text != "" ? 84px : 40px);
        border-radius: Metrics.radius-xxl;
        background: Theme.bar;
        border-width: 1px; border-color: Theme.divider;
        TouchArea { } // keep clicks off the video
        hint := HorizontalLayout {
            padding-left: Metrics.space-4; padding-right: Metrics.space-2; spacing: Metrics.space-4;
            Text { text: Notices.hint-text; color: Theme.fg-2; font-size: Metrics.font-base; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: Metrics.space-1; horizontal-stretch: 0;
                VerticalLayout { alignment: center;
                    PrimaryButton { size: ButtonSize.sm; text: Notices.hint-action; clicked => { Notices.hint-accept(); fs.focus(); } }
                }
                VerticalLayout { alignment: center;
                    FlatButton { size: ButtonSize.sm; text: "Don't show again"; clicked => { Notices.hint-never(); fs.focus(); } }
                }
            }
        }
    }

    // ---------- Miniplayer (Figma "Miniplayer" variants) ----------
    // Tiny: video only; hovering shows play/pause and the way back.
    if root.mini && root.mini-tiny && Playback.has-media && root.show-ui: Rectangle {
        width: root.width; height: root.mini-video-h; x: 0; y: root.mini-video-y;
        background: Theme.scrim-soft;
        IconButton { tab-focus: false; x: 6px; y: 6px; icon: @image-url("../assets/icons/window.svg"); tip: "Full player (P)"; clicked => { Playback.toggle-mini(); } }
        IconButton { tab-focus: false;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            primary: true; tip: Playback.playing ? "Pause" : "Play";
            icon: Playback.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
            clicked => { Playback.toggle-play(); fs.focus(); }
        }
        Rectangle {
            y: parent.height - 4px; height: 4px; x: 0;
            width: Playback.duration > 0 ? parent.width * Playback.position / Playback.duration : 0;
            background: Theme.accent;
        }
    }
    // Compact: × / ⧉ in the corners, transport in the middle, progress along the bottom edge.
    if root.mini && !root.mini-tiny && Playback.has-media && root.show-ui: Rectangle {
        width: root.width; height: root.mini-video-h; x: 0; y: root.mini-video-y;
        background: Theme.scrim-soft;
        IconButton { tab-focus: false; x: 8px; y: 8px; icon: @image-url("../assets/icons/close.svg"); tip: "Stop and close the miniplayer"; clicked => { Playback.stop(); Playback.toggle-mini(); } }
        IconButton { tab-focus: false; x: parent.width - self.width - 8px; y: 8px; icon: @image-url("../assets/icons/window.svg"); tip: "Full player (P)"; clicked => { Playback.toggle-mini(); } }
        HorizontalLayout {
            x: (parent.width - self.preferred-width) / 2; y: (parent.height - 40px) / 2; width: self.preferred-width; height: 40px;
            spacing: 18px; alignment: center;
            IconButton { tab-focus: false; y: 4px; tip: "Previous"; icon: @image-url("../assets/icons/previous.svg"); clicked => { Playback.prev(); } }
            IconButton { tab-focus: false; y: 2px; primary: true; tip: Playback.playing ? "Pause" : (Playback.duration > 0 && Playback.position >= Playback.duration - 0.5 ? "Replay" : "Play"); icon: Playback.playing ? @image-url("../assets/icons/pause.svg") : (Playback.duration > 0 && Playback.position >= Playback.duration - 0.5 ? @image-url("../assets/icons/replay.svg") : @image-url("../assets/icons/play.svg")); clicked => { Playback.toggle-play(); fs.focus(); } }
            IconButton { tab-focus: false; y: 4px; tip: "Next"; icon: @image-url("../assets/icons/next.svg"); clicked => { Playback.next(); } }
        }
        Rectangle {
            x: 10px; width: parent.width - 20px; y: parent.height - 18px; height: 14px;
            Rectangle { y: 5px; height: 4px; border-radius: self.height / 2; background: Theme.on-media-dim; }
            Rectangle { x: 0; y: 5px; height: 4px; border-radius: self.height / 2; width: Playback.duration > 0 ? parent.width * Playback.position / Playback.duration : 0; background: Theme.accent.mix(Theme.video-bg, 70%); }
            Rectangle {
                x: (Playback.duration > 0 ? parent.width * Playback.position / Playback.duration : 0) - 5px; y: 2px;
                width: 10px; height: 10px; border-radius: self.height / 2; background: Theme.accent;
            }
            TouchArea {
                mouse-cursor: pointer;
                accessible-role: slider; accessible-label: "Seek";
                accessible-value-minimum: 0; accessible-value-maximum: Playback.duration; accessible-value: round(Playback.position) + " s";
                clicked => { if (Playback.duration > 0) { Playback.seek(clamp(self.mouse-x / self.width, 0, 1) * Playback.duration); } }
            }
        }
    }
    // Info strip under the video: title, folder, subtitle track and the queue toggle.
    if root.mini && !root.mini-tiny: Rectangle {
        x: 0; y: root.mini-video-y + root.mini-video-h; width: root.width; height: root.mini-strip-h;
        background: Theme.bar-solid;
        TouchArea { }
        VerticalLayout {
            padding-left: 12px; padding-right: 8px; padding-top: 7px; padding-bottom: 5px; spacing: 2px;
            Text { text: Playback.media-title; color: Theme.fg-a2; font-size: Metrics.font-sm; overflow: elide; }
            HorizontalLayout {
                spacing: 6px;
                Icon { y: 4px; width: 14px; height: 14px; source: @image-url("../assets/icons/folder.svg"); tint: Theme.fg-a3; }
                Text { text: root.mini-folder; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; overflow: elide; max-width: 120px; }
                Rectangle { width: 6px; }
                Icon { y: 4px; width: 14px; height: 14px; source: @image-url("../assets/icons/subtitles.svg"); tint: Theme.fg-a3; }
                Text { text: root.mini-sub; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Rectangle {
                    width: 26px; height: 22px; border-radius: Metrics.radius-sm;
                    background: qta.has-hover ? Theme.bg-a1 : transparent;
                    Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/queue.svg"); tint: root.mini-queue ? Theme.accent : Theme.fg-a2; }
                    qta := TouchArea { accessible-role: button; accessible-label: "Queue"; accessible-checked: root.mini-queue; mouse-cursor: pointer; clicked => { Playback.toggle-mini-queue(); } }
                    Tooltip { text: @markdown("Queue"); }
                }
            }
        }
    }
    // Queue variant: header, item count/length with sort/remove/add, draggable rows.
    if root.mini-q-shown: Rectangle {
        y: 0; height: root.mini-q-h;
        background: Theme.bar-solid;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: 36px; background: Theme.surface-head;
                Text { text: "Queue"; color: Theme.fg-a2; font-size: Metrics.font-sm; }
            }
            HorizontalLayout {
                height: 34px; padding-left: 12px; padding-right: 6px; spacing: 2px;
                Text { text: root.mini-q-meta; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { tab-focus: false; y: 2px; width: 30px; height: 30px; icon: @image-url("../assets/icons/sort.svg"); tip: "Sort by name"; clicked => { Playback.queue-sort(); } }
                IconButton { tab-focus: false; y: 2px; width: 30px; height: 30px; icon: @image-url("../assets/icons/remove.svg"); tip: "Remove selected"; clicked => { if (root.mini-q-sel >= 0) { Panel.queue-remove(root.mini-q-sel); root.mini-q-sel = -1; } } }
                IconButton { tab-focus: false; y: 2px; width: 30px; height: 30px; icon: @image-url("../assets/icons/add.svg"); tip: "Add files"; clicked => { Panel.queue-add(); } }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start; spacing: 0px; padding-left: 6px; padding-right: 6px;
                    for it[i] in Panel.queue: Rectangle {
                        height: 30px; border-radius: Metrics.radius-sm;
                        property <length> dy;
                        background: i == root.mini-q-sel ? Theme.bg-a1 : row-ta.has-hover ? Theme.hover : transparent;
                        row-ta := TouchArea {
                            accessible-role: list-item; accessible-label: it.label; accessible-item-selected: i == root.mini-q-sel;
                            accessible-action-default => { Panel.queue-play(i); }
                            mouse-cursor: pointer;
                            clicked => { root.mini-q-sel = i; }
                            double-clicked => { Panel.queue-play(i); }
                        }
                        HorizontalLayout {
                            padding-left: 4px; padding-right: 8px; spacing: 8px;
                            Rectangle {
                                width: 22px;
                                Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/list.svg"); tint: drag.pressed ? Theme.accent : Theme.fg-a3; }
                                drag := TouchArea {
                                    accessible-role: button; accessible-label: "Drag to re-order " + it.label;
                                    mouse-cursor: grab;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.up) {
                                            let d = round((self.mouse-y - self.pressed-y) / 30px);
                                            if (d != 0) { Panel.queue-move(i, clamp(d, -i, Panel.queue.length - 1 - i)); }
                                        }
                                    }
                                }
                            }
                            Text { text: it.label; color: it.selected ? Theme.accent : Theme.fg-a2; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Text { text: i < root.queue-durations.length ? root.queue-durations[i] : ""; color: Theme.fg-a3; font-family: "DM Mono"; font-size: Metrics.font-xs; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }


    overflow := PopupWindow {
        x: root.width - 220px; y: root.height - root.bar-h - self.height - 6px;
        width: 210px;
        Rectangle {
            background: Theme.bg-a4; border-radius: Metrics.radius-md; border-width: 1px; border-color: Theme.bg-a1;
            drop-shadow-blur: 12px; drop-shadow-color: Theme.shadow;
        }
        VerticalLayout {
            padding: 6px;
            for id[i] in Customize.bar-items: OverflowRow { visible: i < Customize.bar-cum.length && Customize.bar-cum[i] > root.bar-fit; height: self.visible ? 36px : 0; id: id;
                plabel: i < Customize.bar-meta.length ? Customize.bar-meta[i].label : ""; picon: Icons.plugin(i < Customize.bar-meta.length ? Customize.bar-meta[i].icon : ""); active: root.bar-active(id); act(x) => { root.bar-act(x == "volume" ? "mute" : x); } }
        }
    }

    // ---------- Network stream ----------
    if Overlays.network-open: NetworkStreamDialog {
        width: root.width; height: root.height;
        ytdlp: Library.ytdlp; history: Dialogs.net-history; error: Dialogs.net-error;
        urls <=> Dialogs.net-urls; name <=> Dialogs.net-name;
        submit(u, n) => { Dialogs.network-submit(u, n); }
        close() => { Overlays.network-open = false; Dialogs.net-error = ""; fs.focus(); }
    }

    // ---------- New playlist ----------
    if Overlays.new-playlist-open: NewPlaylistDialog {
        width: root.width; height: root.height;
        files: Dialogs.new-playlist-files; cover: Dialogs.new-playlist-cover; has-cover: Dialogs.new-playlist-has-cover; error: Dialogs.new-playlist-error;
        name <=> Dialogs.new-playlist-name;
        pick-cover => { Dialogs.new-playlist-pick-cover(); }
        pick-files => { Dialogs.new-playlist-pick-files(); }
        remove-file(i) => { Dialogs.new-playlist-remove(i); }
        save(n) => { Dialogs.new-playlist-save(n); }
        close => { Dialogs.new-playlist-close(); fs.focus(); }
    }

    // ---------- Settings dialog ----------
    if Overlays.settings-open: SettingsDialog {
        width: root.width; height: root.height;
        categories: Settings.categories;
        rows: Settings.rows;
        category <=> Settings.category;
        status: Settings.status;
        search <=> Settings.search;
        advanced <=> Settings.advanced;
        changed(id, v) => { Settings.setting-changed(id, v); }
        refresh(c, q, adv) => { Settings.refresh(c, q, adv); }
        close() => { Overlays.settings-open = false; fs.focus(); }
    }

    // ---------- Extensions window (src/extwin.rs) ----------
    if Overlays.extensions-open: ExtensionsDialog {
        width: root.width; height: root.height;
        changed(id, v) => { Settings.setting-changed(id, v); }
        close() => { Overlays.extensions-open = false; fs.focus(); }
    }

    // ---------- Plugin QR code (above Settings, which opens it) ----------
    if Overlays.qr-open: QrDialog {
        width: root.width; height: root.height;
        title: Dialogs.qr-title; code: Dialogs.qr-code; text: Dialogs.qr-text; caption: Dialogs.qr-caption;
        close => { Overlays.qr-open = false; }
    }

    // ---------- Add Subtitles (Subtitle Search plugin) ----------
    if Overlays.subs-open: SubtitleDialog {
        width: root.width; height: root.height;
        hits: Subtitles.hits; langs: Subtitles.langs; selected: Subtitles.selected;
        details: Subtitles.details; preview: Subtitles.preview; save-next: Subtitles.save-next;
        status: Subtitles.status; busy: Subtitles.busy;
        query <=> Subtitles.query; lang <=> Subtitles.lang;
        local: Subtitles.local; folder: Subtitles.folder;
        target <=> Subtitles.target; source <=> Subtitles.source;
        cmd(n, a) => { root.plugin-command("subtitle-search", n, a); }
        close => { Overlays.subs-open = false; fs.focus(); }
    }

    // ---------- Auto-tagger / Free Music ----------
    if Overlays.md-open: MusicDialog {
        width: root.width; height: root.height;
        title: MusicDialogState.title; results: MusicDialogState.results; logos: MusicDialogState.caps.logos ? MusicDialogState.logos : []; status: MusicDialogState.status; busy: MusicDialogState.busy;
        detail: MusicDialogState.detail; placeholder: MusicDialogState.placeholder;
        detail-cover: MusicDialogState.detail-cover; has-detail-cover: MusicDialogState.has-detail-cover && MusicDialogState.detail-cover-owner == MusicDialogState.owner; search-label: MusicDialogState.search-label;
        primary-text: MusicDialogState.primary; secondary-text: MusicDialogState.secondary; sources: MusicDialogState.sources;
        source <=> MusicDialogState.source; query <=> MusicDialogState.query;
        chips: MusicDialogState.caps.chips ? MusicDialogState.chips : []; chip: MusicDialogState.chip;
        actions: MusicDialogState.caps.chips ? MusicDialogState.actions : [];
        rich: MusicDialogState.caps.rich; tracks: MusicDialogState.caps.rich ? MusicDialogState.tracks : [];
        filters: MusicDialogState.caps.rich ? MusicDialogState.filters : []; copy-text: MusicDialogState.copy;
        has-more: MusicDialogState.caps.rich && MusicDialogState.has-more;
        can-grid: MusicDialogState.caps.grid; grid: MusicDialogState.caps.grid && MusicDialogState.grid;
        view(g) => { MusicDialogState.grid = g; root.plugin-command(MusicDialogState.owner, "view", g ? "grid" : "list"); }
        filter(n, v) => { root.plugin-command(MusicDialogState.owner, "filter", n + "\u{1f}" + v); }
        more => { root.plugin-command(MusicDialogState.owner, "more", ""); }
        window(f, c) => { MusicDialogState.win-first = f; MusicDialogState.win-count = c; MusicDialogState.window-changed(); }
        edited => { if MusicDialogState.caps.rich { root.plugin-command(MusicDialogState.owner, "edited", ""); } }
        chip-clicked(c) => { root.plugin-command(MusicDialogState.owner, "chip", c); }
        action(n, i) => { root.plugin-command(MusicDialogState.owner, "act:" + n, i); }
        search => { root.plugin-command(MusicDialogState.owner, "search", ""); }
        select(i) => { root.plugin-command(MusicDialogState.owner, "select", i); }
        primary(i) => { root.plugin-command(MusicDialogState.owner, "primary", i); }
        secondary(i) => { root.plugin-command(MusicDialogState.owner, "secondary", i); }
        close => { Overlays.md-open = false; root.plugin-command(MusicDialogState.owner, "close", ""); fs.focus(); }
    }

    // ---------- Plugin confirmation (above Settings and the music dialog) ----------
    if Overlays.confirm-open: ConfirmDialog {
        width: root.width; height: root.height;
        title: Dialogs.confirm-title; heading: Dialogs.confirm-heading; text: Dialogs.confirm-text;
        ok-label: Dialogs.confirm-ok; warning: Dialogs.confirm-warning;
        answer(yes) => {
            Overlays.confirm-open = false;
            root.plugin-command(Dialogs.confirm-owner, "confirm", Dialogs.confirm-key + "\u{1f}" + (yes ? "yes" : "no"));
        }
    }

    // ---------- Find Lyrics (Lyrics plugin) ----------
    if Overlays.ls-open: LyricsSearchDialog {
        width: root.width; height: root.height;
        results: Lyrics.search-results; status: Lyrics.search-status; preview: Lyrics.search-preview; busy: Lyrics.search-busy;
        artist <=> Lyrics.search-artist; title <=> Lyrics.search-title; selected <=> Lyrics.search-selected;
        cmd(n, a) => { root.plugin-command("lyrics", n, a); if (n == "search-close") { fs.focus(); } }
    }

    // ---------- Auto-tagger review ----------
    if Overlays.tr-open: TagReviewDialog {
        width: root.width; height: root.height;
        files: TagReview.files; status: TagReview.status; busy: TagReview.busy;
        summary: TagReview.summary; summary-sub: TagReview.summary-sub; summary-ok: TagReview.summary-ok; results: TagReview.results; can-undo: TagReview.can-undo;
        cmd(n, a) => { root.plugin-command("auto-tagger", n, a); if (n == "review-close") { fs.focus(); } }
    }

    // ---------- Customize player ----------
    if Overlays.customize-open: CustomizeDialog {
        width: root.width; height: root.height;
        items: Customize.bar-items; styles: Customize.bar-styles; bar-style: Customize.bar-style;
        pick-style(st) => { Customize.style(st); }
        vol-styles: Customize.vol-styles; vol-style: Customize.vol-style;
        pick-volume(st) => { Customize.pick-volume(st); }
        available: Customize.available;
        items-meta: Customize.bar-meta; available-meta: Customize.available-meta;
        profiles: Customize.profiles; profile: Customize.profile;
        move(i, d) => { Customize.move(i, d); }
        remove(i) => { Customize.remove(i); }
        add(id) => { Customize.add(id); }
        pick-profile(p) => { Customize.select-profile(p); }
        save() => { Customize.done(true); fs.focus(); }
        cancel() => { Customize.done(false); fs.focus(); }
    }

    // ---------- First-run onboarding ----------
    if Overlays.onboarding-open: OnboardingDialog {
        width: root.width; height: root.height;
        step <=> Settings.onboarding-step;
        dark: Theme.dark; accent: Settings.accent-name;
        accents: Settings.accent-names; swatches: Settings.accent-colors;
        keys: Settings.onboarding-keys; actions: Settings.onboarding-actions;
        set-theme(t) => { Settings.setting-changed("interface.theme", t); }
        set-accent(a) => { Settings.setting-changed("interface.accent", a); }
        finish() => { Settings.onboarding-done(); fs.focus(); }
    }

    // ---------- Properties & Metadata ----------
    if Overlays.info-open: Modal {
        card-width: 520px;
        card-height: icol.preferred-height;
        inset: 48px;
        card-background: Theme.bar-solid;
        bordered: false;
        dismissed => { Overlays.info-open = false; }
        icol := VerticalLayout {
            padding: 20px; spacing: 10px;
            Text { text: Dialogs.info-title; color: Theme.fg-1; font-size: Metrics.font-lg; overflow: elide; }
            Rectangle { height: 1px; background: Theme.bg-a1; }
            for k[i] in Dialogs.info-keys: HorizontalLayout {
                spacing: 10px;
                Text { text: k; color: Theme.fg-a3; font-size: Metrics.font-base; width: 110px; }
                Text { text: Dialogs.info-values[i]; color: Theme.fg-a2; font-size: Metrics.font-base; wrap: word-wrap; horizontal-stretch: 1; }
            }
            HorizontalLayout {
                alignment: end;
                PrimaryButton {
                    size: ButtonSize.sm; min-w: 80px; text: "Close";
                    clicked => { Overlays.info-open = false; }
                }
            }
        }
    }

    // ---------- Keyboard shortcuts ("?") ----------
    if Overlays.shortcuts-open: ShortcutsDialog {
        width: root.width; height: root.height;
        actions: Settings.shortcut-actions; keys: Settings.shortcut-keys;
        close => { Overlays.shortcuts-open = false; fs.focus(); }
    }

    // ---------- Toast / resume prompt (above every screen and dialog, below the menus;
    // also without media, e.g. plugin results while browsing the library or Extensions) ----------
    if Notices.resume-text != "": Rectangle {
        width: toast.preferred-width; height: 52px;
        x: (root.width - self.width) / 2;
        y: root.height - (Playback.has-media ? root.bar-h : 0px) - self.height - 16px;
        border-radius: Metrics.radius-xxl;
        background: Theme.bar;
        toast := HorizontalLayout {
            padding-left: 20px; padding-right: 10px; spacing: 24px;
            Text { text: Notices.resume-text; color: Theme.fg-2; font-size: Metrics.font-lg; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 10px; padding-top: 10px; padding-bottom: 10px;
                if Notices.toast-action != "" && Notices.toast-action-text == Notices.resume-text: Rectangle {
                    width: ta-label.preferred-width + 20px; border-radius: Metrics.radius-md; background: Theme.accent-bg;
                    ta-label := Text { text: Notices.toast-action; color: Theme.accent-bright; vertical-alignment: center; }
                    TouchArea { accessible-role: button; accessible-label: Notices.toast-action; mouse-cursor: pointer; accessible-action-default => { Notices.toast-run(Notices.toast-action-id); } clicked => { Notices.toast-run(Notices.toast-action-id); } }
                }
                if Notices.resume-offer != "" && Notices.resume-offer == Notices.resume-text: Rectangle {
                    width: so.preferred-width + 20px; border-radius: Metrics.radius-md; background: Theme.accent-bg;
                    so := Text { text: "Start over"; color: Theme.accent-bright; vertical-alignment: center; }
                    TouchArea { accessible-role: button; accessible-label: "Start over"; mouse-cursor: pointer; accessible-action-default => { Notices.start-over(); } clicked => { Notices.start-over(); } }
                }
                Rectangle {
                    width: 44px; border-radius: Metrics.radius-md; background: Theme.accent;
                    Text { text: "OK"; color: Theme.bg-b2; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                    TouchArea { accessible-role: button; accessible-label: "OK"; mouse-cursor: pointer; clicked => { Notices.dismiss-resume(); } }
                }
            }
        }
    }

    // ---------- Menus (topmost) ----------
    // ---------- Command palette (src/palette.rs) ----------
    if Overlays.palette-open: PaletteDialog {
        width: root.width; height: root.height;
        close => { Overlays.palette-open = false; fs.focus(); }
    }

    if Menus.menu-kind != "": TouchArea {
        clicked => { Menus.menu-kind = ""; Menus.sub-open = ""; }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { Menus.menu-kind = ""; Menus.sub-open = ""; }
        }
    }
    if Menus.menu-kind != "": main-menu := MenuPanel {
        width: Menus.menu-width;
        x: max(4px, min(Menus.menu-x, root.width - self.width - 4px));
        y: max(4px, min(Menus.menu-y, root.height - self.height - 4px));
        items: Menus.menu-items;
        open-sub: Menus.sub-open;
        activated(id) => { Menus.menu-activate(id); }
        row-hovered(id, y) => {
            Menus.sub-y = self.y + y - 4px;
            Menus.sub-open = id;
            Menus.menu-sub(id);
        }
    }
    if Menus.menu-kind != "" && Menus.sub-open != "" && Menus.sub-items.length > 0: MenuPanel {
        property <length> right-x: Menus.menu-x + Menus.menu-width - 4px;
        width: 265px;
        x: self.right-x + self.width > root.width ? max(4px, Menus.menu-x - self.width + 4px) : self.right-x;
        y: max(4px, min(Menus.sub-y, root.height - self.height - 4px));
        items: Menus.sub-items;
        activated(id) => { Menus.menu-activate(id); }
    }
    } // keys
}
