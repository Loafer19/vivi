// Vivi player UI. Layout & tokens follow the Figma "Player" frame:
// topbar 40px #191919 (pad 6, gap 10, title Inter 14 #8F8F8F centered),
// Controls 54px #191919 @93% (pad 20/11, gap 20), radii 4/6.

import { Theme, Metrics, Icon } from "core/theme.slint";
import { ScrollView } from "std-widgets.slint";
import { SidePanel, Item } from "panel.slint";
import { SettingsDialog, SettingRow } from "settings.slint";
import { CustomizeDialog, Tools } from "toolbar.slint";
import { OnboardingDialog } from "onboarding.slint";
import { LibraryView, LibItem } from "library.slint";
import { NetworkStreamDialog, NewPlaylistDialog, QrDialog, ShortcutsDialog } from "dialogs.slint";
import { FxState } from "filters.slint";
import { MenuPanel, MenuItem } from "menu.slint";
import { VizView, VizDropdown } from "viz.slint";
import { SkipButton, LyricsView, SubtitleDialog, MusicDialog, FmRow, MdFilter, NowPlayingCard, TagReviewDialog, TagFile, TagField, TagCover, TagResult, KaraokeView, LyricsState, LyricsSearchDialog, KWord, LyricsHit, SubHit } from "plugins.slint";
import { Modal } from "core/modal.slint";
import { IconButton, PrimaryButton, ButtonSize } from "core/buttons.slint";
import { BarStyle, BarMetrics, Bars, PanelTab, Overlay, TagStatus } from "core/types.slint";
import { Overlays } from "state/overlays.slint";
export { MenuItem } from "menu.slint";
export { About } from "about.slint";
export { Item, SettingRow, Theme, LibItem, FxState, LyricsState, BarStyle, PanelTab, Overlay, TagStatus, Overlays }

component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <[image]> frames; // evenly spaced preview frames (may be empty / partial)
    in property <[float]> chapters; // chapter start times (s) → segment gaps on the track
    in property <[float]> peaks; // audio waveform peaks 0..1 (empty = plain bar)
    in property <float> range-a: -1; // plugin range (vivi-range), drawn in blue
    in property <float> range-b: -1;
    in property <string> range-label;
    in property <float> ab-a: -1; // A-B loop / range bounds in seconds (-1 = unset)
    in property <float> ab-b: -1;
    in property <length> track-h: 8px;
    in property <bool> boxed: false; // full-height dark track, dim fill, slim bright handle
    callback seek(float);
    callback ab-set(float, float);
    pure callback fmt(float) -> string;
    height: 18px;
    property <float> frac: duration > 0 ? clamp(position / duration, 0, 1) : 0;
    property <float> hover-frac: clamp(ta.mouse-x / self.width, 0, 1);
    property <bool> wave: root.peaks.length > 0;
    property <float> ra: root.duration > 0 && root.ab-a >= 0 ? clamp(root.ab-a / root.duration, 0, 1) : -1;
    property <float> rb: root.duration > 0 && root.ab-b >= 0 ? clamp(root.ab-b / root.duration, 0, 1) : (root.ra >= 0 ? root.frac : -1);
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.wave || root.boxed ? root.height : (ta.has-hover ? root.track-h + 2px : root.track-h);
        border-radius: root.boxed ? 4px : 2px;
        background: root.wave ? transparent : root.boxed ? Theme.track : Theme.bg-a1;
        clip: root.boxed;
        if ta.has-hover && !root.wave: Rectangle {
            x: root.boxed ? 1.5px : 0; y: root.boxed ? 1.5px : 0;
            height: parent.height - (root.boxed ? 3px : 0); border-radius: root.boxed ? 2.5px : 2px;
            width: max(0, (parent.width - (root.boxed ? 3px : 0)) * root.hover-frac);
            background: root.boxed ? Theme.track-tick : Theme.divider;
        }
        if !root.wave: Rectangle {
            x: root.boxed ? 1.5px : 0; y: root.boxed ? 1.5px : 0;
            height: parent.height - (root.boxed ? 3px : 0); border-radius: root.boxed ? 2.5px : 2px;
            width: max(0, (parent.width - (root.boxed ? 3px : 0)) * (ta.pressed ? root.hover-frac : root.frac));
            background: root.boxed ? (ta.has-hover ? Theme.track-fill-hover : Theme.track-fill) : (ta.has-hover ? Theme.accent-bright : Theme.accent);
        }
        // Waveform: one bar per peak, the played part in the accent colour.
        for v[i] in root.peaks: Rectangle {
            x: parent.width * i / root.peaks.length;
            width: max(1px, parent.width / root.peaks.length - 1px);
            height: max(2px, parent.height * clamp(v, 0, 1));
            y: (parent.height - self.height) / 2;
            border-radius: Metrics.radius-xs;
            background: (i + 0.5) / root.peaks.length <= (ta.pressed ? root.hover-frac : root.frac) ? Theme.accent
                : ta.has-hover && (i + 0.5) / root.peaks.length <= root.hover-frac ? Theme.fg-a2 : Theme.fg-a3;
        }
        // Chapter boundaries cut the track into segments.
        for c in root.chapters: Rectangle {
            visible: root.duration > 0 && c > 0.5 && c < root.duration - 0.5;
            x: parent.width * c / max(root.duration, 1) - 2px; width: 4px;
            height: parent.height; background: Theme.bar.with-alpha(1);
            // Notch above and below so boundaries read on thin tracks too.
            if !root.boxed: Rectangle { x: 1px; width: 2px; y: -4px; height: 3px; border-radius: self.width / 2; background: Theme.fg-a2; }
            if !root.boxed: Rectangle { x: 1px; width: 2px; y: parent.height + 1px; height: 3px; border-radius: self.width / 2; background: Theme.fg-a2; }
        }
        // Plugin range (Cut & Export In/Out)
        if root.duration > 0 && root.range-a >= 0: Rectangle {
            property <float> e: root.range-b >= 0 ? root.range-b : root.position;
            x: parent.width * clamp(min(root.range-a, self.e) / root.duration, 0, 1);
            width: parent.width * clamp(abs(self.e - root.range-a) / root.duration, 0, 1);
            height: parent.height; border-radius: Metrics.radius-xs;
            background: Theme.range.with-alpha(0.25); border-width: 1px; border-color: Theme.range;
        }
        // A-B range overlay
        if root.ra >= 0 && root.rb >= 0: Rectangle {
            x: parent.width * min(root.ra, root.rb); width: parent.width * abs(root.rb - root.ra);
            height: parent.height; border-radius: Metrics.radius-xs;
            background: Theme.accent.with-alpha(0.28);
            border-width: 1px; border-color: Theme.accent-bright;
        }
    }
    // Playhead handle (compact style)
    if root.duration > 0 && !root.wave: Rectangle {
        width: root.boxed ? 5px : 4px; height: root.boxed ? root.height - 3px : root.track-h + 8px; border-radius: root.boxed ? 2.5px : 2px;
        x: clamp(1.5px + (root.width - 3px) * (ta.pressed ? root.hover-frac : root.frac) - self.width, 1.5px, root.width - self.width - 1.5px); y: (root.height - self.height) / 2;
        background: Theme.accent;
        visible: root.boxed || root.track-h > 8px || ta.has-hover;
    }
    // Hover frame preview (#10)
    if ta.has-hover && root.duration > 0 && root.frames.length > 0: Rectangle {
        y: -30px - 6px - 108px;
        width: 192px; height: 108px;
        x: clamp(ta.mouse-x - self.width / 2, 0, root.width - self.width);
        border-radius: Metrics.radius-md; clip: true;
        background: Theme.video-bg;
        border-width: 1px; border-color: Theme.divider;
        Image {
            width: parent.width; height: parent.height; image-fit: contain;
            source: root.frames[round(root.hover-frac * (root.frames.length - 1))];
        }
    }
    // Hover time tooltip
    if ta.has-hover && root.duration > 0: Rectangle {
        y: -30px;
        width: tiptext.preferred-width + 12px; height: 22px;
        x: clamp(ta.mouse-x - self.width / 2, 0, root.width - self.width);
        border-radius: Metrics.radius-sm;
        background: Theme.bg-a1;
        tiptext := Text {
            text: root.fmt(root.hover-frac * root.duration);
            color: Theme.fg-1; font-family: "DM Mono"; font-size: Metrics.font-sm;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && root.duration > 0) {
                root.seek(root.hover-frac * root.duration);
            }
        }
    }
    // Draggable A/B edge handles
    if root.ra >= 0 && root.ab-b >= 0: Rectangle {
        x: root.width * root.ra - 5px; width: 10px; height: root.height + 6px; y: -3px;
        Rectangle { x: 3px; width: 4px; border-radius: self.width / 2; background: ha.has-hover || ha.pressed ? Theme.on-media : Theme.accent-bright; }
        ha := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed) {
                    root.ab-set(clamp((parent.x + self.mouse-x) / root.width, 0, 1) * root.duration, root.ab-b);
                }
            }
        }
    }
    if root.ab-a >= 0 && root.ab-b >= 0: Rectangle {
        x: root.width * root.rb - 5px; width: 10px; height: root.height + 6px; y: -3px;
        Rectangle { x: 3px; width: 4px; border-radius: self.width / 2; background: hb.has-hover || hb.pressed ? Theme.on-media : Theme.accent-bright; }
        hb := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed) {
                    root.ab-set(root.ab-a, clamp((parent.x + self.mouse-x) / root.width, 0, 1) * root.duration);
                }
            }
        }
    }
}

// Cone volume control (Figma "volume": 88x28 wedge, green→red gradient fill).
// The fill width follows the Figma states: 10% → 7px … 100% → 63px, 150% → 75px, 200% → 88px.
component VolumeBar inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 150;
    callback changed(float);
    in property <bool> compact: false;
    width: compact ? 56px : 88px; height: compact ? 18px : 28px;
    // volume (percent) → filled width in Figma units (0..88)
    pure function fill-of(v: float) -> float {
        if (v <= 0) { return 0; }
        if (v <= 50) { return v * 0.66; }
        if (v <= 60) { return 33 + (v - 50) * 0.8; }
        if (v <= 70) { return 41 + (v - 60) * 0.7; }
        if (v <= 100) { return 48 + (v - 70) * 0.5; }
        if (v <= 150) { return 63 + (v - 100) * 0.24; }
        return min(88, 75 + (v - 150) * 0.26);
    }
    // inverse of fill-of
    pure function volume-of(x: float) -> float {
        if (x <= 33) { return x / 0.66; }
        if (x <= 41) { return 50 + (x - 33) / 0.8; }
        if (x <= 48) { return 60 + (x - 41) / 0.7; }
        if (x <= 63) { return 70 + (x - 48) / 0.5; }
        if (x <= 75) { return 100 + (x - 63) / 0.24; }
        return 150 + (x - 75) / 0.26;
    }
    property <float> fx: fill-of(min(root.value, root.maximum));
    // wedge edges: top y = 10.5 - x*10/88, bottom y = 15.5 + x*11/88
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 88; viewbox-height: 28;
        fill: Theme.track;
        MoveTo { x: 0; y: 10; }
        LineTo { x: 88; y: 0; }
        LineTo { x: 88; y: 28; }
        LineTo { x: 0; y: 16; }
        Close { }
    }
    // gradient fill, inset ~1.5 units so the black wedge reads as an outline
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 88; viewbox-height: 28;
        fill: @linear-gradient(90deg, Theme.meter-low 0%, Theme.meter-mid 58%, Theme.meter-high 79%, Theme.meter-peak 100%);
        opacity: 0.8; // Figma renders the gradient at ~80% over the black wedge
        MoveTo { x: 1.5; y: 11.5; }
        LineTo { x: 86.5; y: 2; }
        LineTo { x: 86.5; y: 26; }
        LineTo { x: 1.5; y: 14.5; }
        Close { }
    }
    // unfilled part
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 88; viewbox-height: 28;
        fill: Theme.track;
        MoveTo { x: root.fx; y: 10.5 - root.fx * 10 / 88; }
        LineTo { x: 88; y: 0.5; }
        LineTo { x: 88; y: 27.5; }
        LineTo { x: root.fx; y: 15.5 + root.fx * 12 / 88; }
        Close { }
    }
    TouchArea {
        mouse-cursor: pointer;
        moved => { if (self.pressed) { root.changed(min(root.maximum, root.volume-of(clamp(self.mouse-x / self.width, 0, 1) * 88))); } }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.changed(min(root.maximum, root.volume-of(clamp(self.mouse-x / self.width, 0, 1) * 88))); }
        }
        scroll-event(e) => {
            root.changed(clamp(root.value + (e.delta-y > 0 ? 5 : -5), 0, root.maximum));
            accept
        }
    }
}

// A configurable bottom-bar item (see toolbar.slint for the catalogue).
component BarItem inherits HorizontalLayout {
    in property <string> id;
    in property <bool> active;
    in property <bool> muted;
    in property <float> volume;
    in property <float> volume-max: 150;
    in property <bool> fullscreen;
    in property <bool> wide: true; // room for the volume slider
    in property <bool> shown: true; // false = collapsed into the overflow menu
    in property <bool> compact: false;
    callback act(string);
    callback volume-changed(float);
    spacing: root.compact ? 2px : 6px;
    horizontal-stretch: 0;
    if root.shown && root.id == "volume": IconButton {
        size: root.compact ? ButtonSize.sm : ButtonSize.md;
        tip: Tools.label("volume");
        icon: root.muted || root.volume < 1 ? @image-url("../assets/icons/close-none.svg")
            : root.volume < 50 ? @image-url("../assets/icons/close-low.svg")
            : root.volume < 100 ? @image-url("../assets/icons/close-medium.svg")
            : @image-url("../assets/icons/volume-high.svg");
        clicked => { root.act("mute"); }
    }
    if root.shown && root.wide && root.id == "volume": VolumeBar {
        compact: root.compact; value: root.volume; maximum: root.volume-max;
        changed(v) => { root.volume-changed(v); }
    }
    // Icon only on the bar (labels live in the ⋯ overflow menu and hover Tooltip).
    if root.shown && root.id != "volume": IconButton {
        size: root.compact ? ButtonSize.sm : ButtonSize.md; active: root.active; tip: Tools.label(root.id);
        icon: root.id == "fullscreen" && root.fullscreen ? @image-url("../assets/icons/fullscreen-active.svg") : Tools.icon(root.id);
        clicked => { root.act(root.id); }
    }
}

component OverflowRow inherits Rectangle {
    in property <string> id;
    in property <bool> active;
    callback act(string);
    border-radius: Metrics.radius-sm;
    background: ta.has-hover ? Theme.bg-a1 : transparent;
    clip: true;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.act(root.id); } }
    HorizontalLayout {
        padding-left: 8px; spacing: 10px;
        Icon { source: Tools.icon(root.id); width: 20px; height: 20px; y: 8px; tint: root.active ? Theme.accent : Theme.fg-1; }
        Text { text: Tools.label(root.id); color: root.active ? Theme.accent : Theme.fg-1; vertical-alignment: center; }
    }
}

export component AppWindow inherits Window {
    icon: @image-url("../packaging/vivi.svg");
    title: root.has-media ? root.media-title + " — Vivi" : "Vivi";
    preferred-width: 1280px;
    preferred-height: 720px;
    // Main window minimum; the miniplayer goes down to 280x160.
    min-width: root.mini ? 280px : 480px;
    min-height: root.mini ? 160px : 320px;
    // Transparent only while playing (mpv underlay shows through); opaque otherwise.
    background: root.has-media ? transparent : Theme.bg-b1;
    default-font-family: "Inter";
    default-font-size: Metrics.font-base;

    in property <string> media-title: "";
    in property <bool> playing: false;
    in property <float> position: 0;
    in property <float> duration: 0;
    in-out property <float> volume: 100;
    in property <bool> muted: false;
    in property <bool> has-media: false;
    in property <bool> fullscreen: false;
    // Driven from Rust: false after ~2s of mouse inactivity during playback.
    in property <bool> controls-visible: true;

    callback toggle-play();
    callback open-file();
    callback seek(float);
    callback volume-changed(float);
    callback toggle-mute();
    callback toggle-fullscreen();
    callback prev();
    callback next();
    callback activity();
    // text, shift, ctrl, alt; unhandled keys are forwarded to mpv scripts.
    callback key(string, bool, bool, bool) -> bool;
    // Music visualizer (src/viz): shown for audio-only media; mode 0 = Disabled.
    in property <bool> viz-audio;
    in property <image> viz-frame;
    in property <string> viz-note;
    in property <int> viz-mode;
    in property <[string]> viz-modes: ["Disabled"];
    callback viz-select(int);
    // Plugins (src/plugins). Fields of `plugin-command` args are joined with U+001F.
    callback plugin-command(string, string, string);
    in-out property <string> skip-label;
    in property <float> skip-target;
    in property <[string]> lyrics-lines;
    in property <int> lyrics-index: -1;
    // Plain (unsynced) lyrics, e.g. radio: a scrollable block without highlight.
    in property <bool> lyrics-plain;
    in property <float> lyrics-size: 22;
    // Full-screen karaoke view and manual search (Lyrics plugin).
    in property <bool> lyrics-enabled;
    in property <[KWord]> lyrics-words;
    in property <int> lyrics-rows;
    in property <string> lyrics-source;
    in property <float> lyrics-offset;
    in property <LyricsState> lyrics-state: LyricsState.missing;
    in property <string> lyrics-offset-label: "0.0 s";
    in property <string> lyrics-title;
    in property <string> lyrics-artist;
    in property <bool> lyrics-can-save;
    in property <bool> lyrics-manual;
    out property <length> karaoke-big: clamp(root.width / 22, 30px, 64px);
    // Characters per karaoke row, for wrapping the word-timed current line.
    out property <int> karaoke-cols: max(10, floor((root.width - 2 * max(40px, root.width * 0.08)) / (root.karaoke-big * 0.6)));
    in-out property <string> ls-artist;
    in-out property <string> ls-title;
    in-out property <int> ls-selected: -1;
    in property <[LyricsHit]> ls-results;
    in property <string> ls-status;
    in property <string> ls-preview;
    in property <bool> ls-busy;
    in property <bool> subs-plugin;
    in property <[SubHit]> subs-hits;
    in property <[Item]> subs-langs;
    in property <int> subs-selected: -1;
    in property <string> subs-details;
    in property <string> subs-preview;
    in property <bool> subs-save-next;
    // Per-file subtitle offset label, pick and whether Subtitle Auto-Sync is installed.
    in property <string> subs-offset: "0.0 s";
    in property <bool> subs-has-pick;
    in property <string> subs-pick-label;
    in property <bool> subs-sync;
    in property <string> subs-status;
    in property <bool> subs-busy;
    in-out property <string> subs-query;
    in-out property <string> subs-lang;
    in property <[Item]> subs-local;
    in property <string> subs-folder;
    in-out property <int> subs-target;
    in-out property <int> subs-source;
    // Shared dialog of the music plugins (Auto-tagger, Free Music); md-owner = plugin id.
    in property <string> md-owner;
    in property <string> md-title;
    in property <[Item]> md-results;
    in property <[image]> md-logos; // optional row logos (Network Streams)
    in property <string> md-status;
    in property <bool> md-busy;
    in property <string> md-detail;
    in property <[TagFile]> tr-files;
    in property <string> tr-status;
    in property <bool> tr-busy;
    in property <string> tr-summary;
    in property <string> tr-summary-sub;
    in property <bool> tr-summary-ok;
    in property <[TagResult]> tr-results;
    in property <bool> tr-can-undo;
    in property <string> md-placeholder;
    in property <string> md-search-label;
    in property <string> md-primary;
    in property <string> md-secondary;
    in property <[string]> md-sources;
    in-out property <string> md-source;
    in-out property <string> md-query;
    in property <[string]> md-chips;
    in property <string> md-chip;
    in property <[string]> md-actions;
    in property <[FmRow]> md-tracks;    // Free Music rows
    in property <[MdFilter]> md-filters;
    in property <string> md-copy;
    in property <bool> md-has-more;
    // Network stream loading overlay (core, see loading.rs).
    in property <bool> loading-show;
    in property <bool> loading-buffering;
    in property <string> loading-name;
    in-out property <string> stream-error;
    // Now-playing card for audio-only network streams (Network Streams plugin).
    in property <bool> np-show;
    in property <string> np-station;
    in property <string> np-track;
    in property <string> np-info;
    in property <image> np-logo;
    in property <bool> np-has-logo;
    // "Add subtitles": the search dialog when the Subtitle Search plugin is on.
    public function add-subs() {
        if (root.subs-plugin) { Overlays.subs-open = true; root.plugin-command("subtitle-search", "open", ""); }
        else { root.load-sub(); }
    }

    // Side panel
    in-out property <length> panel-scroll;
    in-out property <PanelTab> panel-tab: PanelTab.subtitles;
    // The overlay Esc closes (top-most open one); same conditions as each overlay's `if` below.
    out property <Overlay> top-overlay:
        root.menu-kind != "" ? Overlay.menu
        : Overlays.shortcuts-open ? Overlay.shortcuts
        : Overlays.info-open ? Overlay.info
        : Overlays.onboarding-open ? Overlay.onboarding
        : Overlays.customize-open ? Overlay.customize
        : Overlays.tr-open ? Overlay.tag-review
        : Overlays.ls-open ? Overlay.lyrics-search
        : Overlays.md-open ? Overlay.music-dialog
        : Overlays.subs-open ? Overlay.subtitles
        : Overlays.qr-open ? Overlay.qr
        : Overlays.settings-open ? Overlay.settings
        : Overlays.np-open ? Overlay.new-playlist
        : Overlays.network-open ? Overlay.network
        : Overlays.panel-open && root.has-media && !root.mini ? Overlay.side-panel
        : Overlays.library-open && root.has-media ? Overlay.library
        : Overlays.karaoke-open && root.has-media && !root.mini && !Overlays.library-open ? Overlay.karaoke
        : Overlay.none;
    in property <[Item]> sub-tracks;
    in property <[Item]> audio-tracks;
    in property <[Item]> audio-devices;
    in property <[Item]> chapters;
    in property <[image]> chapter-thumbs;
    in property <[bool]> chapter-has-thumb;
    in property <[string]> chapter-times;
    callback chapters-refresh();
    in property <[Item]> bookmarks;
    callback remove-bookmark();
    in property <[Item]> queue;
    in property <[Item]> playlists;
    in property <[Item]> recent;
    in property <string> resume-text;
    // Only the resume message (this text) offers "Start over"; other toasts just have OK.
    in property <string> resume-offer;
    callback queue-play(int);
    callback queue-move(int, int);
    callback queue-remove(int);
    callback queue-add();
    callback queue-clear();
    callback playlist-save(string);
    callback playlist-load(string);
    callback playlist-delete(string);
    callback open-recent(string);
    callback clear-recent();
    callback start-over();
    callback dismiss-resume();

    // Side-panel slider values (synced from mpv so presets/defaults show up)
    in-out property <float> pv-sub-delay: 0;
    in-out property <float> pv-sub-scale: 1;
    in-out property <float> pv-sub-pos: 100;
    in-out property <float> pv-audio-delay: 0;
    in-out property <float> pv-boost: 100;
    in-out property <int> pv-rotate: 0;
    in-out property <float> pv-zoom: 0;
    in-out property <float> pv-panscan: 0;
    in-out property <float> pv-brightness: 0;
    in-out property <float> pv-contrast: 0;
    in-out property <float> pv-saturation: 0;
    in-out property <float> pv-gamma: 0;
    in-out property <float> pv-speed: 1;

    // Toolbar (bottom bar) and customization
    in property <[string]> bar-items: ["prev", "play", "next", "time", "seek", "duration", "volume", "audio", "subtitles", "settings", "queue", "fullscreen"];
    // Cumulative ~32 px slots of foldable items (-1 = always shown) and their total.
    in property <[int]> bar-cum;
    in property <int> bar-slots;
    in property <BarStyle> bar-style: BarStyle.compact;
    in property <[string]> bar-styles;
    callback customize-style(string);
    pure function is-core(id: string) -> bool {
        return id == "prev" || id == "play" || id == "next" || id == "time" || id == "seek" || id == "duration" || id == "spacer" || id == "back10" || id == "fwd10";
    }
    in property <bool> repeat-on;
    in property <bool> shuffle-on;
    in property <float> volume-max: 150;
    in property <[string]> customize-available;
    in property <[string]> profiles;
    in property <string> profile;
    callback bar-action(string);
    callback customize-move(int, int);
    callback customize-remove(int);
    callback customize-add(string);
    callback customize-profile(string);
    callback customize-done(bool);
    public function bar-act(id: string) {
        if (id == "queue") { root.open-panel(PanelTab.queue); }
        else if (id == "subtitles") { root.open-panel(PanelTab.subtitles); }
        else if (id == "audio") { root.open-panel(PanelTab.audio); }
        else if (id == "video") { root.open-panel(PanelTab.video); }
        else if (id == "speed") { root.open-panel(PanelTab.playback); }
        else if (id == "chapters") { root.open-panel(PanelTab.chapters); root.chapters-refresh(); }
        else if (id == "mute") { root.toggle-mute(); }
        else if (id == "fullscreen") { root.toggle-fullscreen(); }
        else if (id == "bookmark") { root.add-bookmark(); }
        else if (id == "settings") { Overlays.settings-open = true; root.settings-refresh(root.settings-category, "", false); }
        else { root.bar-action(id); }
    }
    // Responsive bottom bar: how many items fit on each side of the play controls.
    // Items are ~40px wide; the left side also holds the time display. The rest go to "⋯".
    // Foldable slots that fit beside the transport, times and a 200 px seekbar.
    property <int> bar-fit: max(0, floor((root.width - root.bar.reserve) / root.bar.slot));
    property <bool> bar-has-volume: root.width >= root.bar.volume-min-window;
    function bar-active(id: string) -> bool {
        return (id == "queue" && Overlays.panel-open && root.panel-tab == PanelTab.queue)
            || (id == "subtitles" && Overlays.panel-open && root.panel-tab == PanelTab.subtitles)
            || (id == "audio" && Overlays.panel-open && root.panel-tab == PanelTab.audio)
            || (id == "video" && Overlays.panel-open && root.panel-tab == PanelTab.video)
            || (id == "speed" && Overlays.panel-open && root.panel-tab == PanelTab.playback)
            || (id == "chapters" && Overlays.panel-open && root.panel-tab == PanelTab.chapters)
            || (id == "repeat" && root.repeat-on) || (id == "shuffle" && root.shuffle-on)
            || (id == "settings" && Overlays.settings-open);
    }

    // Library
    // QR dialog of a plugin (vivi-qr).
    in property <string> qr-title;
    in property <image> qr-code;
    in property <string> qr-text;
    in property <string> qr-caption;
    in property <[string]> net-history;
    in-out property <string> net-error;
    in-out property <string> net-urls;
    in-out property <string> net-name;
    callback network-submit(string, string);
    in property <[string]> np-files;
    in property <image> np-cover;
    in property <bool> np-has-cover;
    in property <string> np-error;
    in-out property <string> np-name;
    callback np-pick-cover();
    callback np-pick-files();
    callback np-remove(int);
    callback np-save(string);
    callback np-close();
    in property <[LibItem]> lib-items;
    in property <[LibItem]> lib-continue;
    in property <[LibItem]> lib-recent;
    in property <[LibItem]> lib-pinned;
    in property <[LibItem]> lib-listen;
    in property <[LibItem]> lib-folders;
    in property <[LibItem]> lib-lists;
    in property <[LibItem]> lib-artists;
    in property <bool> lib-can-back;
    in property <bool> lib-can-forward;
    // Library as the full home screen (vs. the 427 px sidebar while playing).
    in-out property <bool> lib-full;
    // Properties & Metadata dialog
    in property <string> info-title;
    in property <[string]> info-keys;
    in property <[string]> info-values;
    // "Hide UI" from the main menu (Ctrl+\): bars stay hidden until toggled back.
    in-out property <bool> ui-hidden;
    callback stop();
    callback toggle-record();
    callback open-folder();
    callback lib-history(bool);
    callback lib-add-folder();
    callback lib-create-playlist();
    in property <string> lib-nav: "home";
    in property <[string]> lib-crumb-keys;
    in property <[string]> lib-crumb-labels;
    in property <string> lib-sort: "name";
    in property <bool> lib-grid: true;
    in property <int> lib-count;
    in property <bool> lib-scanning;
    in property <bool> ytdlp;
    in-out property <string> lib-query;
    in property <[Item]> panel-lib;
    in property <[image]> preview-frames;
    // Menus (built in src/menus.rs): main right-click menu, library context menus,
    // sort and view options. menu-kind "" = closed.
    in-out property <string> menu-kind;
    in property <[MenuItem]> menu-items;
    in property <[MenuItem]> sub-items;
    in-out property <string> sub-open;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in property <length> menu-width: 265px;
    in-out property <length> sub-y;
    callback menu-request(string, length, length, string); // kind, x, y, context
    callback menu-activate(string);
    callback menu-sub(string); // ask for the submenu of a row ("" closes it)
    // Miniplayer: compact always-on-top window (391x339, 391x690 with the queue).
    in-out property <bool> mini;
    in-out property <bool> mini-queue;
    callback toggle-mini();
    callback toggle-mini-queue();
    // Miniplayer layout: queue shown only when there is room; "tiny" = video-only.
    property <bool> mini-q-shown: root.mini && root.mini-queue && root.height >= 420px;
    // Figma miniplayer: queue on top, the video, then a 52px info strip (not in the tiny variant).
    property <length> mini-q-h: root.mini-q-shown ? min(351px, root.height - 212px) : 0px;
    property <bool> mini-tiny: root.width < 320px || root.height - root.mini-q-h < 200px;
    property <length> mini-strip-h: root.mini && !root.mini-tiny ? 52px : 0px;
    property <length> mini-video-y: root.mini-q-h;
    property <length> mini-video-h: root.height - root.mini-q-h - root.mini-strip-h;
    property <float> mini-margin: root.mini ? root.mini-q-h / root.height : 0;
    property <float> mini-margin-b: root.mini ? root.mini-strip-h / root.height : 0;
    changed mini-margin-b => { root.set-prop("video-margin-ratio-bottom", root.mini-margin-b); }
    in property <string> mini-folder;
    in property <string> mini-sub;
    in property <string> mini-q-meta;
    in property <[string]> queue-durations;
    callback queue-sort();
    property <int> mini-q-sel: -1;
    changed mini-margin => { root.set-prop("video-margin-ratio-top", root.mini-margin); }
    callback lib-refresh();
    callback lib-rescan();
    callback lib-navigate(string);
    callback lib-search(string);
    callback lib-set-sort(string);
    callback lib-set-grid(bool);
    callback lib-open(string, string);
    callback lib-menu(string, string, string);
    callback open-url(string);
    callback panel-lib-search(string);

    // Onboarding
    in-out property <int> onboarding-step;
    in property <[string]> accent-names;
    in property <[color]> accent-colors;
    in property <string> accent-name;
    in property <[string]> onboarding-keys;
    in property <[string]> onboarding-actions;
    callback onboarding-done();

    // Settings
    // "?" overlay; rows come from the keymap (src/keymap.rs).
    in property <[string]> shortcut-actions;
    in property <[string]> shortcut-keys;
    in property <[string]> settings-categories;
    in property <[SettingRow]> settings-rows;
    in-out property <int> settings-category: 0;
    in property <string> settings-status;
    in-out property <string> settings-search;
    in-out property <bool> settings-advanced;
    in property <string> preset-name;
    callback setting-changed(string, string);
    callback settings-refresh(int, string, bool);
    callback save-preset();
    callback add-bookmark();
    in property <string> ab-state: "Off";
    in property <float> ab-a: -1;
    in property <float> ab-b: -1;
    callback ab-set(float, float);
    in property <[float]> chapter-starts;
    in property <[float]> wave-peaks;
    in property <string> wave-path;
    // Plugin range on the seekbar (`script-message vivi-range <a> <b> [label]`), e.g. Cut & Export In/Out.
    in property <float> range-a: -1;
    in property <float> range-b: -1;
    in property <string> range-label;
    property <BarMetrics> bar: Bars.metrics(root.bar-style);
    property <bool> bar-classic: root.bar.classic;
    out property <length> bar-h: root.bar.height;
    in property <string> sleep-state: "";
    in property <string> hwdec: "auto-safe";
    callback set-prop(string, string);
    callback run(string);
    callback load-sub();
    callback sleep(int);
    function open-panel(t: PanelTab) {
        if (Overlays.panel-open && root.panel-tab == t) { Overlays.panel-open = false; }
        else { root.panel-tab = t; Overlays.panel-open = true; }
    }

    pure function fmt(t: float) -> string {
        if (t < 0) { return "00:00"; }
        let h = floor(t / 3600);
        let m = floor(mod(t, 3600) / 60);
        let s = floor(mod(t, 60));
        (h > 0 ? h + ":" : "") + (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s
    }
    property <bool> show-ui: (!root.has-media || root.controls-visible || Overlays.panel-open || Overlays.settings-open || Overlays.customize-open) && !(root.ui-hidden && root.has-media);

    // Rust moves focus back to the player after Esc closed an overlay.
    public function focus-main() { fs.focus(); }

    // Esc reaches the keymap even while a text field inside a dialog has focus: this
    // scope wraps every element below and sees Esc before the focused item does.
    keys := FocusScope {
    width: 100%; height: 100%;
    focus-on-click: false; focus-on-tab-navigation: false;
    capture-key-pressed(e) => {
        if (e.text == Key.Escape) {
            root.activity();
            if (root.key(e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt)) { return accept; }
        }
        reject
    }

    fs := FocusScope {
        key-pressed(e) => {
            root.activity();
            if (root.key(e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt)) { return accept; }
            reject
        }
    }
    init => { fs.focus(); }

    // Whole-window activity tracker (mouse moves reset the auto-hide timer).
    main-ta := TouchArea {
        mouse-cursor: root.show-ui ? MouseCursor.default : MouseCursor.none;
        changed mouse-x => { root.activity(); }
        changed mouse-y => { root.activity(); }
        clicked => { fs.focus(); if (root.has-media) { root.toggle-play(); } }
        double-clicked => { root.toggle-fullscreen(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down && root.has-media) {
                root.menu-request("main", self.mouse-x, self.mouse-y, "");
            }
        }
    }

    // ---------- Music visualizer (audio-only media) ----------
    if root.has-media && root.viz-audio && root.viz-mode > 0: VizView {
        frame: root.viz-frame; note: root.viz-note;
    }

    // ---------- Now playing card (audio-only network streams) ----------
    if root.has-media && root.np-show && !root.mini: NowPlayingCard {
        // Centred in the space right of the docked library while that is shown.
        property <length> left: Overlays.library-open && !root.lib-full && root.show-ui ? min(427px, root.width) : 0px;
        x: self.left + (root.width - self.left - self.width) / 2;
        y: root.viz-mode > 0 ? 64px : (root.height - self.height) / 2;
        width: min(460px, root.width - self.left - 48px);
        station: root.np-station; track: root.np-track; info: root.np-info;
        logo: root.np-logo; has-logo: root.np-has-logo;
    }

    // ---------- Lyrics overlay (Lyrics plugin) ----------
    if root.has-media && root.lyrics-lines.length > 0 && !Overlays.library-open && !root.mini && !Overlays.karaoke-open: LyricsView {
        x: 40px; width: root.width - 80px;
        y: root.viz-audio && root.viz-mode > 0 ? (root.height - self.height) / 2 + 40px : root.height - root.bar-h - self.height - 60px;
        lines: root.lyrics-lines; index: root.lyrics-index; size: root.lyrics-size * 1px; plain: root.lyrics-plain;
        backdrop: !(root.viz-audio && root.viz-mode > 0);
    }

    // ---------- Full-screen karaoke (Lyrics plugin; L or side panel) ----------
    if root.has-media && Overlays.karaoke-open && !Overlays.library-open && !root.mini: KaraokeView {
        width: root.width; height: root.height;
        lines: root.lyrics-lines; index: root.lyrics-index; plain: root.lyrics-plain;
        words: root.lyrics-words; rows: root.lyrics-rows; big: root.karaoke-big;
        title: root.lyrics-title; artist: root.lyrics-artist; source: root.lyrics-source;
        state: root.lyrics-state; offset-s: root.lyrics-offset;
        offset: root.lyrics-offset-label; can-save: root.lyrics-can-save; manual: root.lyrics-manual;
        cmd(n, a) => { root.plugin-command("lyrics", n, a); fs.focus(); }
    }

    // ---------- Library (home screen when idle; overlay via the Home button) ----------
    if !root.has-media || Overlays.library-open: LibraryView {
        property <bool> docked: root.has-media && !root.lib-full;
        // The docked library hides with the other controls during playback.
        visible: !self.docked || root.show-ui;
        sidebar: self.docked;
        x: 0; y: 40px;
        width: self.docked ? min(427px, root.width) : root.width;
        height: root.height - 40px - (self.docked ? root.bar-h : 0px);
        items: root.lib-items; continue-items: root.lib-continue; recent-items: root.lib-recent; pinned-items: root.lib-pinned;
        listen-items: root.lib-listen; folder-items: root.lib-folders; list-items: root.lib-lists; artist-items: root.lib-artists;
        nav: root.lib-nav; crumb-keys: root.lib-crumb-keys; crumb-labels: root.lib-crumb-labels;
        sort: root.lib-sort; grid: root.lib-grid; count: root.lib-count; scanning: root.lib-scanning; has-media: root.has-media;
        can-back: root.lib-can-back; can-forward: root.lib-can-forward;
        query <=> root.lib-query;
        navigate(k) => { root.lib-query = ""; root.lib-navigate(k); }
        history(f) => { root.lib-query = ""; root.lib-history(f); }
        search(q) => { root.lib-search(q); }
        open(k, kind) => { root.lib-open(k, kind); }
        menu-request(kind, x, y, c) => { root.menu-request(kind, x, y, c); }
        open-file() => { root.open-file(); }
        open-network() => { Overlays.network-open = true; }
        clear-recent() => { root.clear-recent(); }
        popout() => {
            if (root.has-media) { root.lib-full = !root.lib-full; } else { root.open-file(); }
        }
    }

    // ---------- Top bar (title) ----------
    // Hover strip that reveals the bar. It must sit *below* the bar in z-order (declared
    // first); declared after it, it swallowed every click on the top-bar buttons.
    top-ta := TouchArea { y: 0; height: 40px; changed has-hover => { root.activity(); } }
    if !root.mini && (root.show-ui || top-ta.has-hover): Rectangle {
        y: 0; height: 40px;
        background: root.has-media ? Theme.bar : Theme.bg-a4;
        HorizontalLayout {
            padding-left: 6px; padding-right: 6px; padding-top: 4px; padding-bottom: 4px; spacing: Theme.gap;
            IconButton { icon: @image-url("../assets/icons/open.svg"); tip: "Open file"; clicked => { root.open-file(); } }
            if root.has-media: IconButton { icon: @image-url("../assets/icons/home.svg"); active: Overlays.library-open; clicked => { Overlays.library-open = !Overlays.library-open; } }
            Text {
                horizontal-stretch: 1;
                text: root.has-media ? root.media-title : "Vivi Media Player";
                color: Theme.fg-a2; horizontal-alignment: center; vertical-alignment: center;
                overflow: elide;
            }
            if root.has-media: IconButton { icon: @image-url("../assets/icons/pip.svg"); tip: "Miniplayer (P)"; clicked => { root.toggle-mini(); } }
            IconButton { icon: @image-url("../assets/icons/settings.svg"); active: Overlays.settings-open; clicked => { Overlays.settings-open = !Overlays.settings-open; root.settings-refresh(root.settings-category, "", false); } }
            IconButton { icon: @image-url("../assets/icons/fullscreen.svg"); active: root.fullscreen; clicked => { root.toggle-fullscreen(); } }
        }
    }

    if !root.mini && root.has-media && root.viz-audio && !Overlays.library-open && !Overlays.karaoke-open && (root.show-ui || top-ta.has-hover): VizDropdown {
        x: 12px; y: 50px;
        modes: root.viz-modes; mode: root.viz-mode;
        select(i) => { root.viz-select(i); }
    }

    // ---------- Side panel ----------
    if !root.mini && root.has-media && Overlays.panel-open: SidePanel {
        // Overlays the video; full width on narrow windows.
        scroll-y <=> root.panel-scroll;
        width: root.width < 800px ? root.width : 400px;
        x: root.width - self.width;
        y: 40px;
        height: root.height - 40px - root.bar-h;
        tab <=> root.panel-tab;
        sub-tracks: root.sub-tracks; audio-tracks: root.audio-tracks;
        audio-devices: root.audio-devices; chapters: root.chapters; chapter-thumbs: root.chapter-thumbs; chapter-has-thumb: root.chapter-has-thumb;
        chapters-refresh => { root.chapters-refresh(); }
        ab-state: root.ab-state; sleep-state: root.sleep-state; hwdec: root.hwdec;
        set-prop(n, v) => { root.set-prop(n, v); }
        run(c) => { root.run(c); }
        load-sub() => { root.load-sub(); }
        sleep(m) => { root.sleep(m); }
        bookmarks: root.bookmarks;
        seek-to(k) => { root.seek(k.to-float()); }
        add-bookmark() => { root.add-bookmark(); }
        remove-bookmark() => { root.remove-bookmark(); }
        chapter-times: root.chapter-times;
        viz-modes: root.viz-modes; viz-mode: root.viz-mode;
        viz-select(i) => { root.viz-select(i); }
        lyrics-enabled: root.lyrics-enabled; karaoke-open: Overlays.karaoke-open; lyrics-source: root.lyrics-source;
        lyrics-offset-s: root.lyrics-offset; subs-offset-s: root.pv-sub-delay;
        lyrics-offset: root.lyrics-offset-label; lyrics-can-save: root.lyrics-can-save; lyrics-manual: root.lyrics-manual;
        lyrics(n, a) => { root.plugin-command("lyrics", n, a); }
        subs-enabled: root.subs-plugin; subs-offset: root.subs-offset; subs-has-pick: root.subs-has-pick; subs-pick-label: root.subs-pick-label; subs-sync: root.subs-sync;
        subs(n, a) => { root.plugin-command("subtitle-search", n, a); }
        find-subs() => { root.add-subs(); }
        open-settings(c) => { root.settings-category = c; Overlays.settings-open = true; root.settings-refresh(c, "", false); }
        queue: root.queue; playlists: root.playlists;
        queue-play(i) => { root.queue-play(i); }
        queue-move(i, d) => { root.queue-move(i, d); }
        queue-remove(i) => { root.queue-remove(i); }
        queue-add() => { root.queue-add(); }
        queue-clear() => { root.queue-clear(); }
        playlist-save(n) => { root.playlist-save(n); }
        playlist-load(k) => { root.playlist-load(k); }
        playlist-delete(k) => { root.playlist-delete(k); }
        preset-name: root.preset-name;
        library: root.panel-lib;
        library-search(q) => { root.panel-lib-search(q); }
        library-play(k) => { root.lib-open(k, "video"); }
        library-enqueue(k) => { root.lib-menu(k, "video", "enqueue"); }
        sub-delay <=> root.pv-sub-delay;
        sub-scale <=> root.pv-sub-scale;
        sub-pos <=> root.pv-sub-pos;
        audio-delay <=> root.pv-audio-delay;
        boost <=> root.pv-boost;
        rotate <=> root.pv-rotate;
        zoom <=> root.pv-zoom;
        panscan <=> root.pv-panscan;
        brightness <=> root.pv-brightness;
        contrast <=> root.pv-contrast;
        saturation <=> root.pv-saturation;
        gamma <=> root.pv-gamma;
        speed <=> root.pv-speed;
        save-preset() => { root.save-preset(); }
        close() => { Overlays.panel-open = false; }
    }

    // ---------- Network stream loading spinner / error ----------
    if root.loading-show && !root.mini: Rectangle {
        background: transparent;
        VerticalLayout {
            alignment: center; spacing: 14px;
            HorizontalLayout { alignment: center;
                Rectangle { width: 48px; height: 48px;
                    Image {
                        width: 48px; height: 48px; source: @image-url("../assets/icons/spinner.svg");
                        colorize: Theme.accent;
                        transform-rotation: mod(animation-tick() / 1ms, 1000) * 0.36deg;
                    }
                }
            }
            Text { text: root.loading-buffering ? "Buffering…" : "Opening…"; color: Theme.fg-a2; font-size: Metrics.font-md; horizontal-alignment: center; }
            Text { text: root.loading-name; color: Theme.fg-1; font-size: Metrics.font-h3; horizontal-alignment: center; overflow: elide; }
        }
    }
    if root.stream-error != "": Rectangle {
        width: min(se.preferred-width + 40px, root.width - 32px); height: 48px;
        x: (root.width - self.width) / 2;
        y: root.height - root.bar-h - self.height - 16px;
        border-radius: Metrics.radius-xxl; background: Theme.bar;
        se := Text { text: root.stream-error; color: Theme.err; font-size: Metrics.font-base; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
        TouchArea { clicked => { root.stream-error = ""; } }
    }

    // ---------- Resume toast ----------
    if root.has-media && root.resume-text != "": Rectangle {
        width: toast.preferred-width; height: 52px;
        x: (root.width - self.width) / 2;
        y: root.height - root.bar-h - self.height - 16px;
        border-radius: Metrics.radius-xxl;
        background: Theme.bar;
        toast := HorizontalLayout {
            padding-left: 20px; padding-right: 10px; spacing: 24px;
            Text { text: root.resume-text; color: Theme.fg-2; font-size: Metrics.font-lg; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 10px; padding-top: 10px; padding-bottom: 10px;
                if root.resume-offer != "" && root.resume-offer == root.resume-text: Rectangle {
                    width: so.preferred-width + 20px; border-radius: Metrics.radius-md; background: Theme.accent-bg;
                    so := Text { text: "Start over"; color: Theme.accent-bright; vertical-alignment: center; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.start-over(); } }
                }
                Rectangle {
                    width: 44px; border-radius: Metrics.radius-md; background: Theme.accent;
                    Text { text: "OK"; color: Theme.bg-b2; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.dismiss-resume(); } }
                }
            }
        }
    }

    // ---------- Skip intro / credits (Skip Intro plugin) ----------
    if root.has-media && root.skip-label != "" && !root.mini: SkipButton {
        x: root.width - self.width - 24px;
        y: root.height - (root.show-ui ? root.bar-h : 0px) - self.height - 24px;
        text: root.skip-label;
        clicked => { root.plugin-command("skip-intro", "skip", ""); fs.focus(); }
        dismiss => { root.plugin-command("skip-intro", "dismiss", ""); fs.focus(); }
    }

    // ---------- Controls ----------
    // ---------- Bottom bar: every element is a movable item (Customize Player) ----------
    // Compact / Waveform / Plain: one row with the seekbar inline where "seek" sits.
    // Classic: the seekbar spans a row on top and "seek" becomes a flexible gap.
    if !root.mini && root.has-media && root.show-ui: Rectangle {
        y: root.height - self.height;
        height: root.bar-h;
        background: Theme.bar-dark;
        TouchArea { } // swallow clicks so they don't toggle play
        Rectangle { y: 0; height: 1px; background: Theme.bar-line; }
        VerticalLayout {
            padding-left: root.bar.pad-x-left; padding-right: root.bar.pad-x-right;
            padding-top: root.bar.pad-top; padding-bottom: root.bar.pad-bottom;
            spacing: 2px;
            if root.bar-classic: SeekBar {
                position: root.position; duration: root.duration;
                frames: root.preview-frames;
                chapters: root.chapter-starts; ab-a: root.ab-a; ab-b: root.ab-b; range-a: root.range-a; range-b: root.range-b; range-label: root.range-label;
                ab-set(x, y) => { root.ab-set(x, y); }
                fmt(t) => { root.fmt(t) }
                seek(t) => { root.seek(t); fs.focus(); }
            }
            HorizontalLayout {
                spacing: root.bar.gap;
                for id[i] in root.bar-items: HorizontalLayout {
                    property <bool> on: i >= root.bar-cum.length || root.bar-cum[i] < 0 || root.bar-cum[i] <= root.bar-fit;
                    property <bool> ab: root.ab-a >= 0 && root.ab-b >= 0;
                    horizontal-stretch: id == "seek" || id == "spacer" ? 1 : 0;
                    spacing: 2px;
                    if id == "prev": IconButton { size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; tip: "Previous"; icon: @image-url("../assets/icons/previous.svg"); clicked => { root.prev(); } }
                    if id == "play": IconButton { size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; primary: true; tip: root.playing ? "Pause" : "Play"; icon: root.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg"); clicked => { root.toggle-play(); fs.focus(); } }
                    if id == "next": IconButton { size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; tip: "Next"; icon: @image-url("../assets/icons/next.svg"); clicked => { root.next(); } }
                    if on && id == "back10": IconButton { size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; tip: "Back 10 s"; icon: @image-url("../assets/icons/backward-10-sec.svg"); clicked => { root.seek(max(0, root.position - 10)); fs.focus(); } }
                    if on && id == "fwd10": IconButton { size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; tip: "Forward 10 s"; icon: @image-url("../assets/icons/forward-10-sec.svg"); clicked => { root.seek(min(root.duration, root.position + 10)); fs.focus(); } }
                    if id == "time": HorizontalLayout {
                        padding-left: 8px; padding-right: 6px; spacing: 4px;
                        Text {
                            text: ab ? "*" + fmt(root.ab-a) : fmt(root.position);
                            color: ab ? Theme.accent-bright : (root.bar-classic ? Theme.fg-1 : Theme.fg-a2);
                            font-size: Metrics.font-sm; vertical-alignment: center;
                        }
                        if ab: Text {
                            text: "‹"; color: na.has-hover ? Theme.accent-bright : Theme.fg-a2; font-size: Metrics.font-h3; vertical-alignment: center; width: 14px; horizontal-alignment: center;
                            na := TouchArea { mouse-cursor: pointer; clicked => { root.ab-set(max(0, root.ab-a - 0.5), root.ab-b); } }
                        }
                    }
                    if id == "duration": HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; spacing: 4px;
                        if ab: Text {
                            text: "›"; color: nb.has-hover ? Theme.accent-bright : Theme.fg-a2; font-size: Metrics.font-h3; vertical-alignment: center; width: 14px; horizontal-alignment: center;
                            nb := TouchArea { mouse-cursor: pointer; clicked => { root.ab-set(root.ab-a, min(root.duration, root.ab-b + 0.5)); } }
                        }
                        Text {
                            text: ab ? "*" + fmt(root.ab-b) : fmt(root.duration);
                            color: ab ? Theme.accent-bright : Theme.fg-a2;
                            font-size: Metrics.font-sm; vertical-alignment: center;
                        }
                        if ab: IconButton { size: true ? ButtonSize.sm : ButtonSize.md; tip: "Clear A-B range"; icon: @image-url("../assets/icons/close.svg"); clicked => { root.ab-set(-1, -1); fs.focus(); } }
                    }
                    if id == "seek" && !root.bar-classic: SeekBar {
                        horizontal-stretch: 1;
                        height: root.wave-peaks.length > 0 ? 24px : 18px;
                        boxed: root.bar.boxed;
                        track-h: 4px;
                        position: root.position; duration: root.duration;
                        frames: root.preview-frames; peaks: root.wave-peaks;
                        chapters: root.chapter-starts; ab-a: root.ab-a; ab-b: root.ab-b; range-a: root.range-a; range-b: root.range-b; range-label: root.range-label;
                        ab-set(x, y) => { root.ab-set(x, y); }
                        fmt(t) => { root.fmt(t) }
                        seek(t) => { root.seek(t); fs.focus(); }
                    }
                    if id == "spacer" || (id == "seek" && root.bar-classic): Rectangle { horizontal-stretch: 1; }
                    if on && !root.is-core(id): BarItem {
                        id: id; compact: !root.bar-classic; wide: root.bar-has-volume; active: root.bar-active(id); muted: root.muted; volume: root.volume; volume-max: root.volume-max; fullscreen: root.fullscreen;
                        act(x) => { root.bar-act(x); fs.focus(); }
                        volume-changed(v) => { root.volume = v; root.volume-changed(v); }
                    }
                }
                if root.bar-slots > root.bar-fit: IconButton {
                    size: !root.bar-classic ? ButtonSize.sm : ButtonSize.md; icon: @image-url("../assets/icons/more.svg"); tip: "More";
                    clicked => { overflow.show(); }
                }
            }
        }
    }

    // ---------- Miniplayer (Figma "Miniplayer" variants) ----------
    // Tiny: video only; hovering shows play/pause and the way back.
    if root.mini && root.mini-tiny && root.has-media && root.show-ui: Rectangle {
        width: root.width; height: root.mini-video-h; x: 0; y: root.mini-video-y;
        background: Theme.scrim-soft;
        IconButton { x: 6px; y: 6px; icon: @image-url("../assets/icons/window.svg"); tip: "Full player (P)"; clicked => { root.toggle-mini(); } }
        IconButton {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            primary: true; tip: root.playing ? "Pause" : "Play";
            icon: root.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
            clicked => { root.toggle-play(); fs.focus(); }
        }
        Rectangle {
            y: parent.height - 4px; height: 4px; x: 0;
            width: root.duration > 0 ? parent.width * root.position / root.duration : 0;
            background: Theme.accent;
        }
    }
    // Compact: × / ⧉ in the corners, transport in the middle, progress along the bottom edge.
    if root.mini && !root.mini-tiny && root.has-media && root.show-ui: Rectangle {
        width: root.width; height: root.mini-video-h; x: 0; y: root.mini-video-y;
        background: Theme.scrim-soft;
        IconButton { x: 8px; y: 8px; icon: @image-url("../assets/icons/close.svg"); tip: "Stop and close the miniplayer"; clicked => { root.stop(); root.toggle-mini(); } }
        IconButton { x: parent.width - self.width - 8px; y: 8px; icon: @image-url("../assets/icons/window.svg"); tip: "Full player (P)"; clicked => { root.toggle-mini(); } }
        HorizontalLayout {
            x: (parent.width - self.preferred-width) / 2; y: (parent.height - 40px) / 2; width: self.preferred-width; height: 40px;
            spacing: 18px; alignment: center;
            IconButton { y: 4px; tip: "Previous"; icon: @image-url("../assets/icons/previous.svg"); clicked => { root.prev(); } }
            IconButton { y: 2px; primary: true; tip: root.playing ? "Pause" : (root.duration > 0 && root.position >= root.duration - 0.5 ? "Replay" : "Play"); icon: root.playing ? @image-url("../assets/icons/pause.svg") : (root.duration > 0 && root.position >= root.duration - 0.5 ? @image-url("../assets/icons/replay.svg") : @image-url("../assets/icons/play.svg")); clicked => { root.toggle-play(); fs.focus(); } }
            IconButton { y: 4px; tip: "Next"; icon: @image-url("../assets/icons/next.svg"); clicked => { root.next(); } }
        }
        Rectangle {
            x: 10px; width: parent.width - 20px; y: parent.height - 18px; height: 14px;
            Rectangle { y: 5px; height: 4px; border-radius: self.height / 2; background: Theme.on-media-dim; }
            Rectangle { x: 0; y: 5px; height: 4px; border-radius: self.height / 2; width: root.duration > 0 ? parent.width * root.position / root.duration : 0; background: Theme.accent.mix(Theme.video-bg, 70%); }
            Rectangle {
                x: (root.duration > 0 ? parent.width * root.position / root.duration : 0) - 5px; y: 2px;
                width: 10px; height: 10px; border-radius: self.height / 2; background: Theme.accent;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { if (root.duration > 0) { root.seek(clamp(self.mouse-x / self.width, 0, 1) * root.duration); } }
            }
        }
    }
    // Info strip under the video: title, folder, subtitle track and the queue toggle.
    if root.mini && !root.mini-tiny: Rectangle {
        x: 0; y: root.mini-video-y + root.mini-video-h; width: root.width; height: root.mini-strip-h;
        background: Theme.bar-solid;
        TouchArea { }
        VerticalLayout {
            padding-left: 12px; padding-right: 8px; padding-top: 7px; padding-bottom: 5px; spacing: 2px;
            Text { text: root.media-title; color: Theme.fg-a2; font-size: Metrics.font-sm; overflow: elide; }
            HorizontalLayout {
                spacing: 6px;
                Icon { y: 4px; width: 14px; height: 14px; source: @image-url("../assets/icons/folder.svg"); tint: Theme.fg-a3; }
                Text { text: root.mini-folder; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; overflow: elide; max-width: 120px; }
                Rectangle { width: 6px; }
                Icon { y: 4px; width: 14px; height: 14px; source: @image-url("../assets/icons/subtitles.svg"); tint: Theme.fg-a3; }
                Text { text: root.mini-sub; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Rectangle {
                    width: 26px; height: 22px; border-radius: Metrics.radius-sm;
                    background: qta.has-hover ? Theme.bg-a1 : transparent;
                    Icon { width: 16px; height: 16px; source: @image-url("../assets/icons/queue.svg"); tint: root.mini-queue ? Theme.accent : Theme.fg-a2; }
                    qta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-mini-queue(); } }
                }
            }
        }
    }
    // Queue variant: header, item count/length with sort/remove/add, draggable rows.
    if root.mini-q-shown: Rectangle {
        y: 0; height: root.mini-q-h;
        background: Theme.bar-solid;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: 36px; background: Theme.surface-head;
                Text { text: "Queue"; color: Theme.fg-a2; font-size: Metrics.font-sm; }
            }
            HorizontalLayout {
                height: 34px; padding-left: 12px; padding-right: 6px; spacing: 2px;
                Text { text: root.mini-q-meta; color: Theme.fg-a3; font-size: Metrics.font-xs; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { y: 2px; width: 30px; height: 30px; icon: @image-url("../assets/icons/sort.svg"); tip: "Sort by name"; clicked => { root.queue-sort(); } }
                IconButton { y: 2px; width: 30px; height: 30px; icon: @image-url("../assets/icons/remove.svg"); tip: "Remove selected"; clicked => { if (root.mini-q-sel >= 0) { root.queue-remove(root.mini-q-sel); root.mini-q-sel = -1; } } }
                IconButton { y: 2px; width: 30px; height: 30px; icon: @image-url("../assets/icons/add.svg"); tip: "Add files"; clicked => { root.queue-add(); } }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start; spacing: 0px; padding-left: 6px; padding-right: 6px;
                    for it[i] in root.queue: Rectangle {
                        height: 30px; border-radius: Metrics.radius-sm;
                        property <length> dy;
                        background: i == root.mini-q-sel ? Theme.bg-a1 : row-ta.has-hover ? Theme.hover : transparent;
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.mini-q-sel = i; }
                            double-clicked => { root.queue-play(i); }
                        }
                        HorizontalLayout {
                            padding-left: 4px; padding-right: 8px; spacing: 8px;
                            Rectangle {
                                width: 22px;
                                Icon { width: 14px; height: 14px; source: @image-url("../assets/icons/list.svg"); tint: drag.pressed ? Theme.accent : Theme.fg-a3; }
                                drag := TouchArea {
                                    mouse-cursor: grab;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.up) {
                                            let d = round((self.mouse-y - self.pressed-y) / 30px);
                                            if (d != 0) { root.queue-move(i, clamp(d, -i, root.queue.length - 1 - i)); }
                                        }
                                    }
                                }
                            }
                            Text { text: it.label; color: it.selected ? Theme.accent : Theme.fg-a2; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Text { text: i < root.queue-durations.length ? root.queue-durations[i] : ""; color: Theme.fg-a3; font-family: "DM Mono"; font-size: Metrics.font-xs; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }


    overflow := PopupWindow {
        x: root.width - 220px; y: root.height - root.bar-h - self.height - 6px;
        width: 210px;
        Rectangle {
            background: Theme.bg-a4; border-radius: Metrics.radius-md; border-width: 1px; border-color: Theme.bg-a1;
            drop-shadow-blur: 12px; drop-shadow-color: Theme.shadow;
        }
        VerticalLayout {
            padding: 6px;
            for id[i] in root.bar-items: OverflowRow { visible: i < root.bar-cum.length && root.bar-cum[i] > root.bar-fit; height: self.visible ? 36px : 0; id: id; active: root.bar-active(id); act(x) => { root.bar-act(x == "volume" ? "mute" : x); } }
        }
    }

    // ---------- Network stream ----------
    if Overlays.network-open: NetworkStreamDialog {
        width: root.width; height: root.height;
        ytdlp: root.ytdlp; history: root.net-history; error: root.net-error;
        urls <=> root.net-urls; name <=> root.net-name;
        submit(u, n) => { root.network-submit(u, n); }
        close() => { Overlays.network-open = false; root.net-error = ""; fs.focus(); }
    }

    // ---------- New playlist ----------
    if Overlays.np-open: NewPlaylistDialog {
        width: root.width; height: root.height;
        files: root.np-files; cover: root.np-cover; has-cover: root.np-has-cover; error: root.np-error;
        name <=> root.np-name;
        pick-cover => { root.np-pick-cover(); }
        pick-files => { root.np-pick-files(); }
        remove-file(i) => { root.np-remove(i); }
        save(n) => { root.np-save(n); }
        close => { root.np-close(); fs.focus(); }
    }

    // ---------- Settings dialog ----------
    if Overlays.settings-open: SettingsDialog {
        width: root.width; height: root.height;
        categories: root.settings-categories;
        rows: root.settings-rows;
        category <=> root.settings-category;
        status: root.settings-status;
        search <=> root.settings-search;
        advanced <=> root.settings-advanced;
        changed(id, v) => { root.setting-changed(id, v); }
        refresh(c, q, adv) => { root.settings-refresh(c, q, adv); }
        close() => { Overlays.settings-open = false; fs.focus(); }
    }

    // ---------- Plugin QR code (above Settings, which opens it) ----------
    if Overlays.qr-open: QrDialog {
        width: root.width; height: root.height;
        title: root.qr-title; code: root.qr-code; text: root.qr-text; caption: root.qr-caption;
        close => { Overlays.qr-open = false; }
    }

    // ---------- Add Subtitles (Subtitle Search plugin) ----------
    if Overlays.subs-open: SubtitleDialog {
        width: root.width; height: root.height;
        hits: root.subs-hits; langs: root.subs-langs; selected: root.subs-selected;
        details: root.subs-details; preview: root.subs-preview; save-next: root.subs-save-next;
        status: root.subs-status; busy: root.subs-busy;
        query <=> root.subs-query; lang <=> root.subs-lang;
        local: root.subs-local; folder: root.subs-folder;
        target <=> root.subs-target; source <=> root.subs-source;
        cmd(n, a) => { root.plugin-command("subtitle-search", n, a); }
        close => { Overlays.subs-open = false; fs.focus(); }
    }

    // ---------- Auto-tagger / Free Music ----------
    if Overlays.md-open: MusicDialog {
        width: root.width; height: root.height;
        title: root.md-title; results: root.md-results; logos: root.md-owner == "network-streams" ? root.md-logos : []; status: root.md-status; busy: root.md-busy;
        detail: root.md-detail; placeholder: root.md-placeholder; search-label: root.md-search-label;
        primary-text: root.md-primary; secondary-text: root.md-secondary; sources: root.md-sources;
        source <=> root.md-source; query <=> root.md-query;
        chips: root.md-owner == "network-streams" || root.md-owner == "free-music" ? root.md-chips : []; chip: root.md-chip;
        actions: root.md-owner == "network-streams" || root.md-owner == "free-music" ? root.md-actions : [];
        rich: root.md-owner == "free-music"; tracks: root.md-owner == "free-music" ? root.md-tracks : [];
        filters: root.md-owner == "free-music" ? root.md-filters : []; copy-text: root.md-copy;
        has-more: root.md-owner == "free-music" && root.md-has-more;
        filter(n, v) => { root.plugin-command(root.md-owner, "filter", n + "\u{1f}" + v); }
        more => { root.plugin-command(root.md-owner, "more", ""); }
        edited => { if root.md-owner == "free-music" { root.plugin-command(root.md-owner, "edited", ""); } }
        chip-clicked(c) => { root.plugin-command(root.md-owner, "chip", c); }
        action(n, i) => { root.plugin-command(root.md-owner, "act:" + n, i); }
        search => { root.plugin-command(root.md-owner, "search", ""); }
        select(i) => { root.plugin-command(root.md-owner, "select", i); }
        primary(i) => { root.plugin-command(root.md-owner, "primary", i); }
        secondary(i) => { root.plugin-command(root.md-owner, "secondary", i); }
        close => { Overlays.md-open = false; root.plugin-command(root.md-owner, "close", ""); fs.focus(); }
    }

    // ---------- Find Lyrics (Lyrics plugin) ----------
    if Overlays.ls-open: LyricsSearchDialog {
        width: root.width; height: root.height;
        results: root.ls-results; status: root.ls-status; preview: root.ls-preview; busy: root.ls-busy;
        artist <=> root.ls-artist; title <=> root.ls-title; selected <=> root.ls-selected;
        cmd(n, a) => { root.plugin-command("lyrics", n, a); if (n == "search-close") { fs.focus(); } }
    }

    // ---------- Auto-tagger review ----------
    if Overlays.tr-open: TagReviewDialog {
        width: root.width; height: root.height;
        files: root.tr-files; status: root.tr-status; busy: root.tr-busy;
        summary: root.tr-summary; summary-sub: root.tr-summary-sub; summary-ok: root.tr-summary-ok; results: root.tr-results; can-undo: root.tr-can-undo;
        cmd(n, a) => { root.plugin-command("auto-tagger", n, a); if (n == "review-close") { fs.focus(); } }
    }

    // ---------- Customize player ----------
    if Overlays.customize-open: CustomizeDialog {
        width: root.width; height: root.height;
        items: root.bar-items; styles: root.bar-styles; bar-style: root.bar-style;
        pick-style(st) => { root.customize-style(st); }
        available: root.customize-available;
        profiles: root.profiles; profile: root.profile;
        move(i, d) => { root.customize-move(i, d); }
        remove(i) => { root.customize-remove(i); }
        add(id) => { root.customize-add(id); }
        pick-profile(p) => { root.customize-profile(p); }
        save() => { root.customize-done(true); fs.focus(); }
        cancel() => { root.customize-done(false); fs.focus(); }
    }

    // ---------- First-run onboarding ----------
    if Overlays.onboarding-open: OnboardingDialog {
        width: root.width; height: root.height;
        step <=> root.onboarding-step;
        dark: Theme.dark; accent: root.accent-name;
        accents: root.accent-names; swatches: root.accent-colors;
        keys: root.onboarding-keys; actions: root.onboarding-actions;
        set-theme(t) => { root.setting-changed("interface.theme", t); }
        set-accent(a) => { root.setting-changed("interface.accent", a); }
        finish() => { root.onboarding-done(); fs.focus(); }
    }

    // ---------- Properties & Metadata ----------
    if Overlays.info-open: Modal {
        card-width: 520px;
        card-height: icol.preferred-height;
        inset: 48px;
        card-background: Theme.bar-solid;
        bordered: false;
        dismissed => { Overlays.info-open = false; }
        icol := VerticalLayout {
            padding: 20px; spacing: 10px;
            Text { text: root.info-title; color: Theme.fg-1; font-size: Metrics.font-lg; overflow: elide; }
            Rectangle { height: 1px; background: Theme.bg-a1; }
            for k[i] in root.info-keys: HorizontalLayout {
                spacing: 10px;
                Text { text: k; color: Theme.fg-a3; font-size: Metrics.font-base; width: 110px; }
                Text { text: root.info-values[i]; color: Theme.fg-a2; font-size: Metrics.font-base; wrap: word-wrap; horizontal-stretch: 1; }
            }
            HorizontalLayout {
                alignment: end;
                PrimaryButton {
                    size: ButtonSize.sm; min-w: 80px; text: "Close";
                    clicked => { Overlays.info-open = false; }
                }
            }
        }
    }

    // ---------- Keyboard shortcuts ("?") ----------
    if Overlays.shortcuts-open: ShortcutsDialog {
        width: root.width; height: root.height;
        actions: root.shortcut-actions; keys: root.shortcut-keys;
        close => { Overlays.shortcuts-open = false; fs.focus(); }
    }

    // ---------- Menus (topmost) ----------
    if root.menu-kind != "": TouchArea {
        clicked => { root.menu-kind = ""; root.sub-open = ""; }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { root.menu-kind = ""; root.sub-open = ""; }
        }
    }
    if root.menu-kind != "": main-menu := MenuPanel {
        width: root.menu-width;
        x: max(4px, min(root.menu-x, root.width - self.width - 4px));
        y: max(4px, min(root.menu-y, root.height - self.height - 4px));
        items: root.menu-items;
        open-sub: root.sub-open;
        activated(id) => { root.menu-activate(id); }
        row-hovered(id, y) => {
            root.sub-y = self.y + y - 4px;
            root.sub-open = id;
            root.menu-sub(id);
        }
    }
    if root.menu-kind != "" && root.sub-open != "" && root.sub-items.length > 0: MenuPanel {
        property <length> right-x: root.menu-x + root.menu-width - 4px;
        width: 265px;
        x: self.right-x + self.width > root.width ? max(4px, root.menu-x - self.width + 4px) : self.right-x;
        y: max(4px, min(root.sub-y, root.height - self.height - 4px));
        items: root.sub-items;
        activated(id) => { root.menu-activate(id); }
    }
    } // keys
}
