// Library per the Figma "Library Sidebar" frames (docs/design/frames/library-sidebars.png):
// 50 px icon rail (#191919, 32 px buttons, gap 14), content #0E0E0E with 20 px padding:
// back/forward + breadcrumb (Inter 16 #8F8F8F, "▸" separators) + more/open icons, item count
// with sort/view/search icons, a #222 divider, then 32 px rows (32 px thumbnail, gap 10,
// Inter 14; watched rows dimmer with an orange progress line; "⋯" on hover). Home shows
// titled sections of three rows each.
import { ScrollView } from "std-widgets.slint";
import { TextField, Toggle, Segmented } from "core/controls.slint";
import { Theme, Metrics, Icon, TriIcon } from "core/theme.slint";
import { Icons } from "core/icons.slint";
import { ListRow, LiveRow, LiveRows, MeterBar } from "core/rows.slint";
import { EmptyState } from "core/empty-state.slint";
import { FlatButton, IconButton, PrimaryButton, SecondaryButton, ButtonSize } from "core/buttons.slint";
import { ExtTab, ExtWidget } from "state/extensions.slint";
import { Downloads } from "state/downloads.slint";
import { DownloadsView } from "downloads.slint";
import { Streams } from "state/streams.slint";
import { StreamsHub, ServicePage, StreamsRow } from "streams.slint";

export struct LibItem {
    key: string,
    title: string,
    subtitle: string,
    // "video" | "audio" | "folder" | "group" | "playlist"
    kind: string,
    thumb: image,
    has-thumb: bool,
    progress: float,
    pinned: bool,
    // Media path whose thumbnail this item shows (groups use their first song).
    thumb-key: string,
    watched: bool,
    // Icon name for rows without a thumbnail ("add", "songs", "album", …); "" = by kind.
    icon: string,
    // Recent entries: type label ("Stream", "Folder", …) and the target to remove.
    badge: string,
    recent-key: string,
}

// One Home widget in the grid (src/homeview.rs). `frac`: share of the line width.
export struct HomeCell {
    id: string,
    // built-in widget id ("continue", "jump", "mixes", …) or "plugin"
    kind: string,
    title: string,
    size: string,        // "s" | "m" | "l"
    width: string,       // "⅓" | "⅔" | "Full"
    size-opts: [string], // allowed sizes ("S", "M", "L")
    width-opts: [string],
    frac: float,
    on: bool,
    empty: bool,
    // Plugin widgets: owner, command, icon, template ("card" | "tiles" | "list") and live content.
    plugin: string,
    command: string,
    icon: string,
    template: string,
    info: string,
    live: bool,
    value: string,
    progress: float,
    rows: [LiveRow],
    items: [LibItem],
}
export struct HomeLine { cells: [HomeCell] }

// Small type label of a Recent entry.
export component TypeBadge inherits Rectangle {
    in property <string> text;
    in property <brush> bg: Theme.bg-a3;
    in property <brush> fg: Theme.fg-a2;
    width: bt.preferred-width + 12px; height: 18px; border-radius: self.height / 2;
    background: root.bg;
    bt := Text { text: root.text; color: root.fg; font-size: Metrics.font-micro; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
}





// Grid tile / list row. Right-click opens the context menu.
component Tile inherits Rectangle {
    in property <LibItem> it;
    in property <bool> grid: true;
    callback open();
    callback menu(length, length);
    callback forget();
    border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.bg-a1 : transparent;
    property <length> tw: grid ? self.width - 12px : 96px;
    property <length> th: grid ? (self.width - 12px) * 9 / 16 : 54px;
    thumb := Rectangle {
        x: 6px; y: 6px; width: root.tw; height: root.th;
        border-radius: Metrics.radius-md; clip: true;
        background: Theme.bg-a3;
        if root.it.has-thumb: Image { width: parent.width; height: parent.height; source: root.it.thumb; image-fit: cover; }
        // Recent entries use their own type icon (stream, folder, playlist, web video).
        if !root.it.has-thumb: TriIcon { name: Icons.kind-duo(root.it.badge != "" && root.it.icon != "" ? root.it.icon : root.it.kind); width: root.grid ? 40px : 24px; height: self.width; tint: Theme.fg-a3; }
        if root.it.progress > 0: Rectangle {
            y: parent.height - 4px; height: 4px; background: Theme.media-track;
            Rectangle { x: 0; width: parent.width * root.it.progress; background: Theme.accent; }
        }
        if root.grid && root.it.badge != "": TypeBadge { x: parent.width - self.width - 6px; y: parent.height - self.height - 6px; text: root.it.badge; bg: Theme.media-chip; fg: Theme.on-media; }
        if root.it.pinned: Rectangle {
            x: 6px; y: 6px; width: 22px; height: 22px; border-radius: self.height / 2; background: Theme.media-chip;
            Icon { source: @image-url("../assets/icons/favorite-active.svg"); width: 14px; height: 14px; tint: Theme.accent-bright; }
        }
    }
    Text {
        x: grid ? 8px : root.tw + 20px; y: grid ? root.th + 12px : 12px;
        width: grid ? root.width - 16px : root.width - root.tw - 30px;
        text: root.it.title; color: Theme.fg-1; overflow: elide; font-size: Metrics.font-base;
    }
    Text {
        x: grid ? 8px : root.tw + 20px; y: grid ? root.th + 32px : 34px;
        width: grid ? root.width - 16px : root.width - root.tw - 30px;
        text: root.it.subtitle; color: Theme.fg-a1; overflow: elide; font-size: Metrics.font-sm;
    }
    ta := TouchArea {
        accessible-role: button; accessible-label: root.it.title + (root.it.subtitle != "" ? ", " + root.it.subtitle : "");
        accessible-description: root.it.kind + (root.it.progress > 0 ? ", " + round(root.it.progress * 100) + "% played" : "") + (root.it.pinned ? ", favorite" : "");
        mouse-cursor: pointer;
        clicked => { root.open(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    // Recent entries: remove with the × (after `ta` so it sits on top of the tile's click area).
    Rectangle {
        visible: root.it.recent-key != "" && (ta.has-hover || xta.has-hover);
        x: thumb.x + thumb.width - self.width - 6px; y: thumb.y + 6px; width: 24px; height: 24px; border-radius: self.height / 2;
        background: xta.has-hover ? Theme.media-chip.darker(0.5) : Theme.media-chip;
        Icon { source: @image-url("../assets/icons/close.svg"); width: 14px; height: 14px; tint: Theme.on-media; }
        xta := TouchArea {
            accessible-role: button; accessible-label: "Remove from Recent: " + root.it.title;
            mouse-cursor: pointer; clicked => { root.forget(); }
        }
    }
}

component Grid inherits Rectangle {
    in property <[LibItem]> items;
    in property <bool> grid: true;
    in property <int> max-rows: 0; // 0 = unlimited
    // The scroll view's offset and height; view-h 0 = no virtualization (all tiles).
    in property <length> scroll-y;
    in property <length> view-h: 0px;
    callback window(int, int); // items near the view (thumbnails follow it)
    callback open(LibItem);
    callback menu(LibItem, length, length);
    callback forget(LibItem);
    // Grid columns follow the width; very narrow widths fall back to the list view.
    property <bool> g: grid && self.width >= 400px;
    property <int> cols: g ? max(1, floor(self.width / 210px)) : 1;
    property <length> cw: self.width / cols;
    property <length> ch: g ? (cw - 12px) * 9 / 16 + 62px : 66px;
    property <int> shown: max-rows > 0 ? min(items.length, max-rows * cols) : items.length;
    // Virtualized: only tiles near the viewport exist (large folders).
    property <int> first: view-h > 0 ? max(0, floor((scroll-y - self.y) / ch)) * cols : 0;
    property <int> lo: view-h > 0 ? first - 2 * cols : 0;
    property <int> hi: view-h > 0 ? first + (ceil(view-h / ch) + 3) * cols : items.length;
    changed lo => { root.window(max(0, lo), hi); }
    changed hi => { root.window(max(0, lo), hi); }
    init => { root.window(max(0, lo), hi); }
    height: ceil(shown / cols) * ch;
    for it[i] in root.items: Rectangle {
        visible: i < root.shown;
        x: mod(i, root.cols) * root.cw; y: floor(i / root.cols) * root.ch;
        width: root.cw - 6px; height: root.ch - 6px;
        if i >= root.lo && i < root.hi: Tile {
            width: parent.width; height: parent.height;
            it: it; grid: root.g;
            open => { root.open(it); }
            menu(x, y) => { root.menu(it, x, y); }
            forget => { root.forget(it); }
        }
    }
}

// One 32 px library row (Figma "media" / "playlist" components).
component LibRow inherits ListRow {
    in property <LibItem> it;
    in property <bool> dim; // Home sections draw rows in the dimmer #6B6B6B
    callback open();
    callback menu(length, length);
    callback forget();
    label: root.it.title;
    description: root.it.subtitle != "" ? root.it.subtitle : root.it.kind;
    row-height: 32px; radius: 0; hover-bg: transparent;
    clicked => { root.open(); }
    right-clicked(x, y) => { if (root.it.kind != "action") { root.menu(x, y); } }
    property <bool> media: (it.kind == "video" || it.kind == "audio") && it.icon == "";
    property <bool> hover: root.row-hovered || more-ta.has-hover || x-ta.has-hover;
    property <bool> can-forget: root.it.recent-key != "";
    // Room on the right: "⋯" (34px), × (28px) and the type badge.
    property <length> tail: (root.hover && root.it.kind != "action" ? 34px : 0px) + (root.hover && root.can-forget ? 28px : 0px);
    property <length> badge-w: root.it.badge != "" ? badge.width + 8px : 0px;
    if root.media || root.it.has-thumb: Rectangle {
        x: 0; width: 32px; height: 32px; border-radius: Metrics.radius-xs; clip: true;
        background: Theme.field-raised;
        if root.it.has-thumb: Image { width: parent.width; height: parent.height; source: root.it.thumb; image-fit: cover; }
        if !root.it.has-thumb: Icon { source: Icons.kind(root.it.kind); width: 16px; height: 16px; tint: Theme.fg-a3; }
        if root.it.progress > 0 || root.it.watched: Rectangle {
            x: 0; y: parent.height - 2px; height: 2px;
            width: parent.width * (root.it.watched ? 1 : root.it.progress);
            background: Theme.accent;
        }
    }
    if !root.media && !root.it.has-thumb: TriIcon {
        x: 4px; width: 24px; height: 24px;
        name: Icons.kind-duo(root.it.icon != "" ? root.it.icon : root.it.kind);
        tint: Theme.fg-a2;
    }
    Text {
        x: 42px; width: root.width - 42px - root.tail - root.badge-w;
        height: root.height;
        text: root.it.title; font-size: Metrics.font-base; overflow: elide; vertical-alignment: center;
        color: root.it.watched || root.dim ? Theme.fg-a3 : Theme.fg-a2; // hover only adds "⋯" (Figma)
    }
    if root.hover && root.it.kind != "action": TriIcon {
        x: root.width - 24px; y: 4px; name: "more";
        tint: more-ta.has-hover ? Theme.fg-1 : Theme.fg-a2;
    }
    badge := TypeBadge {
        visible: root.it.badge != "";
        x: root.width - root.tail - self.width - 4px; y: (root.height - self.height) / 2;
        text: root.it.badge;
    }
    Icon {
        visible: root.hover && root.can-forget;
        x: root.width - 54px; y: 6px; width: 20px; height: 20px;
        source: @image-url("../assets/icons/close.svg");
        tint: x-ta.has-hover ? Theme.fg-1 : Theme.fg-a2;
    }
    x-ta := TouchArea {
        enabled: root.can-forget;
        x: root.width - 60px; width: 28px;
        accessible-role: button; accessible-label: "Remove from Recent: " + root.it.title;
        mouse-cursor: pointer;
        clicked => { root.forget(); }
    }
    more-ta := TouchArea {
        x: root.width - 28px; width: 28px;
        accessible-role: button; accessible-label: "More options: " + root.it.title;
        mouse-cursor: pointer;
        clicked => { root.menu(self.absolute-position.x, self.absolute-position.y + 28px); }
    }
}

component Rows inherits VerticalLayout {
    in property <[LibItem]> items;
    in property <int> max: 0; // 0 = all
    in property <bool> dim;
    callback open(LibItem);
    callback menu(LibItem, length, length);
    callback forget(LibItem);
    // The scroll view's offset and height; view-h 0 = no virtualization (Home shelves).
    in property <length> scroll-y;
    in property <length> view-h: 0px;
    callback window(int, int); // rows near the view (thumbnails follow it)
    spacing: 10px;
    // Virtualized: only rows near the viewport exist (42 px = row + spacing).
    property <int> first: view-h > 0 && scroll-y > self.y ? floor((scroll-y - self.y) / 42px) : 0;
    property <int> lo: view-h > 0 ? first - 10 : 0;
    property <int> hi: view-h > 0 ? first + ceil(view-h / 42px) + 10 : items.length;
    changed lo => { if view-h > 0 { root.window(lo < 0 ? 0 : lo, hi); } }
    changed hi => { if view-h > 0 { root.window(lo < 0 ? 0 : lo, hi); } }
    init => { if view-h > 0 { root.window(lo < 0 ? 0 : lo, hi); } }
    for it[i] in root.items: Rectangle {
        visible: root.max == 0 || i < root.max;
        height: self.visible ? 32px : 0px;
        if i >= root.lo && i < root.hi: LibRow {
            width: parent.width; height: parent.height;
            dim: root.dim;
            it: it;
            open => { root.open(it); }
            menu(x, y) => { root.menu(it, x, y); }
            forget => { root.forget(it); }
        }
    }
}

component RailButton inherits Rectangle {
    in property <string> label;   // screen-reader name and hover tooltip
    in property <string> icon;    // icon name (two-tone, see TriIcon)
    in property <image> active-icon;
    in property <image> active-accent;
    in property <image> active-dim;
    in property <bool> active;
    callback clicked();
    width: 32px; height: 32px; border-radius: Metrics.radius-sm;
    background: ta.has-hover && !root.active ? Theme.bg-a1 : transparent;
    if root.active: TriIcon { base: root.active-icon; accent: root.active-accent; dim: root.active-dim; }
    if !root.active: TriIcon { name: root.icon; tint: ta.has-hover ? Theme.fg-1 : Theme.fg-a2; }
    ta := TouchArea { accessible-role: button; accessible-label: root.label; accessible-item-selected: root.active; mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.label != "": Tooltip { text: @markdown("\{root.label}"); }
}

// Sidebar → Sources: a plugin's content browser (manifest point `sidebar.source`).
// Plugin icons are small single-tone glyphs (18 px) in the 32 px rail slot.
component SourceButton inherits Rectangle {
    in property <string> label;
    in property <string> icon; // icon name (two-tone, see TriIcon)
    callback clicked();
    width: 32px; height: 32px; border-radius: Metrics.radius-sm;
    background: ta.has-hover ? Theme.bg-a1 : transparent;
    TriIcon { width: 18px; height: 18px; name: root.icon; tint: ta.has-hover ? Theme.fg-1 : Theme.fg-a2; }
    ta := TouchArea { accessible-role: button; accessible-label: "Source: " + root.label; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Tooltip { text: @markdown("\{root.label}"); }
}

// Home → Sources: icon + name chip.
component SourceChip inherits Rectangle {
    in property <string> label;
    in property <string> icon; // icon name (two-tone, see TriIcon)
    callback clicked();
    height: 40px; width: row.preferred-width + 28px; border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.bg-a1 : Theme.bg-a3;
    row := HorizontalLayout {
        x: 14px; spacing: 10px;
        VerticalLayout { alignment: center; TriIcon { width: 18px; height: 18px; name: root.icon; tint: Theme.accent; } }
        Text { text: root.label; color: Theme.fg-1; font-size: Metrics.font-base; vertical-alignment: center; }
    }
    ta := TouchArea { accessible-role: button; accessible-label: "Open " + root.label; mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; } reject } }
    if fs.has-focus: Rectangle { border-width: Metrics.focus-ring-w; border-color: Theme.focus-ring; border-radius: root.border-radius; }
}

// Home → a plugin widget (`home.widget`): icon, title, the plugin's one-line description.
component WidgetCard inherits Rectangle {
    in property <string> label;
    in property <string> info;
    in property <string> icon; // icon name (two-tone, see TriIcon)
    callback clicked();
    height: 72px; min-width: 200px; border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.bg-a1 : Theme.bg-a3;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 12px;
        VerticalLayout { alignment: center; TriIcon { width: 20px; height: 20px; name: root.icon; tint: Theme.accent; } }
        VerticalLayout {
            alignment: center; spacing: 3px;
            Text { text: root.label; color: Theme.fg-1; font-size: Metrics.font-base; overflow: elide; }
            Text { text: root.info; color: Theme.fg-a3; font-size: Metrics.font-sm; overflow: elide; }
        }
    }
    ta := TouchArea { accessible-role: button; accessible-label: root.label; accessible-description: root.info; mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; } reject } }
    if fs.has-focus: Rectangle { border-width: Metrics.focus-ring-w; border-color: Theme.focus-ring; border-radius: root.border-radius; }
}

// Home → a plugin widget with live content (`vivi-content <id> home`, see
// src/plugins/content.rs): icon and title, a large value line, a sub line, an optional
// progress bar and up to eight rows (bars drawn natively). Click runs the widget command.
component LiveWidgetCard inherits Rectangle {
    in property <string> label;
    in property <string> info;
    in property <string> icon; // icon name (two-tone, see TriIcon)
    in property <string> value;
    in property <float> progress: -1;
    in property <[LiveRow]> rows;
    callback clicked();
    min-width: 200px; border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.bg-a1 : Theme.bg-a3;
    ta := TouchArea { accessible-role: button; accessible-label: root.label; accessible-description: root.value + (root.info != "" ? ", " + root.info : ""); mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 14px; spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout { alignment: center; TriIcon { width: 18px; height: 18px; name: root.icon; tint: Theme.accent; } }
            Text { horizontal-stretch: 1; text: root.label; color: Theme.fg-a2; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; }
        }
        if root.value != "": Text { text: root.value; color: Theme.fg-1; font-size: Metrics.font-xl; font-weight: 700; overflow: elide; }
        if root.info != "": Text { text: root.info; color: Theme.fg-a3; font-size: Metrics.font-sm; overflow: elide; }
        if root.progress >= 0: MeterBar { value: root.progress; label: root.label; }
        if root.rows.length > 0: LiveRows { rows: root.rows; label-w: 64px; value-w: 60px; }
    }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; } reject } }
    if fs.has-focus: Rectangle { border-width: Metrics.focus-ring-w; border-color: Theme.focus-ring; border-radius: root.border-radius; }
}

// Home section title: "Title ›" (click opens the full list), optional action text.
component HomeHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> action-text;
    in property <bool> link: true;
    callback clicked();
    callback action();
    height: 24px; spacing: 4px;
    Text { text: root.title; color: tta.has-hover && root.link ? Theme.fg-1 : Theme.fg-a1; font-size: Metrics.font-lg; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        tta := TouchArea { enabled: root.link; accessible-role: button; accessible-label: root.title; mouse-cursor: pointer; clicked => { root.clicked(); } } }
    if root.action-text != "": Text {
        text: root.action-text; font-size: Metrics.font-base; vertical-alignment: center;
        color: ata.has-hover ? Theme.fg-1 : Theme.fg-a3;
        ata := TouchArea { accessible-role: button; accessible-label: root.action-text + " " + root.title; mouse-cursor: pointer; clicked => { root.action(); } }
    }
    if root.link: Icon { source: @image-url("../assets/icons/chevron-right.svg"); tint: cta.has-hover ? Theme.fg-1 : Theme.fg-a1;
        cta := TouchArea { accessible-role: button; accessible-label: "Show all: " + root.title; mouse-cursor: pointer; clicked => { root.clicked(); } } }
}

// Home → Continue Watching at size L: the latest unfinished video as a large card.
component HomeHero inherits Rectangle {
    in property <LibItem> it;
    in property <length> tall: 240px;
    callback open();
    callback menu(length, length);
    height: root.tall; border-radius: Metrics.radius-lg; clip: true;
    background: Theme.bg-a3;
    if root.it.has-thumb: Image { width: parent.width; height: parent.height; source: root.it.thumb; image-fit: cover; }
    if !root.it.has-thumb: TriIcon { name: Icons.kind-duo(root.it.kind); width: 56px; height: 56px; tint: Theme.fg-a3; }
    Rectangle { background: @linear-gradient(180deg, transparent 35%, Theme.media-chip 100%); }
    Rectangle {
        x: 12px; y: 12px; width: bl.preferred-width + 14px; height: 22px; border-radius: Metrics.radius-sm; background: Theme.media-chip;
        bl := Text { text: "Continue watching"; color: Theme.on-media; font-size: Metrics.font-sm; vertical-alignment: center; horizontal-alignment: center; }
    }
    VerticalLayout {
        x: 18px; y: parent.height - self.preferred-height - 22px; width: parent.width - 36px; spacing: 4px;
        Text { text: root.it.title; color: Theme.on-media; font-size: Metrics.font-xl; font-weight: 700; overflow: elide; }
        Text { text: (root.it.subtitle != "" ? root.it.subtitle + " · " : "") + "Resume ▸"; color: Theme.on-media; opacity: 0.8; font-size: Metrics.font-sm; overflow: elide; }
    }
    if root.it.progress > 0: Rectangle {
        y: parent.height - 4px; height: 4px; background: Theme.media-track;
        Rectangle { x: 0; width: parent.width * root.it.progress; background: Theme.accent; }
    }
    ta := TouchArea {
        accessible-role: button; accessible-label: "Resume " + root.it.title;
        mouse-cursor: pointer; clicked => { root.open(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    if ta.has-hover: Rectangle { border-width: 1px; border-color: Theme.fg-a3; border-radius: root.border-radius; }
}

// Home → Jump Back In at size M: a recent entry as a card with its cover.
component JumpCard inherits Rectangle {
    in property <LibItem> it;
    callback open();
    callback menu(length, length);
    height: 52px; border-radius: Metrics.radius-md; clip: true;
    background: ta.has-hover ? Theme.bg-a1 : Theme.bg-a3;
    Rectangle {
        x: 0; width: 52px; height: 52px; background: Theme.field-raised;
        if root.it.has-thumb: Image { width: parent.width; height: parent.height; source: root.it.thumb; image-fit: cover; }
        if !root.it.has-thumb: TriIcon { name: Icons.kind-duo(root.it.icon != "" ? root.it.icon : root.it.kind); width: 22px; height: 22px; tint: Theme.fg-a3; }
    }
    VerticalLayout {
        x: 64px; width: root.width - 72px; alignment: center; spacing: 2px;
        Text { text: root.it.title; color: Theme.fg-1; font-size: Metrics.font-base; overflow: elide; }
        Text { text: root.it.badge != "" ? root.it.badge + (root.it.subtitle != "" ? " · " + root.it.subtitle : "") : root.it.subtitle; color: Theme.fg-a3; font-size: Metrics.font-sm; overflow: elide; }
    }
    ta := TouchArea {
        accessible-role: button; accessible-label: root.it.title;
        mouse-cursor: pointer; clicked => { root.open(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// Home → Your Mixes: a smart playlist tile (S chip, M wide tile, L square card).
component MixTile inherits Rectangle {
    in property <LibItem> it;
    in property <int> index;
    in property <string> size: "m";
    callback open();
    callback menu(length, length);
    property <color> base: mod(root.index, 4) == 0 ? Theme.accent : (mod(root.index, 4) == 1 ? Theme.accent.darker(35%) : (mod(root.index, 4) == 2 ? Theme.accent-dim.darker(55%) : Theme.accent.darker(70%)));
    border-radius: root.size == "s" ? self.height / 2 : Metrics.radius-lg; clip: true;
    background: root.size == "s" ? (ta.has-hover ? Theme.bg-a1 : Theme.bg-a3) : @linear-gradient(135deg, root.base 0%, root.base.darker(60%) 100%);
    if root.size == "s": HorizontalLayout {
        padding-left: 12px; padding-right: 14px; spacing: 8px;
        VerticalLayout { alignment: center; TriIcon { name: "playlist"; width: 16px; height: 16px; tint: Theme.accent; } }
        Text { text: root.it.title; color: Theme.fg-1; font-size: Metrics.font-base; vertical-alignment: center; overflow: elide; }
    }
    if root.size != "s": Rectangle {
        TriIcon { x: parent.width - 30px; y: 10px; name: "playlist"; width: 20px; height: 20px; tint: Theme.on-media; }
        Text {
            x: 12px; y: parent.height - self.height - 12px; width: parent.width - (root.size == "m" ? 60px : 24px);
            text: root.it.title; color: Theme.on-media; font-size: root.size == "l" ? Metrics.font-xl : Metrics.font-lg; font-weight: 700; wrap: word-wrap; overflow: elide;
        }
        if root.size == "m": Text {
            x: parent.width - self.width - 12px; y: parent.height - self.height - 14px;
            text: root.it.subtitle; color: Theme.on-media; opacity: 0.8; font-size: Metrics.font-sm;
        }
    }
    ta := TouchArea {
        accessible-role: button; accessible-label: root.it.title + ", smart playlist, " + root.it.subtitle;
        mouse-cursor: pointer; clicked => { root.open(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    if ta.has-hover && root.size != "s": Rectangle { border-width: 1px; border-color: Theme.on-media; border-radius: root.border-radius; opacity: 0.4; }
}

// Customize Home: a widget's header in edit mode (drag handle, name, size, width, ↑ ↓, on / off).
component HomeEditBar inherits Rectangle {
    in property <HomeCell> c;
    callback act(string, string); // (action, value)
    callback drag(length);        // absolute pointer y while dragging
    callback dropped();
    in property <bool> compact; // narrow widget: cycle buttons instead of segments
    height: 34px; border-radius: Metrics.radius-md; background: Theme.bg-a3;
    HorizontalLayout {
        padding-left: 6px; padding-right: 8px; spacing: 8px;
        Rectangle {
            width: 22px;
            TriIcon { name: "list"; width: 16px; height: 16px; tint: hta.has-hover || hta.pressed ? Theme.fg-1 : Theme.fg-a3; }
            hta := TouchArea {
                accessible-role: button; accessible-label: "Drag to move " + root.c.title;
                mouse-cursor: hta.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                moved => { if (self.pressed) { root.drag(self.absolute-position.y + self.mouse-y); } }
                pointer-event(e) => { if (e.kind == PointerEventKind.up) { root.dropped(); } }
            }
        }
        Text { text: root.c.title; color: root.c.on ? Theme.fg-1 : Theme.fg-a3; font-size: Metrics.font-base; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if !root.compact && root.c.size-opts.length > 1: Text { text: "Size"; color: Theme.fg-a3; font-size: Metrics.font-sm; vertical-alignment: center; }
        if !root.compact && root.c.size-opts.length > 1: VerticalLayout { alignment: center; Segmented { options: root.c.size-opts; value: root.c.size == "s" ? "S" : (root.c.size == "l" ? "L" : "M"); label: "Size of " + root.c.title; selected(v) => { root.act("size", v); } } }
        if !root.compact && root.c.width-opts.length > 1: Text { text: "Width"; color: Theme.fg-a3; font-size: Metrics.font-sm; vertical-alignment: center; }
        if !root.compact && root.c.width-opts.length > 1: VerticalLayout { alignment: center; Segmented { options: root.c.width-opts; value: root.c.width; label: "Width of " + root.c.title; selected(v) => { root.act("width", v); } } }
        // Narrow widgets: one button cycles the size, one the width.
        if root.compact && root.c.size-opts.length > 1: VerticalLayout { alignment: center; FlatButton { text: "Size " + (root.c.size == "s" ? "S" : (root.c.size == "l" ? "L" : "M")); size: ButtonSize.sm; clicked => { root.act("size-next", ""); } } }
        if root.compact && root.c.width-opts.length > 1: VerticalLayout { alignment: center; FlatButton { text: root.c.width; size: ButtonSize.sm; clicked => { root.act("width-next", ""); } } }
        VerticalLayout { alignment: center; IconButton { duo: "arrow-up"; size: ButtonSize.sm; tip: "Move " + root.c.title + " up"; clicked => { root.act("up", ""); } } }
        VerticalLayout { alignment: center; IconButton { duo: "arrow-down"; size: ButtonSize.sm; tip: "Move " + root.c.title + " down"; clicked => { root.act("down", ""); } } }
        VerticalLayout { alignment: center; Toggle { on: root.c.on; label: (root.c.on ? "Hide " : "Show ") + root.c.title; toggled => { root.act("toggle", root.c.on ? "false" : "true"); } } }
    }
}

component HeadIcon inherits Rectangle {
    in property <string> label;   // screen-reader name and hover tooltip
    in property <string> icon;    // icon name (two-tone, see TriIcon)
    in property <bool> enabled: true;
    callback clicked();
    width: 24px; height: 24px;
    TriIcon { name: root.icon; tint: ta.has-hover && root.enabled ? Theme.fg-1 : Theme.fg-a2; opacity: root.enabled ? 1 : 0.3; }
    ta := TouchArea { enabled: root.enabled; accessible-role: button; accessible-label: root.label; mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.label != "": Tooltip { text: @markdown("\{root.label}"); }
}

export component LibraryView inherits Rectangle {
    in property <[LibItem]> items;
    in property <[LibItem]> continue-items;
    in property <[LibItem]> recent-items;
    in property <[LibItem]> pinned-items;
    in property <[LibItem]> listen-items;
    in property <[LibItem]> folder-items;
    in property <[LibItem]> list-items;
    in property <[LibItem]> artist-items;
    in property <string> nav: "home";
    in property <bool> smart;
    in property <[string]> crumb-keys;
    in property <[string]> crumb-labels;
    in property <string> sort: "name";
    in property <bool> grid: true;
    in property <int> count;
    in property <bool> scanning;
    in property <bool> has-media;
    in property <bool> can-back;
    in property <bool> can-forward;
    // Docked 427 px sidebar next to the video (Figma "Library Sidebar") vs. the full home screen.
    in property <bool> sidebar;
    // Source plugins (Extensions.sources): rail buttons and the Home "Sources" row.
    in property <[ExtTab]> sources;
    callback open-source(string);
    // Plugin widgets on Home (Extensions.widgets); run(plugin id, command).
    in property <[ExtWidget]> widgets;
    callback run-widget(string, string);
    // Home widgets (src/homeview.rs): lines of cells, smart playlists, edit mode.
    in property <[HomeLine]> home-lines;
    in property <[LibItem]> mix-items;
    in property <bool> home-edit;
    callback home-action(string, string, string); // (action, widget id, value)
    callback home-narrow(bool);
    property <bool> dragging;
    property <string> drag-id;
    property <length> drag-y;
    property <int> drop-line: -1;
    property <bool> home-is-narrow: root.sidebar || root.width < 900px;
    changed home-is-narrow => { root.home-narrow(self.home-is-narrow); }
    init => { root.home-narrow(self.home-is-narrow); }
    callback open-extensions();
    callback navigate(string);
    callback history(bool); // false = back, true = forward
    callback search(string);
    callback open(string, string);
    // kind ("lib" | "sort" | "view"), window x, y, context (see src/menus.rs)
    callback menu-request(string, length, length, string);
    callback open-file();
    callback open-network();
    callback add-folders();
    callback create-playlist();
    callback clear-recent();
    callback thumb-window(int, int);
    // Remove one Recent entry (hover ×).
    callback forget-recent(LibItem);
    callback popout();
    // Plugin dialogs shown as pages (Streams hub tabs, service pages): (owner, name, args).
    callback plugin-command(string, string, string);
    in-out property <string> query;
    property <bool> searching: query != "";
    property <string> section: nav == "home" ? "home" : (crumb-keys.length > 0 ? crumb-keys[0] : nav);
    // The Streams hub or a service page fills the content area (#86).
    property <bool> hub: Streams.view != "";
    property <bool> show-grid: root.grid && !root.sidebar && root.width >= 520px && root.nav != "home" && root.items.length > 0 && root.items[0].kind != "action";
    property <int> rows-max: root.sidebar ? 3 : 6;

    function ctx-of(it: LibItem) -> string {
        return it.key + "\n" + it.kind + "\n" + (it.pinned ? "1" : "0") + "\n" + (it.watched ? "1" : "0") + "\n" + (it.progress > 0 && !it.watched ? "1" : "0") + "\n" + (it.recent-key != "" ? "1" : "0");
    }
    function item-menu(it: LibItem, x: length, y: length) {
        root.menu-request("lib", x, y, root.ctx-of(it));
    }
    function go(it: LibItem) { root.open(it.key, it.kind); }

    background: root.sidebar ? Theme.panel(Theme.bg-b1, 0.95) : Theme.bg-b1;
    TouchArea { }

    HorizontalLayout {
        // Icon rail
        Rectangle {
            width: 50px; background: Theme.bg-a4;
            VerticalLayout {
                padding-top: 8px; padding-left: 9px; padding-right: 9px; spacing: 14px; alignment: start;
                RailButton { label: "Home"; icon: "home"; active-icon: @image-url("../assets/icons/layers/home-active-b.svg"); active-accent: @image-url("../assets/icons/layers/home-active-a.svg"); active-dim: @image-url("../assets/icons/layers/home-active-d.svg"); active: root.section == "home"; clicked => { root.navigate("home"); } }
                RailButton { label: "Videos"; icon: "videos"; active-icon: @image-url("../assets/icons/layers/videos-active-b.svg"); active-accent: @image-url("../assets/icons/layers/videos-active-a.svg"); active-dim: @image-url("../assets/icons/layers/videos-active-d.svg"); active: root.section == "video"; clicked => { root.navigate("video"); } }
                RailButton { label: "Music"; icon: "songs"; active-icon: @image-url("../assets/icons/layers/songs-active-b.svg"); active-accent: @image-url("../assets/icons/layers/songs-active-a.svg"); active-dim: @image-url("../assets/icons/layers/songs-active-d.svg"); active: root.section == "music"; clicked => { root.navigate("music"); } }
                RailButton { label: "Streams"; icon: "streaming"; active-icon: @image-url("../assets/icons/layers/streaming-active-b.svg"); active-accent: @image-url("../assets/icons/layers/streaming-active-a.svg"); active-dim: @image-url("../assets/icons/layers/streaming-active-d.svg"); active: root.section == "streams" && Streams.view == "hub"; clicked => { root.navigate("streams"); } }
                RailButton { label: "Playlists"; icon: "playlist"; active-icon: @image-url("../assets/icons/layers/playlist-active-b.svg"); active-accent: @image-url("../assets/icons/layers/playlist-active-a.svg"); active-dim: @image-url("../assets/icons/layers/playlist-active-d.svg"); active: root.section == "playlists"; clicked => { root.navigate("playlists"); } }
                RailButton { label: "Recently played"; icon: "recent"; active-icon: @image-url("../assets/icons/layers/recent-active-b.svg"); active-accent: @image-url("../assets/icons/layers/recent-active-a.svg"); active-dim: @image-url("../assets/icons/layers/recent-active-d.svg"); active: root.section == "recent"; clicked => { root.navigate("recent"); } }
                // Shared Downloads panel; the badge counts queued / running / paused jobs.
                Rectangle {
                    width: 32px; height: 32px;
                    RailButton {
                        label: Downloads.active > 0 ? "Downloads (" + Downloads.active + " active)" : "Downloads";
                        icon: "arrow-down";
                        active-icon: @image-url("../assets/icons/layers/arrow-down-active-b.svg"); active-accent: @image-url("../assets/icons/layers/arrow-down-active-a.svg"); active-dim: @image-url("../assets/icons/layers/arrow-down-active-d.svg");
                        active: root.section == "downloads"; clicked => { root.navigate("downloads"); }
                    }
                    if Downloads.active > 0: Rectangle {
                        x: parent.width - 12px; y: -3px; width: max(15px, bt.preferred-width + 8px); height: 15px;
                        border-radius: 7.5px; background: Theme.accent;
                        bt := Text { text: Downloads.active > 99 ? "99+" : Downloads.active; color: Theme.bg-b2; font-size: Metrics.font-micro; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                RailButton { label: "Open file"; icon: "add"; active-icon: @image-url("../assets/icons/add.svg"); clicked => { root.open-file(); } }
                if root.sources.length > 0: Rectangle { height: 1px; background: Theme.bg-a1; }
                for s in root.sources: SourceButton { label: s.name; icon: Icons.plugin-duo(s.icon); clicked => { root.open-source(s.id); } }
            }
            VerticalLayout {
                height: self.preferred-height; y: parent.height - self.height; padding-left: 9px; padding-right: 9px; padding-bottom: 10px;
                RailButton {
                    label: "Extensions (Ctrl+E)"; icon: "plugins";
                    active-icon: @image-url("../assets/icons/layers/plugins-active-b.svg"); active-accent: @image-url("../assets/icons/layers/plugins-active-a.svg"); active-dim: @image-url("../assets/icons/layers/plugins-active-d.svg");
                    clicked => { root.open-extensions(); }
                }
            }
        }
        // Content
        VerticalLayout {
            padding: 20px; padding-bottom: 0; spacing: 17px;
            HorizontalLayout {
                height: 24px; spacing: 12px;
                HeadIcon { label: "Back"; icon: "arrow-left"; enabled: root.can-back; clicked => { root.history(false); } }
                HeadIcon { label: "Forward"; icon: "arrow-right"; enabled: root.can-forward; clicked => { root.history(true); } }
                // Breadcrumb ("..." for long paths comes from src/libview.rs).
                HorizontalLayout {
                    horizontal-stretch: 1; spacing: 6px;
                    for k[i] in root.crumb-keys: HorizontalLayout {
                        spacing: 6px;
                        if i > 0: Text { text: "▸"; color: Theme.fg-a2; font-size: Metrics.font-micro; vertical-alignment: center; }
                        Text {
                            text: root.crumb-labels[i]; font-size: Metrics.font-lg; overflow: elide; vertical-alignment: center;
                            // Docked, long names give way sooner so the row fits the panel.
                            min-width: min(self.preferred-width, root.sidebar ? 56px : 140px);
                            color: cta.has-hover ? Theme.fg-1 : Theme.fg-a2;
                            cta := TouchArea { accessible-role: button; accessible-label: root.crumb-labels[i]; mouse-cursor: pointer; clicked => { root.navigate(k); } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                more := HeadIcon {
                    label: "More"; icon: "more";
                    clicked => {
                        if (root.nav.character-count > 6 && root.crumb-keys.length > 1 && root.section == "video") {
                            root.menu-request("lib", self.absolute-position.x, self.absolute-position.y + 28px,
                                root.nav + "\nfolder\n0\n0\n0");
                        } else {
                            root.menu-request("view", self.absolute-position.x, self.absolute-position.y + 28px, "");
                        }
                    }
                }
                HeadIcon { label: root.has-media ? "Back to the player" : "Open file"; icon: "open"; clicked => { root.popout(); } }
            }
            if !root.hub: HorizontalLayout {
                height: 24px; spacing: 12px;
                Text {
                    horizontal-stretch: 1; vertical-alignment: center; font-size: Metrics.font-base; color: Theme.fg-a3;
                    text: root.nav == "downloads" ? Downloads.jobs.length + " downloads" : root.scanning ? "Scanning…" : (root.nav == "home" ? root.count : root.items.length) + " items";
                }
                if root.nav != "downloads": HeadIcon {
                    label: "Sort"; icon: root.sort != "name" && root.sort != "title" ? "sort-active" : "sort";
                    clicked => { root.menu-request("sort", self.absolute-position.x, self.absolute-position.y + 28px, ""); }
                }
                if root.nav != "downloads": HeadIcon {
                    label: "View"; icon: "list";
                    clicked => { root.menu-request("view", self.absolute-position.x, self.absolute-position.y + 28px, ""); }
                }
                if root.nav != "downloads": HeadIcon {
                    label: "Search"; icon: "search";
                    clicked => { root.searching = !root.searching; if (!root.searching) { root.query = ""; root.search(""); } }
                }
            }
            if root.searching && !root.hub: TextField {
                placeholder: "Search library"; label: "Search library"; text <=> root.query;
                edited(t) => { root.search(t); }
                init => { self.focus-input(); }
            }
            Rectangle { height: 1px; background: Theme.bg-a1; }
            if Streams.view == "hub": StreamsHub {
                vertical-stretch: 1; padding-bottom: 16px; narrow: root.sidebar || root.width < 640px;
                command(o, n, a) => { root.plugin-command(o, n, a); }
                open-extensions => { root.open-extensions(); }
            }
            if Streams.view == "service": ServicePage {
                vertical-stretch: 1; padding-bottom: 16px;
                command(o, n, a) => { root.plugin-command(o, n, a); }
            }
            if !root.hub: lsv := ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start; padding-top: 3px; padding-bottom: 20px; padding-right: 8px; spacing: 30px;
                    if root.nav == "home" && root.query == "": VerticalLayout {
                        spacing: 33px;
                        if root.count == 0 && root.recent-items.length == 0: EmptyState {
                            picture: @image-url("../packaging/vivi.svg");
                            title: "Your library is empty";
                            sentence: "Open a file, or add folders in Settings → Library (Ctrl+,). Drop files anywhere to play.";
                            primary-text: "Open file"; secondary-text: "Open stream"; tertiary-text: "Add folders";
                            primary => { root.open-file(); }
                            secondary => { root.open-network(); }
                            tertiary => { root.add-folders(); }
                        }
                        // Customize Home: the edit strip, or the entry button above the widgets.
                        if root.home-edit: Rectangle {
                            height: 52px; border-radius: Metrics.radius-lg; background: Theme.bg-a3; border-width: 1px; border-color: Theme.bg-a1;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 10px; spacing: 10px;
                                Text { text: "Customize Home"; color: Theme.fg-1; font-size: Metrics.font-lg; font-weight: 600; vertical-alignment: center; }
                                Text { text: "Drag a widget by its handle or use ↑ ↓ · size and width per widget · the switch hides it"; color: Theme.fg-a3; font-size: Metrics.font-sm; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                VerticalLayout { alignment: center; FlatButton { text: "Reset to default"; size: ButtonSize.sm; clicked => { root.home-action("reset", "", ""); } } }
                                VerticalLayout { alignment: center; SecondaryButton { text: "Cancel"; size: ButtonSize.sm; clicked => { root.home-action("cancel", "", ""); } } }
                                VerticalLayout { alignment: center; PrimaryButton { text: "Done"; size: ButtonSize.sm; clicked => { root.home-action("done", "", ""); } } }
                            }
                        }
                        if !root.home-edit && !root.sidebar && root.home-lines.length > 0: HorizontalLayout {
                            height: 24px;
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: "Customize Home"; color: cha.has-hover ? Theme.fg-1 : Theme.fg-a3; font-size: Metrics.font-base; vertical-alignment: center;
                                cha := TouchArea { accessible-role: button; accessible-label: "Customize Home"; mouse-cursor: pointer; clicked => { root.home-action("edit", "", ""); } }
                            }
                        }
                        // The widgets, line by line (src/home.rs packs them into lines of three columns).
                        for line[li] in root.home-lines: Rectangle {
                            property <bool> drop-here: root.dragging && root.drag-y >= self.absolute-position.y - 16px && root.drag-y < self.absolute-position.y + self.height + 16px;
                            changed drop-here => { if (self.drop-here) { root.drop-line = li; } }
                            height: lrow.preferred-height;
                            lrow := HorizontalLayout {
                                spacing: 16px;
                                for c in line.cells: VerticalLayout {
                                    // Share of the line by stretch (an explicit width would loop with the scroll view).
                                    horizontal-stretch: c.frac; preferred-width: 1px;
                                    alignment: start; spacing: 12px;
                                    if root.home-edit: HomeEditBar {
                                        c: c; compact: c.frac < 0.5 || root.home-is-narrow;
                                        act(a, v) => { root.home-action(a, c.id, v); }
                                        drag(y) => { root.dragging = true; root.drag-id = c.id; root.drag-y = y; }
                                        dropped => { if (root.dragging) { root.dragging = false; root.home-action("drop", c.id, "\{root.drop-line}"); } }
                                    }
                                    if root.home-edit && !c.on: Text { text: "Hidden. Turn it on to show it here."; color: Theme.fg-a3; font-size: Metrics.font-sm; }
                                    if root.home-edit && c.on && c.empty: Text { text: "Nothing here yet. It fills in as you use Vivi."; color: Theme.fg-a3; font-size: Metrics.font-sm; }
                                    if c.on && !c.empty: VerticalLayout {
                                        spacing: 14px;
                                        // Continue Watching
                                        if c.kind == "continue" && c.size == "l": HomeHero {
                                            it: root.continue-items[0]; open => { root.go(root.continue-items[0]); } menu(x, y) => { root.item-menu(root.continue-items[0], x, y); }
                                        }
                                        if c.kind == "continue" && c.size != "l": HomeHead { title: c.title; clicked => { root.navigate("recent"); } }
                                        if c.kind == "continue" && c.size == "m": Grid { items: root.continue-items; max-rows: 1; open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                                        if c.kind == "continue" && c.size == "s": Rows { items: root.continue-items; max: 3; dim: true; open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                                        // Jump Back In: the latest entries of every kind
                                        if c.kind == "jump": HomeHead { title: c.title; clicked => { root.navigate("recent"); } }
                                        if c.kind == "jump" && c.size == "m": VerticalLayout {
                                            spacing: 8px;
                                            for it[i] in root.recent-items: JumpCard { visible: i < 4; height: i < 4 ? 52px : 0px; it: it; open => { root.go(it); } menu(x, y) => { root.item-menu(it, x, y); } }
                                        }
                                        if c.kind == "jump" && c.size == "s": Rows { items: root.recent-items; max: 5; dim: true; forget(it) => { root.forget-recent(it); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                                        // Your Mixes: smart playlists
                                        if c.kind == "mixes": HomeHead { title: c.title; clicked => { root.navigate("playlists"); } }
                                        if c.kind == "mixes" && c.size == "s": HorizontalLayout {
                                            spacing: 10px; alignment: start;
                                            for it[i] in root.mix-items: MixTile { it: it; index: i; size: "s"; height: 36px; width: min(220px, self.preferred-width + 40px); open => { root.go(it); } menu(x, y) => { root.item-menu(it, x, y); } }
                                        }
                                        if c.kind == "mixes" && c.size != "s": Rectangle {
                                            property <int> cols: max(1, floor((self.width + 14px) / ((c.size == "l" ? 170px : 220px) + 14px)));
                                            property <length> tw: (self.width - (self.cols - 1) * 14px) / self.cols;
                                            property <length> th: c.size == "l" ? self.tw : 84px;
                                            property <int> n: min(root.mix-items.length, c.size == "l" ? self.cols : self.cols * 2);
                                            height: ceil(self.n / self.cols) * (self.th + 14px) - 14px;
                                            for it[i] in root.mix-items: MixTile {
                                                visible: i < parent.n;
                                                x: mod(i, parent.cols) * (parent.tw + 14px); y: floor(i / parent.cols) * (parent.th + 14px);
                                                width: parent.tw; height: parent.th;
                                                it: it; index: i; size: c.size;
                                                open => { root.go(it); } menu(x, y) => { root.item-menu(it, x, y); }
                                            }
                                        }
                                        // Library shelves: S rows, M one row of cards, L two rows of cards
                                        if c.kind == "added" || c.kind == "listen" || c.kind == "favorites" || c.kind == "folders" || c.kind == "artists" || c.kind == "lists" || c.kind == "recent": HomeHead {
                                            title: c.title; link: c.kind != "favorites";
                                            action-text: c.kind == "recent" ? "Clear" : "";
                                            action => { root.clear-recent(); }
                                            clicked => { root.navigate(c.kind == "added" || c.kind == "folders" ? "video" : (c.kind == "artists" ? "music:artists" : (c.kind == "lists" ? "playlists" : "recent"))); }
                                        }
                                        if c.kind == "added" || c.kind == "listen" || c.kind == "favorites" || c.kind == "folders" || c.kind == "artists" || c.kind == "lists" || c.kind == "recent": VerticalLayout {
                                            property <[LibItem]> src: c.kind == "added" ? root.items : (c.kind == "listen" ? root.listen-items : (c.kind == "favorites" ? root.pinned-items : (c.kind == "folders" ? root.folder-items : (c.kind == "artists" ? root.artist-items : (c.kind == "lists" ? root.list-items : root.recent-items)))));
                                            if c.size != "s": Grid { items: parent.src; max-rows: c.size == "l" ? 2 : 1; forget(it) => { root.forget-recent(it); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                                            if c.size == "s": Rows { items: parent.src; max: 4; dim: true; forget(it) => { root.forget-recent(it); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                                        }
                                        // Streams (#86) and plugin sources
                                        if c.kind == "streams": StreamsRow { open-hub => { root.navigate("streams"); } }
                                        if c.kind == "sources": HomeHead { title: c.title; action-text: "Manage"; link: false; action => { root.open-extensions(); } }
                                        if c.kind == "sources": HorizontalLayout {
                                            spacing: 10px; alignment: start;
                                            for so in root.sources: SourceChip { label: so.name; icon: Icons.plugin-duo(so.icon); clicked => { root.open-source(so.id); } }
                                        }
                                        // Plugin widgets (`home.widget`): card, tiles or list
                                        if c.kind == "plugin" && c.template == "card" && !c.live: WidgetCard { label: c.title; info: c.info; icon: Icons.plugin-duo(c.icon); clicked => { root.run-widget(c.plugin, c.command); } }
                                        if c.kind == "plugin" && c.template == "card" && c.live: LiveWidgetCard { label: c.title; info: c.info; icon: Icons.plugin-duo(c.icon); value: c.value; progress: c.progress; rows: c.rows; clicked => { root.run-widget(c.plugin, c.command); } }
                                        if c.kind == "plugin" && c.template != "card": HomeHead { title: c.title; clicked => { root.run-widget(c.plugin, c.command); } }
                                        if c.kind == "plugin" && c.template == "tiles": Grid { items: c.items; max-rows: c.size == "l" ? 2 : 1; open(it) => { root.run-widget(c.plugin, c.command + "\n" + it.key); } }
                                        if c.kind == "plugin" && c.template == "list": Rows { items: c.items; max: c.size == "s" ? 3 : (c.size == "l" ? 8 : 5); dim: true; open(it) => { root.run-widget(c.plugin, c.command + "\n" + it.key); } }
                                    }
                                }
                            }
                            if self.drop-here && root.drag-y < self.absolute-position.y + self.height / 2: Rectangle { y: -11px; height: 3px; border-radius: 2px; background: Theme.accent; }
                            if self.drop-here && root.drag-y >= self.absolute-position.y + self.height / 2: Rectangle { y: self.height + 8px; height: 3px; border-radius: 2px; background: Theme.accent; }
                        }
                    }
                    if root.nav == "downloads": DownloadsView { narrow: root.sidebar; }
                    if (root.nav != "home" || root.query != "") && root.nav != "downloads" && !root.show-grid: Rows {
                        items: root.items; forget(it) => { root.forget-recent(it); }
                        scroll-y: -lsv.content-y; view-h: lsv.visible-height; window(lo, hi) => { root.thumb-window(lo, hi); }
                        open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); }
                    }
                    if (root.nav != "home" || root.query != "") && root.nav != "downloads" && root.show-grid: Grid {
                        items: root.items; grid: true; forget(it) => { root.forget-recent(it); }
                        scroll-y: -lsv.content-y; view-h: lsv.visible-height; window(lo, hi) => { root.thumb-window(lo, hi); }
                        open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); }
                    }
                    if (root.nav != "home" || root.query != "") && root.nav != "downloads" && root.items.length == 0 && root.scanning: Text {
                        text: "Scanning…"; color: Theme.fg-a3;
                    }
                    if (root.nav != "home" || root.query != "") && root.nav != "downloads" && root.items.length == 0 && !root.scanning && root.query != "": EmptyState {
                        icon: "search"; title: "No matching files";
                        sentence: "Nothing in the library matches “" + root.query + "”. Try another search, or add more folders.";
                        primary-text: "Clear search";
                        primary => { root.query = ""; root.search(""); }
                    }
                    if root.smart && root.items.length == 0 && !root.scanning && root.query == "": EmptyState {
                        icon: "playlist"; title: "Nothing matches yet";
                        sentence: "Smart playlists fill themselves from what you play. Play a few songs and come back.";
                        primary-text: "Open Music";
                        primary => { root.navigate("music"); }
                    }
                    if (root.nav != "home" || root.query != "") && root.nav != "downloads" && root.items.length == 0 && !root.scanning && root.query == "" && root.section == "playlists" && !root.smart: EmptyState {
                        icon: "playlist"; title: "No playlists yet";
                        sentence: "Save the queue from the side panel, or create a playlist to see it here.";
                        primary-text: "New playlist";
                        primary => { root.create-playlist(); }
                    }
                    if (root.nav != "home" || root.query != "") && root.nav != "downloads" && root.items.length == 0 && !root.scanning && root.query == "" && root.section != "playlists": EmptyState {
                        icon: root.section == "music" ? "music" : (root.section == "recent" ? "recent" : "videos");
                        title: "Nothing here yet";
                        sentence: "Add folders in Settings → Library, or open a file to start this collection.";
                        primary-text: "Open file"; secondary-text: "Add folders";
                        primary => { root.open-file(); }
                        secondary => { root.add-folders(); }
                    }
                }
            }
        }
    }
}
