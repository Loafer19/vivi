// Library per the Figma "Library Sidebar" frames (docs/design/frames/library-sidebars.png):
// 50 px icon rail (#191919, 32 px buttons, gap 14), content #0E0E0E with 20 px padding:
// back/forward + breadcrumb (Inter 16 #8F8F8F, "▸" separators) + more/open icons, item count
// with sort/view/search icons, a #222 divider, then 32 px rows (32 px thumbnail, gap 10,
// Inter 14; watched rows dimmer with an orange progress line; "⋯" on hover). Home shows
// titled sections of three rows each.
import { ScrollView } from "std-widgets.slint";
import { TextField } from "core/controls.slint";
import { Theme, Metrics, Icon, TriIcon } from "core/theme.slint";
import { Icons } from "core/icons.slint";
import { ListRow } from "core/rows.slint";
import { PrimaryButton, SecondaryButton } from "core/buttons.slint";
import { ExtTab, ExtWidget } from "state/extensions.slint";
import { Downloads } from "state/downloads.slint";
import { DownloadsView } from "downloads.slint";

export struct LibItem {
    key: string,
    title: string,
    subtitle: string,
    // "video" | "audio" | "folder" | "group" | "playlist"
    kind: string,
    thumb: image,
    has-thumb: bool,
    progress: float,
    pinned: bool,
    // Media path whose thumbnail this item shows (groups use their first song).
    thumb-key: string,
    watched: bool,
    // Icon name for rows without a thumbnail ("add", "songs", "album", …); "" = by kind.
    icon: string,
    // Recent entries: type label ("Stream", "Folder", …) and the target to remove.
    badge: string,
    recent-key: string,
}

// Small type label of a Recent entry.
export component TypeBadge inherits Rectangle {
    in property <string> text;
    in property <brush> bg: Theme.bg-a3;
    in property <brush> fg: Theme.fg-a2;
    width: bt.preferred-width + 12px; height: 18px; border-radius: self.height / 2;
    background: root.bg;
    bt := Text { text: root.text; color: root.fg; font-size: Metrics.font-micro; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
}





// Grid tile / list row. Right-click opens the context menu.
component Tile inherits Rectangle {
    in property <LibItem> it;
    in property <bool> grid: true;
    callback open();
    callback menu(length, length);
    callback forget();
    border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.bg-a1 : transparent;
    property <length> tw: grid ? self.width - 12px : 96px;
    property <length> th: grid ? (self.width - 12px) * 9 / 16 : 54px;
    thumb := Rectangle {
        x: 6px; y: 6px; width: root.tw; height: root.th;
        border-radius: Metrics.radius-md; clip: true;
        background: Theme.bg-a3;
        if root.it.has-thumb: Image { width: parent.width; height: parent.height; source: root.it.thumb; image-fit: cover; }
        // Recent entries use their own type icon (stream, folder, playlist, web video).
        if !root.it.has-thumb: Icon { source: Icons.kind(root.it.badge != "" && root.it.icon != "" ? root.it.icon : root.it.kind); width: root.grid ? 40px : 24px; height: self.width; tint: Theme.fg-a3; }
        if root.it.progress > 0: Rectangle {
            y: parent.height - 4px; height: 4px; background: Theme.media-track;
            Rectangle { x: 0; width: parent.width * root.it.progress; background: Theme.accent; }
        }
        if root.grid && root.it.badge != "": TypeBadge { x: parent.width - self.width - 6px; y: parent.height - self.height - 6px; text: root.it.badge; bg: Theme.media-chip; fg: Theme.on-media; }
        if root.it.pinned: Rectangle {
            x: 6px; y: 6px; width: 22px; height: 22px; border-radius: self.height / 2; background: Theme.media-chip;
            Icon { source: @image-url("../assets/icons/favorite-active.svg"); width: 14px; height: 14px; tint: Theme.accent-bright; }
        }
    }
    Text {
        x: grid ? 8px : root.tw + 20px; y: grid ? root.th + 12px : 12px;
        width: grid ? root.width - 16px : root.width - root.tw - 30px;
        text: root.it.title; color: Theme.fg-1; overflow: elide; font-size: Metrics.font-base;
    }
    Text {
        x: grid ? 8px : root.tw + 20px; y: grid ? root.th + 32px : 34px;
        width: grid ? root.width - 16px : root.width - root.tw - 30px;
        text: root.it.subtitle; color: Theme.fg-a1; overflow: elide; font-size: Metrics.font-sm;
    }
    ta := TouchArea {
        accessible-role: button; accessible-label: root.it.title + (root.it.subtitle != "" ? ", " + root.it.subtitle : "");
        mouse-cursor: pointer;
        clicked => { root.open(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    // Recent entries: remove with the × (after `ta` so it sits on top of the tile's click area).
    Rectangle {
        visible: root.it.recent-key != "" && (ta.has-hover || xta.has-hover);
        x: thumb.x + thumb.width - self.width - 6px; y: thumb.y + 6px; width: 24px; height: 24px; border-radius: self.height / 2;
        background: xta.has-hover ? Theme.media-chip.darker(0.5) : Theme.media-chip;
        Icon { source: @image-url("../assets/icons/close.svg"); width: 14px; height: 14px; tint: Theme.on-media; }
        xta := TouchArea {
            accessible-role: button; accessible-label: "Remove from Recent: " + root.it.title;
            mouse-cursor: pointer; clicked => { root.forget(); }
        }
    }
}

component Grid inherits Rectangle {
    in property <[LibItem]> items;
    in property <bool> grid: true;
    in property <int> max-rows: 0; // 0 = unlimited
    callback open(LibItem);
    callback menu(LibItem, length, length);
    callback forget(LibItem);
    // Grid columns follow the width; very narrow widths fall back to the list view.
    property <bool> g: grid && self.width >= 400px;
    property <int> cols: g ? max(1, floor(self.width / 210px)) : 1;
    property <length> cw: self.width / cols;
    property <length> ch: g ? (cw - 12px) * 9 / 16 + 62px : 66px;
    property <int> shown: max-rows > 0 ? min(items.length, max-rows * cols) : items.length;
    height: ceil(shown / cols) * ch;
    for it[i] in root.items: Tile {
        visible: i < root.shown;
        x: mod(i, root.cols) * root.cw; y: floor(i / root.cols) * root.ch;
        width: root.cw - 6px; height: root.ch - 6px;
        it: it; grid: root.g;
        open => { root.open(it); }
        menu(x, y) => { root.menu(it, x, y); }
        forget => { root.forget(it); }
    }
}

// One 32 px library row (Figma "media" / "playlist" components).
component LibRow inherits ListRow {
    in property <LibItem> it;
    in property <bool> dim; // Home sections draw rows in the dimmer #6B6B6B
    callback open();
    callback menu(length, length);
    callback forget();
    label: root.it.title;
    row-height: 32px; radius: 0; hover-bg: transparent;
    clicked => { root.open(); }
    right-clicked(x, y) => { if (root.it.kind != "action") { root.menu(x, y); } }
    property <bool> media: (it.kind == "video" || it.kind == "audio") && it.icon == "";
    property <bool> hover: root.row-hovered || more-ta.has-hover || x-ta.has-hover;
    property <bool> can-forget: root.it.recent-key != "";
    // Room on the right: "⋯" (34px), × (28px) and the type badge.
    property <length> tail: (root.hover && root.it.kind != "action" ? 34px : 0px) + (root.hover && root.can-forget ? 28px : 0px);
    property <length> badge-w: root.it.badge != "" ? badge.width + 8px : 0px;
    if root.media || root.it.has-thumb: Rectangle {
        x: 0; width: 32px; height: 32px; border-radius: Metrics.radius-xs; clip: true;
        background: Theme.field-raised;
        if root.it.has-thumb: Image { width: parent.width; height: parent.height; source: root.it.thumb; image-fit: cover; }
        if !root.it.has-thumb: Icon { source: Icons.kind(root.it.kind); width: 16px; height: 16px; tint: Theme.fg-a3; }
        if root.it.progress > 0 || root.it.watched: Rectangle {
            x: 0; y: parent.height - 2px; height: 2px;
            width: parent.width * (root.it.watched ? 1 : root.it.progress);
            background: Theme.accent;
        }
    }
    if !root.media && !root.it.has-thumb: Icon {
        x: 4px; width: 24px; height: 24px;
        source: Icons.kind(root.it.icon != "" ? root.it.icon : root.it.kind);
        tint: Theme.fg-a2;
    }
    Text {
        x: 42px; width: root.width - 42px - root.tail - root.badge-w;
        height: root.height;
        text: root.it.title; font-size: Metrics.font-base; overflow: elide; vertical-alignment: center;
        color: root.it.watched || root.dim ? Theme.fg-a3 : Theme.fg-a2; // hover only adds "⋯" (Figma)
    }
    if root.hover && root.it.kind != "action": Icon {
        x: root.width - 24px; y: 4px; source: @image-url("../assets/icons/more.svg");
        tint: more-ta.has-hover ? Theme.fg-1 : Theme.fg-a2;
    }
    badge := TypeBadge {
        visible: root.it.badge != "";
        x: root.width - root.tail - self.width - 4px; y: (root.height - self.height) / 2;
        text: root.it.badge;
    }
    Icon {
        visible: root.hover && root.can-forget;
        x: root.width - 54px; y: 6px; width: 20px; height: 20px;
        source: @image-url("../assets/icons/close.svg");
        tint: x-ta.has-hover ? Theme.fg-1 : Theme.fg-a2;
    }
    x-ta := TouchArea {
        enabled: root.can-forget;
        x: root.width - 60px; width: 28px;
        accessible-role: button; accessible-label: "Remove from Recent: " + root.it.title;
        mouse-cursor: pointer;
        clicked => { root.forget(); }
    }
    more-ta := TouchArea {
        x: root.width - 28px; width: 28px;
        accessible-role: button; accessible-label: "More options: " + root.it.title;
        mouse-cursor: pointer;
        clicked => { root.menu(self.absolute-position.x, self.absolute-position.y + 28px); }
    }
}

component Rows inherits VerticalLayout {
    in property <[LibItem]> items;
    in property <int> max: 0; // 0 = all
    in property <bool> dim;
    callback open(LibItem);
    callback menu(LibItem, length, length);
    callback forget(LibItem);
    spacing: 10px;
    for it[i] in root.items: LibRow {
        dim: root.dim;
        visible: root.max == 0 || i < root.max;
        height: self.visible ? 32px : 0px;
        it: it;
        open => { root.open(it); }
        menu(x, y) => { root.menu(it, x, y); }
        forget => { root.forget(it); }
    }
}

// Home section: "Title ›" (Inter 16) then three rows; the title opens the full list.
component Shelf inherits VerticalLayout {
    in property <string> title;
    in property <[LibItem]> items;
    in property <int> max: 3;
    in property <string> action-text; // e.g. "Clear"
    callback title-clicked();
    callback action();
    callback open(LibItem);
    callback menu(LibItem, length, length);
    callback forget(LibItem);
    spacing: 20px;
    HorizontalLayout {
        height: 24px; spacing: 4px;
        Text { text: root.title; color: tta.has-hover ? Theme.fg-1 : Theme.fg-a1; font-size: Metrics.font-lg; vertical-alignment: center; horizontal-stretch: 1;
            tta := TouchArea { accessible-role: button; accessible-label: root.title; mouse-cursor: pointer; clicked => { root.title-clicked(); } } }
        if root.action-text != "": Text {
            text: root.action-text; font-size: Metrics.font-base; vertical-alignment: center;
            color: ata.has-hover ? Theme.fg-1 : Theme.fg-a3;
            ata := TouchArea { accessible-role: button; accessible-label: root.action-text + " " + root.title; mouse-cursor: pointer; clicked => { root.action(); } }
        }
        Icon { source: @image-url("../assets/icons/chevron-right.svg"); tint: cta.has-hover ? Theme.fg-1 : Theme.fg-a1;
            cta := TouchArea { accessible-role: button; accessible-label: "Show all: " + root.title; mouse-cursor: pointer; clicked => { root.title-clicked(); } } }
    }
    Rows { items: root.items; max: root.max; dim: true; open(it) => { root.open(it); } menu(it, x, y) => { root.menu(it, x, y); } forget(it) => { root.forget(it); } }
}

component RailButton inherits Rectangle {
    in property <string> label;   // screen-reader name and hover tooltip
    in property <image> icon;
    in property <image> active-icon;
    in property <image> active-accent;
    in property <image> active-dim;
    in property <bool> active;
    callback clicked();
    width: 32px; height: 32px; border-radius: Metrics.radius-sm;
    background: ta.has-hover && !root.active ? Theme.bg-a1 : transparent;
    if root.active: TriIcon { base: root.active-icon; accent: root.active-accent; dim: root.active-dim; }
    if !root.active: Icon { source: root.icon; tint: ta.has-hover ? Theme.fg-1 : Theme.fg-a2; }
    ta := TouchArea { accessible-role: button; accessible-label: root.label; accessible-item-selected: root.active; mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.label != "": Tooltip { text: @markdown("\{root.label}"); }
}

// Sidebar → Sources: a plugin's content browser (manifest point `sidebar.source`).
// Plugin icons are small single-tone glyphs (18 px) in the 32 px rail slot.
component SourceButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    callback clicked();
    width: 32px; height: 32px; border-radius: Metrics.radius-sm;
    background: ta.has-hover ? Theme.bg-a1 : transparent;
    Icon { width: 18px; height: 18px; source: root.icon; tint: ta.has-hover ? Theme.fg-1 : Theme.fg-a2; }
    ta := TouchArea { accessible-role: button; accessible-label: "Source: " + root.label; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Tooltip { text: @markdown("\{root.label}"); }
}

// Home → Sources: icon + name chip.
component SourceChip inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    callback clicked();
    height: 40px; width: row.preferred-width + 28px; border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.bg-a1 : Theme.bg-a3;
    row := HorizontalLayout {
        x: 14px; spacing: 10px;
        VerticalLayout { alignment: center; Icon { width: 18px; height: 18px; source: root.icon; tint: Theme.accent; } }
        Text { text: root.label; color: Theme.fg-1; font-size: Metrics.font-base; vertical-alignment: center; }
    }
    ta := TouchArea { accessible-role: button; accessible-label: "Open " + root.label; mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; } reject } }
    if fs.has-focus: Rectangle { border-width: Metrics.focus-ring-w; border-color: Theme.focus-ring; border-radius: root.border-radius; }
}

// Home → a plugin widget (`home.widget`): icon, title, the plugin's one-line description.
component WidgetCard inherits Rectangle {
    in property <string> label;
    in property <string> info;
    in property <image> icon;
    callback clicked();
    height: 72px; width: 260px; border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.bg-a1 : Theme.bg-a3;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 12px;
        VerticalLayout { alignment: center; Icon { width: 20px; height: 20px; source: root.icon; tint: Theme.accent; } }
        VerticalLayout {
            alignment: center; spacing: 3px;
            Text { text: root.label; color: Theme.fg-1; font-size: Metrics.font-base; overflow: elide; }
            Text { text: root.info; color: Theme.fg-a3; font-size: Metrics.font-sm; overflow: elide; }
        }
    }
    ta := TouchArea { accessible-role: button; accessible-label: root.label; accessible-description: root.info; mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope { focus-on-click: false; key-pressed(e) => { if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; } reject } }
    if fs.has-focus: Rectangle { border-width: Metrics.focus-ring-w; border-color: Theme.focus-ring; border-radius: root.border-radius; }
}

component HeadIcon inherits Rectangle {
    in property <string> label;   // screen-reader name and hover tooltip
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 24px; height: 24px;
    Icon { source: root.icon; tint: ta.has-hover && root.enabled ? Theme.fg-1 : Theme.fg-a2; opacity: root.enabled ? 1 : 0.3; }
    ta := TouchArea { enabled: root.enabled; accessible-role: button; accessible-label: root.label; mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.label != "": Tooltip { text: @markdown("\{root.label}"); }
}

export component LibraryView inherits Rectangle {
    in property <[LibItem]> items;
    in property <[LibItem]> continue-items;
    in property <[LibItem]> recent-items;
    in property <[LibItem]> pinned-items;
    in property <[LibItem]> listen-items;
    in property <[LibItem]> folder-items;
    in property <[LibItem]> list-items;
    in property <[LibItem]> artist-items;
    in property <string> nav: "home";
    in property <[string]> crumb-keys;
    in property <[string]> crumb-labels;
    in property <string> sort: "name";
    in property <bool> grid: true;
    in property <int> count;
    in property <bool> scanning;
    in property <bool> has-media;
    in property <bool> can-back;
    in property <bool> can-forward;
    // Docked 427 px sidebar next to the video (Figma "Library Sidebar") vs. the full home screen.
    in property <bool> sidebar;
    // Source plugins (Extensions.sources): rail buttons and the Home "Sources" row.
    in property <[ExtTab]> sources;
    callback open-source(string);
    // Plugin widgets on Home (Extensions.widgets); run(plugin id, command).
    in property <[ExtWidget]> widgets;
    callback run-widget(string, string);
    callback open-extensions();
    callback navigate(string);
    callback history(bool); // false = back, true = forward
    callback search(string);
    callback open(string, string);
    // kind ("lib" | "sort" | "view"), window x, y, context (see src/menus.rs)
    callback menu-request(string, length, length, string);
    callback open-file();
    callback open-network();
    callback add-folders();
    callback clear-recent();
    // Remove one Recent entry (hover ×).
    callback forget-recent(LibItem);
    callback popout();
    in-out property <string> query;
    property <bool> searching: query != "";
    property <string> section: nav == "home" ? "home" : (crumb-keys.length > 0 ? crumb-keys[0] : nav);
    property <bool> show-grid: root.grid && !root.sidebar && root.width >= 520px && root.nav != "home" && root.items.length > 0 && root.items[0].kind != "action";
    property <int> rows-max: root.sidebar ? 3 : 6;

    function ctx-of(it: LibItem) -> string {
        return it.key + "\n" + it.kind + "\n" + (it.pinned ? "1" : "0") + "\n" + (it.watched ? "1" : "0") + "\n" + (it.progress > 0 && !it.watched ? "1" : "0") + "\n" + (it.recent-key != "" ? "1" : "0");
    }
    function item-menu(it: LibItem, x: length, y: length) {
        root.menu-request("lib", x, y, root.ctx-of(it));
    }
    function go(it: LibItem) { root.open(it.key, it.kind); }

    background: root.sidebar ? Theme.bg-b1.with-alpha(0.95) : Theme.bg-b1;
    TouchArea { }

    HorizontalLayout {
        // Icon rail
        Rectangle {
            width: 50px; background: Theme.bg-a4;
            VerticalLayout {
                padding-top: 8px; padding-left: 9px; padding-right: 9px; spacing: 14px; alignment: start;
                RailButton { label: "Home"; icon: @image-url("../assets/icons/home.svg"); active-icon: @image-url("../assets/icons/layers/home-active-b.svg"); active-accent: @image-url("../assets/icons/layers/home-active-a.svg"); active-dim: @image-url("../assets/icons/layers/home-active-d.svg"); active: root.section == "home"; clicked => { root.navigate("home"); } }
                RailButton { label: "Videos"; icon: @image-url("../assets/icons/videos.svg"); active-icon: @image-url("../assets/icons/layers/videos-active-b.svg"); active-accent: @image-url("../assets/icons/layers/videos-active-a.svg"); active-dim: @image-url("../assets/icons/layers/videos-active-d.svg"); active: root.section == "video"; clicked => { root.navigate("video"); } }
                RailButton { label: "Music"; icon: @image-url("../assets/icons/songs.svg"); active-icon: @image-url("../assets/icons/layers/songs-active-b.svg"); active-accent: @image-url("../assets/icons/layers/songs-active-a.svg"); active-dim: @image-url("../assets/icons/layers/songs-active-d.svg"); active: root.section == "music"; clicked => { root.navigate("music"); } }
                RailButton { label: "Streams"; icon: @image-url("../assets/icons/streaming.svg"); active-icon: @image-url("../assets/icons/layers/streaming-active-b.svg"); active-accent: @image-url("../assets/icons/layers/streaming-active-a.svg"); active-dim: @image-url("../assets/icons/layers/streaming-active-d.svg"); active: root.section == "network"; clicked => { root.navigate("network"); } }
                RailButton { label: "Playlists"; icon: @image-url("../assets/icons/playlist.svg"); active-icon: @image-url("../assets/icons/layers/playlist-active-b.svg"); active-accent: @image-url("../assets/icons/layers/playlist-active-a.svg"); active-dim: @image-url("../assets/icons/layers/playlist-active-d.svg"); active: root.section == "playlists"; clicked => { root.navigate("playlists"); } }
                RailButton { label: "Recently played"; icon: @image-url("../assets/icons/recent.svg"); active-icon: @image-url("../assets/icons/recent.svg"); active: root.section == "recent"; clicked => { root.navigate("recent"); } }
                // Shared Downloads panel; the badge counts queued / running / paused jobs.
                Rectangle {
                    width: 32px; height: 32px;
                    RailButton {
                        label: Downloads.active > 0 ? "Downloads (" + Downloads.active + " active)" : "Downloads";
                        icon: @image-url("../assets/icons/arrow-down.svg");
                        active-icon: @image-url("../assets/icons/layers/arrow-down-twotone-b.svg"); active-accent: @image-url("../assets/icons/layers/arrow-down-twotone-a.svg"); active-dim: @image-url("../assets/icons/layers/arrow-down-twotone-d.svg");
                        active: root.section == "downloads"; clicked => { root.navigate("downloads"); }
                    }
                    if Downloads.active > 0: Rectangle {
                        x: parent.width - 12px; y: -3px; width: max(15px, bt.preferred-width + 8px); height: 15px;
                        border-radius: 7.5px; background: Theme.accent;
                        bt := Text { text: Downloads.active > 99 ? "99+" : Downloads.active; color: Theme.bg-b2; font-size: Metrics.font-micro; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                RailButton { label: "Open file"; icon: @image-url("../assets/icons/add.svg"); active-icon: @image-url("../assets/icons/add.svg"); clicked => { root.open-file(); } }
                if root.sources.length > 0: Rectangle { height: 1px; background: Theme.bg-a1; }
                for s in root.sources: SourceButton { label: s.name; icon: Icons.plugin(s.icon); clicked => { root.open-source(s.id); } }
            }
            VerticalLayout {
                height: self.preferred-height; y: parent.height - self.height; padding-left: 9px; padding-right: 9px; padding-bottom: 10px;
                RailButton {
                    label: "Extensions (Ctrl+E)"; icon: @image-url("../assets/icons/plugins.svg");
                    active-icon: @image-url("../assets/icons/layers/plugins-active-b.svg"); active-accent: @image-url("../assets/icons/layers/plugins-active-a.svg"); active-dim: @image-url("../assets/icons/layers/plugins-active-d.svg");
                    clicked => { root.open-extensions(); }
                }
            }
        }
        // Content
        VerticalLayout {
            padding: 20px; padding-bottom: 0; spacing: 17px;
            HorizontalLayout {
                height: 24px; spacing: 12px;
                HeadIcon { label: "Back"; icon: @image-url("../assets/icons/arrow-left.svg"); enabled: root.can-back; clicked => { root.history(false); } }
                HeadIcon { label: "Forward"; icon: @image-url("../assets/icons/arrow-right.svg"); enabled: root.can-forward; clicked => { root.history(true); } }
                // Breadcrumb ("..." for long paths comes from src/libview.rs).
                HorizontalLayout {
                    horizontal-stretch: 1; spacing: 6px;
                    for k[i] in root.crumb-keys: HorizontalLayout {
                        spacing: 6px;
                        if i > 0: Text { text: "▸"; color: Theme.fg-a2; font-size: Metrics.font-micro; vertical-alignment: center; }
                        Text {
                            text: root.crumb-labels[i]; font-size: Metrics.font-lg; overflow: elide; vertical-alignment: center;
                            min-width: min(self.preferred-width, 140px);
                            color: cta.has-hover ? Theme.fg-1 : Theme.fg-a2;
                            cta := TouchArea { accessible-role: button; accessible-label: root.crumb-labels[i]; mouse-cursor: pointer; clicked => { root.navigate(k); } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                more := HeadIcon {
                    label: "More"; icon: @image-url("../assets/icons/more.svg");
                    clicked => {
                        if (root.nav.character-count > 6 && root.crumb-keys.length > 1 && root.section == "video") {
                            root.menu-request("lib", self.absolute-position.x, self.absolute-position.y + 28px,
                                root.nav + "\nfolder\n0\n0\n0");
                        } else {
                            root.menu-request("view", self.absolute-position.x, self.absolute-position.y + 28px, "");
                        }
                    }
                }
                HeadIcon { label: root.has-media ? "Back to the player" : "Open file"; icon: @image-url("../assets/icons/open.svg"); clicked => { root.popout(); } }
            }
            HorizontalLayout {
                height: 24px; spacing: 12px;
                Text {
                    horizontal-stretch: 1; vertical-alignment: center; font-size: Metrics.font-base; color: Theme.fg-a3;
                    text: root.nav == "downloads" ? Downloads.jobs.length + " downloads" : root.scanning ? "Scanning…" : (root.nav == "home" ? root.count : root.items.length) + " items";
                }
                if root.nav != "downloads": HeadIcon {
                    label: "Sort"; icon: root.sort != "name" && root.sort != "title" ? @image-url("../assets/icons/sort-active.svg") : @image-url("../assets/icons/sort.svg");
                    clicked => { root.menu-request("sort", self.absolute-position.x, self.absolute-position.y + 28px, ""); }
                }
                if root.nav != "downloads": HeadIcon {
                    label: "View"; icon: @image-url("../assets/icons/list.svg");
                    clicked => { root.menu-request("view", self.absolute-position.x, self.absolute-position.y + 28px, ""); }
                }
                if root.nav != "downloads": HeadIcon {
                    label: "Search"; icon: @image-url("../assets/icons/search.svg");
                    clicked => { root.searching = !root.searching; if (!root.searching) { root.query = ""; root.search(""); } }
                }
            }
            if root.searching: TextField {
                placeholder: "Search library"; text <=> root.query;
                edited(t) => { root.search(t); }
                init => { self.focus-input(); }
            }
            Rectangle { height: 1px; background: Theme.bg-a1; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start; padding-top: 3px; padding-bottom: 20px; padding-right: 8px; spacing: 30px;
                    if root.nav == "home" && root.query == "": VerticalLayout {
                        spacing: 33px;
                        if root.count == 0 && root.recent-items.length == 0: VerticalLayout {
                            spacing: 10px; padding-top: 40px;
                            HorizontalLayout { alignment: center; Image { source: @image-url("../packaging/vivi.svg"); width: 72px; height: 72px; } }
                            Text { text: "Your library is empty"; color: Theme.fg-1; font-size: Metrics.font-xl; horizontal-alignment: center; }
                            Text { text: "Open a file, or add folders in Settings → Library (Ctrl+,). Drop files anywhere to play."; color: Theme.fg-a1; horizontal-alignment: center; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: center; spacing: Metrics.space-2; padding-top: 6px;
                                PrimaryButton { icon: @image-url("../assets/icons/file.svg"); text: "Open file"; clicked => { root.open-file(); } }
                                SecondaryButton { icon: @image-url("../assets/icons/streaming.svg"); text: "Open stream"; clicked => { root.open-network(); } }
                                SecondaryButton { icon: @image-url("../assets/icons/new_folder.svg"); text: "Add folders"; clicked => { root.add-folders(); } }
                            }
                        }
                        if root.sources.length > 0: VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Sources"; color: Theme.fg-1; font-size: Metrics.font-lg; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: "Manage"; color: mta.has-hover ? Theme.fg-1 : Theme.fg-a3; font-size: Metrics.font-base; vertical-alignment: center;
                                    mta := TouchArea { accessible-role: button; accessible-label: "Manage sources in Extensions"; mouse-cursor: pointer; clicked => { root.open-extensions(); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px; alignment: start;
                                for s in root.sources: SourceChip { label: s.name; icon: Icons.plugin(s.icon); clicked => { root.open-source(s.id); } }
                            }
                        }
                        if root.widgets.length > 0: VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Widgets"; color: Theme.fg-1; font-size: Metrics.font-lg; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: "Manage"; color: wta.has-hover ? Theme.fg-1 : Theme.fg-a3; font-size: Metrics.font-base; vertical-alignment: center;
                                    wta := TouchArea { accessible-role: button; accessible-label: "Manage Home widgets in Extensions"; mouse-cursor: pointer; clicked => { root.open-extensions(); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px; alignment: start;
                                for w in root.widgets: WidgetCard { label: w.label; info: w.info; icon: Icons.plugin(w.icon); clicked => { root.run-widget(w.id, w.command); } }
                            }
                        }
                        if root.continue-items.length > 0: Shelf { title: "Continue Watching"; items: root.continue-items; max: root.rows-max;
                            title-clicked => { root.navigate("recent"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.listen-items.length > 0: Shelf { title: "Listen Again"; items: root.listen-items; max: root.rows-max;
                            title-clicked => { root.navigate("recent"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.folder-items.length > 0: Shelf { title: "Frequently Visited Folders"; items: root.folder-items; max: root.rows-max;
                            title-clicked => { root.navigate("video"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.list-items.length > 0: Shelf { title: "Frequently Visited Playlists"; items: root.list-items; max: root.rows-max;
                            title-clicked => { root.navigate("playlists"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.artist-items.length > 0: Shelf { title: "Frequently Listened Artists"; items: root.artist-items; max: root.rows-max;
                            title-clicked => { root.navigate("music:artists"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.pinned-items.length > 0: Shelf { title: "Favorites"; items: root.pinned-items; max: root.rows-max;
                            open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.items.length > 0: Shelf { title: "Recently Added"; items: root.items; max: root.rows-max;
                            title-clicked => { root.navigate("video"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.recent-items.length > 0: Shelf { title: "Recently Played"; items: root.recent-items; max: root.rows-max; action-text: "Clear";
                            title-clicked => { root.navigate("recent"); } action => { root.clear-recent(); } forget(it) => { root.forget-recent(it); }
                            open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                    }
                    if root.nav == "downloads": DownloadsView { narrow: root.sidebar; }
                    if (root.nav != "home" || root.query != "") && root.nav != "downloads" && !root.show-grid: Rows {
                        items: root.items; forget(it) => { root.forget-recent(it); }
                        open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); }
                    }
                    if (root.nav != "home" || root.query != "") && root.nav != "downloads" && root.show-grid: Grid {
                        items: root.items; grid: true; forget(it) => { root.forget-recent(it); }
                        open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); }
                    }
                    if (root.nav != "home" || root.query != "") && root.nav != "downloads" && root.items.length == 0: Text {
                        text: root.scanning ? "Scanning…" : (root.query != "" ? "Nothing matches “" + root.query + "”." : "Nothing here yet.");
                        color: Theme.fg-a3;
                    }
                }
            }
        }
    }
}
