// Library per the Figma "Library Sidebar" frames (docs/design/frames/library-sidebars.png):
// 50 px icon rail (#191919, 32 px buttons, gap 14), content #0E0E0E with 20 px padding:
// back/forward + breadcrumb (Inter 16 #8F8F8F, "▸" separators) + more/open icons, item count
// with sort/view/search icons, a #222 divider, then 32 px rows (32 px thumbnail, gap 10,
// Inter 14; watched rows dimmer with an orange progress line; "⋯" on hover). Home shows
// titled sections of three rows each.
import { ScrollView } from "std-widgets.slint";
import { TextField } from "core/controls.slint";
import { Theme, Metrics, Icon, TriIcon } from "core/theme.slint";
import { Icons } from "core/icons.slint";

export struct LibItem {
    key: string,
    title: string,
    subtitle: string,
    // "video" | "audio" | "folder" | "group" | "playlist"
    kind: string,
    thumb: image,
    has-thumb: bool,
    progress: float,
    pinned: bool,
    // Media path whose thumbnail this item shows (groups use their first song).
    thumb-key: string,
    watched: bool,
    // Icon name for rows without a thumbnail ("add", "songs", "album", …); "" = by kind.
    icon: string,
}





// Grid tile / list row. Right-click opens the context menu.
component Tile inherits Rectangle {
    in property <LibItem> it;
    in property <bool> grid: true;
    callback open();
    callback menu(length, length);
    border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.bg-a1 : transparent;
    property <length> tw: grid ? self.width - 12px : 96px;
    property <length> th: grid ? (self.width - 12px) * 9 / 16 : 54px;
    thumb := Rectangle {
        x: 6px; y: 6px; width: root.tw; height: root.th;
        border-radius: Metrics.radius-md; clip: true;
        background: Theme.bg-a3;
        if root.it.has-thumb: Image { width: parent.width; height: parent.height; source: root.it.thumb; image-fit: cover; }
        if !root.it.has-thumb: Icon { source: Icons.kind(root.it.kind); width: root.grid ? 40px : 24px; height: self.width; tint: Theme.fg-a3; }
        if root.it.progress > 0: Rectangle {
            y: parent.height - 4px; height: 4px; background: Theme.media-track;
            Rectangle { x: 0; width: parent.width * root.it.progress; background: Theme.accent; }
        }
        if root.it.pinned: Rectangle {
            x: 6px; y: 6px; width: 22px; height: 22px; border-radius: self.height / 2; background: Theme.media-chip;
            Icon { source: @image-url("../assets/icons/favorite-active.svg"); width: 14px; height: 14px; tint: Theme.accent-bright; }
        }
    }
    Text {
        x: grid ? 8px : root.tw + 20px; y: grid ? root.th + 12px : 12px;
        width: grid ? root.width - 16px : root.width - root.tw - 30px;
        text: root.it.title; color: Theme.fg-1; overflow: elide; font-size: Metrics.font-base;
    }
    Text {
        x: grid ? 8px : root.tw + 20px; y: grid ? root.th + 32px : 34px;
        width: grid ? root.width - 16px : root.width - root.tw - 30px;
        text: root.it.subtitle; color: Theme.fg-a1; overflow: elide; font-size: Metrics.font-sm;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component Grid inherits Rectangle {
    in property <[LibItem]> items;
    in property <bool> grid: true;
    in property <int> max-rows: 0; // 0 = unlimited
    callback open(LibItem);
    callback menu(LibItem, length, length);
    // Grid columns follow the width; very narrow widths fall back to the list view.
    property <bool> g: grid && self.width >= 400px;
    property <int> cols: g ? max(1, floor(self.width / 210px)) : 1;
    property <length> cw: self.width / cols;
    property <length> ch: g ? (cw - 12px) * 9 / 16 + 62px : 66px;
    property <int> shown: max-rows > 0 ? min(items.length, max-rows * cols) : items.length;
    height: ceil(shown / cols) * ch;
    for it[i] in root.items: Tile {
        visible: i < root.shown;
        x: mod(i, root.cols) * root.cw; y: floor(i / root.cols) * root.ch;
        width: root.cw - 6px; height: root.ch - 6px;
        it: it; grid: root.g;
        open => { root.open(it); }
        menu(x, y) => { root.menu(it, x, y); }
    }
}

// One 32 px library row (Figma "media" / "playlist" components).
component LibRow inherits Rectangle {
    in property <LibItem> it;
    in property <bool> dim; // Home sections draw rows in the dimmer #6B6B6B
    callback open();
    callback menu(length, length);
    height: 32px;
    property <bool> media: (it.kind == "video" || it.kind == "audio") && it.icon == "";
    property <bool> hover: ta.has-hover || more-ta.has-hover;
    if root.media || root.it.has-thumb: Rectangle {
        x: 0; width: 32px; height: 32px; border-radius: Metrics.radius-xs; clip: true;
        background: Theme.field-raised;
        if root.it.has-thumb: Image { width: parent.width; height: parent.height; source: root.it.thumb; image-fit: cover; }
        if !root.it.has-thumb: Icon { source: Icons.kind(root.it.kind); width: 16px; height: 16px; tint: Theme.fg-a3; }
        if root.it.progress > 0 || root.it.watched: Rectangle {
            x: 0; y: parent.height - 2px; height: 2px;
            width: parent.width * (root.it.watched ? 1 : root.it.progress);
            background: Theme.accent;
        }
    }
    if !root.media && !root.it.has-thumb: Icon {
        x: 4px; width: 24px; height: 24px;
        source: Icons.kind(root.it.icon != "" ? root.it.icon : root.it.kind);
        tint: Theme.fg-a2;
    }
    Text {
        x: 42px; width: root.width - 42px - (root.hover && root.it.kind != "action" ? 34px : 0px);
        height: root.height;
        text: root.it.title; font-size: Metrics.font-base; overflow: elide; vertical-alignment: center;
        color: root.it.watched || root.dim ? Theme.fg-a3 : Theme.fg-a2; // hover only adds "⋯" (Figma)
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down && root.it.kind != "action") {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    if root.hover && root.it.kind != "action": Icon {
        x: root.width - 24px; y: 4px; source: @image-url("../assets/icons/more.svg");
        tint: more-ta.has-hover ? Theme.fg-1 : Theme.fg-a2;
    }
    more-ta := TouchArea {
        x: root.width - 28px; width: 28px;
        mouse-cursor: pointer;
        clicked => { root.menu(self.absolute-position.x, self.absolute-position.y + 28px); }
    }
}

component Rows inherits VerticalLayout {
    in property <[LibItem]> items;
    in property <int> max: 0; // 0 = all
    in property <bool> dim;
    callback open(LibItem);
    callback menu(LibItem, length, length);
    spacing: 10px;
    for it[i] in root.items: LibRow {
        dim: root.dim;
        visible: root.max == 0 || i < root.max;
        height: self.visible ? 32px : 0px;
        it: it;
        open => { root.open(it); }
        menu(x, y) => { root.menu(it, x, y); }
    }
}

// Home section: "Title ›" (Inter 16) then three rows; the title opens the full list.
component Shelf inherits VerticalLayout {
    in property <string> title;
    in property <[LibItem]> items;
    in property <int> max: 3;
    in property <string> action-text; // e.g. "Clear"
    callback title-clicked();
    callback action();
    callback open(LibItem);
    callback menu(LibItem, length, length);
    spacing: 20px;
    HorizontalLayout {
        height: 24px; spacing: 4px;
        Text { text: root.title; color: tta.has-hover ? Theme.fg-1 : Theme.fg-a1; font-size: Metrics.font-lg; vertical-alignment: center; horizontal-stretch: 1;
            tta := TouchArea { mouse-cursor: pointer; clicked => { root.title-clicked(); } } }
        if root.action-text != "": Text {
            text: root.action-text; font-size: Metrics.font-base; vertical-alignment: center;
            color: ata.has-hover ? Theme.fg-1 : Theme.fg-a3;
            ata := TouchArea { mouse-cursor: pointer; clicked => { root.action(); } }
        }
        Icon { source: @image-url("../assets/icons/chevron-right.svg"); tint: cta.has-hover ? Theme.fg-1 : Theme.fg-a1;
            cta := TouchArea { mouse-cursor: pointer; clicked => { root.title-clicked(); } } }
    }
    Rows { items: root.items; max: root.max; dim: true; open(it) => { root.open(it); } menu(it, x, y) => { root.menu(it, x, y); } }
}

component RailButton inherits Rectangle {
    in property <image> icon;
    in property <image> active-icon;
    in property <image> active-accent;
    in property <image> active-dim;
    in property <bool> active;
    callback clicked();
    width: 32px; height: 32px; border-radius: Metrics.radius-sm;
    background: ta.has-hover && !root.active ? Theme.bg-a1 : transparent;
    if root.active: TriIcon { base: root.active-icon; accent: root.active-accent; dim: root.active-dim; }
    if !root.active: Icon { source: root.icon; tint: ta.has-hover ? Theme.fg-1 : Theme.fg-a2; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component HeadIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 24px; height: 24px;
    Icon { source: root.icon; tint: ta.has-hover && root.enabled ? Theme.fg-1 : Theme.fg-a2; opacity: root.enabled ? 1 : 0.3; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component LibraryView inherits Rectangle {
    in property <[LibItem]> items;
    in property <[LibItem]> continue-items;
    in property <[LibItem]> recent-items;
    in property <[LibItem]> pinned-items;
    in property <[LibItem]> listen-items;
    in property <[LibItem]> folder-items;
    in property <[LibItem]> list-items;
    in property <[LibItem]> artist-items;
    in property <string> nav: "home";
    in property <[string]> crumb-keys;
    in property <[string]> crumb-labels;
    in property <string> sort: "name";
    in property <bool> grid: true;
    in property <int> count;
    in property <bool> scanning;
    in property <bool> has-media;
    in property <bool> can-back;
    in property <bool> can-forward;
    // Docked 427 px sidebar next to the video (Figma "Library Sidebar") vs. the full home screen.
    in property <bool> sidebar;
    callback navigate(string);
    callback history(bool); // false = back, true = forward
    callback search(string);
    callback open(string, string);
    // kind ("lib" | "sort" | "view"), window x, y, context (see src/menus.rs)
    callback menu-request(string, length, length, string);
    callback open-file();
    callback open-network();
    callback clear-recent();
    callback popout();
    in-out property <string> query;
    property <bool> searching: query != "";
    property <string> section: nav == "home" ? "home" : (crumb-keys.length > 0 ? crumb-keys[0] : nav);
    property <bool> show-grid: root.grid && !root.sidebar && root.width >= 520px && root.nav != "home" && root.items.length > 0 && root.items[0].kind != "action";
    property <int> rows-max: root.sidebar ? 3 : 6;

    function ctx-of(it: LibItem) -> string {
        return it.key + "\n" + it.kind + "\n" + (it.pinned ? "1" : "0") + "\n" + (it.watched ? "1" : "0") + "\n" + (it.progress > 0 && !it.watched ? "1" : "0");
    }
    function item-menu(it: LibItem, x: length, y: length) {
        root.menu-request("lib", x, y, root.ctx-of(it));
    }
    function go(it: LibItem) { root.open(it.key, it.kind); }

    background: root.sidebar ? Theme.bg-b1.with-alpha(0.95) : Theme.bg-b1;
    TouchArea { }

    HorizontalLayout {
        // Icon rail
        Rectangle {
            width: 50px; background: Theme.bg-a4;
            VerticalLayout {
                padding-top: 8px; padding-left: 9px; padding-right: 9px; spacing: 14px; alignment: start;
                RailButton { icon: @image-url("../assets/icons/home.svg"); active-icon: @image-url("../assets/icons/layers/home-active-b.svg"); active-accent: @image-url("../assets/icons/layers/home-active-a.svg"); active-dim: @image-url("../assets/icons/layers/home-active-d.svg"); active: root.section == "home"; clicked => { root.navigate("home"); } }
                RailButton { icon: @image-url("../assets/icons/videos.svg"); active-icon: @image-url("../assets/icons/layers/videos-active-b.svg"); active-accent: @image-url("../assets/icons/layers/videos-active-a.svg"); active-dim: @image-url("../assets/icons/layers/videos-active-d.svg"); active: root.section == "video"; clicked => { root.navigate("video"); } }
                RailButton { icon: @image-url("../assets/icons/songs.svg"); active-icon: @image-url("../assets/icons/layers/songs-active-b.svg"); active-accent: @image-url("../assets/icons/layers/songs-active-a.svg"); active-dim: @image-url("../assets/icons/layers/songs-active-d.svg"); active: root.section == "music"; clicked => { root.navigate("music"); } }
                RailButton { icon: @image-url("../assets/icons/streaming.svg"); active-icon: @image-url("../assets/icons/layers/streaming-active-b.svg"); active-accent: @image-url("../assets/icons/layers/streaming-active-a.svg"); active-dim: @image-url("../assets/icons/layers/streaming-active-d.svg"); active: root.section == "network"; clicked => { root.navigate("network"); } }
                RailButton { icon: @image-url("../assets/icons/playlist.svg"); active-icon: @image-url("../assets/icons/layers/playlist-active-b.svg"); active-accent: @image-url("../assets/icons/layers/playlist-active-a.svg"); active-dim: @image-url("../assets/icons/layers/playlist-active-d.svg"); active: root.section == "playlists"; clicked => { root.navigate("playlists"); } }
                RailButton { icon: @image-url("../assets/icons/recent.svg"); active-icon: @image-url("../assets/icons/recent.svg"); active: root.section == "recent"; clicked => { root.navigate("recent"); } }
                RailButton { icon: @image-url("../assets/icons/add.svg"); active-icon: @image-url("../assets/icons/add.svg"); clicked => { root.open-file(); } }
            }
        }
        // Content
        VerticalLayout {
            padding: 20px; padding-bottom: 0; spacing: 17px;
            HorizontalLayout {
                height: 24px; spacing: 12px;
                HeadIcon { icon: @image-url("../assets/icons/arrow-left.svg"); enabled: root.can-back; clicked => { root.history(false); } }
                HeadIcon { icon: @image-url("../assets/icons/arrow-right.svg"); enabled: root.can-forward; clicked => { root.history(true); } }
                // Breadcrumb ("..." for long paths comes from src/libview.rs).
                HorizontalLayout {
                    horizontal-stretch: 1; spacing: 6px;
                    for k[i] in root.crumb-keys: HorizontalLayout {
                        spacing: 6px;
                        if i > 0: Text { text: "▸"; color: Theme.fg-a2; font-size: Metrics.font-micro; vertical-alignment: center; }
                        Text {
                            text: root.crumb-labels[i]; font-size: Metrics.font-lg; overflow: elide; vertical-alignment: center;
                            min-width: min(self.preferred-width, 140px);
                            color: cta.has-hover ? Theme.fg-1 : Theme.fg-a2;
                            cta := TouchArea { mouse-cursor: pointer; clicked => { root.navigate(k); } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                more := HeadIcon {
                    icon: @image-url("../assets/icons/more.svg");
                    clicked => {
                        if (root.nav.character-count > 6 && root.crumb-keys.length > 1 && root.section == "video") {
                            root.menu-request("lib", self.absolute-position.x, self.absolute-position.y + 28px,
                                root.nav + "\nfolder\n0\n0\n0");
                        } else {
                            root.menu-request("view", self.absolute-position.x, self.absolute-position.y + 28px, "");
                        }
                    }
                }
                HeadIcon { icon: @image-url("../assets/icons/open.svg"); clicked => { root.popout(); } }
            }
            HorizontalLayout {
                height: 24px; spacing: 12px;
                Text {
                    horizontal-stretch: 1; vertical-alignment: center; font-size: Metrics.font-base; color: Theme.fg-a3;
                    text: root.scanning ? "Scanning…" : (root.nav == "home" ? root.count : root.items.length) + " items";
                }
                HeadIcon {
                    icon: root.sort != "name" && root.sort != "title" ? @image-url("../assets/icons/sort-active.svg") : @image-url("../assets/icons/sort.svg");
                    clicked => { root.menu-request("sort", self.absolute-position.x, self.absolute-position.y + 28px, ""); }
                }
                HeadIcon {
                    icon: @image-url("../assets/icons/list.svg");
                    clicked => { root.menu-request("view", self.absolute-position.x, self.absolute-position.y + 28px, ""); }
                }
                HeadIcon {
                    icon: @image-url("../assets/icons/search.svg");
                    clicked => { root.searching = !root.searching; if (!root.searching) { root.query = ""; root.search(""); } }
                }
            }
            if root.searching: TextField {
                placeholder: "Search library"; text <=> root.query;
                edited(t) => { root.search(t); }
                init => { self.focus-input(); }
            }
            Rectangle { height: 1px; background: Theme.bg-a1; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start; padding-top: 3px; padding-bottom: 20px; padding-right: 8px; spacing: 30px;
                    if root.nav == "home" && root.query == "": VerticalLayout {
                        spacing: 33px;
                        if root.count == 0 && root.recent-items.length == 0: VerticalLayout {
                            spacing: 10px; padding-top: 40px;
                            HorizontalLayout { alignment: center; Image { source: @image-url("../assets/icons/vlc.svg"); width: 72px; height: 72px; } }
                            Text { text: "Your library is empty"; color: Theme.fg-1; font-size: Metrics.font-xl; horizontal-alignment: center; }
                            Text { text: "Open a file, or add folders in Settings → Library (Ctrl+,). Drop files anywhere to play."; color: Theme.fg-a1; horizontal-alignment: center; wrap: word-wrap; }
                        }
                        if root.continue-items.length > 0: Shelf { title: "Continue Watching"; items: root.continue-items; max: root.rows-max;
                            title-clicked => { root.navigate("recent"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.listen-items.length > 0: Shelf { title: "Listen Again"; items: root.listen-items; max: root.rows-max;
                            title-clicked => { root.navigate("recent"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.folder-items.length > 0: Shelf { title: "Frequently Visited Folders"; items: root.folder-items; max: root.rows-max;
                            title-clicked => { root.navigate("video"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.list-items.length > 0: Shelf { title: "Frequently Visited Playlists"; items: root.list-items; max: root.rows-max;
                            title-clicked => { root.navigate("playlists"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.artist-items.length > 0: Shelf { title: "Frequently Listened Artists"; items: root.artist-items; max: root.rows-max;
                            title-clicked => { root.navigate("music:artists"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.pinned-items.length > 0: Shelf { title: "Favorites"; items: root.pinned-items; max: root.rows-max;
                            open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.items.length > 0: Shelf { title: "Recently Added"; items: root.items; max: root.rows-max;
                            title-clicked => { root.navigate("video"); } open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                        if root.recent-items.length > 0: Shelf { title: "Recently Played"; items: root.recent-items; max: root.rows-max; action-text: "Clear";
                            title-clicked => { root.navigate("recent"); } action => { root.clear-recent(); }
                            open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); } }
                    }
                    if (root.nav != "home" || root.query != "") && !root.show-grid: Rows {
                        items: root.items;
                        open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); }
                    }
                    if (root.nav != "home" || root.query != "") && root.show-grid: Grid {
                        items: root.items; grid: true;
                        open(it) => { root.go(it); } menu(it, x, y) => { root.item-menu(it, x, y); }
                    }
                    if (root.nav != "home" || root.query != "") && root.items.length == 0: Text {
                        text: root.scanning ? "Scanning…" : (root.query != "" ? "Nothing matches “" + root.query + "”." : "Nothing here yet.");
                        color: Theme.fg-a3;
                    }
                }
            }
        }
    }
}
