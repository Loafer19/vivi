// Now-playing card for radio / network streams (Network Streams plugin): station, current track, info line and logo.
export global NowPlaying {
    in-out property <bool> show;
    in-out property <string> station;
    in-out property <string> track;
    in-out property <string> info;
    in-out property <image> logo;
    in-out property <bool> has-logo;
    // A song (package metadata such as an Auto-tagger match): a music icon instead of
    // the radio one when there is no cover.
    in-out property <bool> music;
}
