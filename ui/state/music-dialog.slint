// Shared dialog of the music plugins (Auto-tagger, Free Music, Network Streams): owner plugin id, what the owner supports (caps), and the dialog's content.
import { Item } from "../panel.slint";
import { FmRow, MdFilter } from "../plugins.slint";
// What the owning plugin's dialog uses; the plugin sets it together with `owner`.
export struct MdCaps {
    logos: bool,   // per-row logos (Network Streams)
    chips: bool,   // chip row and row actions
    rich: bool,    // Free Music track rows, filters, "more" paging and edit-triggered search
    grid: bool,    // list / grid toggle in the header (Network Streams)
    info: bool,    // info-only plugin dialog: no search row or per-row play / queue (`info_only`)
}
export global MusicDialogState {
    in-out property <MdCaps> caps;
    in-out property <string> owner;
    // Results shown as logo tiles instead of rows (when caps.grid; the owner remembers it).
    in-out property <bool> grid;
    in-out property <string> title;
    in-out property <[Item]> results;
    in-out property <[image]> logos;
    in-out property <string> status;
    in-out property <bool> busy;
    in-out property <string> detail;
    // Large cover in the detail pane (packages: `detail_cover`), shown while its owner has the dialog.
    in-out property <image> detail-cover;
    in-out property <bool> has-detail-cover;
    in-out property <string> detail-cover-owner;
    in-out property <string> placeholder;
    in-out property <string> search-label;
    in-out property <string> primary;
    in-out property <string> secondary;
    in-out property <[string]> sources;
    in-out property <string> source;
    in-out property <string> query;
    in-out property <[string]> chips;
    in-out property <string> chip;
    in-out property <[string]> actions;
    in-out property <[FmRow]> tracks;
    in-out property <[MdFilter]> filters;
    in-out property <string> copy;
    in-out property <bool> has-more;
    // Highlighted row of the dialog (-1 = none); reset each time the dialog opens.
    in-out property <int> selected: -1;
    // Visible part of the rich list / grid (first index, count): covers are decoded only
    // around it (src/plugins/host.rs).
    in-out property <int> win-first;
    in-out property <int> win-count: 60;
    callback window-changed();
}
