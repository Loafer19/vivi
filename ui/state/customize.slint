// Customize: the control bar layout (items, slots, style) and profiles being edited in the Customize overlay, with its actions.
import { BarStyle, VolumeStyle } from "../core/types.slint";
// Label / icon key of a plugin's bar button (`controlbar.button`); empty label = built-in item.
export struct ToolMeta { label: string, icon: string }
export global Customize {
    in-out property <[string]> bar-items: ["prev", "play", "next", "time", "seek", "duration", "volume", "audio", "subtitles", "settings", "queue", "fullscreen"];
    in-out property <[int]> bar-cum;
    // Parallel to bar-items / available: plugin buttons' label and icon.
    in-out property <[ToolMeta]> bar-meta;
    in-out property <[ToolMeta]> available-meta;
    in-out property <int> bar-slots;
    in-out property <BarStyle> bar-style: BarStyle.compact;
    in-out property <[string]> bar-styles;
    in-out property <VolumeStyle> vol-style: VolumeStyle.cone;
    in-out property <[string]> vol-styles;
    callback pick-volume(string);
    in-out property <[string]> available;
    in-out property <[string]> profiles;
    in-out property <string> profile;
    callback style(string);
    callback move(int, int);
    callback remove(int);
    callback add(string);
    callback select-profile(string);
    callback done(bool);
}
