// Settings: the settings page (categories, rows, search, status), the shortcuts overlay, accent choices and onboarding, with their actions.
import { SettingRow } from "../settings.slint";
export global Settings {
    in-out property <[string]> categories;
    in-out property <[SettingRow]> rows;
    in-out property <int> category: 0;
    in-out property <string> status;
    in-out property <string> search;
    in-out property <bool> advanced;
    in-out property <[string]> shortcut-actions;
    in-out property <[string]> shortcut-keys;
    in-out property <[string]> accent-names;
    in-out property <[color]> accent-colors;
    in-out property <string> accent-name;
    in-out property <int> onboarding-step;
    in-out property <[string]> onboarding-keys;
    in-out property <[string]> onboarding-actions;
    callback setting-changed(string, string);
    callback refresh(int, string, bool);
    callback onboarding-done();
}
