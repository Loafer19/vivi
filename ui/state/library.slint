// Library: home sections, the browsed folder / view (path, crumbs, sort, grid), search and scan state, and its actions.
import { LibItem } from "../library.slint";
import { Item } from "../core/types.slint";
export global Library {
    in-out property <[LibItem]> items;
    in-out property <[LibItem]> continue;
    in-out property <[LibItem]> recent;
    in-out property <[LibItem]> pinned;
    in-out property <[LibItem]> listen;
    in-out property <[LibItem]> folders;
    in-out property <[LibItem]> lists;
    in-out property <[LibItem]> artists;
    in-out property <bool> can-back;
    in-out property <bool> can-forward;
    in-out property <bool> full;
    in-out property <string> nav: "home";
    in-out property <[string]> crumb-keys;
    in-out property <[string]> crumb-labels;
    in-out property <string> sort: "name";
    in-out property <bool> grid: true;
    in-out property <int> count;
    in-out property <bool> scanning;
    in-out property <string> query;
    in-out property <bool> ytdlp;
    in-out property <[Item]> recent-files;
    callback history(bool);
    callback add-folder();
    callback create-playlist();
    callback refresh();
    callback rescan();
    callback navigate(string);
    callback search(string);
    callback set-sort(string);
    callback set-grid(bool);
    callback open(string, string);
    callback menu(string, string, string);
    callback open-recent(string);
    callback clear-recent();
    callback open-folder();
}
