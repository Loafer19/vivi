// Menus per the Figma "right-click menu", "file/folder/playlist context menu",
// "Sorting Options" and "View Options" frames (docs/design/frames/menus-and-icons.png):
// panel #191919 @95%, radius 10, padding 4, drop shadow (blur 15, y 8); 48 px rows with
// radius 6 and #1B1B1B hover, 24 px two-tone icons, gap 10, padding 14, Inter 14 #8F8F8F,
// shortcut hints #6B6B6B right-aligned, #222222 dividers, chevron for submenus, accent
// check mark for the selected option.
import { Theme, Metrics, Icon, TriIcon } from "core/theme.slint";
import { Icons } from "core/icons.slint";

export struct MenuItem {
    id: string,
    label: string,
    icon: string, // MenuIcons name, "" for none
    hint: string,
    sub: bool,
    checked: bool,
    divider: bool, // draw a divider above this row
}


// Icon lookup for menu rows (two-tone icons from the Figma menus in assets/icons/menu).
// Menu icons as colour layers: of() = text-coloured part, accent()/dim() = accent parts.
// Layers are generated by tools/icon_layers.py.


component MenuRow inherits Rectangle {
    in property <MenuItem> item;
    in property <bool> open; // its submenu is showing
    callback activated();
    callback hovered();
    height: 48px;
    border-radius: Metrics.radius-md;
    background: ta.has-hover || root.open || root.item.checked ? Theme.bg-a3 : transparent;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 10px;
        if root.item.icon != "": TriIcon { base: Icons.menu(root.item.icon); accent: Icons.menu-accent(root.item.icon); dim: Icons.menu-dim(root.item.icon); y: 12px; }
        Text {
            text: root.item.label; color: Theme.fg-a2; font-size: Metrics.font-base;
            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        }
        if root.item.hint != "": Text {
            text: root.item.hint; color: Theme.fg-a3; font-size: Metrics.font-base;
            vertical-alignment: center; horizontal-alignment: right;
        }
        if root.item.sub: Icon { source: @image-url("../assets/icons/chevron-right.svg"); width: 24px; height: 24px; y: 12px; tint: Theme.fg-a2; }
        if root.item.checked: Icon { source: @image-url("../assets/icons/check-active.svg"); width: 24px; height: 24px; y: 12px; tint: Theme.accent; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        changed has-hover => { if (self.has-hover) { root.hovered(); } }
    }
}

export component MenuPanel inherits Rectangle {
    in property <[MenuItem]> items;
    in property <string> open-sub; // id of the row whose submenu is open
    callback activated(string);
    // row id and its y offset inside the panel (for placing a submenu)
    callback row-hovered(string, length);
    width: 265px;
    height: col.preferred-height;
    background: Theme.bar-solid.with-alpha(0.95);
    border-radius: Metrics.radius-xl;
    drop-shadow-blur: 15px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow-soft;
    TouchArea { } // swallow clicks between rows
    col := VerticalLayout {
        padding: 4px;
        for it in root.items: VerticalLayout {
            if it.divider: Rectangle { height: 1px; background: Theme.bg-a1; }
            row := MenuRow {
                item: it;
                open: it.sub && it.id == root.open-sub;
                activated => { root.activated(it.id); }
                hovered => { root.row-hovered(it.id, self.absolute-position.y - root.absolute-position.y); }
            }
        }
    }
}

// Dropdown per the Figma "Option" rows: 48 px rows, #1F1F1F hover/selected fill, radius 6,
// label after a 24 px icon slot (x = 48), accent check on the selected option.
component OptionRow inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 48px; border-radius: Metrics.radius-md;
    background: ta.has-hover || root.selected ? Theme.popup : transparent;
    Text { x: 48px; width: parent.width - 48px - 48px; text: root.text; color: Theme.fg-a2; font-size: Metrics.font-base; vertical-alignment: center; overflow: elide; }
    if root.selected: Icon { x: parent.width - 14px - 24px; source: @image-url("../assets/icons/check-active.svg"); tint: Theme.accent; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <string> value;
    callback selected(int, string);
    height: 36px; min-width: 140px;
    border-radius: Metrics.radius-md;
    background: ta.has-hover ? Theme.popup-hover : Theme.popup;
    HorizontalLayout {
        padding-left: 14px; padding-right: 8px; spacing: 6px;
        Text { text: root.value; color: Theme.fg-a2; font-size: Metrics.font-base; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Icon { y: (parent.height - 20px) / 2; width: 20px; height: 20px; source: @image-url("../assets/icons/chevron-down.svg"); tint: Theme.fg-a2; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { pop.show(); } }
    pop := PopupWindow {
        x: 0; y: root.height + 4px;
        width: max(root.width, 220px);
        height: min(root.options.length * 48px + 8px, 440px);
        Rectangle {
            background: Theme.bar-solid.with-alpha(0.95); border-radius: Metrics.radius-xl;
            drop-shadow-blur: 15px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow-soft;
            clip: true;
            Flickable {
                content-height: root.options.length * 48px + 8px;
                VerticalLayout {
                    padding: 4px; alignment: start;
                    for o[i] in root.options: OptionRow {
                        text: o; selected: o == root.value;
                        clicked => { root.selected(i, o); pop.close(); }
                    }
                }
            }
        }
    }
}
