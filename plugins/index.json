{
  "schema": 1,
  "plugins": [
    {
      "id": "visualizer",
      "name": "Music Visualizer",
      "description": "Spectrum, scope, waveform, radial, particles and pitch visuals for audio-only files. Pick a mode with the dropdown or V.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "visualizer",
      "lucide": "audio-waveform",
      "kind": "builtin",
      "default_enabled": true,
      "settings": []
    },
    {
      "id": "skip-intro",
      "name": "Skip Intro & Credits",
      "description": "Shows a Skip button during intros and credits found in chapter names (Intro, Opening, OP, Credits, Ending, ED) or set per show. Can skip automatically.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "skip",
      "lucide": "skip-forward",
      "kind": "builtin",
      "default_enabled": true,
      "settings": [
        {
          "key": "auto",
          "title": "Skip automatically",
          "type": "toggle",
          "default": "false"
        },
        {
          "key": "chapters",
          "title": "Detect from chapter names",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "ranges",
          "title": "Per-show ranges",
          "type": "text",
          "default": ""
        },
        {
          "key": "mark",
          "title": "Mark range for this show",
          "type": "action"
        },
        {
          "key": "clear",
          "title": "Clear ranges for this show",
          "type": "action"
        }
      ]
    },
    {
      "id": "lyrics",
      "name": "Lyrics",
      "description": "Synced lyrics as a karaoke overlay, from a .lrc file next to the song or from LRCLIB, cached on disk. Radio streams: lyrics for the current stream title.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "lyrics",
      "lucide": "mic-vocal",
      "kind": "builtin",
      "default_enabled": true,
      "settings": [
        {
          "key": "online",
          "title": "Search lyrics online (LRCLIB)",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "radio-mode",
          "title": "Radio lyrics",
          "type": "choice",
          "options": [
            "Plain lyrics",
            "Approximate sync",
            "Off"
          ],
          "default": "Plain lyrics"
        },
        {
          "key": "radio-offset",
          "title": "Radio sync offset (seconds)",
          "type": "text",
          "default": "0"
        },
        {
          "key": "size",
          "title": "Text size",
          "type": "choice",
          "options": [
            "Medium",
            "Small",
            "Large"
          ],
          "default": "Medium"
        },
        {
          "key": "clear-cache",
          "title": "Downloaded lyrics",
          "type": "action"
        }
      ]
    },
    {
      "id": "subtitle-search",
      "name": "Subtitle Search",
      "description": "Find and download subtitles from OpenSubtitles (by file hash and name) in the Add Subtitles dialog. Needs a free API key.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "subtitles",
      "lucide": "captions",
      "kind": "builtin",
      "default_enabled": true,
      "settings": [
        {
          "key": "api-key",
          "title": "OpenSubtitles API key",
          "type": "secret",
          "default": ""
        },
        {
          "key": "languages",
          "title": "Languages",
          "type": "text",
          "default": "en"
        },
        {
          "key": "username",
          "title": "Username (optional)",
          "type": "text",
          "default": ""
        },
        {
          "key": "password",
          "title": "Password (optional)",
          "type": "secret",
          "default": ""
        }
      ]
    },
    {
      "id": "auto-tagger",
      "name": "Auto-tagger",
      "description": "Identifies songs by their audio (AcoustID fingerprint) or tags, looks them up on MusicBrainz and writes title, artist, album, date, track, genre and Cover Art Archive covers after a preview. Originals are backed up. AcoustID key optional.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "tag",
      "lucide": "tags",
      "kind": "builtin",
      "default_enabled": true,
      "issue": 69,
      "settings": [
        {
          "key": "acoustid-key",
          "title": "AcoustID API key",
          "type": "secret",
          "default": ""
        },
        {
          "key": "cover",
          "title": "Embed cover art",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "folder",
          "title": "Library folder",
          "type": "text",
          "default": ""
        },
        {
          "key": "open",
          "title": "Tag the playing file",
          "type": "action",
          "default": ""
        },
        {
          "key": "batch",
          "title": "Tag library folder",
          "type": "action",
          "default": ""
        },
        {
          "key": "restore",
          "title": "Restore original tags",
          "type": "action",
          "default": ""
        }
      ]
    },
    {
      "id": "free-music",
      "name": "Free Music",
      "description": "Search Creative Commons and public-domain music on the Internet Archive and Jamendo, preview it, and download it to your library with tags, cover and licence attribution. Jamendo needs a free client ID.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "free-music",
      "lucide": "library-big",
      "kind": "builtin",
      "default_enabled": true,
      "issue": 70,
      "settings": [
        {
          "key": "jamendo-client-id",
          "title": "Jamendo client ID",
          "type": "secret",
          "default": ""
        },
        {
          "key": "folder",
          "title": "Download folder",
          "type": "text",
          "default": ""
        },
        {
          "key": "open",
          "title": "Find free music",
          "type": "action",
          "default": ""
        }
      ]
    },
    {
      "id": "network-streams",
      "name": "Network Streams",
      "description": "Browse Internet radio (radio-browser.info), import M3U/IPTV playlists, keep saved and recent streams, and see stream info (now-playing title, codec, bitrate, buffer). No key needed.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "streams",
      "lucide": "radio",
      "kind": "builtin",
      "default_enabled": true,
      "issue": 67,
      "settings": [
        {
          "key": "open",
          "title": "Browse streams",
          "type": "action",
          "default": ""
        },
        {
          "key": "info",
          "title": "Stream info",
          "type": "action",
          "default": ""
        }
      ]
