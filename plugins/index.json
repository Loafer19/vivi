{
  "schema": 1,
  "plugins": [
    {
      "id": "visualizer",
      "name": "Music Visualizer",
      "description": "Spectrum, scope, waveform, radial, particles and pitch visuals for audio-only files. Pick a mode with the dropdown or V.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "visualizer",
      "lucide": "audio-waveform",
      "kind": "builtin",
      "default_enabled": true,
      "settings": []
    },
    {
      "id": "skip-intro",
      "name": "Skip Intro & Credits",
      "description": "Shows a Skip button during intros and credits found in chapter names (Intro, Opening, OP, Credits, Ending, ED) or set per show. Can skip automatically.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "skip",
      "lucide": "skip-forward",
      "kind": "builtin",
      "default_enabled": true,
      "settings": [
        {
          "key": "auto",
          "title": "Skip automatically",
          "type": "toggle",
          "default": "false"
        },
        {
          "key": "chapters",
          "title": "Detect from chapter names",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "ranges",
          "title": "Per-show ranges",
          "type": "text",
          "default": ""
        },
        {
          "key": "mark",
          "title": "Mark range for this show",
          "type": "action"
        },
        {
          "key": "clear",
          "title": "Clear ranges for this show",
          "type": "action"
        }
      ]
    },
    {
      "id": "lyrics",
      "name": "Lyrics",
      "description": "Synced lyrics as a karaoke overlay, from a .lrc file next to the song or from LRCLIB, cached on disk.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "lyrics",
      "lucide": "mic-vocal",
      "kind": "builtin",
      "default_enabled": true,
      "settings": [
        {
          "key": "online",
          "title": "Search lyrics online (LRCLIB)",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "size",
          "title": "Text size",
          "type": "choice",
          "options": [
            "Medium",
            "Small",
            "Large"
          ],
          "default": "Medium"
        },
        {
          "key": "clear-cache",
          "title": "Downloaded lyrics",
          "type": "action"
        }
      ]
    },
    {
      "id": "subtitle-search",
      "name": "Subtitle Search",
      "description": "Find and download subtitles from OpenSubtitles (by file hash and name) in the Add Subtitles dialog. Needs a free API key.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "subtitles",
      "lucide": "captions",
      "kind": "builtin",
      "default_enabled": true,
      "settings": [
        {
          "key": "api-key",
          "title": "OpenSubtitles API key",
          "type": "secret",
          "default": ""
        },
        {
          "key": "languages",
          "title": "Languages",
          "type": "text",
          "default": "en"
        },
        {
          "key": "username",
          "title": "Username (optional)",
          "type": "text",
          "default": ""
        },
        {
          "key": "password",
          "title": "Password (optional)",
          "type": "secret",
          "default": ""
        }
      ]
    },
    {
      "id": "auto-tagger",
      "name": "Auto-tagger",
      "description": "Identifies songs by their audio (AcoustID fingerprint) or tags, looks them up on MusicBrainz and writes title, artist, album, date, track, genre and Cover Art Archive covers after a preview. Originals are backed up. AcoustID key optional.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "tag",
      "lucide": "tags",
      "kind": "builtin",
      "default_enabled": true,
      "issue": 69,
      "settings": [
        {
          "key": "acoustid-key",
          "title": "AcoustID API key",
          "type": "secret",
          "default": ""
        },
        {
          "key": "cover",
          "title": "Embed cover art",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "folder",
          "title": "Library folder",
          "type": "text",
          "default": ""
        },
        {
          "key": "open",
          "title": "Tag the playing file",
          "type": "action",
          "default": ""
        },
        {
          "key": "batch",
          "title": "Tag library folder",
          "type": "action",
          "default": ""
        },
        {
          "key": "restore",
          "title": "Restore original tags",
          "type": "action",
          "default": ""
        }
      ]
    },
    {
      "id": "free-music",
      "name": "Free Music",
      "description": "Search Creative Commons and public-domain music on the Internet Archive and Jamendo, preview it, and download it to your library with tags, cover and licence attribution. Jamendo needs a free client ID.",
      "version": "0.8.0",
      "author": "Vivi",
      "icon": "free-music",
      "lucide": "library-big",
      "kind": "builtin",
      "default_enabled": true,
      "issue": 70,
      "settings": [
        {
          "key": "jamendo-client-id",
          "title": "Jamendo client ID",
          "type": "secret",
          "default": ""
        },
        {
          "key": "folder",
          "title": "Download folder",
          "type": "text",
          "default": ""
        },
        {
          "key": "open",
          "title": "Find free music",
          "type": "action",
          "default": ""
        }
      ]
    },
    {
      "id": "script-now-playing",
      "name": "Now Playing OSD",
      "description": "Example mpv Lua script: shows the title on the OSD when a file starts.",
      "version": "1.0",
      "author": "Vivi",
      "icon": "script",
      "lucide": "code-xml",
      "kind": "script",
      "default_enabled": true,
      "source": "plugins/examples/now-playing.lua",
      "settings": []
    },
    {
      "id": "ab-loop",
      "name": "A-B Loop & Frame Step",
      "description": "Set and clear A-B loop points from the keyboard, nudge them by a frame, step frame by frame while paused and see the loop on an on-screen bar.",
      "version": "1.0.1",
      "author": "Vivi",
      "icon": "loop",
      "lucide": "repeat",
      "kind": "package",
      "runtime": "mpv-lua",
      "default_enabled": true,
      "min_vivi": "0.8.0",
      "permissions": [],
      "source": "plugins/ab-loop",
      "url": "https://github.com/Loafer19/vivi/releases/download/plugin-ab-loop-v1.0.1/ab-loop-1.0.1.zip",
      "sha256": "6b5265a42a3c80f92bd5a923eb00aa12d20e6fb8c1aabdc7aa3324398e9a41a9",
      "size": 5816,
      "settings": [
        {
          "key": "markers",
          "title": "Show loop bar",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "osd-seconds",
          "title": "Show bar for (seconds)",
          "type": "choice",
          "options": [
            "3",
            "1",
            "5",
            "10"
          ],
          "default": "3"
        },
        {
          "key": "clear",
          "title": "Clear loop",
          "type": "action"
        }
      ],
      "issue": 59
    },
    {
      "id": "night-mode",
      "name": "Night Mode",
      "description": "Compresses loud scenes and lifts quiet dialogue so films stay understandable at low volume (mpv dynaudnorm / loudnorm). Toggle with Alt+N.",
      "version": "1.0.2",
      "author": "Vivi",
      "icon": "night",
      "lucide": "moon",
      "kind": "package",
      "runtime": "mpv-lua",
      "default_enabled": true,
      "min_vivi": "0.8.0",
      "permissions": [],
      "source": "plugins/night-mode",
      "url": "https://github.com/Loafer19/vivi/releases/download/plugin-night-mode-v1.0.2/night-mode-1.0.2.zip",
      "sha256": "5d891df2b9bb0891cc13b62563fe0f670383602fb2175a6a9ec8319837ced4a8",
      "size": 3197,
      "settings": [
        {
          "key": "active",
          "title": "Night mode on",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "strength",
          "title": "Strength",
          "type": "choice",
          "options": [
            "Medium",
            "Light",
            "Strong",
            "Loudness (EBU R128)"
          ],
          "default": "Medium"
        }
      ],
      "issue": 60
    },
    {
      "id": "playback-stats",
      "name": "Playback Statistics",
      "description": "Counts time watched and listened per day, with top artists and shows. Kept locally in a small TSV file; Alt+S shows a summary, export as CSV or clear any time.",
      "version": "1.0.1",
      "author": "Vivi",
      "icon": "stats",
      "lucide": "chart-column",
      "kind": "package",
      "runtime": "mpv-lua",
      "default_enabled": true,
      "min_vivi": "0.8.0",
      "permissions": [
        "filesystem"
      ],
      "source": "plugins/playback-stats",
      "url": "https://github.com/Loafer19/vivi/releases/download/plugin-playback-stats-v1.0.1/playback-stats-1.0.1.zip",
      "sha256": "54fd81f1e835d2bea235cea9a0df98ac8ee834ebe575a26b63ba4505a3d0ea52",
      "size": 7980,
      "settings": [
        {
          "key": "days",
          "title": "Summary covers",
          "type": "choice",
          "options": [
            "7",
            "30",
            "365"
          ],
          "default": "7"
        },
        {
          "key": "show",
          "title": "Show summary",
          "type": "action"
        },
        {
          "key": "export",
          "title": "Export CSV to ~/vivi-stats.csv",
          "type": "action"
        },
        {
          "key": "clear",
          "title": "Clear statistics",
          "type": "action"
        }
      ],
      "issue": 66
    },
    {
      "id": "scrobbler",
      "name": "ListenBrainz Scrobbler",
      "description": "Sends what you listen to to ListenBrainz: now playing when a track starts and a listen after half the track or 4 minutes. Listens made offline are queued and sent later. Needs your ListenBrainz user token.",
      "version": "1.0.0",
      "author": "Vivi",
      "icon": "scrobble",
      "lucide": "radio-tower",
      "kind": "package",
      "runtime": "mpv-lua",
      "default_enabled": true,
      "min_vivi": "0.8.0",
      "permissions": [
        "network",
        "filesystem",
        "subprocess"
      ],
      "source": "plugins/scrobbler",
      "url": "https://github.com/Loafer19/vivi/releases/download/plugin-scrobbler-v1.0.0/scrobbler-1.0.0.zip",
      "sha256": "8040e0b0a3051d23e39d4172e09f24a6576fc5e8bc044292e6d51dc333a9e66a",
      "size": 11728,
      "settings": [
        {
          "key": "token",
          "title": "ListenBrainz user token",
          "type": "secret",
          "default": ""
        },
        {
          "key": "now_playing",
          "title": "Send now playing",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "audio_only",
          "title": "Only music (skip videos)",
          "type": "toggle",
          "default": "true"
        },
        {
          "key": "api",
          "title": "API server",
          "type": "text",
          "default": "https://api.listenbrainz.org"
        },
        {
          "key": "flush",
          "title": "Send queued listens now",
          "type": "action"
        },
        {
          "key": "status",
          "title": "Show scrobbler status",
          "type": "action"
        }
      ],
      "issue": 63
    }
  ]
}
