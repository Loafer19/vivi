# Maintainer: Loafer19 <https://github.com/Loafer19>
# Prebuilt binary from the GitHub release. The release workflow also attaches this file
# with the version and checksum filled in (asset "PKGBUILD").
pkgname=vivi-bin
pkgver=0.16.3
pkgrel=1
pkgdesc="Fast, minimal media player built on mpv (Slint UI)"
arch=('x86_64')
url="https://github.com/Loafer19/vivi"
license=('MIT')
# libxkbcommon and the Wayland/X11 libraries are loaded at runtime and come with mpv.
depends=('mpv' 'fontconfig' 'libgcc' 'glibc' 'hicolor-icon-theme')
optdepends=('ffmpeg: library thumbnails, album covers, YouTube plugin merging'
            'yt-dlp: YouTube and other sites in Open Network Stream'
            'xdg-desktop-portal: native file and folder dialogs')
conflicts=('vivi')
source=("vivi-v${pkgver}-linux-x86_64.tar.gz::${url}/releases/download/v${pkgver}/vivi-v${pkgver}-linux-x86_64.tar.gz")
sha256sums=('SKIP')
# The release workflow fills in only sha256sums= (the tarball), so the AppStream metainfo,
# which is not in the tarball, goes in the x86_64 array with its own (unpinned) checksum.
source_x86_64=("io.github.loafer19.vivi.metainfo.xml::${url}/raw/v${pkgver}/packaging/flatpak/io.github.loafer19.vivi.metainfo.xml")
sha256sums_x86_64=('SKIP')

package() {
  cd "vivi-v${pkgver}-linux-x86_64"
  install -Dm755 vivi "${pkgdir}/usr/bin/vivi"
  install -Dm755 vivi-mcp "${pkgdir}/usr/bin/vivi-mcp"
  install -Dm644 vivi.desktop "${pkgdir}/usr/share/applications/vivi.desktop"
  install -Dm644 vivi.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/vivi.svg"
  install -Dm644 vivi.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/vivi.png"
  sed 's|<launchable type="desktop-id">.*</launchable>|<launchable type="desktop-id">vivi.desktop</launchable>|' \
    "${srcdir}/io.github.loafer19.vivi.metainfo.xml" > metainfo.xml
  install -Dm644 metainfo.xml "${pkgdir}/usr/share/metainfo/io.github.loafer19.vivi.metainfo.xml"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
