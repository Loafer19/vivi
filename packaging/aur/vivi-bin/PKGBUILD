# Maintainer: Loafer19 <https://github.com/Loafer19>
# Prebuilt binaries from the GitHub release tarball. pkgver and sha256sums are bumped by
# the release workflow (.github/workflows/release.yml, job "packaging"); see packaging/aur/README.md.
pkgname=vivi-bin
pkgver=0.16.5
pkgrel=1
pkgdesc="Fast, minimal media player built on mpv (Slint UI)"
arch=('x86_64' 'aarch64')
url="https://github.com/Loafer19/vivi"
license=('MIT')
# libxkbcommon and the Wayland/X11 libraries are loaded at runtime and come with mpv.
depends=('mpv' 'fontconfig' 'libgcc' 'glibc' 'hicolor-icon-theme')
optdepends=('ffmpeg: library thumbnails, album covers, YouTube plugin merging'
            'yt-dlp: YouTube and other sites in Open Network Stream'
            'xdg-desktop-portal: native file and folder dialogs')
conflicts=('vivi' 'vivi-git')
options=('!debug' '!strip')
# x86_64 still uses the 0.16.4 asset name so packaging CI can fetch the current release;
# scripts/bump-packaging.py rewrites it to vivi-${pkgver}-linux-x64.tar.gz from 0.16.5.
# aarch64 uses the new name (no arm64 tarball shipped before 0.16.5).
source_x86_64=("${url}/releases/download/v${pkgver}/vivi-${pkgver}-linux-x64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/vivi-${pkgver}-linux-arm64.tar.gz")
source=("io.github.loafer19.vivi.metainfo.xml::${url}/raw/v${pkgver}/packaging/flatpak/io.github.loafer19.vivi.metainfo.xml")
sha256sums=('79b19500960a15fd163d81cb39935c0a9f88da662cd2ea51eb5fd54775f83190')
sha256sums_x86_64=('f202931fc93e7d993453f4a742c9d276dc87d71c07007d816b588fe40c5cbadf')
sha256sums_aarch64=('62c34136b8ab8b406c7c72d9fbc5597fc2f51af3aadbc82c162506fc4b6f3094')

package() {
  case $CARCH in
    x86_64) _dir="vivi-${pkgver}-linux-x64" ;;
    aarch64) _dir="vivi-${pkgver}-linux-arm64" ;;
  esac
  cd "$_dir"
  install -Dm755 vivi "${pkgdir}/usr/bin/vivi"
  install -Dm755 vivi-mcp "${pkgdir}/usr/bin/vivi-mcp"
  install -Dm644 vivi.desktop "${pkgdir}/usr/share/applications/vivi.desktop"
  install -Dm644 vivi.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/vivi.svg"
  install -Dm644 vivi.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/vivi.png"
  sed 's|<launchable type="desktop-id">.*</launchable>|<launchable type="desktop-id">vivi.desktop</launchable>|' \
    "${srcdir}/io.github.loafer19.vivi.metainfo.xml" > metainfo.xml
  install -Dm644 metainfo.xml "${pkgdir}/usr/share/metainfo/io.github.loafer19.vivi.metainfo.xml"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
